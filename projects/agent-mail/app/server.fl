(load "lib/mail/auth.fl")
(load "lib/mail/store.fl")
(load "lib/mail/workflow.fl")

(defn agent-mail-error [request status code message]
  (server-status status {"error" {"code" code "message" message}
    "request_id" (or (server-req-header request "x-request-id") (auth-random-token 16))}))
(defn agent-mail-token [request]
  (let [[header (server-req-header request "authorization")]]
    (if (and (string? header) (str-starts-with header "Bearer ") (> (length header) 7))
      (substring header 7 (length header)) nil)))
(defn agent-mail-identity [request]
  (let [[token (agent-mail-token request)]]
    (if token (mail-authenticate AGENT_MAIL_DB token AGENT_MAIL_SIGNING_SECRET)
      (mail-auth-error "INVALID_CREDENTIAL" "bearer token is required"))))
(defn agent-mail-health [request]
  (server-json {"status" "ok" "service" "agent-mail" "scope" "loopback"}))
(defn agent-mail-login [request]
  (let [[body (server-req-json request)]]
    (if (not (and (map? body) (string? (get body "email")) (string? (get body "password"))))
      (agent-mail-error request 400 "INVALID_REQUEST" "email and password are required")
      (let [[result (mail-auth-login AGENT_MAIL_DB (get body "email") (get body "password") AGENT_MAIL_SIGNING_SECRET)]]
        (if (get result "ok")
          (server-json {"access_token" (get result "token") "token_type" "Bearer"
            "expires_at" (get result "expires_at") "user" (get result "user")
            "memberships" (get result "memberships")})
          (if (= (get (get result "error") "code") "RATE_LIMITED")
            (agent-mail-error request 429 "RATE_LIMITED" "login temporarily unavailable")
            (agent-mail-error request 401 "INVALID_CREDENTIAL" "email or password is invalid")))))))
(defn agent-mail-me [request]
  (let [[identity (agent-mail-identity request)]]
    (if (get identity "ok")
      (server-json {"user" (get identity "user") "memberships" (get identity "memberships")})
      (agent-mail-error request 401 "INVALID_CREDENTIAL" "bearer token is invalid"))))
(defn agent-mail-logout [request]
  (let [[identity (agent-mail-identity request)] [token (agent-mail-token request)]]
    (if (not (get identity "ok"))
      (agent-mail-error request 401 "INVALID_CREDENTIAL" "bearer token is invalid")
      (let [[result (mail-auth-logout AGENT_MAIL_DB token AGENT_MAIL_SIGNING_SECRET)]]
        (if (and (get result "ok") (get result "revoked"))
          (server-json {"ok" true "revoked" true})
          (agent-mail-error request 401 "INVALID_CREDENTIAL" "bearer token is invalid"))))))
(defn agent-mail-role? [identity role]
  (> (length (filter (fn [membership] (= (get membership "role") role))
    (get identity "memberships"))) 0))
(defn agent-mail-mailboxes [request]
  (let [[identity (agent-mail-identity request)]]
    (if (not (get identity "ok"))
      (agent-mail-error request 401 "INVALID_CREDENTIAL" "bearer token is invalid")
      (let [[result (mail-store-list-mailboxes AGENT_MAIL_DB (get (get identity "user") "user_id"))]]
        (server-json {"mailboxes" (get result "mailboxes")})))))
(defn agent-mail-mailbox-messages [request]
  (let [[identity (agent-mail-identity request)]]
    (if (not (get identity "ok"))
      (agent-mail-error request 401 "INVALID_CREDENTIAL" "bearer token is invalid")
      (let [[user-id (get (get identity "user") "user_id")]
            [mailbox-id (get (get request "params") "id")]
            [mailbox (mail-store-get-mailbox AGENT_MAIL_DB user-id mailbox-id)]]
        (if (not mailbox) (agent-mail-error request 404 "MAILBOX_NOT_FOUND" "mailbox was not found")
          (let [[result (mail-store-list-messages AGENT_MAIL_DB user-id mailbox-id 50)]]
            (server-json {"mailbox" {"mailbox_id" mailbox-id "address" (get mailbox "address")}
              "messages" (get result "messages")})))))))
(defn agent-mail-message-get [request]
  (let [[identity (agent-mail-identity request)]]
    (if (not (get identity "ok"))
      (agent-mail-error request 401 "INVALID_CREDENTIAL" "bearer token is invalid")
      (let [[user-id (get (get identity "user") "user_id")]
            [mailbox-id (get (get request "params") "id")]
            [message-id (get (get request "params") "message")]
            [message (mail-store-get-message AGENT_MAIL_DB user-id mailbox-id message-id)]]
        (if (not message)
          (agent-mail-error request 404 "MESSAGE_NOT_FOUND" "message was not found")
          (server-json {"message" message}))))))
(defn agent-mail-message-search [request]
  (let [[identity (agent-mail-identity request)]]
    (if (not (get identity "ok"))
      (agent-mail-error request 401 "INVALID_CREDENTIAL" "bearer token is invalid")
      (let [[user-id (get (get identity "user") "user_id")]
            [mailbox-id (get (get request "params") "id")]
            [query (server-req-query request "q")]
            [mailbox (mail-store-get-mailbox AGENT_MAIL_DB user-id mailbox-id)]]
        (if (not mailbox)
          (agent-mail-error request 404 "MAILBOX_NOT_FOUND" "mailbox was not found")
          (if (not (and (string? query) (!= query "")))
            (agent-mail-error request 400 "QUERY_REQUIRED" "a non-empty q parameter is required")
            (let [[result (mail-store-search-messages AGENT_MAIL_DB user-id mailbox-id query 50)]]
              (if (not (get result "ok"))
                (agent-mail-error request 422 "INVALID_QUERY" "search text is invalid or too long")
                (server-json {"mailbox" {"mailbox_id" mailbox-id "address" (get mailbox "address")}
                  "query" query "messages" (get result "messages")}))))))))
(defn agent-mail-draft-create [request]
  (let [[identity (agent-mail-identity request)]]
    (if (not (get identity "ok"))
      (agent-mail-error request 401 "INVALID_CREDENTIAL" "bearer token is invalid")
      (let [[body (server-req-json request)]
            [user-id (get (get identity "user") "user_id")]
            [mailbox-id (get (get request "params") "id")]
            [source-id (get body "source_message_id")]
            [source (mail-store-get-message AGENT_MAIL_DB user-id mailbox-id source-id)]
            [triage (get body "triage")]]
        (if (not source) (agent-mail-error request 404 "MESSAGE_NOT_FOUND" "source message was not found")
          (if (not (triage-valid? triage))
            (agent-mail-error request 422 "INVALID_TRIAGE" "triage response does not match the required schema")
            (let [[reply (mail-workflow-draft
                {"sequence" (get source "remote_uid") "from" (get source "from_address")
                 "subject" (get source "subject")}
                triage {"from" (get source "mailbox_address")})]]
              (if (!= (get reply "status") "pending-human-approval")
                (server-json {"status" "human-review-required" "draft" nil})
                (let [[draft (assoc (get reply "draft") "draft_id" (str "draft-" (auth-random-token 16)))]]
                  (let [[stored (mail-store-draft-create AGENT_MAIL_DB user-id
                      (assoc (assoc draft "mailbox_id" mailbox-id) "source_message_id" source-id))]]
                    (if (get stored "ok")
                      (server-status 201 {"draft_id" (get draft "draft_id")
                        "state" "pending-human-approval" "approval_required" true})
                      (agent-mail-error request 409 "DRAFT_CONFLICT" "draft could not be stored"))))))))))))
(defn agent-mail-drafts [request]
  (let [[identity (agent-mail-identity request)]]
    (if (not (get identity "ok"))
      (agent-mail-error request 401 "INVALID_CREDENTIAL" "bearer token is invalid")
      (let [[result (mail-store-list-drafts AGENT_MAIL_DB
        (get (get identity "user") "user_id") 50)]]
        (server-json {"drafts" (get result "drafts")})))))
(defn agent-mail-mailbox-create [request]
  (let [[identity (agent-mail-identity request)]]
    (if (not (get identity "ok"))
      (agent-mail-error request 401 "INVALID_CREDENTIAL" "bearer token is invalid")
      (if (not (agent-mail-role? identity "admin"))
        (agent-mail-error request 403 "SCOPE_DENIED" "workspace administrator role required")
        (let [[body (server-req-json request)]
              [email (get body "address")]
              [owner-id (or (get body "owner_id") (get (get identity "user") "user_id"))]
              [owners (db-query AGENT_MAIL_DB "SELECT u.user_id FROM mail_users u
                JOIN mail_memberships m ON m.user_id=u.user_id
                WHERE u.user_id=? AND u.state='active' AND m.workspace_id='default' AND m.state='active'"
                [owner-id])]
              [domain (str "@" AGENT_MAIL_DOMAIN)]]
          (if (not (and (map? body) (string? email) (smtp-address? email)
              (str-ends-with (str-lower email) domain)
              (string? (get body "mailbox_id")) (string? owner-id) (= (length owners) 1)))
            (agent-mail-error request 422 "INVALID_MAILBOX" "address, active mailbox owner and configured mail domain are required")
            (let [[created (mail-store-mailbox-create AGENT_MAIL_DB
              (get body "mailbox_id") owner-id (str-lower email))]]
              (if (get created "ok")
                (server-status 201 {"mailbox_id" (get body "mailbox_id") "owner_id" owner-id "address" (str-lower email)})
                (agent-mail-error request 409 "MAILBOX_CONFLICT" "mailbox id or address already exists")))))))))
(defn agent-mail-user-create [request]
  (let [[identity (agent-mail-identity request)]]
    (if (not (get identity "ok"))
      (agent-mail-error request 401 "INVALID_CREDENTIAL" "bearer token is invalid")
      (if (not (agent-mail-role? identity "admin"))
        (agent-mail-error request 403 "SCOPE_DENIED" "workspace administrator role required")
        (let [[body (server-req-json request)]
              [created (if (and (map? body) (string? (get body "email"))
                  (string? (get body "password")) (includes-item ["agent" "reviewer"] (get body "role")))
                (mail-auth-user-create AGENT_MAIL_DB
                  (get (get identity "user") "user_id") "default"
                  (get body "email") (get body "password") (get body "role"))
                {"ok" false "error" {"code" "INVALID_USER"}})]]
          (if (get created "ok")
            (server-status 201 {"user_id" (get created "user_id") "role" (get created "role")})
            (if (= (get (get created "error") "code") "USER_CONFLICT")
              (agent-mail-error request 409 "USER_CONFLICT" "user could not be created")
              (agent-mail-error request 422 "INVALID_USER" "email, password or role is invalid"))))))))
(defn agent-mail-human-role? [identity]
  (or (agent-mail-role? identity "admin") (agent-mail-role? identity "reviewer")))
(defn agent-mail-policy-dir-ready? []
  (if (not (and (string? AGENT_MAIL_POLICY_DIR) (!= AGENT_MAIL_POLICY_DIR ""))) false
    (let [[made (dir-make AGENT_MAIL_POLICY_DIR)]
          [rate-path (str AGENT_MAIL_POLICY_DIR "/rate.txt")]
          [exists (file-exists? rate-path)]]
      (if (not (get exists "ok")) false
        (if (get exists "value") true
          (get (file-write-atomic rate-path "") "ok"))))))
(defn agent-mail-approval-file [approval-id]
  (str AGENT_MAIL_POLICY_DIR "/approval-" approval-id ".json"))
(defn agent-mail-guard-policy [approval-id hash-id]
  {"lock-file" (str AGENT_MAIL_POLICY_DIR "/guard.lock")
   "approval-file" (agent-mail-approval-file approval-id)
   "rate-file" (str AGENT_MAIL_POLICY_DIR "/rate.txt")
   "stop-file" (str AGENT_MAIL_POLICY_DIR "/STOP")
   "audit-file" (str AGENT_MAIL_POLICY_DIR "/audit.jsonl")
   "hash-temp" (str AGENT_MAIL_POLICY_DIR "/hash-" hash-id ".tmp")})
(defn agent-mail-approve-draft [request]
  (let [[identity (agent-mail-identity request)]]
    (if (not (get identity "ok"))
      (agent-mail-error request 401 "INVALID_CREDENTIAL" "bearer token is invalid")
      (if (not (agent-mail-human-role? identity))
        (agent-mail-error request 403 "SCOPE_DENIED" "human reviewer role required")
        (if (not (agent-mail-policy-dir-ready?))
          (agent-mail-error request 503 "POLICY_UNAVAILABLE" "approval policy storage is unavailable")
          (let [[draft-id (get (get request "params") "id")]
                [draft (mail-store-get-draft AGENT_MAIL_DB draft-id)]]
            (if (not draft) (agent-mail-error request 404 "DRAFT_NOT_FOUND" "draft was not found")
              (if (!= (get draft "state") "pending-human-approval")
                (agent-mail-error request 409 "DRAFT_NOT_PENDING" "draft is not awaiting approval")
                (if (= (get (get identity "user") "user_id") (get draft "owner_id"))
                  (agent-mail-error request 403 "INDEPENDENT_APPROVAL_REQUIRED" "the draft owner cannot approve this draft")
                  (let [[approval-id (auth-random-token 16)]
                        [mail {"from" (get draft "from_address") "to" (get draft "to_address")
                          "subject" (get draft "subject") "body" (get draft "body")}]
                        [material (mail-guard-approval-material mail)]
                        [policy (agent-mail-guard-policy approval-id approval-id)]
                        [hashed (if (get material "ok")
                          (mail-guard-hash policy (get material "value")) {"ok" false})]]
                    (if (not (get hashed "ok"))
                      (agent-mail-error request 503 "APPROVAL_HASH_FAILED" "draft approval could not be prepared")
                      (let [[approval {"draft_id" draft-id "mail_sha256" (get hashed "value") "used" false}]
                            [encoded (json-stringify approval)]]
                        (if (not (get encoded "ok"))
                          (agent-mail-error request 503 "APPROVAL_WRITE_FAILED" "draft approval could not be saved")
                          (let [[written (file-write-atomic (agent-mail-approval-file approval-id) (get encoded "value"))]]
                            (if (not (get written "ok"))
                              (agent-mail-error request 503 "APPROVAL_WRITE_FAILED" "draft approval could not be saved")
                              (let [[saved (mail-store-approve-draft AGENT_MAIL_DB draft-id
                                  (get (get identity "user") "user_id") approval-id
                                  (get hashed "value") (+ (now-s) 86400))]]
                                (if (get saved "ok")
                                  (server-status 201 {"draft_id" draft-id "state" "approved"
                                    "expires_at" (+ (now-s) 86400)})
                                  (do (_fl_file_delete (agent-mail-approval-file approval-id))
                                    (agent-mail-error request 409 "DRAFT_NOT_PENDING" "draft was already approved")))))))))))))))))))
(defn agent-mail-send-draft [request]
  (let [[identity (agent-mail-identity request)]]
    (if (not (get identity "ok"))
      (agent-mail-error request 401 "INVALID_CREDENTIAL" "bearer token is invalid")
      (if (not (agent-mail-human-role? identity))
        (agent-mail-error request 403 "SCOPE_DENIED" "human send role required")
        (if (not (agent-mail-policy-dir-ready?))
          (agent-mail-error request 503 "POLICY_UNAVAILABLE" "send policy storage is unavailable")
          (let [[draft-id (get (get request "params") "id")]
                [draft (mail-store-get-draft AGENT_MAIL_DB draft-id)]
                [approval (mail-store-get-approval AGENT_MAIL_DB draft-id)]]
            (if (or (not draft) (not approval))
              (agent-mail-error request 404 "APPROVAL_NOT_FOUND" "approved draft was not found")
              (if (or (!= (get draft "state") "approved") (!= (get approval "used_at") 0)
                  (<= (get approval "expires_at") (now-s)))
                (agent-mail-error request 409 "APPROVAL_USED_OR_STALE" "approval is expired or already used")
                (let [[mail {"from" (get draft "from_address") "to" (get draft "to_address")
                    "subject" (get draft "subject") "body" (get draft "body")}]
                      [hash-id (auth-random-token 16)]
                      [material (mail-guard-approval-material mail)]
                      [policy (agent-mail-guard-policy (get approval "approval_id") hash-id)]
                      [hashed (if (get material "ok")
                        (mail-guard-hash policy (get material "value")) {"ok" false})]]
                  (if (or (not (get hashed "ok")) (!= (get hashed "value") (get approval "payload_sha256")))
                    (agent-mail-error request 409 "DRAFT_CHANGED" "approved draft content has changed")
                    (let [[job-id (str "send-" (auth-random-token 16))]
                          [started (mail-store-enqueue-send AGENT_MAIL_DB draft-id
                            (get approval "approval_id") job-id)]]
                      (if (not (get started "ok"))
                        (agent-mail-error request 409 "APPROVAL_USED_OR_STALE" "approval is expired or already used")
                        (server-status 202 {"send_job_id" job-id "state" "queued"})))))))))))))
(defn agent-mail-send-job [request]
  (let [[identity (agent-mail-identity request)]]
    (if (not (get identity "ok"))
      (agent-mail-error request 401 "INVALID_CREDENTIAL" "bearer token is invalid")
      (let [[job-id (get (get request "params") "id")]
            [job (mail-store-get-send-job AGENT_MAIL_DB job-id)]]
        (if (not job) (agent-mail-error request 404 "SEND_JOB_NOT_FOUND" "send job was not found")
          (let [[draft (mail-store-get-draft AGENT_MAIL_DB (get job "draft_id"))]]
            (if (or (= (get draft "owner_id") (get (get identity "user") "user_id"))
                (agent-mail-human-role? identity))
              (server-json {"send_job_id" (get job "job_id") "draft_id" (get job "draft_id") "state" (get job "state")})
              (agent-mail-error request 404 "SEND_JOB_NOT_FOUND" "send job was not found"))))))))

(define AGENT_MAIL_DB_PATH (_fl_env_get "AGENT_MAIL_DB"))
(define AGENT_MAIL_SIGNING_SECRET (_fl_env_get "AGENT_MAIL_SIGNING_SECRET"))
(define AGENT_MAIL_PORT (or (str-to-num (_fl_env_get "AGENT_MAIL_PORT")) 40125))
(define AGENT_MAIL_DOMAIN (or (_fl_env_get "AGENT_MAIL_DOMAIN") "example.invalid"))
(define AGENT_MAIL_POLICY_DIR (_fl_env_get "AGENT_MAIL_POLICY_DIR"))
(if (not (and (string? AGENT_MAIL_DB_PATH) (!= AGENT_MAIL_DB_PATH "")
    (string? AGENT_MAIL_SIGNING_SECRET) (>= (length AGENT_MAIL_SIGNING_SECRET) 32)
    (string? AGENT_MAIL_DOMAIN) (!= AGENT_MAIL_DOMAIN "")
    (number? AGENT_MAIL_PORT) (>= AGENT_MAIL_PORT 0) (<= AGENT_MAIL_PORT 65535)))
  (do (println "AGENT_MAIL_BOOT=CONFIG_ERROR") (_fl_exit 2)) nil)
(define AGENT_MAIL_DB (db-open AGENT_MAIL_DB_PATH))
(mail-auth-init AGENT_MAIL_DB)
(mail-store-init AGENT_MAIL_DB)
(mail-store-reconcile-send-jobs AGENT_MAIL_DB)
(define AGENT_MAIL_USERS (db-query AGENT_MAIL_DB "SELECT COUNT(*) AS count FROM mail_users" []))
(if (= (get (get AGENT_MAIL_USERS 0) "count") 0)
  (let [[bootstrap (mail-auth-bootstrap-admin AGENT_MAIL_DB
      (_fl_env_get "AGENT_MAIL_BOOTSTRAP_EMAIL") (_fl_env_get "AGENT_MAIL_BOOTSTRAP_PASSWORD"))]]
    (if (not (get bootstrap "ok"))
      (do (println "AGENT_MAIL_BOOT=ADMIN_BOOTSTRAP_REQUIRED") (_fl_exit 2)) nil)) nil)

(server-get "/health" agent-mail-health)
(server-post "/v1/auth/login" agent-mail-login)
(server-get "/v1/auth/me" agent-mail-me)
(server-post "/v1/auth/logout" agent-mail-logout)
(server-post "/v1/admin/mailboxes" agent-mail-mailbox-create)
(server-post "/v1/admin/users" agent-mail-user-create)
(server-get "/v1/mailboxes" agent-mail-mailboxes)
(server-get "/v1/mailboxes/:id/messages" agent-mail-mailbox-messages)
(server-get "/v1/mailboxes/:id/messages/:message" agent-mail-message-get)
(server-get "/v1/mailboxes/:id/search" agent-mail-message-search)
(server-post "/v1/mailboxes/:id/drafts" agent-mail-draft-create)
(server-post "/v1/drafts/:id/approve" agent-mail-approve-draft)
(server-post "/v1/drafts/:id/send" agent-mail-send-draft)
(server-get "/v1/drafts" agent-mail-drafts)
(server-get "/v1/send-jobs/:id" agent-mail-send-job)
(server-start AGENT_MAIL_PORT)
