;; tasks-store.fl — 작업 정의·이력 (Phase X3)

[FUNC tasks-ensure-tables :params [$db]
  :body (do
    (db_create $db "CREATE TABLE IF NOT EXISTS tasks (
      id          INTEGER PRIMARY KEY AUTOINCREMENT,
      name        TEXT NOT NULL UNIQUE,
      cron_expr   TEXT NOT NULL,
      topic       TEXT NOT NULL,
      payload     TEXT,
      enabled     INTEGER NOT NULL DEFAULT 1,
      last_run    INTEGER,
      next_run    INTEGER,
      created_at  TEXT NOT NULL
    )")
    (db_create $db "CREATE TABLE IF NOT EXISTS task_runs (
      id          INTEGER PRIMARY KEY AUTOINCREMENT,
      task_id     INTEGER NOT NULL,
      task_name   TEXT NOT NULL,
      started_at  INTEGER NOT NULL,
      ended_at    INTEGER,
      status      TEXT NOT NULL,
      detail      TEXT
    )")
    (db_create $db "CREATE INDEX IF NOT EXISTS idx_runs_task ON task_runs(task_id, started_at DESC)"))]

[FUNC task-add :params [$db $name $cron-expr $topic $payload]
  :body (let [
    valid (cron_validate $cron-expr)
  ]
    (if (not $valid)
      false
      (do
        (db_delete_row $db "tasks" (str "name='" $name "'"))
        (db_insert $db "tasks" {
          :name $name
          :cron_expr $cron-expr
          :topic $topic
          :payload (if (= $payload nil) "" (json_stringify $payload))
          :enabled 1
          :next_run (cron_next_match $cron-expr (now_ms))
          :created_at (now_iso)
        })
        true)))]

[FUNC task-list :params [$db]
  :body (db_query $db
    "SELECT id, name, cron_expr, topic, enabled, last_run, next_run FROM tasks ORDER BY name"
    [])]

[FUNC task-due :params [$db $now-ms]
  :body (db_query $db
    (str "SELECT id, name, cron_expr, topic, payload FROM tasks WHERE enabled=1 AND next_run <= " $now-ms)
    [])]

[FUNC task-mark-run :params [$db $task-id $cron-expr]
  :body (let [now-ms (now_ms)]
    (db_update $db "tasks"
      {:last_run $now-ms
       :next_run (cron_next_match $cron-expr (+ $now-ms 60000))}
      (str "id=" $task-id)))]

[FUNC task-run-record :params [$db $task-id $task-name $status $detail]
  :body (db_insert $db "task_runs" {
    :task_id $task-id
    :task_name $task-name
    :started_at (now_ms)
    :ended_at (now_ms)
    :status $status
    :detail (if (= $detail nil) "" $detail)
  })]

[FUNC task-recent-runs :params [$db $limit]
  :body (db_query $db
    (str "SELECT task_id, task_name, started_at, status, detail FROM task_runs ORDER BY started_at DESC LIMIT " $limit)
    [])]
