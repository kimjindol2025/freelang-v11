{
  "$": "airc-spec",
  "version": "1.0.0",
  "project": "freelang-v11",
  "date": "2026-06-02",
  "identity": {
    "what": "AI(Claude) 전용 FreeLang v11 함수 명세 — 이름·인자 순서·실수 패턴",
    "why": "훈련 데이터 부족으로 AI가 FL 함수명·인자 순서를 자주 틀림. 세션마다 재확인 비용 제거",
    "for": "Claude가 FL 코드 작성 전 참조하는 단일 진실 소스",
    "not": "인간용 튜토리얼. 설명 최소화, 패턴 중심"
  },
  "constitution": {
    "1": "함수명은 kebab-case 정식명 기준. snake_case 별칭도 동작하지만 정식명 사용",
    "2": "인자 순서가 틀리면 런타임 에러 또는 조용한 오작동. 순서 먼저 확인",
    "3": "danger 마크된 함수는 작성 전 반드시 이 파일 참조",
    "4": "새 실수 패턴 발견 시 errors 노드에 추가"
  },
  "danger_patterns": {
    "fn_first": {
      "rule": "fn이 첫 번째 인자",
      "correct": ["(map fn arr)", "(filter fn arr)", "(sort-by fn arr)", "(map-indexed fn arr)"],
      "wrong":   ["(map arr fn)", "(filter arr fn)", "(sort-by arr fn)"]
    },
    "n_first": {
      "rule": "n이 첫 번째 인자",
      "correct": ["(take n arr)", "(drop n arr)"],
      "wrong":   ["(take arr n)", "(drop arr n)"]
    },
    "string_key": {
      "rule": "assoc 키는 문자열",
      "correct": ["(assoc m \"key\" val)"],
      "wrong":   ["(assoc m :key val)"]
    },
    "sep_first": {
      "rule": "str-join에서 sep이 첫 번째",
      "correct": ["(str-join \", \" arr)"],
      "wrong":   ["(str-join arr \", \")"]
    },
    "naming": {
      "correct": ["(define x 1)", "(obj-merge a b)", "(server-start port)", "(server-html h)"],
      "wrong":   ["(def x 1)", "(merge a b)", "(server_listen port)", "(server-response h)"]
    }
  },
  "functions": {
    "string": {
      "str":             "(str v1 v2 ...) → string",
      "str-includes":    "(str-includes s sub) → boolean",
      "str-starts-with": "(str-starts-with s prefix) → boolean",
      "str-ends-with":   "(str-ends-with s suffix) → boolean",
      "str-split":       "(str-split s sep) → [string] | (str-split s sep n) → 최대n개",
      "str-replace":     "(str-replace s old new) → string (첫번째만)",
      "str-replace-all": "(str-replace-all s old new) → string",
      "str-trim":        "(str-trim s) → string",
      "str-to-upper":    "(str-to-upper s) → string",
      "str-to-lower":    "(str-to-lower s) → string",
      "str-to-num":      "(str-to-num s) → number | nil",
      "str-slice":       "(str-slice s start end) → string",
      "str-pad-left":    "(str-pad-left s n ch) → string",
      "str-pad-right":   "(str-pad-right s n ch) → string",
      "str-index-of":    "(str-index-of s sub) → number (-1이면없음)",
      "str-blank?":      "(str-blank? s) → boolean (nil/빈/공백)",
      "str-format":      "(str-format \"%s %d\" v1 v2) → string",
      "str-join":        "(str-join sep arr) → string  ← sep 먼저!",
      "str-repeat":      "(str-repeat s n) → string",
      "str-count":       "(str-count s sub) → number",
      "str-lines":       "(str-lines s) → [string]",
      "triple-quote":    "\"\"\"<h1>${name}</h1>\"\"\" → 변수 보간 지원"
    },
    "array": {
      "range":        "(range start end) → [number]  (end 미포함)",
      "repeat":       "(repeat n val) → [val, ...]",
      "length":       "(length arr) → number",
      "count":        "(count arr) → number  (length 별칭)",
      "first":        "(first arr) → any | nil",
      "last":         "(last arr) → any | nil",
      "rest":         "(rest arr) → [any]",
      "nth":          "(nth arr n) → any",
      "map":          "(map fn arr) → [any]  ← fn 먼저!",
      "filter":       "(filter fn arr) → [any]  ← fn 먼저!",
      "reduce":       "(reduce fn init arr) → any",
      "map-indexed":  "(map-indexed fn arr) → [any]  fn인자: (idx val)",
      "sort":         "(sort arr) → [any]",
      "sort-by":      "(sort-by fn arr) → [any]  ← fn 먼저!",
      "reverse":      "(reverse arr) → [any]",
      "take":         "(take n arr) → [any]  ← n 먼저!",
      "drop":         "(drop n arr) → [any]  ← n 먼저!",
      "take-while":   "(take-while fn arr) → [any]",
      "drop-while":   "(drop-while fn arr) → [any]",
      "push":         "(push arr val) → [any] (불변)",
      "conj":         "(conj arr val) → [any]",
      "into":         "(into arr1 arr2) → [any]",
      "includes-item":"(includes-item arr val) → boolean",
      "index-of":     "(index-of arr val) → number",
      "find-first":   "(find-first fn arr) → any | nil",
      "some":         "(some fn arr) → any | nil",
      "every?":       "(every? fn arr) → boolean",
      "any?":         "(any? fn arr) → boolean",
      "sum":          "(sum arr) → number",
      "average":      "(average arr) → number",
      "count-if":     "(count-if fn arr) → number",
      "distinct":     "(distinct arr) → [any]",
      "flatten":      "(flatten arr) → [any]",
      "flatten-1":    "(flatten-1 arr) → [any] (1단계만)",
      "group-by":     "(group-by fn arr) → {key: [items]}",
      "frequencies":  "(frequencies arr) → {val: count}",
      "zip":          "(zip arr1 arr2) → [[a,b], ...]",
      "partition":    "(partition n arr) → [[any], ...]"
    },
    "map": {
      "get":         "(get m key) → any | nil | (get m key default)",
      "get-in":      "(get-in m [k1 k2]) → any | (get-in m [k1 k2] default)",
      "?.":          "(?. m :k1 :k2) → any | nil (nil 안전 체이닝)",
      "??":          "(?? a b) → a가 nil이면 b 반환",
      "assoc":       "(assoc m \"key\" val) → map  ← 문자열 키 필수!",
      "assoc-in":    "(assoc-in m [\"k1\" \"k2\"] val) → map",
      "dissoc":      "(dissoc m \"key\") → map",
      "update":      "(update m \"key\" fn) → map",
      "update-in":   "(update-in m [\"k\"] fn) → map",
      "obj-merge":   "(obj-merge m1 m2) → map",
      "obj-pick":    "(obj-pick m [\"k1\" \"k2\"]) → map",
      "obj-omit":    "(obj-omit m [\"k1\" \"k2\"]) → map",
      "obj-keys":    "(obj-keys m) → [string]",
      "obj-values":  "(obj-values m) → [any]",
      "obj-entries": "(obj-entries m) → [[k,v], ...]",
      "map-vals":    "(map-vals fn m) → map",
      "map-keys":    "(map-keys fn m) → map",
      "filter-vals": "(filter-vals fn m) → map",
      "has-key?":    "(has-key? m \"key\") → boolean",
      "select-keys": "(select-keys m [\"k1\" \"k2\"]) → map",
      "rename-keys": "(rename-keys m {\"old\" \"new\"}) → map",
      "merge-with":  "(merge-with fn m1 m2) → map"
    },
    "control": {
      "if":      "(if cond then else)",
      "when":    "(when cond body)",
      "when-not":"(when-not cond body)",
      "cond":    "(cond (= x 1) \"one\" (= x 2) \"two\" :else \"other\")",
      "case":    "(case x 1 \"one\" 2 \"two\" \"default\")",
      "do":      "(do e1 e2 ...) → 마지막 값",
      "let":     "(let [x 1 y 2] body)",
      "loop":    "(loop [i 0] (if (< i 10) (recur (inc i)) i))",
      "for":     "(for [x arr :when (> x 0)] (* x 2))",
      "dotimes": "(dotimes [i 5] (println i))",
      "doseq":   "(doseq [x arr] (println x))",
      "try":     "(try body (catch e handler) (finally cleanup))"
    },
    "type_check": {
      "nil?":         "(nil? x)",
      "string?":      "(string? x)",
      "number?":      "(number? x)",
      "boolean?":     "(boolean? x)",
      "array?":       "(array? x)",
      "map?":         "(map? x)",
      "fn?":          "(fn? x)",
      "integer?":     "(integer? x)",
      "float?":       "(float? x)",
      "empty?":       "(empty? x)  배열/문자열/맵/nil 모두 지원",
      "nil-or-empty?":"(nil-or-empty? x)",
      "str-blank?":   "(str-blank? x)  nil/빈/공백",
      "type-of":      "(type-of x) → \"nil\"|\"string\"|\"number\"|\"boolean\"|\"array\"|\"map\"|\"function\""
    },
    "server": {
      "server-start":       "(server-start 40001)",
      "server-get":         "(server-get \"/path\" (fn [req] response))",
      "server-post":        "(server-post \"/path\" (fn [req] response))",
      "server-put":         "(server-put \"/path\" (fn [req] response))",
      "server-delete":      "(server-delete \"/path\" (fn [req] response))",
      "server-html":        "(server-html \"<h1>hi</h1>\")",
      "server-json":        "(server-json {:ok true :data []})",
      "server-status":      "(server-status 404 \"Not Found\")",
      "server-redirect":    "(server-redirect \"/login\")",
      "server-text":        "(server-text \"plain\")",
      "server-set-cookie":  "(server-set-cookie \"name\" \"val\" {:max_age 3600}) → cookie",
      "server-html-cookie": "(server-html-cookie \"<h1>ok</h1>\" cookie)",
      "req-body":           "(get req \"body\") → map (JSON 자동 파싱)",
      "req-params":         "(get req \"params\") → map (경로 파라미터)",
      "req-query":          "(get req \"query\") → map",
      "req-headers":        "(get req \"headers\") → map",
      "req-cookies":        "(get req \"cookies\") → map",
      "http-get":           "(http-get url) → {ok, status, body}",
      "http-post-json":     "(http-post-json url body) → {ok, status, body}",
      "http-ok?":           "(http-ok? result) → boolean",
      "http-body":          "(http-body result) → parsed body"
    },
    "database": {
      "db-config":     "{\"host\" \"localhost\" \"port\" 3306 \"user\" \"u\" \"password\" \"p\" \"database\" \"db\"}",
      "db-query":      "(db-query db \"SELECT * FROM t WHERE id=?\" [id]) → [row, ...]",
      "db-exec":       "(db-exec db \"INSERT INTO t (a) VALUES (?)\" [val]) → result",
      "db-transaction":"(db-transaction db (fn [] ...))"
    },
    "auth": {
      "auth-jwt-sign":        "(auth-jwt-sign {:user_id 1} \"secret\" 3600) → token",
      "auth-jwt-verify":      "(auth-jwt-verify token \"secret\") → payload | nil",
      "auth-jwt-expired":     "(auth-jwt-expired token) → boolean",
      "auth-hash-password":   "(auth-hash-password \"pass\") → hash",
      "auth-verify-password": "(auth-verify-password \"pass\" hash) → boolean",
      "auth-csrf-token":      "(auth-csrf-token \"secret\") → token",
      "auth-csrf-verify":     "(auth-csrf-verify token \"secret\") → boolean",
      "auth-bearer-extract":  "(auth-bearer-extract req) → token | nil"
    },
    "file": {
      "file-read":    "(file-read \"/path\") → string",
      "file-write":   "(file-write \"/path\" \"content\") → boolean",
      "file-append":  "(file-append \"/path\" \"content\") → boolean",
      "file-exists":  "(file-exists \"/path\") → boolean",
      "file-delete":  "(file-delete \"/path\") → boolean"
    },
    "util": {
      "fl-env-get":    "(fl-env-get \"KEY\" \"default\") → string",
      "now-ms":        "(now-ms) → Unix ms",
      "uuid":          "(uuid) → string",
      "sleep":         "(sleep ms) → nil",
      "println":       "(println v1 v2) → nil",
      "json-parse":    "(json-parse str) → any",
      "json-stringify":"(json-stringify val) → string",
      "html-escape":   "(html-escape str) → string",
      "js-escape":     "(js-escape str) → string",
      "rand":          "(rand) → 0.0~1.0",
      "rand-int":      "(rand-int n) → 0~n-1 | (rand-int min max) → min~max-1",
      "format-date":   "(format-date ms \"YYYY-MM-DD\") → string",
      "re-test":       "(re-test \"pattern\" str) → boolean",
      "inc":           "(inc n)",
      "dec":           "(dec n)",
      "abs":           "(abs n)",
      "round":         "(round n)",
      "floor":         "(floor n)",
      "ceil":          "(ceil n)",
      "min":           "(min a b)",
      "max":           "(max a b)",
      "pow":           "(pow a b)",
      "sqrt":          "(sqrt n)",
      "mod":           "(mod a b)",
      "quot":          "(quot a b)",
      "rem":           "(rem a b)"
    },
    "atom": {
      "atom":       "(atom 0) → atom",
      "deref":      "@atom 또는 (deref atom) → 현재 값",
      "swap!":      "(swap! atom fn) → 새값  fn: oldVal→newVal",
      "reset!":     "(reset! atom val) → val",
      "get-store":  "(get-store \"key\") → any",
      "dispatch":   "(dispatch \"key\" val) → nil",
      "watch-store":"(watch-store fn) → unsubscribe-fn"
    },
    "functional": {
      "comp":       "(comp f g) → (fn [x] (f (g x)))  오른쪽→왼쪽",
      "partial":    "(partial fn arg1) → fn",
      "complement": "(complement fn) → fn (결과 반전)",
      "constantly": "(constantly val) → (fn [& _] val)",
      "juxt":       "(juxt f g) → (fn [x] [(f x) (g x)])",
      "apply":      "(apply fn arr) → fn 호출",
      "tap":        "(tap val fn) → val (side-effect용)"
    }
  },
  "errors": {
    "e-001": {
      "t": "error",
      "v": "map/filter/sort-by에서 arr fn 순서로 작성",
      "cause": "JS/Python 습관. 올바른 순서는 fn 먼저",
      "fix": "항상 (map fn arr) 형태 확인",
      "repeat_risk": "high"
    },
    "e-002": {
      "t": "error",
      "v": "take/drop에서 arr n 순서로 작성",
      "cause": "직관적으로 arr을 먼저 쓰게 됨",
      "fix": "(take n arr) — n 먼저",
      "repeat_risk": "high"
    },
    "e-003": {
      "t": "error",
      "v": "assoc에서 :keyword 키 사용",
      "cause": "Clojure 습관",
      "fix": "(assoc m \"key\" val) — 문자열 키 필수",
      "repeat_risk": "medium"
    },
    "e-004": {
      "t": "error",
      "v": "fl-env-get이 null 반환",
      "cause": "2026-06-02 전 버전에서 process.env 대신 FL 내부 스코프를 읽는 버그",
      "fix": "freelang-v11 커밋 eedf81c9 이후 수정됨. bootstrap.js 갱신 필요",
      "repeat_risk": "low"
    },
    "e-005": {
      "t": "error",
      "v": "Island atom이 클릭마다 0으로 리셋",
      "cause": "renderFn 안에서 atom 선언 시 update()마다 재초기화",
      "fix": "island-compiler.js 커밋 40dbc86 이후 최상위 let의 atom 자동 호이스팅됨",
      "repeat_risk": "low"
    }
  },
  "checklist": [
    "map/filter/sort-by → fn이 첫번째",
    "take/drop → n이 첫번째",
    "assoc → 키는 문자열",
    "str-join → sep이 첫번째",
    "db-query → params는 벡터 [v1 v2]",
    "define not def",
    "obj-merge not merge",
    "server-start not server_listen",
    "Island atom → let 최상위에서 선언"
  ]
}
