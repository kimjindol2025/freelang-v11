;; tests/critical-fixes-simple-test.fl — CRITICAL Fixes 통합 테스트 (stdlib 함수만)
;; Fix #3 (cron-tick) + Fix #4 (email) 검증

(load "stdlib/cron.fl")
(load "stdlib/email.fl")

(println "========================================")
(println "FreeLang v11.7.11 CRITICAL Fixes 검증")
(println "========================================")
(println "")

;; ───────────────────────────────────────────────────────────────────────────────
;; Fix #3 테스트: cron-tick 중복 실행 방지
;; ───────────────────────────────────────────────────────────────────────────────

(println "[ Fix #3 테스트 ] cron-tick 중복 실행 방지")
(println "────────────────────────────────────────────")

;; 테스트 3-1: 같은 분 내 중복 실행 방지
(println "Test 3-1: 같은 분에 2번 tick 호출 → 1회만 실행")
(let [cr (cron-create)
      counter (atom 0)
      handler (fn [] (swap! counter + 1))]
  (cron-add cr "test-job" "* * * * *" handler)
  ;; 1번째 tick
  (cron-tick cr)
  (let [count1 (deref counter)]
    ;; 2번째 tick (같은 분)
    (cron-tick cr)
    (let [count2 (deref counter)]
      (if (and (= count1 1) (= count2 1))
        (println "✅ PASS (중복 실행 방지됨)")
        (println "❌ FAIL: count1=" count1 " count2=" count2)))))

;; 테스트 3-2: 실패해도 :last-run 업데이트 확인
(println "Test 3-2: handler 실패 후에도 :last-run 업데이트 확인")
(let [cr (cron-create)
      fail-counter (atom 0)
      fail-handler (fn [] (do (swap! fail-counter + 1) (throw "intentional error")))]
  (cron-add cr "failing-job" "* * * * *" fail-handler)
  ;; 1번째 tick (실패)
  (let [result1 (try (cron-tick cr) (catch err {:error (get err "message")}))]
    (let [job (cron-job cr "failing-job")]
      (if (not (nil? (get job :last-run)))
        (println "✅ PASS (실패했지만 :last-run 업데이트됨)")
        (println "❌ FAIL: :last-run이 nil")))))

;; ───────────────────────────────────────────────────────────────────────────────
;; Fix #4 테스트: email 헬퍼 함수 검증
;; ───────────────────────────────────────────────────────────────────────────────

(println "")
(println "[ Fix #4 테스트 ] email 재시도 헬퍼")
(println "─────────────────────────────────────")

;; 테스트 4-1: -exponential-backoff 동작 확인
(println "Test 4-1: -exponential-backoff (지수 백오프 계산)")
(let [backoff0 (-exponential-backoff 0)
      backoff1 (-exponential-backoff 1)
      backoff2 (-exponential-backoff 2)
      backoff3 (-exponential-backoff 3)]
  (if (and (= backoff0 1000)  ;; 2^0 * 1000 = 1000
           (= backoff1 2000)  ;; 2^1 * 1000 = 2000
           (= backoff2 4000)  ;; 2^2 * 1000 = 4000
           (= backoff3 8000)) ;; 2^3 * 1000 = 8000
    (println "✅ PASS (지수 백오프: 1000ms → 2000ms → 4000ms → 8000ms)")
    (println "❌ FAIL: " backoff0 " / " backoff1 " / " backoff2 " / " backoff3)))

;; 테스트 4-2: -should-retry-email? 동작 확인 (상태 코드 분류)
(println "Test 4-2: -should-retry-email? (상태 코드 분류)")
(let [cases [
      {:status 0 :expected true :name "타임아웃"}
      {:status 429 :expected true :name "Rate limit"}
      {:status 503 :expected true :name "Service unavailable"}
      {:status 500 :expected true :name "Server error"}
      {:status 401 :expected false :name "Auth error"}
      {:status 400 :expected false :name "Bad request"}
      {:status 404 :expected false :name "Not found"}
    ]
      results (map (fn [$case]
        (let [$status (get $case :status)
              $expected (get $case :expected)
              $result (-should-retry-email? $status)]
          (if (= $result $expected)
            {:ok true :status $status}
            {:ok false :status $status :expected $expected :got $result})))
      $cases)
      all-pass (every (fn [$r] (get $r :ok)) $results)]
  (if all-pass
    (println "✅ PASS (모든 상태 코드 분류 정상)")
    (do
      (println "❌ FAIL: 상태 코드 분류 오류")
      (doseq [$r $results]
        (if (not (get $r :ok))
          (println "  - status=" (get $r :status) " expected=" (get $r :expected) " got=" (get $r :got)))))))

;; 테스트 4-3: email-init-sendgrid 동작 확인
(println "Test 4-3: email-init-sendgrid (설정 생성)")
(let [$cfg (email-init-sendgrid "test-api-key")
      $type (get $cfg "type")
      $api-key (get $cfg "api_key")]
  (if (and (= $type "sendgrid") (= $api-key "test-api-key"))
    (println "✅ PASS (SendGrid 설정 생성 정상)")
    (println "❌ FAIL: " $cfg)))

(println "")
(println "========================================")
(println "통합 테스트 완료!")
(println "========================================")
