(load "../../self/stdlib/json.fl")

(defn assert-eq [actual expected name]
  (if (= actual expected)
    (println (str "PASS " name))
    (throw (str "FAIL " name " expected=" expected " actual=" actual))))
(defn error-code [result] (get (get result "error") "code"))

;; Valid values (15)
(assert-eq (get (json-parse "0") "value") 0 "number zero")
(assert-eq (get (json-parse "-17") "value") -17 "negative integer")
(assert-eq (get (json-parse "2.5") "value") 2.5 "fraction")
(assert-eq (get (json-parse "1e2") "value") 100 "exponent")
(assert-eq (get (json-parse "true") "value") true "true")
(assert-eq (get (json-parse "false") "value") false "false")
(assert-eq (get (json-parse "null") "ok") true "null")
(assert-eq (get (json-parse "[]") "value") [] "empty array")
(assert-eq (get (json-parse "[1,\"x\",false]") "value") [1 "x" false] "mixed array")
(assert-eq (get (json-parse "{}") "value") {} "empty object")
(assert-eq (get (get (json-parse "{\"a\":1,\"b\":2}") "value") "b") 2 "object member")
(assert-eq (get (json-parse " { \"x\" : 9 } \n") "ok") true "whitespace")
(assert-eq (json-valid? "[true, null, 3]" ) true "valid predicate")
(assert-eq (json-valid? "[true,]" ) false "invalid predicate")
(assert-eq (get (json-get {:a [10 20]} ["a" 1]) "value") 20 "nested path")

;; Malformed inputs (10)
(assert-eq (get (json-parse "") "ok") false "empty input")
(assert-eq (error-code (json-parse "{")) "JSON_OBJECT" "unterminated object")
(assert-eq (error-code (json-parse "[1,]")) "JSON_VALUE" "array trailing comma")
(assert-eq (error-code (json-parse "{\"a\":}")) "JSON_VALUE" "missing object value")
(assert-eq (error-code (json-parse "{a:1}")) "JSON_OBJECT" "unquoted key")
(assert-eq (error-code (json-parse "true false")) "JSON_TRAILING" "trailing value")
(assert-eq (error-code (json-parse "01")) "JSON_NUMBER" "leading zero")
(assert-eq (error-code (json-parse "1.")) "JSON_NUMBER" "fraction needs digits")
(assert-eq (error-code (json-parse "1e+")) "JSON_NUMBER" "exponent needs digits")
(assert-eq (error-code (json-parse "\"\\q\"")) "JSON_ESCAPE" "unknown escape")

;; Unicode, escaping, and NUL (6)
(assert-eq (get (json-parse "\"\\u0041\"") "value") "A" "unicode ascii escape")
(assert-eq (get (json-parse "\"\\uAC00\"") "value") "가" "unicode hangul escape")
(assert-eq (get (json-parse "\"\\uD83D\\uDE00\"") "value") "😀" "surrogate pair")
(assert-eq (error-code (json-parse "\"\\uD83D\"")) "JSON_SURROGATE" "unpaired high surrogate")
(assert-eq (error-code (json-parse "\"\\uDE00\"")) "JSON_SURROGATE" "unpaired low surrogate")
(assert-eq (error-code (json-parse "\"\\u0000\"")) "UNSUPPORTED_NUL" "nul unsupported")
(assert-eq (get (json-parse "\"line\\nnext\\t\\\"\\\\\"") "value") "line\nnext\t\"\\" "escape newline tab quote slash")
(assert-eq (error-code (json-parse (get (char-from-byte 128) "value"))) "JSON_UTF8" "reject invalid raw UTF-8")

;; Serializer and round-trip behavior (9)
(assert-eq (get (json-stringify nil) "value") "null" "stringify null")
(assert-eq (get (json-stringify true) "value") "true" "stringify boolean")
(assert-eq (get (json-stringify [1 "a"]) "value") "[1,\"a\"]" "stringify array")
(assert-eq (get (json-stringify {:a 1}) "value") "{\"a\":1}" "stringify object")
(assert-eq (get (json-stringify {:a 1 :b 2}) "value") "{\"a\":1,\"b\":2}" "preserve key order")
(assert-eq (get (json-stringify "가😀") "value") "\"가😀\"" "stringify unicode")
(assert-eq (get (json-stringify "a\nb") "value") "\"a\\nb\"" "escape newline")
(assert-eq (json-valid? (get (json-stringify {:ok [1 "가"]}) "value")) true "serialized output parses")
(assert-eq (get (json-parse (get (json-stringify {:ok [1 "가"]}) "value")) "ok") true "round trip parse stringify parse")

;; Error shape and positions (2)
(assert-eq (get (get (json-parse "[1,]") "error") "position") 3 "error position")
(assert-eq (get (json-get {:a 1} ["missing"]) "ok") false "missing path error")

(println "JSON_SUMMARY=44/44")
