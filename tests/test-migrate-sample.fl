;; 마이그레이션 테스트용 샘플 파일

(defn handle-request [$req]
  (let [[body (get $req "body")]
        [count (str-to-num (get body "count"))]]
    (if (file-exists? "log.txt")
      (do
        (file-append "log.txt" "request\n")
        (server-json $req {:success true :count count}))
      (server-status $req 404))))

(defn check-data [$data]
  (if (array? $data)
    (let [[len (json-parse (str "[1,2,3]"))]]
      (> (length len) 0))
    false))

(defn test-map []
  (map [1 2 3 4 5] (fn [$x] (* $x 2))))

(defn test-filter []
  (filter [1 2 10 3 20] (fn [$x] (> $x 5))))
