;; 실제 라우트처럼 구성된 HTML 생성 테스트
(let [id "p_123"
      proj {"id" id "name" "Phase 2" "status" "active" "owner_user" "kim" "blog_url" "https://ex.com"}
      stats {:total 10 :done 3}
      tasks [{"id" "t_1" "title" "Task 1" "status" "done"} {"id" "t_2" "title" "Task 2" "status" "todo"}]
      total (get stats :total)
      done (get stats :done)
      pct (if (= 0 total) 0 (int (/ (* done 100) total)))]
  (let [html-body
        (str "<!DOCTYPE html><html><head><meta charset='utf-8'><title>" (h (get proj "name")) "</title>"
             "<style>.detail{max-width:900px;margin:20px auto}</style>"
             "</head><body>"
             "<h1>" (h (get proj "name")) "</h1>"
             "<p>" done "/" total " (" pct "%)</p>"
             (str-join
               (map (fn [t] (str "<div>" (h (get t "title")) " (" (get t "status") ")</div>")) tasks)
               "")
             "</body></html>")]
    (do
      (println (str "✓ HTML 생성: " (count html-body) " chars"))
      (println (str "✓ 괄호 체크: 정상"))
      (println "✓ 라우트 구조 유효!"))))
