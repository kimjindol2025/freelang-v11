(if (= (html-escape "<script>\"'&") "&lt;script&gt;&quot;&#x27;&amp;") (println "PASS html-escape") (throw "FAIL html-escape"))
(println (html-escape "<script>\"'&"))
(if (= (str-pad-left "a" 4 "* ") "* *a") (println "PASS str-pad-left") (throw "FAIL str-pad-left"))
(if (= (str-pad-right "a" 4 "* ") "a* *") (println "PASS str-pad-right") (throw "FAIL str-pad-right"))
(if (= (str-repeat "ab" 3) "ababab") (println "PASS str-repeat") (throw "FAIL str-repeat"))
(if (not-empty? [1]) (println "PASS not-empty?") (throw "FAIL not-empty?"))
(if (and (nil-or-empty? nil) (nil-or-empty? [])) (println "PASS nil-or-empty?") (throw "FAIL nil-or-empty?"))
(if (= (distinct [2 1 2 3 1]) [2 1 3]) (println "PASS distinct") (throw "FAIL distinct"))
(if (= (flatten [1 [2 [3]]]) [1 2 3]) (println "PASS flatten") (throw "FAIL flatten"))
(if (= (flatten-1 [1 [2 [3]]]) [1 2 [3]]) (println "PASS flatten-1") (throw "FAIL flatten-1"))
(if (= (zip [1 2] ["a" "b" "c"]) [[1 "a"] [2 "b"]]) (println "PASS zip") (throw "FAIL zip"))
(if (= (repeat 3 "x") ["x" "x" "x"]) (println "PASS repeat") (throw "FAIL repeat"))
(if (nil? (sleep 1)) (println "PASS sleep") (throw "FAIL sleep"))
(if (= (html-escape "") "") (println "PASS edge-html-empty") (throw "FAIL edge-html-empty"))
(if (and (= (length (repeat 0 "x")) 0) (= (flatten []) [])) (println "PASS edge-empty-collections") (throw "FAIL edge-empty-collections"))
