(defn check [condition name]
  (if condition (println (str "PASS " name)) (throw (str "FAIL " name))))

(let [[password "test-only-9-27"]
      [encoded (auth-hash-password password)]
      [again (auth-hash-password password)]
      [parts (str-split encoded "$")]
      [digest (get parts 3)]
      [long-password (str-repeat "x" 1000)]
      [empty-hash (auth-hash-password "")]
      [korean-hash (auth-hash-password "시험전용-비밀번호")]
      [long-hash (auth-hash-password long-password)]]
  (do
    (check (auth-verify-password password encoded) "correct password")
    (check (not (auth-verify-password "wrong-test-only" encoded)) "wrong password")
    (check (not (= encoded again)) "random salts differ")
    (check (auth-verify-password "" empty-hash) "empty password")
    (check (auth-verify-password "시험전용-비밀번호" korean-hash) "Korean password")
    (check (auth-verify-password long-password long-hash) "1000-character password")
    (check (not (auth-verify-password password "not-a-pbkdf2-hash")) "malformed format")
    (check (not (auth-verify-password password (str "pbkdf2-sha256$1000$" (get parts 2) "$" digest))) "iterations below 10000")
    (check (and (= (get parts 0) "pbkdf2-sha256") (= (get parts 1) "100000")
                (= (length (get parts 2)) 32) (= (length digest) 64)) "encoded format and lengths")
    (check (auth-verify-password password (str "pbkdf2-sha256$100000$" (get parts 2) "$" digest)) "stored legacy fields verify")
    (println (str "PW_FORMAT_EXAMPLE=pbkdf2-sha256$100000$<가림>$" (substring digest 0 12)))
    (println "PW_SUMMARY=10/10")))
