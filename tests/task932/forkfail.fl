(define jobs [(fn [] 1) (fn [] 2) (fn [] 3) (fn [] 4) (fn [] 5)
              (fn [] 6) (fn [] 7) (fn [] 8) (fn [] 9) (fn [] 10)
              (fn [] 11) (fn [] 12) (fn [] 13) (fn [] 14) (fn [] 15)
              (fn [] 16) (fn [] 17) (fn [] 18) (fn [] 19) (fn [] 20)])
(define results (run-parallel jobs 8))
(println (str "RESULT_COUNT=" (length results)))
(println (str "SLOT0=" (json-stringify (get results 0))))
(println (str "SLOT1=" (json-stringify (get results 1))))
(println (str "SLOT2=" (json-stringify (get results 2))))
(println (str "SLOT3=" (json-stringify (get results 3))))
(println (str "SLOT4=" (json-stringify (get results 4))))
(println (str "SLOT5=" (json-stringify (get results 5))))
(println (str "SLOT6=" (json-stringify (get results 6))))
(println (str "SLOT7=" (json-stringify (get results 7))))
(println (str "SLOT8=" (json-stringify (get results 8))))
(println (str "SLOT9=" (json-stringify (get results 9))))
(println (str "SLOT10=" (json-stringify (get results 10))))
(println (str "SLOT11=" (json-stringify (get results 11))))
(println (str "SLOT12=" (json-stringify (get results 12))))
(println (str "SLOT13=" (json-stringify (get results 13))))
(println (str "SLOT14=" (json-stringify (get results 14))))
(println (str "SLOT15=" (json-stringify (get results 15))))
(println (str "SLOT16=" (json-stringify (get results 16))))
(println (str "SLOT17=" (json-stringify (get results 17))))
(println (str "SLOT18=" (json-stringify (get results 18))))
(println (str "SLOT19=" (json-stringify (get results 19))))
(println "PARALLEL_DONE")
