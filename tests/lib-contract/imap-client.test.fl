(load "../../lib/mail/imap.fl")
(define args (cli-args))
(define mode (get args 0))
(define expected (get args 2))
(define result (imap-read-inbox "localhost" (str-to-num (get args 1))
  {"username" "fixture" "password" (_fl_env_get "IMAP_TEST_PASSWORD")
   "timeout-ms" (if (= mode "silent") 200 3000) "max-response-bytes" 4096}))
(define actual (if (get result "ok") "OK" (get (get result "error") "code")))
(if (get result "transcript") (print (get result "transcript")) nil)
(define messages (get result "messages"))
(define passed (and (= actual expected)
  (if (= mode "normal")
    (= messages [{"sequence" 3 "subject" "Third folded" "from" "three@example.invalid"}
                 {"sequence" 4 "subject" "넷째 메일" "from" "four@example.invalid"}
                 {"sequence" 5 "subject" "Fifth" "from" "five@example.invalid"}])
    (if (= mode "silent") (= (get (get result "error") "message") "read deadline exceeded")
      (if (= mode "large") (= (get (get result "error") "message") "literal exceeds response bound") true)))))
(if (= mode "normal")
  (doseq [message messages] (println (str "READ sequence=" (get message "sequence")
    " subject=" (get message "subject") " from=" (get message "from")))) nil)
(println (str (if passed "PASS " "FAIL ") "IMAP " mode " expected=" expected " actual=" actual))
(if passed (_fl_exit 0) (_fl_exit 1))
