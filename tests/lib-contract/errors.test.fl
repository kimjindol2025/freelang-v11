(load "../../self/stdlib/error.fl")
(defn check [actual expected name]
  (if (= actual expected) (println (str "PASS " name)) (throw (str "FAIL " name))))
(let [[err {:message "bad input" :type "InputError" :stack "trace" :cause "source"}]]
  (check (error-message "plain") "plain" "string message")
  (check (error-message nil) "null" "nil message")
  (check (error-message err) "bad input" "map message")
  (check (error-message {}) "unknown error" "missing message")
  (check (error-type nil) "null" "nil type")
  (check (error-type "x") "string" "string type")
  (check (error-type err) "InputError" "map type")
  (check (error-type {}) "Error" "default type")
  (check (is-error? err) true "error predicate true")
  (check (is-error? "bad") false "error predicate string false")
  (check (is-error? nil) false "error predicate nil false")
  (check (error-stack err) "trace" "stack value")
  (check (error-stack {}) "" "missing stack")
  (check (error-cause err) "source" "cause value")
  (check (error-cause {}) nil "missing cause"))
(println "ERRORS_SUMMARY=15/15")
