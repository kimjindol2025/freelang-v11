(load "../../lib/fs/fs.fl")
(define args (cli-args))
(define lock (file-lock-acquire (get args 0) 5000))
(if (not (get lock "ok")) (_fl_exit 2) nil)
(define current (file-read (get args 1)))
(if (not (get current "ok")) (do (file-lock-release (get lock "value")) (_fl_exit 3)) nil)
(define next (+ (str-to-num (get current "value")) 1))
(sleep 20)
(define saved (file-write-atomic (get args 1) (str next)))
(define released (file-lock-release (get lock "value")))
(if (and (get saved "ok") (get released "ok")) (_fl_exit 0) (_fl_exit 4))
