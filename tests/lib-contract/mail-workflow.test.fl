(load "../../lib/mail/workflow.fl")
(define failures (atom 0))
(defn check [name result expected]
  (let [[passed (= result expected)]]
    (println (str (if passed "PASS " "FAIL ") "MAIL_WORKFLOW " name))
    (if passed nil (reset! failures (+ @failures 1)))))
(define source {"sequence" "42" "from" "sender@example.invalid"
  "subject" "Question" "body" "untrusted request"})
(define safe {"요약" "question" "분류" "업무" "할 일 목록" []
  "답장 초안" "Thanks, I will review it." "위험 표시" false})
(define risky (assoc safe "위험 표시" true))
(define draft (mail-workflow-draft source safe {"from" "agent@example.invalid"}))
(define triage-record {"status" "초안 저장" "result" safe})
(check "safe-draft-created" (get draft "status") "pending-human-approval")
(check "reply-address-bound" (get (get (get draft "draft") "mail") "to") "sender@example.invalid")
(check "subject-bound" (get (get (get draft "draft") "mail") "subject") "Re: Question")
(check "risk-held" (get (mail-workflow-draft source risky {"from" "agent@example.invalid"}) "status") "human-review-required")
(check "saved-triage-record-integrates" (get (mail-workflow-from-records source triage-record
  {"from" "agent@example.invalid"}) "status") "pending-human-approval")
(check "saved-risk-record-held" (get (mail-workflow-from-records source
  {"status" "사장님 확인 필요"} {"from" "agent@example.invalid"}) "status") "human-review-required")
(check "newline-header-rejected" (get (get (mail-workflow-draft
  (assoc source "subject" "bad\r\nBcc: x") safe {"from" "agent@example.invalid"}) "error") "code")
  "UNSAFE_HEADER_OR_ADDRESS")
(check "display-name-address-rejected" (get (get (mail-workflow-draft
  (assoc source "from" "Name <sender@example.invalid>") safe {"from" "agent@example.invalid"}) "error") "code")
  "UNSAFE_HEADER_OR_ADDRESS")
(define args (cli-args))
(define state-root (get args 0))
(define send-source (assoc source "from" "receiver@example.invalid"))
(define send-draft (mail-workflow-draft send-source safe {"from" "agent@example.invalid"}))
(define save-result (mail-workflow-save-draft (str state-root "/draft.json") send-draft))
(define send-result (mail-workflow-send-approved "localhost" 1 (str state-root "/draft.json")
  {"approval-file" (str state-root "/approval.json") "audit-file" (str state-root "/audit.jsonl")
   "rate-file" (str state-root "/rate.txt") "lock-file" (str state-root "/guard.lock")
   "stop-file" (str state-root "/STOP") "hash-temp" (str state-root "/hash.tmp")}
  {"username" "fixture" "password" "unused" "timeout-ms" 100 "max-message-bytes" 4096}))
(check "draft-saved" (get save-result "ok") true)
(check "missing-approval-blocks-send" (get send-result "status") "approval-missing-stale-or-used")
(println (str "MAIL_WORKFLOW_SUMMARY=" (- 10 @failures) "/10"))
(_fl_exit (if (= @failures 0) 0 1))
