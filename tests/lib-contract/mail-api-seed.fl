(load "../../lib/mail/auth.fl")
(load "../../lib/mail/store.fl")
(define args (cli-args))
(define database (db-open (get args 0)))
(mail-auth-init database)
(mail-store-init database)
(define admin (mail-auth-bootstrap-admin database "admin@example.invalid" "local-Admin-Password-42"))
(define agent (mail-auth-user-create database (get admin "user_id") "default"
  "agent@example.invalid" "local-Agent-Password-42" "agent"))
(define reviewer (mail-auth-user-create database (get admin "user_id") "default"
  "reviewer@example.invalid" "local-Reviewer-Password-42" "reviewer"))
(define box-admin (mail-store-mailbox-create database "box-1" (get admin "user_id") "admin@example.invalid"))
(define box-agent (mail-store-mailbox-create database "agent-box" (get agent "user_id") "agent@example.invalid"))
(define message (mail-store-ingest database {"message_id" "msg-1" "mailbox_id" "box-1"
  "remote_uid" "uid-1" "from" "receiver@example.invalid" "to" "admin@example.invalid"
  "subject" "Local test" "body" "Please reply" "received_at" 1793836800}))
(if (and (get admin "ok") (get agent "ok") (get reviewer "ok") (get box-admin "ok")
    (get box-agent "ok") (= (get message "inserted") 1))
  (do (println "MAIL_API_SEED=OK") (db-close database) (_fl_exit 0))
  (do (println "MAIL_API_SEED=FAIL") (db-close database) (_fl_exit 1)))
