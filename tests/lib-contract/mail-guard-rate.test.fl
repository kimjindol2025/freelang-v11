(load "../../lib/mail/guard.fl")
(define base (get (cli-args) 0))
(define now (now-s))
(defn rate-check [name result expected-ok expected-count]
  (let [[ok (= (get result "ok") expected-ok)]
        [count-ok (if expected-ok (= (get result "value") expected-count) true)]]
    (if (and ok count-ok)
      (println (str "PASS RATE " name))
      (do (println (str "FAIL RATE " name " ok=" (get result "ok") " count=" (get result "value")))
          (_fl_exit 1)))))
(define empty-path (str base "/empty.txt"))
(file-write empty-path "")
(rate-check "empty" (mail-guard-read-count empty-path now) true 0)
(define one-path (str base "/one.txt"))
(file-write one-path (str now "\n"))
(rate-check "one-line" (mail-guard-read-count one-path now) true 1)
(define many-path (str base "/many.txt"))
(file-write many-path (str (- now 10) "\n" (- now 20) "\n" (- now 4000) "\n"))
(rate-check "multiple-lines" (mail-guard-read-count many-path now) true 2)
(define missing-path (str base "/missing.txt"))
(rate-check "missing-file" (mail-guard-read-count missing-path now) false nil)
(define bad-path (str base "/bad.txt"))
(file-write bad-path "not-a-timestamp\n")
(rate-check "corrupt-content" (mail-guard-read-count bad-path now) false nil)
(define directory-path (str base "/read-error"))
(dir-make directory-path)
(rate-check "read-error" (mail-guard-read-count directory-path now) false nil)
(_fl_file_delete empty-path)
(_fl_file_delete one-path)
(_fl_file_delete many-path)
(_fl_file_delete bad-path)
(dir-remove directory-path)
(println "RATE_COUNT_SUMMARY=5/5 READ_ERROR=PASS")
