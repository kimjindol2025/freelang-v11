(load "../../lib/http/http.fl")
(defn check [actual expected name]
  (if (= actual expected) (println (str "PASS " name)) (throw (str "FAIL " name))))
(defn tcp-test-code [value] (get (get value "error") "code"))
(check (tcp-test-code (tcp-bind "0.0.0.0" 0)) "ADDRESS" "wildcard rejected")
(check (tcp-test-code (tcp-listen "192.0.2.1" 0)) "ADDRESS" "external rejected")
(check (tcp-test-code (tcp-bind "localhost" 0)) "ADDRESS" "literal loopback only")
(check (tcp-test-code (tcp-bind "127.0.0.1" -1)) "INVALID_ARGUMENT" "negative port")
(check (tcp-test-code (tcp-listen "127.0.0.1" 65536)) "INVALID_ARGUMENT" "large port")
(check (tcp-test-code (tcp-bind "127.0.0.1" "0")) "INVALID_ARGUMENT" "typed port")
(define guard (tcp-bind "127.0.0.1" 0))
(check (number? guard) true "bind socket")
(define port (tcp-local-port guard))
(check (> port 0) true "ephemeral positive")
(check (<= port 65535) true "ephemeral bounded")
(check (tcp-test-code (tcp-listen "127.0.0.1" port)) "BIND" "occupied port")
(check (tcp-test-code (tcp-accept guard 0)) "INVALID_SOCKET" "bind is not listen")
(check (tcp-test-code (http-get (str "http://127.0.0.1:" port "/"))) "CONNECT" "bind-only refuses connection")
(check (tcp-close guard) true "close bind")
(check (tcp-test-code (tcp-close guard)) "INVALID_SOCKET" "double close")
(check (tcp-test-code (tcp-local-port guard)) "INVALID_SOCKET" "closed socket")
(define listener (tcp-listen "127.0.0.1" 0))
(check (number? listener) true "listen socket")
(check (> (tcp-local-port listener) 0) true "listen port")
(check (tcp-test-code (tcp-accept listener 0)) "TIMEOUT" "zero timeout")
(check (tcp-test-code (tcp-accept listener 15)) "TIMEOUT" "bounded timeout")
(check (tcp-test-code (tcp-accept listener -1)) "INVALID_ARGUMENT" "negative timeout")
(check (tcp-test-code (tcp-accept listener "1")) "INVALID_ARGUMENT" "typed timeout")
(check (tcp-close listener) true "close listen")
(check (tcp-test-code (tcp-accept listener 0)) "INVALID_SOCKET" "accept closed")
(check (tcp-test-code (tcp-close 1)) "INVALID_SOCKET" "never close stdout")
(println "TCP_SUMMARY=24/24")
