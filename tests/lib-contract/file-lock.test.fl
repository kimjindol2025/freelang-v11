(load "../../lib/fs/fs.fl")
(defn check [condition name]
  (println (str (if condition "PASS LOCK " "FAIL LOCK ") name))
  (if condition true (_fl_exit 1)))
(define args (cli-args))
(define path (get args 0))
(define invalid (file-lock-acquire "" 50))
(check (= (get (get invalid "error") "code") "INVALID_ARGUMENT") "invalid-path")
(define fractional-timeout (file-lock-acquire path 1.5))
(check (= (get (get fractional-timeout "error") "code") "INVALID_ARGUMENT") "integer-timeout")
(define large-timeout (file-lock-acquire path 60001))
(check (= (get (get large-timeout "error") "code") "INVALID_ARGUMENT") "timeout-bound")
(define first (file-lock-acquire path 1000))
(check (get first "ok") "acquire")
(define blocked (file-lock-acquire path 30))
(check (= (get (get blocked "error") "code") "LOCK_UNAVAILABLE") "bounded-contention")
(check (get (file-lock-release (get first "value")) "ok") "release")
(check (not (get (file-lock-release (get first "value")) "ok")) "double-release")
(define again (file-lock-acquire path 1000))
(check (get again "ok") "reacquire")
(check (get (file-lock-release (get again "value")) "ok") "release-again")
(println "FILE_LOCK_SUMMARY=9/9")
