(load "../../self/stdlib/encoding.fl")
(load "../../self/stdlib/error.fl")
(load "../../self/stdlib/time.fl")
(defn check [actual expected name]
  (if (= actual expected) (println (str "PASS " name)) (throw (str "FAIL " name))))
(check (get (utf8-encode 65) "value") "A" "loaded encoding export")
(check (get (utf8-decode "가") "value") [44032] "loaded UTF-8 decoder")
(check (get (char-count "가😀") "value") 2 "loaded character counter")
(check (error-message "module") "module" "loaded error utility")
(check (error-type nil) "null" "loaded error type")
(check (s-to-ts 3) 3000 "loaded time utility")
(check (ts-to-s 3000) 3 "loaded time conversion")
(check (get (utf8-encode 44032) "ok") true "loaded unicode export")
(check (number? (now-s)) true "loaded clock utility")
(check (get (utf8-encode 0) "ok") false "loaded encoding error")
(println "MODULES_SUMMARY=10/10")
