(load "../../lib/http/http.fl")
(defn check [actual expected name]
  (if (= actual expected) (println (str "PASS " name)) (throw (str "FAIL " name))))
(define base (get (cli-args) 0))
(define refused (get (cli-args) 1))
(let [[r (http-get (str base "/hello"))]]
  (check (get r "ok") true "GET ok")
  (check (get r "status") 200 "GET status")
  (check (get r "body") "hello" "GET body")
  (check (get (get r "headers") "content-type") "text/html; charset=utf-8" "response headers"))
(check (get (http-post (str base "/echo") "hello") "body") "hello" "POST body")
(check (get (http-post (str base "/echo") "한글 본문") "body") "한글 본문" "Korean body")
(check (get (http-request "PUT" (str base "/put") {"x-test" "value"} "" {}) "body") "value" "method and header")
(check (get (http-request "HEAD" (str base "/hello") {} "" {}) "body") "" "HEAD empty")
(let [[r (http-json "POST" (str base "/echo") {"text" "한글"} {})]]
  (check (get r "ok") true "JSON ok")
  (check (get (get r "body") "text") "한글" "JSON round trip"))
(check (get (http-get (str base "/missing")) "status") 404 "404 status")
(check (get (http-get (str base "/fail")) "status") 500 "500 status")
(check (get (http-get (str base "/fail")) "ok") false "500 not ok")
(check (get (http-get (str base "/missing")) "ok") false "404 not ok")
(check (get (get (http-get "https://127.0.0.1/") "error") "code") "HTTPS_UNSUPPORTED" "HTTPS rejected")
(check (get (get (http-get "bad-url") "error") "code") "INVALID_URL" "invalid URL")
(check (get (get (http-get "http://127.0.0.1:bad/") "error") "code") "INVALID_URL" "invalid port")
(check (get (get (http-get refused) "error") "code") "CONNECT" "connection refused")
(check (get (get (http-request "GET" (str base "/slow") {} "" {"timeout-ms" 30}) "error") "code") "TIMEOUT" "timeout")
(check (get (get (http-request "GET" (str base "/large") {} "" {"max-response-bytes" 256}) "error") "code") "RESPONSE_TOO_LARGE" "response bound")
(check (get (get (http-request "POST" (str base "/echo") {} "large" {"max-request-bytes" 4}) "error") "code") "REQUEST_TOO_LARGE" "request bound")
(check (get (get (http-request "GET\r\nX" base {} "" {}) "error") "code") "INVALID_REQUEST" "method injection")
(check (get (get (http-request "GET" base {"x" "bad\r\nvalue"} "" {}) "error") "code") "INVALID_REQUEST" "header injection")
(check (get (get (http-request "GET" base {} "" {"timeout-ms" 0}) "error") "code") "INVALID_OPTIONS" "invalid timeout")
;; json-parse's existing contract assigns JSON_VALUE to the token `hello`.
(check (get (get (http-json "GET" (str base "/hello") nil {}) "error") "code") "JSON_VALUE" "invalid JSON response")
(check (get (http-get (str base "/hello")) "body") "hello" "recovery after errors")
(println "HTTP_SUMMARY=26/26")
