(defn check [condition name]
  (println (str (if condition "PASS " "FAIL ") "API " name))
  (if condition true (_fl_exit 1)))
(define args (cli-args))
(define socket (_fl_connection_open "localhost" (str-to-num (get args 0)) 3000))
(check (number? socket) "open normal")
(check (= (get (get (_fl_connection_open "localhost" 0 3000) "error") "code") "INVALID_ARGUMENT") "open failure")
(check (= (get (_fl_connection_read socket 0 3000 64) "value") "hello\r\n") "read normal")
(check (= (get (get (_fl_connection_read socket 65 3000 64) "error") "code") "INVALID_ARGUMENT") "read failure")
(check (= (get (_fl_connection_write socket "PING\r\n" 3000) "value") 6) "write normal")
(check (= (get (get (_fl_connection_write -1 "PING" 3000) "error") "code") "INVALID_SOCKET") "write failure")
(check (get (_fl_connection_close socket) "ok") "close normal")
(check (= (get (get (_fl_connection_close socket) "error") "code") "INVALID_SOCKET") "close failure")
(define good (_fl_connection_open "localhost" (str-to-num (get args 1)) 3000))
(check (get (_fl_connection_starttls good 3000) "ok") "starttls normal")
(_fl_connection_close good)
(define bad (_fl_connection_open "127.0.0.1" (str-to-num (get args 2)) 3000))
(check (= (get (get (_fl_connection_starttls bad 3000) "error") "code") "TLS") "starttls failure")
;; A failed transition already released its connection.
(check (= (get (get (_fl_connection_close bad) "error") "code") "INVALID_SOCKET") "failed transition cleanup")
(println "API_SUMMARY=10/10")
