(load "../../lib/fs/fs.fl")
(define count (atom 0))
(defn check [actual expected name]
  (if (= actual expected)
    (do (swap! count + 1) (println (str "PASS " name)))
    (throw (str "FAIL " name " actual=" actual " expected=" expected))))
(defn val [r] (get r "value"))
(defn fs-test-code [r] (get (get r "error") "code"))
(define root (get (cli-args) 0))
(define p (str root "/한글.txt"))
(check (val (path-normalize "a//b/./../c/")) "a/c" "normalize")
(check (val (path-normalize "/a/../")) "/" "absolute normalize")
(check (val (path-normalize "a/..")) "." "relative empty")
(check (fs-test-code (path-normalize "../escape")) "PATH_ESCAPE" "relative escape")
(check (fs-test-code (path-normalize "/../../escape")) "PATH_ESCAPE" "absolute escape")
(check (val (path-join "a" "b/../c")) "a/c" "join")
(check (fs-test-code (path-join "a" "/b")) "INVALID_PATH" "join absolute child")
(check (val (path-base "/a/b.txt")) "b.txt" "base")
(check (val (path-dir "/a/b.txt")) "/a" "dirname")
(check (val (path-dir "a")) "." "relative dirname")
(check (val (path-ext "/a/b.tar.gz")) ".gz" "extension")
(check (val (path-ext ".profile")) "" "dotfile extension")
(check (val (path-ext "a.")) "." "trailing extension")
(check (fs-test-code (path-normalize nil)) "INVALID_PATH" "invalid path type")
(check (get (dir-make (str root "/a/b")) "ok") true "recursive mkdir")
(check (get (dir-make (str root "/a/b")) "ok") true "mkdir idempotent")
(check (get (file-write p "첫째\n둘째\n") "ok") true "Korean write")
(check (val (file-read p)) "첫째\n둘째\n" "Korean read")
(check (val (file-read-lines p)) ["첫째" "둘째"] "read lines")
(check (get (file-append p "end") "ok") true "append")
(check (val (file-read-lines p)) ["첫째" "둘째" "end"] "append lines")
(check (val (file-exists? p)) true "exists")
(check (val (file-exists? (str root "/absent"))) false "absent exists")
(check (val (file-size p)) 17 "UTF8 byte size")
(check (> (val (file-mtime p)) 0) true "mtime milliseconds")
(check (get (file-write (str root "/empty") "") "ok") true "empty write")
(check (val (file-read-lines (str root "/empty"))) [] "empty lines")
(check (val (file-read (str root "/empty"))) "" "empty read")
(check (val (file-size (str root "/large"))) 1048577 "large size")
(check (length (val (file-read (str root "/large")))) 1048577 "large read")
(check (get (file-write (str root "/large-copy") (val (file-read (str root "/large")))) "ok") true "large write")
(check (= (val (file-read (str root "/large-copy"))) (val (file-read (str root "/large")))) true "large round trip")
(check (get (file-write-atomic p "replacement") "ok") true "atomic replace")
(check (val (file-read p)) "replacement" "atomic visible")
(check (fs-test-code (file-write-atomic (str root "/a") "fail")) "IS_DIRECTORY" "atomic rename failure")
(check (get (dir-list (str root "/a")) "ok") true "atomic failure preserves directory")
(check (fs-test-code (file-read (str root "/absent"))) "NOT_FOUND" "missing error")
(check (get (get (file-read (str root "/absent")) "error") "path") (str root "/absent") "error path")
(check (string? (get (get (file-read (str root "/absent")) "error") "message")) true "error message")
(check (fs-test-code (file-read (str root "/denied"))) "PERMISSION" "denied read")
(check (fs-test-code (file-write (str root "/denied") "x")) "PERMISSION" "denied write")
(check (fs-test-code (file-write-atomic (str root "/locked/target") "new")) "PERMISSION" "atomic temp failure")
(check (val (file-read (str root "/locked/target"))) "old" "atomic failure preserves original")
(check (fs-test-code (file-write p nil)) "INVALID_CONTENT" "invalid content")
(check (fs-test-code (file-read root)) "IS_DIRECTORY" "directory read rejected")
(check (fs-test-code (dir-list p)) "NOT_DIRECTORY" "list file rejected")
(check (fs-test-code (dir-list (str root "/absent"))) "NOT_FOUND" "missing list")
(check (fs-test-code (dir-remove (str root "/a"))) "NOT_EMPTY" "nonempty remove rejected")
(check (get (dir-remove (str root "/a/b")) "ok") true "empty remove")
(check (get (file-write-json (str root "/a/data.json") {"한글" [1 true nil]}) "ok") true "JSON write")
(check (get (val (file-read-json (str root "/a/data.json"))) "한글") [1 true nil] "JSON read")
(check (get (file-read-json p) "ok") false "invalid JSON error")
(check (get (get (file-read-json p) "error") "path") p "JSON error path")
(check (get (file-read-json (str root "/absent")) "ok") false "JSON missing error")
(check (get (file-append p "!") "ok") true "recovery after failures")
(check (val (file-read p)) "replacement!" "recovery content")
(check (get (dir-walk root) "ok") true "recursive walk with symlink loop")
(check (includes-item (val (dir-walk root)) (str root "/a/data.json")) true "walk nested file")
(check (includes-item (val (dir-list root)) "한글.txt") true "list names")
(check (fs-test-code (dir-walk (str root "/absent"))) "NOT_FOUND" "walk failure")
(check (fs-test-code (dir-make (str p "/child"))) "NOT_DIRECTORY" "mkdir through file")
(check (fs-test-code (file-write-atomic (str root "/absent/target") "x")) "NOT_FOUND" "atomic missing parent")
(check (fs-test-code (file-append (str root "/denied") "x")) "PERMISSION" "append denied")
(check (fs-test-code (file-size (str root "/absent"))) "NOT_FOUND" "size missing")
(check (fs-test-code (file-mtime (str root "/absent"))) "NOT_FOUND" "mtime missing")
(println (str "FS_SUMMARY=" @count "/" @count))
