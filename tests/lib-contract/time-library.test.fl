(load "../../lib/time/time.fl")
(define checks (atom 0))
(defn check [a b name]
  (if (= a b) (do (swap! checks + 1) (println (str "PASS " name)))
    (throw (str "FAIL " name " actual=" a " expected=" b))))
(defn val [r] (if (get r "ok") (get r "value") (throw (str r))))
(defn parse [s] (val (time-parse s)))
(check (parse "1970-01-01") 0 "epoch")
(check (parse "1969-12-31T23:59:59.999Z") -1 "before epoch")
(check (parse "2040-01-01Z") 2208988800000 "after 2038")
(check (parse "2026-10-20T09:00:00+09:00") (parse "2026-10-20T00:00:00Z") "positive offset")
(check (parse "2026-10-19T19:00:00-05:00") (parse "2026-10-20") "negative offset")
(check (parse "2000-02-29T00:00:00") 951782400000 "leap date")
(check (val (leap-year? 2000)) true "400 leap")
(check (val (leap-year? 1900)) false "100 nonleap")
(check (val (leap-year? 2024)) true "4 leap")
(check (val (days-in-month 2024 2)) 29 "February leap")
(check (val (days-in-month 2025 2)) 28 "February common")
(check (val (days-in-month 2025 4)) 30 "April")
(check (val (weekday 0)) 4 "Thursday epoch")
(check (val (weekday -86400000)) 3 "Wednesday before epoch")
(check (val (time-diff 10 25)) -15 "diff direction")
(check (val (time-add 0 1 "s")) 1000 "add seconds")
(check (val (time-add 0 1 "m")) 60000 "add minutes")
(check (val (time-add 0 1 "h")) 3600000 "add hours")
(check (val (time-add (parse "2024-01-31") 1 "month")) (parse "2024-02-29") "leap month clamp")
(check (val (time-add (parse "2025-01-31") 1 "month")) (parse "2025-02-28") "common month clamp")
(check (val (time-add (parse "2024-02-29") 1 "year")) (parse "2025-02-28") "year clamp")
(check (val (time-add (parse "2025-03-31") -1 "month")) (parse "2025-02-28") "negative month")
(check (val (time-add (parse "2025-12-31") 1 "d")) (parse "2026-01-01") "day year rollover")
(check (val (time-add (parse "2024-02-29") 1 "d")) (parse "2024-03-01") "day month rollover")
(check (val (time-format 0 "YYYY-MM-DDTHH:mm:ss.SSSZ" 0)) "1970-01-01T00:00:00.000+00:00" "format UTC")
(check (val (time-format 0 "YYYY-MM-DD HH:mm:ss Z" 540)) "1970-01-01 09:00:00 +09:00" "format offset")
(check (val (time-format -1 "YYYY-MM-DDTHH:mm:ss.SSS" 0)) "1969-12-31T23:59:59.999" "format negative")
(check (val (duration-format 3723000 "ko")) "1시간 2분 3초" "duration Korean")
(check (val (duration-format 3723000 "short")) "1h2m3s" "duration short")
(check (val (duration-format 3600000 "short")) "1h" "omit zero units")
(check (val (duration-format 0 "short")) "0s" "zero duration")
(check (get (time-parse "garbage") "ok") false "broken")
(check (get (time-parse "2024-13-01") "ok") false "month range")
(check (get (time-parse "2024-01-01T25:00:00Z") "ok") false "hour range")
(check (get (time-parse "2024-02-30") "ok") false "day range")
(check (get (time-parse "1900-02-29") "ok") false "invalid leap")
(check (get (time-parse "2024-01-01T00:00:00+24:00") "ok") false "offset range")
(check (get (time-parse "2024-01-01junk") "ok") false "trailing garbage")
(check (get (time-parse 42) "ok") false "parse type")
(check (get (time-add 0 1 "bad") "ok") false "bad unit")
(check (get (days-in-month 2024 0) "ok") false "bad month")
(check (get (time-diff "bad" 0) "ok") false "diff type")
(check (get (time-format 0 "YYYY" 1440) "ok") false "format offset range")
(check (get (duration-format -1 "short") "ok") false "negative duration")
(check (get (duration-format 1 "bad") "ok") false "duration style")
(check (get (get (time-parse "bad") "error") "position") 0 "error location")
(check (parse "1970-01-01") 0 "recovery after failure")
(let [[before (now-ms)] [middle (now-ms)] [after (now-ms)]]
  (check (and (>= middle before) (<= middle after)) true "now bounded"))
(let [[before (floor (/ (now-ms) 1000))] [middle (now-s)] [after (floor (/ (now-ms) 1000))]]
  (check (and (>= middle before) (<= middle after)) true "now seconds bounded"))
(let [[before (now-ms)] [middle (parse (now-iso))] [after (now-ms)]]
  (check (and (>= middle before) (<= middle after)) true "ISO now bounded"))
(let [[start (stopwatch-start)]]
  (check (>= (val (stopwatch-elapsed start)) 0) true "elapsed milliseconds"))
(check (parse "1970-01-01T00:00:00.1Z") 100 "one fractional digit")
(check (parse "1970-01-01T00:00:00.12Z") 120 "two fractional digits")
(check (get (time-parse "1970-01-01T00:00:00.Z") "ok") false "empty fraction")
(check (get (time-parse "1970-01-01T00:00:00.1234Z") "ok") false "precision overflow")
(check (get (time-parse "2000-01-01T00:00:60Z") "ok") false "leap second unsupported")
(check (parse "0001-01-01") -62135596800000 "minimum year")
(check (parse "9999-12-31T23:59:59.999Z") 253402300799999 "maximum year")
(check (get (time-add 253402300799999 1 "s") "ok") false "timestamp overflow")
(check (get (time-parse "0000-01-01") "ok") false "year zero unsupported")
(check (val (time-format 0 "한글 YYYY" 0)) "한글 1970" "literal UTF8")
(println (str "TIME_LIBRARY_SUMMARY=" @checks "/61"))
