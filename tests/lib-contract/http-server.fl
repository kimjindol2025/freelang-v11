(defn hello [request] (fl-resp-html "hello"))
(defn echo-body [request] (fl-resp-html (get request "body")))
(defn put-header [request] (fl-resp-html (get (get request "headers") "x-test")))
(defn fail [request] (fl-resp-status 500 "failed"))
(defn slow [request] (do (_fl_process_run_args "/bin/sleep" ["0.15"]) (fl-resp-html "late")))
(defn repeat-double [text count]
  (if (= count 0) text (repeat-double (str text text) (- count 1))))
(defn large [request] (fl-resp-html (repeat-double "x" 12)))
(fl-http-route "GET" "/hello" hello)
(fl-http-route "HEAD" "/hello" hello)
(fl-http-route "POST" "/echo" echo-body)
(fl-http-route "PUT" "/put" put-header)
(fl-http-route "GET" "/fail" fail)
(fl-http-route "GET" "/slow" slow)
(fl-http-route "GET" "/large" large)
(fl-http-start 0)
