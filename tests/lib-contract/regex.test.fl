(load "../../lib/regex/regex.fl")
(define rx-test-count (atom 0))
(defn rx-check [actual expected label]
  (if (= actual expected) (do (swap! rx-test-count + 1) (println (str "PASS " label)))
    (throw (str "FAIL " label " expected=" expected " actual=" actual))))
(defn rv [r] (get r "value"))
(defn re [r] (get (get r "error") "code"))
(rx-check (rv (regex-match? "가😀" "가😀")) true "literal unicode")
(rx-check (rv (regex-match? "^.$" "😀")) true "dot scalar")
(rx-check (rv (regex-match? "^.$" "가나")) false "dot single scalar")
(rx-check (rv (regex-match? "^a*$" "")) true "star empty")
(rx-check (rv (regex-match? "^a+$" "aaa")) true "plus")
(rx-check (rv (regex-match? "^a+$" "")) false "plus requires one")
(rx-check (rv (regex-match? "^ab?c$" "ac")) true "optional")
(rx-check (rv (regex-match? "^(가|나)+$" "가나가")) true "group alternation")
(rx-check (rv (regex-match? "^[a-z]+$" "abc")) true "range")
(rx-check (rv (regex-match? "^[^a-z]+$" "가😀")) true "negated class")
(rx-check (rv (regex-match? "^\\d+$" "123")) true "digits")
(rx-check (rv (regex-match? "^\\w+$" "Ab_9")) true "word ASCII")
(rx-check (rv (regex-match? "^\\s+$" " \t\n")) true "whitespace")
(rx-check (rv (regex-match? "^가{2,3}$" "가가가")) true "bounded repeat")
(rx-check (rv (regex-match? "^가{2,3}$" "가")) false "repeat minimum")
(rx-check (rv (regex-match? "^a{2}$" "aa")) true "exact repeat")
(rx-check (rv (regex-match? "^a{2,}$" "aaaa")) true "open repeat")
(rx-check (rv (regex-match? "^a$" "ba")) false "start anchor")
(rx-check (rv (regex-match? "a$" "ab")) false "end anchor")
(rx-check (rv (regex-match? "" "")) true "empty pattern")
(rx-check (rv (regex-match? "a" "ba")) true "search semantics")
(rx-check (get (rv (regex-find "😀+" "가😀😀나")) "start") 1 "find scalar start")
(rx-check (get (rv (regex-find "😀+" "가😀😀나")) "end") 3 "find scalar end")
(rx-check (get (rv (regex-find "😀+" "가😀😀나")) "text") "😀😀" "greedy find")
(rx-check (rv (regex-find "z" "abc")) nil "find missing")
(rx-check (length (rv (regex-find-all "가" "가나가"))) 2 "find all")
(rx-check (length (rv (regex-find-all "" "가😀"))) 3 "zero width advances")
(rx-check (rv (regex-replace "가+" "가가나가" "😀")) "😀나😀" "replace all")
(rx-check (rv (regex-replace "" "가" "-")) "-가-" "zero width replace")
(rx-check (rv (regex-split "[,;]+" "가,,나;😀")) ["가" "나" "😀"] "split")
(rx-check (rv (regex-split "," ",가,")) ["" "가" ""] "split edges")
(rx-check (rv (regex-match? "^\\.$" ".")) true "escaped literal")
(rx-check (re (regex-match? "(" "")) "INVALID_PATTERN" "unclosed group")
(rx-check (re (regex-match? "[z-a]" "")) "INVALID_PATTERN" "reversed range")
(rx-check (re (regex-match? "[abc" "")) "INVALID_PATTERN" "unclosed class")
(rx-check (re (regex-match? "a{3,2}" "")) "INVALID_PATTERN" "invalid bounds")
(rx-check (re (regex-match? "*a" "")) "INVALID_PATTERN" "orphan quantifier")
(rx-check (re (regex-match? "a**" "")) "INVALID_PATTERN" "double quantifier")
(rx-check (re (regex-match? "(?<=a)b" "ab")) "UNSUPPORTED_SYNTAX" "lookbehind")
(rx-check (re (regex-match? "(a)\\1" "aa")) "UNSUPPORTED_SYNTAX" "backreference")
(rx-check (re (regex-match? "a+?" "aaa")) "UNSUPPORTED_SYNTAX" "lazy quantifier")
(rx-check (re (regex-find-limit "(a|aa)*b" "aaaaaaaaaaaaaaaa" 20)) "STEP_LIMIT" "bounded work")
(rx-check (rv (regex-match? "^가$" "가")) true "recovery after limit")
(rx-check (rv (regex-match? "^(a?)*$" "")) true "nullable loop terminates")
(rx-check (get (rv (regex-find "a|ab" "ab")) "text") "a" "left alternative first")
(rx-check (get (rv (regex-find "a*a" "aaa")) "text") "aaa" "greedy backtrack")
(rx-check (rv (regex-match? "^(a?){3}$" "")) true "nullable minimum")
(rx-check (rv (regex-match? "^[가-힣]+$" "한글")) true "unicode range")
(rx-check (rv (regex-match? "^[\\d]+$" "123")) true "class escape")
(rx-check (rv (regex-match? "^[a-]+$" "a--")) true "class trailing hyphen")
(rx-check (rv (regex-match? "^.$" "\n")) false "dot excludes newline")
(rx-check (rv (regex-match? "^\\s$" "　")) true "unicode whitespace")
(rx-check (rv (regex-match? "^\\w$" "가")) false "word ascii documented")
(rx-check (re (regex-match? "[]" "")) "INVALID_PATTERN" "empty class")
(rx-check (re (regex-match? "\\" "")) "INVALID_PATTERN" "dangling escape")
(rx-check (re (regex-match? "\\p{L}" "가")) "UNSUPPORTED_SYNTAX" "unicode properties unsupported")
(rx-check (re (regex-match? "(?=a)" "a")) "UNSUPPORTED_SYNTAX" "lookahead unsupported")
(rx-check (re (regex-match? "a{1001}" "")) "PATTERN_LIMIT" "bounded repeat cap")
(rx-check (re (regex-match? (get (str-repeat "a" 257) "value") "")) "PATTERN_LIMIT" "pattern cap")
(rx-check (re (regex-find-limit "a" "a" 0)) "INVALID_ARGUMENT" "invalid budget")
(rx-check (re (regex-match? "(a|aa)*b" "aaaaaaaaaaaaaaaaaaaaaaaa")) "STEP_LIMIT" "default budget exhausted")
(rx-check (rv (regex-match? "b" "b")) true "default budget recovery")
(rx-check (re (regex-match? "." (get (char-from-byte 128) "value"))) "INVALID_UTF8" "invalid utf8 text")
(rx-check (length (rv (regex-find-all "a*" "b"))) 2 "empty repeat progress")
(rx-check (re (regex-match? "^*" "")) "INVALID_PATTERN" "start anchor not repeatable")
(rx-check (re (regex-match? "$?" "")) "INVALID_PATTERN" "end anchor not repeatable")
(rx-check (re (regex-match? "a{,2}" "")) "INVALID_PATTERN" "missing repeat minimum")
(println (str "REGEX_SUMMARY=" @rx-test-count "/67"))
