(load "../../lib/str/str.fl")
(define str-test-count (atom 0))
(defn str-check [actual expected label]
  (if (= actual expected) (do (swap! str-test-count + 1) (println (str "PASS " label)))
    (throw (str "FAIL " label " expected=" expected " actual=" actual))))
(defn sv [r] (get r "value"))
(defn se [r] (get (get r "error") "code"))
(str-check (sv (str-split "가😀나" "")) ["가" "😀" "나"] "split scalars")
(str-check (sv (str-split "가,나," ",")) ["가" "나" ""] "split trailing")
(str-check (sv (str-split "" ",")) [""] "split empty")
(str-check (sv (str-split "" "")) [] "split empty scalars")
(str-check (sv (str-join ["가" "😀"] "-")) "가-😀" "join")
(str-check (sv (str-join [] ",")) "" "join empty")
(str-check (sv (str-trim "　 가 😀 \n" "both")) "가 😀" "trim unicode whitespace")
(str-check (sv (str-trim " 가 " "left")) "가 " "trim left")
(str-check (sv (str-trim " 가 " "right")) " 가" "trim right")
(str-check (sv (str-replace "가가가" "가" "😀" "all")) "😀😀😀" "replace all")
(str-check (sv (str-replace "가가" "가" "나" "first")) "나가" "replace first")
(str-check (sv (str-replace "aaa" "aa" "x" "all")) "xa" "nonoverlap")
(str-check (sv (str-starts? "가😀" "가")) true "starts")
(str-check (sv (str-ends? "가😀" "😀")) true "ends")
(str-check (sv (str-contains? "가😀나" "😀")) true "contains")
(str-check (sv (str-index-of "가😀나" "나")) 2 "scalar index")
(str-check (sv (str-index-of "가" "나")) -1 "missing index")
(str-check (sv (str-index-of "" "")) 0 "empty index")
(str-check (sv (str-pad-left "가" 4 "😀나")) "😀나😀가" "pad left scalars")
(str-check (sv (str-pad-right "가" 4 "😀나")) "가😀나😀" "pad right scalars")
(str-check (sv (str-pad-right "가나" 1 "x")) "가나" "no truncate")
(str-check (sv (str-repeat "가😀" 2)) "가😀가😀" "repeat")
(str-check (sv (str-repeat "가" 0)) "" "repeat zero")
(str-check (sv (str-lines "가\r\n나\r😀\n")) ["가" "나" "😀" ""] "lines CRLF CR LF")
(str-check (sv (str-lines "")) [] "empty lines")
(str-check (sv (str-format "{name}님 {name}!" {"name" "서윤"})) "서윤님 서윤!" "format repeated")
(str-check (se (str-format "{missing}" {})) "MISSING_KEY" "missing format key")
(str-check (se (str-format "{name" {})) "INVALID_FORMAT" "broken format")
(str-check (se (str-repeat "x" -1)) "INVALID_ARGUMENT" "negative repeat")
(str-check (se (str-pad-left "x" 3 "")) "INVALID_ARGUMENT" "empty padding")
(str-check (se (str-replace "x" "" "y" "all")) "INVALID_ARGUMENT" "empty search rejected")
(str-check (se (str-join [1] ",")) "INVALID_ARGUMENT" "join nonstring")
(str-check (se (str-trim "x" "bad")) "INVALID_ARGUMENT" "trim mode")
(str-check (se (str-split nil ",")) "INVALID_UTF8" "invalid input")
(str-check (se (str-split (get (char-from-byte 128) "value") "")) "INVALID_UTF8" "broken utf8")
(println (str "STR_SUMMARY=" @str-test-count "/35"))
