(load "../../lib/mail/guard.fl")
(define args (cli-args))
(define mode (get args 0))
(define base (get args 2))
(define body (if (= mode "changed") "body after approval" "approved local draft"))
(define mail {"from" "sender@example.invalid" "to"
  (if (= mode "outside") "outside@example.invalid" "receiver@example.invalid")
  "subject" (str "guard " mode) "body" body})
(define policy {"approval-file" (str base "/approval.json")
  "audit-file" (str base "/audit.jsonl") "rate-file" (str base "/rate.txt")
  "stop-file" (str base "/STOP") "hash-temp" (str base "/hash.tmp")})
(define options {"username" "fixture" "password" (_fl_env_get "SMTP_TEST_PASSWORD")
  "timeout-ms" 3000 "max-message-bytes" 4096})
(define approval-debug (file-read-json (get policy "approval-file")))
(define hash-write-debug (file-write-atomic (get policy "hash-temp") body))
(define hash-value-debug (evidence-hash (get policy "hash-temp")))
(println (str "DEBUG_HASH_WRITE=" (get hash-write-debug "ok")
  " DEBUG_HASH_OK=" (get hash-value-debug "ok")
  " DEBUG_HASH_ERROR=" (get (get (get hash-value-debug "error") "code"))))
(define hash-debug (mail-guard-hash policy body))
(println (str "DEBUG_APPROVAL_ID=" (get (get approval-debug "value") "draft_id")
  " DEBUG_APPROVAL_HASH=" (get (get approval-debug "value") "body_sha256")
  " DEBUG_BODY_HASH=" (get hash-debug "value")))
(define draft-id (if (includes-item ["success" "hourly"] mode) "draft-hourly" (str "draft-" mode)))
(define result (mail-guard-send "localhost" (str-to-num (get args 1))
  draft-id mail (= mode "risk") policy options))
(println (str "GUARD_RESULT=" (get result "status")))
(if (and (= mode "success") (get result "ok")) (_fl_exit 0)
  (if (and (!= mode "success") (not (get result "ok"))) (_fl_exit 0) (_fl_exit 1)))
