(load "../../lib/mail/guard.fl")
(define args (cli-args))
(define mode (get args 0))
(define base (get args 2))
(define state (if (> (length args) 3) (get args 3) base))
(define draft-id (if (> (length args) 4) (get args 4)
  (if (includes-item ["success" "hourly"] mode) "draft-hourly" (str "draft-" mode))))
(define body (if (= mode "changed") "body after approval" "approved local draft"))
(define mail {"from" "sender@example.invalid" "to"
  (if (= mode "outside") "outside@example.invalid" "receiver@example.invalid")
  "subject" (if (= mode "changed-subject") "changed after approval" (str "guard " (if (= mode "success") "hourly" mode)))
  "body" body})
(define policy {"approval-file" (str base "/approval.json")
  "audit-file" (str state "/audit.jsonl") "rate-file" (str state "/rate.txt")
  "lock-file" (str state "/guard.lock") "stop-file" (str state "/STOP")
  "hash-temp" (str state "/hash.tmp")})
(define options {"username" "fixture" "password" (_fl_env_get "SMTP_TEST_PASSWORD")
  "timeout-ms" 3000 "max-message-bytes" 4096})
(define result (mail-guard-send "localhost" (str-to-num (get args 1))
  draft-id mail (= mode "risk") policy options))
(println (str "GUARD_RESULT=" (get result "status")))
(_fl_exit 0)
