(load "../../lib/test/test.fl")
(load "../../lib/evidence/evidence.fl")
(define checks (atom 0))
(defn check [actual expected name]
  (if (= actual expected) (do (swap! checks + 1) (println (str "PASS " name)))
    (throw (str "FAIL " name " expected=" expected " actual=" actual))))
(check (get (assert-eq 2 2 "equal") "ok") true "equal pass")
(check (get (assert-eq 2 3 "different") "ok") false "equal fail")
(check (get (get (assert-eq 2 3 "different") "error") "name") "different" "failure name")
(check (get (get (assert-eq 2 3 "different") "error") "expected") 2 "failure expected")
(check (get (get (assert-eq 2 3 "different") "error") "actual") 3 "failure actual")
(check (get (assert-eq [1 2] [1 2] "vectors") "ok") true "deep equality")
(check (get (assert-true true "true") "ok") true "true pass")
(check (get (assert-true 1 "truthy") "ok") false "truthy is not true")
(check (get (assert-error "E" (fn [] (throw {"code" "E"})) "throw") "ok") true "expected exception")
(check (get (assert-error "E" (fn [] {"ok" false "error" {"code" "E"}}) "result") "ok") true "expected error result")
(check (get (assert-error "E" (fn [] true) "missing") "ok") false "missing error")
(check (get (assert-error "E" (fn [] (throw {"code" "OTHER"})) "wrong") "ok") false "wrong error code")
(define mixed (test-run [
  {"name" "good" "run" (fn [] (assert-eq 1 1 "good"))}
  {"name" "bad" "run" (fn [] (assert-eq 1 2 "bad"))}
  {"name" "throw" "run" (fn [] (throw "boom"))}
  {"name" "fatal" "run" (fn [] (/ 1 0))}
  {"name" "after" "run" (fn [] (assert-true true "after"))}]))
(check (get mixed "passed") 2 "pass count")
(check (get mixed "failed") 3 "fail count")
(check (get mixed "failed-names") ["bad" "throw" "fatal"] "ordered failure names")
(check (get (get (get mixed "failures") 1) "code") "EXCEPTION" "throw isolated")
(check (get (get (get mixed "failures") 2) "code") "TEST_PROCESS" "fatal isolated")
(check (get (test-run []) "passed") 0 "empty count")
(check (get (test-run [{"name" "invalid" "run" (fn [] nil)}]) "failed") 1 "nil cannot pass")
(check (get (test-run [{"name" "early-exit" "run" (fn [] (_fl_exit 0))}]) "failed") 1 "exit zero without result fails")
(define isolated-boundaries (test-run [
  {"name" "timeout" "run" (fn [] (loop [n 0] (recur (+ n 1))))}
  {"name" "signal" "run" (fn [] (do (_fl_process_kill (_fl_process_pid)) (assert-true true "signal")))}
  {"name" "recovery" "run" (fn [] (assert-true true "recovery"))}]))
(check (get isolated-boundaries "passed") 1 "recovery after timeout and signal")
(check (get isolated-boundaries "failed") 2 "timeout and signal fail")
(check (get isolated-boundaries "failed-names") ["timeout" "signal"] "timeout and signal names")
(define run-ok (evidence-run "printf" ["%s" "space ; $(literal)"]))
(check (get run-ok "code") 0 "command exit")
(check (get run-ok "stdout") "space ; $(literal)" "argv preserved without shell")
(check (get run-ok "stderr") "" "stdout separation")
(check (>= (get run-ok "duration-ms") 0) true "elapsed milliseconds")
(define run-fail (evidence-run "sh" ["-c" "printf out; printf err >&2; exit 7"]))
(check (get run-fail "code") 7 "nonzero preserved")
(check (get run-fail "stdout") "out" "failed stdout")
(check (get run-fail "stderr") "err" "failed stderr")
(check (get (evidence-run "no-such-task98-command" []) "code") 127 "missing executable")
(check (get (evidence-run "sh" ["-c" "kill -TERM $$"]) "signal") 15 "signal preserved")
(check (get (evidence-run 3 []) "ok") false "invalid command")
(check (get (evidence-run "printf" [2]) "ok") false "invalid argument")
(check (get (file-write "hash-input.txt" "abc") "ok") true "hash fixture")
(check (get (evidence-hash "hash-input.txt") "value") "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" "sha256 known answer")
(check (get (evidence-hash "missing-hash-input") "ok") false "hash missing file")
(check (get (evidence-hash "") "ok") false "hash empty path")
(check (get (file-write "line\nbreak.txt" "abc") "ok") true "newline filename fixture")
(check (get (evidence-hash "line\nbreak.txt") "value") "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" "hash escaped filename")
(check (evidence-mask "/home/test/file https://example.test user@example.test 192.0.2.1" []) "<가림> <가림> <가림> <가림>" "automatic mask")
(check (evidence-mask "operator alice" ["alice"]) "operator <가림>" "explicit account mask")
(check (evidence-mask {"account" "alice" "count" 7 "nested" [{"path" "relative-file"}]} [])
  {"account" "<가림>" "count" 7 "nested" [{"path" "<가림>"}]} "recursive mask")
(check (evidence-mask "PASS 3/4 exit=7" []) "PASS 3/4 exit=7" "counts preserved")
(check (evidence-mask "duration=1.25 2026-10-21T00:00:00.000Z" []) "duration=1.25 2026-10-21T00:00:00.000Z" "decimals and dates preserved")
(check (evidence-mask "2001:db8:0:0:0:0:0:1" []) "<가림>" "expanded IPv6 mask")
(check (evidence-mask "C:\\Users\\alice\\file" []) "<가림>" "windows path mask")
(check (get (evidence-write "evidence.json" {"stdout" "/private/file" "code" 7}) "ok") true "atomic evidence write")
(define stored (get (file-read-json "evidence.json") "value"))
(check (get (get stored "record") "stdout") "<가림>" "stored record masked")
(check (get (get stored "record") "code") 7 "stored exit preserved")
(check (get (time-parse (get stored "timestamp")) "ok") true "iso timestamp")
(check (get (evidence-write "absent/evidence.json" {}) "ok") false "write failure")
(check (get (evidence-write "evidence.json" {"code" 0}) "ok") true "write recovery")
(println (str "TEST_EVIDENCE_SUMMARY=" @checks "/" @checks))
