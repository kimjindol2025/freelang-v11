(defn check [condition name]
  (if condition (println (str "PASS " name)) (throw (str "FAIL " name))))
(define base (str "http://127.0.0.1:" (env-get "FL_STREAM_PORT")))
(define chunks (http-post-stream (str base "/chunks") {} "request"
  (fn [part] (do (println (str "CALLBACK_CHUNK=" part)) true))))
(check (= (get chunks "body") "onetwothree") "stream body matches original")
(check (= (http-stream-collect (str base "/chunks") {} "") "onetwothree") "collect joins chunks")
(check (= (http-stream-collect (str base "/empty") {} "") "") "empty chunk termination")
(check (= (http-stream-collect (str base "/single") {} "") "solo") "single chunk")
(define stopped (http-post-stream (str base "/stop") {} "" (fn [part] (do (println (str "STOP_CHUNK=" part)) false))))
(check (get stopped "ok") "false callback stops delivery")
(check (not (get (http-stream-collect (str base "/bad") {} "") "ok")) "nonhex chunk rejected")
(check (not (get (http-stream-collect (str base "/large") {} "") "ok")) "over 2MiB chunk rejected")
(check (not (get (http-stream-collect (str base "/truncated") {} "") "ok")) "truncated response rejected")
(define timeout-start (now-ms))
(define timeout-result (http-stream-collect (str base "/timeout") {} ""))
(check (and (not (get timeout-result "ok")) (>= (- (now-ms) timeout-start) 4900)) "five second timeout")
(define plain (http-post-stream (str base "/plain") {} "" (fn [part] (do (println (str "PLAIN_CHUNK=" part)) true))))
(check (= (get plain "body") "plain") "plain response callback")
(check (= (http-stream-collect (str base "/plain") {} "") "plain") "plain collect")
(check (= (http-stream-collect (str base "/echo") {"X-Test" "free-lang"} "request-body") "ok") "content-length echo response")
(println "STREAM_SUMMARY=13/13")
