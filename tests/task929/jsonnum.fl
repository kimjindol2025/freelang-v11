(defn check [condition name]
  (if condition (println (str "PASS " name)) (throw (str "FAIL " name))))
(define fractional (json-stringify {:t 1700000000.5}))
(define decimal (json-stringify 0.1))
(define tiny (json-stringify (json-parse "1e-10")))
(define negative (json-stringify -123.5))
(define integer-real (json-stringify 2.0))
(check (= (json-parse fractional) {:t 1700000000.5}) "large fractional timestamp roundtrip")
(check (= (json-stringify (json-parse fractional)) fractional) "timestamp stringify roundtrip")
(check (= decimal "0.10000000000000001") "0.1 output preserved")
(check (= tiny "1e-10") "1e-10 output preserved")
(check (= (json-stringify (json-parse tiny)) tiny) "1e-10 parse stringify roundtrip")
(check (= negative "-123.5") "negative float output preserved")
(check (= integer-real "2") "2.0 integer-like output preserved")
(check (= fractional (json-stringify {:t 1700000000.5})) "serialization deterministic")
(println (str "JSONNUM_OUTPUTS=" fractional "|" decimal "|" tiny "|" negative "|" integer-real))
(println "JSONNUM_SUMMARY=9/9")
