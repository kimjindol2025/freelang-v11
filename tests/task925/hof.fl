(if (= (any? (fn [x] (> x 2)) [1 3 5]) 3) (println "PASS any?") (throw "FAIL any?"))
(if (none? (fn [x] (> x 5)) [1 2 3]) (println "PASS none?") (throw "FAIL none?"))
(if (= (count-if (fn [x] (> x 1)) [1 2 3]) 2) (println "PASS count-if") (throw "FAIL count-if"))
(if (= (find-first (fn [x] (> x 2)) [1 2 3 4]) 3) (println "PASS find-first") (throw "FAIL find-first"))
(if (= (keep (fn [x] (if (= (% x 2) 0) x nil)) [1 2 3 4]) [2 4]) (println "PASS keep") (throw "FAIL keep"))
(if (= (map-indexed (fn [i x] (+ i x)) [10 10 10]) [10 11 12]) (println "PASS map-indexed") (throw "FAIL map-indexed"))
(if (= (map-vals (fn [x] (* x 2)) {"a" 2 "b" 3}) {"a" 4 "b" 6}) (println "PASS map-vals") (throw "FAIL map-vals"))
(if (= (map (comp (fn [x] (+ x 3)) (fn [x] (* x 2))) [4]) [11]) (println "PASS comp") (throw "FAIL comp"))
(if (= (get-in {"a" {"b" 7}} ["a" "b"]) 7) (println "PASS get-in") (throw "FAIL get-in"))
(if (and (= (get-in {"a" 1} ["a" "missing"]) nil) (= (get-in [1 [2]] [1 "0"]) 2))
  (println "PASS get-in-missing") (throw "FAIL get-in-missing"))
(if (and (= (get (group-by (fn [x] (if (= (% x 2) 0) "even" "odd")) [1 2 3 4]) "odd") [1 3])
         (= (keys (group-by (fn [x] (if (= (% x 2) 0) "even" "odd")) [1 2 3 4])) ["odd" "even"]))
  (println "PASS group-by") (throw "FAIL group-by"))
(if (and (= (get (frequencies ["b" "a" "b"]) "b") 2)
         (= (keys (frequencies ["b" "a" "b"])) ["b" "a"]))
  (println "PASS frequencies") (throw "FAIL frequencies"))
(if (= (into [1] [2 3]) [1 2 3]) (println "PASS into") (throw "FAIL into"))
(if (= (conj [1] 2 3) [1 2 3]) (println "PASS conj") (throw "FAIL conj"))
(if (= (obj-pick {"a" 1 "b" 2} ["b"]) {"b" 2}) (println "PASS obj-pick") (throw "FAIL obj-pick"))
(if (= (obj-omit {"a" 1 "b" 2} ["a"]) {"b" 2}) (println "PASS obj-omit") (throw "FAIL obj-omit"))
(if (= (zip-with (fn [a b] (+ a b)) [1 2 3] [10 20]) [11 22]) (println "PASS zip-with") (throw "FAIL zip-with"))
(let [offset 5]
  (if (= (map (fn [x] (+ x offset)) [1 2]) [6 7]) (println "PASS capture-map") (throw "FAIL capture-map")))
(let [offset 3]
(if (= (map (comp (fn [x] (+ x offset)) (fn [x] (* x 2))) [4]) [11]) (println "PASS capture-comp") (throw "FAIL capture-comp")))
(if (and (nil? (any? (fn [x] true) [])) (= (count-if (fn [x] true) []) 0))
  (println "PASS empty-predicates") (throw "FAIL empty-predicates"))
(if (and (= (keep (fn [x] x) []) []) (= (map-indexed (fn [i x] x) []) []))
  (println "PASS empty-maps") (throw "FAIL empty-maps"))
