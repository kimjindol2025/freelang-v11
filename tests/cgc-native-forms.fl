(load "../lib/db/sqlite-store-compat.fl")
(define counter (atom 0))
(define empty-counter (atom 0))
(define fallback (?? nil "fallback"))
(define preserved (?? "kept" "fallback"))
(define evaluated (?? (do (reset! counter (+ (deref counter) 1)) "once") "fallback"))
(define empty-once (empty? (do (reset! empty-counter (+ (deref empty-counter) 1)) [])))
(if (and (= (when true "yes") "yes")
         (nil? (when false "no"))
         (= fallback "fallback")
         (= preserved "kept")
         (= evaluated "once")
         (= (deref counter) 1)
         (empty? [])
         (not (empty? [1]))
         (empty? {})
         (not (empty? {:a 1}))
         empty-once
         (= (deref empty-counter) 1)
         (str-blank? " \t ")
         (str-blank? nil)
         (not (str-blank? "x"))
         (str-contains "sqlite-store" "store")
         (= (str-format "vendor=%s, id=%d" ["Acme" 7]) "vendor=Acme, id=7")
         (= (get (map str ["Acme" 7]) 1) "7"))
  (println "NATIVE_FORMS=PASS")
  (println "NATIVE_FORMS=FAIL"))
