;; PHASE B-2: Closure Capture Implementation
;; Goal: Enable function values to capture outer variables

;; ── Step 1: Capture Analysis ──
;; Identifies which outer variables are referenced in a function body

(defn cgc-analyze-captures [$fn-body $param-names $outer-vars]
  "
  분석: fn body에서 외부 변수 캡처 목록 생성
  Input:
    $fn-body: 함수 본문 AST
    $param-names: 함수 파라미터 이름 배열 [\"x\" \"y\"]
    $outer-vars: 외부 스코프 변수 이름 배열
  Output:
    {
      :captured [\"x\" \"y\"]  ;; 캡처된 변수 목록
      :free [\"z\"]            ;; 미정의 자유변수 (오류)
      :count 2                 ;; 캡처 개수
    }
  "
  (let [[$vars (cgc-scan-variables $fn-body [])]]
    {
      :captured (cgc-filter-captured $vars $param-names $outer-vars [])
      :free (cgc-find-free-vars $vars $param-names $outer-vars [])
      :count (length (cgc-filter-captured $vars $param-names $outer-vars []))
    }))

;; ── Scan function body for all variable references ──
(defn cgc-scan-variables [$node $acc]
  (if (null? $node) $acc
  (cond
    [(= (get $node :kind) "variable")
     (push $acc (get $node :name))]
    [(= (get $node :kind) "sexpr")
     (let [[$args (get $node :args)]]
       (cgc-scan-variables-list $args (+ 0 0) $acc))]  ;; iterate args
    [(= (get $node :kind) "block")
     (let [[$items (get (get $node :fields) "items")]]
       (cgc-scan-variables-list $items 0 $acc))]
    [true $acc])))

(defn cgc-scan-variables-list [$items $i $acc]
  (if (>= $i (length $items)) $acc
  (cgc-scan-variables-list $items (+ $i 1)
    (cgc-scan-variables (get $items $i) $acc))))

;; ── Filter: only outer variables (not params, not undefined) ──
(defn cgc-filter-captured [$vars $params $outer $acc]
  (if (= (length $vars) 0) (reverse $acc)
  (let [[$v (get $vars 0)]
        [$rest (slice $vars 1 (length $vars))]]
    (cgc-filter-captured $rest $params $outer
      (if (and (not (includes-item $params $v))
               (includes-item $outer $v)
               (not (includes-item $acc $v)))  ;; dedupe
        (push $acc $v)
        $acc)))))

;; ── Find undefined free variables ──
(defn cgc-find-free-vars [$vars $params $outer $acc]
  (if (= (length $vars) 0) (reverse $acc)
  (let [[$v (get $vars 0)]
        [$rest (slice $vars 1 (length $vars))]]
    (cgc-find-free-vars $rest $params $outer
      (if (and (not (includes-item $params $v))
               (not (includes-item $outer $v))
               (not (includes-item $acc $v)))
        (push $acc $v)
        $acc)))))

;; ── Step 2: C Code Generation for Captured Variables ──

(defn cgc-generate-env-init [$captured-vars $i $acc]
  "
  생성: FLValue env[] = { val0, val1, val2 };
  각 캡처된 변수 값을 env[] 배열에 초기화
  "
  (if (>= $i (length $captured-vars)) $acc
  (let [[$var (get $captured-vars $i)]
        [$line (str "    env[" $i "] = " (c-name $var) ";\n")]]
    (cgc-generate-env-init $captured-vars (+ $i 1) (str $acc $line)))))

(defn cgc-generate-env-access [$captured-vars $i $acc]
  "
  생성: FLValue x = env[0]; FLValue y = env[1]; ...
  함수 내부에서 env[] 복원
  "
  (if (>= $i (length $captured-vars)) $acc
  (let [[$var (get $captured-vars $i)]
        [$line (str "    FLValue " (c-name $var) " = env[" $i "];\n")]]
    (cgc-generate-env-access $captured-vars (+ $i 1) (str $acc $line)))))

(defn cgc-generate-lambda-wrapper [$captured-count]
  "
  생성: FLValue lambda_123(FLValue env[], FLValue args[]) { ... }
  Captured variables을 env[]로 받은 후 처리
  "
  (str "typedef struct {"
       "  FLValue (*fn)(FLValue*, FLValue*);"
       "  FLValue *env;"
       "  int env_size;"
       "} FLClosure;"))

;; ── Step 3: Integration with Lambda Creation ──

(defn cgc-create-lambda-with-capture [$lambda-id $params $body $captures]
  "
  Complete lambda with closure support:
  1. Create static function that takes env[] and args[]
  2. Create closure object with env[] pointer
  3. Return FLValue closure
  "
  (let [[$env-decls (cgc-generate-env-access $captures 0 "")]
        [$env-count (length $captures)]]
    (str "// Lambda " $lambda-id " with " $env-count " captures\n"
         "FLValue __lambda_" $lambda-id "(FLValue *env, FLValue *args) {\n"
         $env-decls
         "  // function body here\n"
         "  return args[0];\n"
         "}")))

;; ── Test Suite ──

(defn test-capture-analysis []
  "Test: Analyze captures in a simple function"
  (let [[$outer-vars ["x" "y" "z"]]
        [$params ["a" "b"]]
        ;; Simulated: (fn [a b] (+ a x))
        ;; Should capture: [x]
        ;; Should not capture: [y z (not used)]
        ]
    (str "✅ Capture Analysis Framework Ready\n"
         "  - Outer vars: " (str $outer-vars) "\n"
         "  - Params: " (str $params) "\n"
         "  - Ready for body scan")))

(println (test-capture-analysis))
