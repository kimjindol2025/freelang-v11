;; self/all.fl — FreeLang 컴파일러 (self-hosted)
;; 독립선언 v1 달성 (2026-05-12) — L2 고정점 SHA256: 5fe0a3fd...

;; ── Lexer ───────────────────────────────────────────────────────────
;; 입력: source string
;; 출력: tokens list. 각 토큰 = {:kind :value :line :col}
;; 토큰 종류: LParen/RParen/LBracket/RBracket/LBrace/RBrace
;;          Number/String/Symbol/Variable/Keyword/Unknown

;; ── char predicates

(defn is-digit? [$c]
  (if (null? $c) false (and (>= $c "0") (<= $c "9"))))

(defn is-alpha? [$c]
  (if (null? $c) false
  (or (and (>= $c "a") (<= $c "z"))
      (and (>= $c "A") (<= $c "Z")))))

(defn is-alnum? [$c]
  (or (is-digit? $c) (is-alpha? $c)))

(defn is-space? [$c]
  (or (= $c " ") (= $c "\t") (= $c "\n") (= $c "\r")))

(defn is-symbol-char? [$c]
  (if (null? $c) false
  (or (is-alnum? $c)
      (= $c "-") (= $c "_") (= $c "?") (= $c "!")
      (= $c "/") (= $c ".") (= $c "<") (= $c ">")
      (= $c "=") (= $c "+") (= $c "*") (= $c "%")
      (= $c "&") (= $c "|") (= $c "^") (= $c "~"))))

;; ── state = {:src :idx :line :col :tokens}

(defn make-state [$src]
  {:src $src :idx 0 :line 1 :col 1 :tokens []})

(defn peek-at [$st $offset]
  (let [[$src (get $st :src)]
      [$i (+ (get $st :idx) $offset)]]
  (if (>= $i (length $src)) null (char-at $src $i))))

(defn peek [$st]
  (peek-at $st 0))

(defn at-end? [$st]
  (>= (get $st :idx) (length (get $st :src))))

(defn advance [$st]
  (let [[$c (peek $st)]]
  (if (= $c "\n")
    {:src (get $st :src) :idx (+ (get $st :idx) 1)
     :line (+ (get $st :line) 1) :col 1
     :tokens (get $st :tokens)}
    {:src (get $st :src) :idx (+ (get $st :idx) 1)
     :line (get $st :line) :col (+ (get $st :col) 1)
     :tokens (get $st :tokens)})))

(defn emit [$st $kind $value $sl $sc]
  {:src (get $st :src) :idx (get $st :idx)
  :line (get $st :line) :col (get $st :col)
  :tokens (append (get $st :tokens)
                  {:kind $kind :type $kind :value $value :line $sl :col $sc})})

;; ── 스킵 (whitespace + ; line comment)

(defn skip-comment-loop [$_cur]
  (loop [$cur $_cur]
    (if (or (at-end? $cur) (= (peek $cur) "\n"))
      (if (at-end? $cur) $cur (advance $cur))
      (recur (advance $cur)))))

(defn skip-comment [$st]
  (skip-comment-loop $st))

(defn skip-ws-loop [$_cur]
  (loop [$cur $_cur]
    (if (at-end? $cur) $cur
      (let [[$c (peek $cur)]]
        (cond
          [(is-space? $c) (recur (advance $cur))]
          [(= $c ";")     (recur (skip-comment $cur))]
          [true           $cur])))))

(defn skip-ws [$st]
  (skip-ws-loop $st))

;; ── 숫자 (정수/실수/음수)

(defn read-number-iter [$_cur $_res_acc $_dot $line $col]
  (loop [$cur $_cur $res_acc $_res_acc $dot $_dot]
    (if (at-end? $cur) (emit $cur "Number" $res_acc $line $col)
      (let [[$c (peek $cur)]]
        (cond
          [(is-digit? $c)
           (recur (advance $cur) (str $res_acc $c) $dot)]
          [(and (= $c ".") (not $dot))
           (recur (advance $cur) (str $res_acc $c) true)]
          [true (emit $cur "Number" $res_acc $line $col)])))))

(defn read-number-body [$st $acc $has-dot $line $col]
  (read-number-iter $st $acc $has-dot $line $col))

(defn read-number [$st]
  (read-number-body $st "" false (get $st :line) (get $st :col)))

;; ── 문자열 (escape \n \t \r \" \\)

(defn translate-esc [$c]
  (cond
  [(= $c "n") "\n"] [(= $c "t") "\t"] [(= $c "r") "\r"]
  [(= $c "\"") "\""] [(= $c "\\") "\\"] [true $c]))

(defn read-string-iter [$_cur $_res_acc $line $col]
  (loop [$cur $_cur $res_acc $_res_acc]
    (if (at-end? $cur) (emit $cur "UnclosedString" $res_acc $line $col)
      (let [[$c (peek $cur)]]
        (cond
          [(= $c "\"")
           (emit (advance $cur) "String" $res_acc $line $col)]
          [(= $c "\\")
           (let [[$st2 (advance $cur)] [$c2 (peek $st2)]]
             (recur (advance $st2) (str $res_acc (translate-esc $c2))))]
          [true
           (recur (advance $cur) (str $res_acc $c))])))))

(defn read-string-body [$st $acc $line $col]
  (read-string-iter $st $acc $line $col))

(defn read-string [$st]
  (let [[$line (get $st :line)] [$col (get $st :col)]
      [$st1 (advance $st)]]
  (read-string-body $st1 "" $line $col)))

;; ── 심볼 / 변수 / 키워드 (모두 symbol-char 연속)

(defn read-symbol-iter [$_cur $_res_acc $line $col $kind]
  (loop [$cur $_cur $res_acc $_res_acc]
    (if (at-end? $cur) (emit $cur $kind $res_acc $line $col)
      (let [[$c (peek $cur)]]
        (if (is-symbol-char? $c)
          (recur (advance $cur) (str $res_acc $c))
          (emit $cur $kind $res_acc $line $col))))))

(defn read-symbol-body-kind [$st $acc $line $col $kind]
  (read-symbol-iter $st $acc $line $col $kind))

(defn read-symbol [$st]
  (read-symbol-body-kind $st "" (get $st :line) (get $st :col) "Symbol"))

(defn read-variable [$st]
  (let [[$line (get $st :line)] [$col (get $st :col)]
      [$st1 (advance $st)]]
  (read-symbol-body-kind $st1 "" $line $col "Variable")))

(defn read-keyword [$st]
  (let [[$line (get $st :line)] [$col (get $st :col)]
      [$st1 (advance $st)]]
  (read-symbol-body-kind $st1 "" $line $col "Keyword")))

;; ── 토큰 하나 읽기

(defn read-token [$st]
  (let [[$st1 (skip-ws $st)]]
  (if (at-end? $st1) $st1
    (let [[$c (peek $st1)] [$line (get $st1 :line)] [$col (get $st1 :col)]]
      (cond
        [(= $c "(") (emit (advance $st1) "LParen"   $c $line $col)]
        [(= $c ")") (emit (advance $st1) "RParen"   $c $line $col)]
        [(= $c "[") (emit (advance $st1) "LBracket" $c $line $col)]
        [(= $c "]") (emit (advance $st1) "RBracket" $c $line $col)]
        [(= $c "{") (emit (advance $st1) "LBrace"   $c $line $col)]
        [(= $c "}") (emit (advance $st1) "RBrace"   $c $line $col)]
        [(= $c "\"") (read-string $st1)]
        [(= $c "$") (read-variable $st1)]
        [(= $c ":") (read-keyword $st1)]
        [(is-digit? $c) (read-number $st1)]
        [(and (= $c "-") (is-digit? (peek-at $st1 1)))
         (read-number-body (advance $st1) "-" false $line $col)]
        [(is-symbol-char? $c) (read-symbol $st1)]
        [true (emit (advance $st1) "Unknown" $c $line $col)])))))

;; ── 메인 루프 — 모든 토큰 수집

(defn lex-loop [$_cur]
  (loop [$cur $_cur]
    (let [[$ws (skip-ws $cur)]]
      (if (at-end? $ws)
        (get $ws :tokens)
        (recur (read-token $ws))))))

(defn lex [$src]
  (lex-loop (make-state $src)))

;; ── AST 노드 생성자 ─────────────────────────────────────────────────
;; 모든 노드는 plain map: {:kind "..." ...필드}

;; ── 21 기본 원자 (Literal/Variable/Keyword/SExpr)

(defn make-literal [type value line]
  {:kind "literal" :type type :value value :line line})

(defn make-variable [name line]
  {:kind "variable" :name name :line line})

(defn make-keyword [name line]
  {:kind "keyword" :name name :line line})

(defn make-sexpr [op args line]
  {:kind "sexpr" :op op :args args :line line})

;; ── 22 SExpr 편의 + 원시값 래퍼

(defn make-number [v line]
  (make-literal "number" v line))

(defn make-string [v line]
  (make-literal "string" v line))

(defn make-bool [v line]
  (make-literal "boolean" v line))

(defn make-null [line]
  (make-literal "null" null line))

(defn make-symbol [v line]
  (make-literal "symbol" v line))

;; ──────────────────────────────────────
;; 23 Block (Array/Map/Named)
;; fields 는 items(list) 또는 named map. block 의 type 으로 구분.
;; ──────────────────────────────────────

(defn make-block [type name fields line]
  {:kind "block" :type type :name name :fields fields :line line})

(defn make-array-block [items line]
  (make-block "Array" null {:items items} line))

(defn make-map-block [items line]
  (make-block "Map" null {:items items} line))

;; ── 24 Pattern 7종

(defn make-pattern-literal [value line]
  {:kind "pattern-literal" :value value :line line})

(defn make-pattern-variable [name line]
  {:kind "pattern-variable" :name name :line line})

(defn make-pattern-wildcard [line]
  {:kind "pattern-wildcard" :line line})

(defn make-pattern-list [items rest line]
  {:kind "pattern-list" :items items :rest rest :line line})

(defn make-pattern-struct [type-name fields line]
  {:kind "pattern-struct" :type type-name :fields fields :line line})

(defn make-pattern-or [alternatives line]
  {:kind "pattern-or" :alternatives alternatives :line line})

(defn make-pattern-range [start end line]
  {:kind "pattern-range" :start start :end end :line line})

;; ── 25 Pattern matching

(defn make-pattern-match [value cases line]
  {:kind "pattern-match" :value value :cases cases :line line})

(defn make-match-case [pattern guard body line]
  {:kind "match-case" :pattern pattern :guard guard :body body :line line})

;; ── 26 함수/타입

(defn make-function-value [params body captured-env name]
  {:kind "function-value" :params params :body body
  :capturedEnv captured-env :name name})

(defn make-type-class [name generics methods line]
  {:kind "type-class" :name name :generics generics
  :methods methods :line line})

(defn make-type-class-instance [class-name type-name impls line]
  {:kind "type-class-instance" :class class-name :type type-name
  :impls impls :line line})

;; ── 27 Module / Import

(defn make-module-block [name exports body line]
  {:kind "module" :name name :exports exports :body body :line line})

(defn make-import-block [path alias names line]
  {:kind "import" :path path :alias alias :names names :line line})

(defn make-open-block [module-name line]
  {:kind "open" :module module-name :line line})

;; ── 28 AI 블록 (SearchBlock / LearnBlock / ReasoningBlock)

(defn make-search-block [query fields line]
  {:kind "search-block" :query query :fields fields :line line})

(defn make-learn-block [topic fields line]
  {:kind "learn-block" :topic topic :fields fields :line line})

(defn make-reasoning-block [name fields line]
  {:kind "reasoning-block" :name name :fields fields :line line})

;; ── 29 Async / Try

(defn make-async-function [name params body line]
  {:kind "async-function" :name name :params params :body body :line line})

(defn make-await [expr line]
  {:kind "await" :expr expr :line line})

(defn make-try [body catch finally line]
  {:kind "try" :body body :catch catch :finally finally :line line})

(defn make-catch [param body line]
  {:kind "catch" :param param :body body :line line})

(defn make-throw [expr line]
  {:kind "throw" :expr expr :line line})

(defn make-template-string [parts expressions line]
  {:kind "template-string" :parts parts :expressions expressions :line line})

(defn make-loop [init condition update body line]
  {:kind "loop" :init init :condition condition :update update :body body :line line})

;; ── 30 웹 노드 + deep-equal?

(defn make-page [name path fields line]
  {:kind "page" :name name :path path :fields fields :line line})

(defn make-route [method path handler line]
  {:kind "route" :method method :path path :handler handler :line line})

(defn make-component [name fields line]
  {:kind "component" :name name :fields fields :line line})

(defn make-form [name fields line]
  {:kind "form" :name name :fields fields :line line})

;; deep-equal? — 노드 비교 (line 무시)
;; Map 이면 모든 키를 순회, list 면 원소별, 원시값은 =.

(defn deep-equal? [a b]
  (cond
  [(and (null? a) (null? b)) true]
  [(or  (null? a) (null? b)) false]
  [(and (list? a) (list? b)) (deep-equal-list? a b 0)]
  [(and (map? a) (map? b))   (deep-equal-map? a b)]
  [true (= a b)]))

(defn deep-equal-list? [a b i]
  (cond
  [(not (= (length a) (length b))) false]
  [(>= i (length a)) true]
  [(not (deep-equal? (get a i) (get b i))) false]
  [true (deep-equal-list? a b (+ i 1))]))

;; Map 비교: :line 은 무시. keys 정렬 후 각 키의 값 비교.
(defn deep-equal-map? [a b]
  (let [[ka (keys-no-line a)]
      [kb (keys-no-line b)]]
  (if (not (= (length ka) (length kb))) false
    (deep-equal-map-keys? a b ka 0))))

(defn keys-no-line [m]
  (filter (fn [k] (not (= k "line"))) (json_keys m)))

(defn deep-equal-map-keys? [a b ks i]
  (cond
  [(>= i (length ks)) true]
  [(let [[k (get ks i)]]
     (not (deep-equal? (get a k) (get b k)))) false]
  [true (deep-equal-map-keys? a b ks (+ i 1))]))

;; ── 독립선언 v1: 누락 builtin 추가 ──────────────────────────
(defn json-keys [m] (obj-keys m))
;; list? / array? / map? 는 prelude builtin — 재정의 불필요

;; ── Parser ──────────────────────────────────────────────────────────
;; 입력: tokens (lexer 출력) / 출력: AST nodes
;; 모든 함수 [FUNC] 블록. 파서 상태 = {:tokens :idx}.
;; node 생성자는 self/ast.fl 정의 재사용. 테스트 단독 실행 위해 여기에도 복제.

;; ──────────────────────────────────────
;; AST 생성자 — self/ast.fl 에서 정의됨
;; (모든 make-* 함수는 ast.fl 표준 정의 참조)
;; ──────────────────────────────────────

;; ── 31 파서 상태 + peek/advance/expect

(defn p-make [$tokens]
  {:tokens $tokens :idx 0 :ast []})

(defn p-peek [$p]
  (let [[$i (get $p :idx)] [$t (get $p :tokens)]]
  (if (>= $i (length $t)) null (get $t $i))))

(defn p-peek-at [$p $offset]
  (let [[$i (+ (get $p :idx) $offset)] [$t (get $p :tokens)]]
  (if (>= $i (length $t)) null (get $t $i))))

(defn p-end? [$p]
  (>= (get $p :idx) (length (get $p :tokens))))

(defn p-advance [$p]
  {:tokens (get $p :tokens) :idx (+ (get $p :idx) 1) :ast (get $p :ast)})

(defn p-with-ast [$p $ast]
  {:tokens (get $p :tokens) :idx (get $p :idx) :ast $ast})

(defn p-append-ast [$p $node]
  (p-with-ast $p (append (get $p :ast) $node)))

;; 2-tuple 반환용 map {:p p' :node n}
(defn r-pair [$p $node]
  {:p $p :node $node})

;; ── 32 parseAtom — number/string/symbol/keyword/variable

(defn string-contains? [$s $substr]
  (not (= -1 (str-index-of $s $substr))))

(defn parse-atom [$p]
  (let [[$t (p-peek $p)] [$k (get $t :kind)] [$v (get $t :value)] [$line (get $t :line)]]
  (cond
    [(= $k "Number")
     (r-pair (p-advance $p) (make-literal "number" $v $line))]
    [(= $k "String")
     (if (string-contains? $v (str "$" "{"))
       (r-pair (p-advance $p) (make-template-string $v (list) $line))
       (r-pair (p-advance $p) (make-literal "string" $v $line)))]
    [(= $k "Symbol")
     (cond
       [(= $v "true")  (r-pair (p-advance $p) (make-literal "boolean" true  $line))]
       [(= $v "false") (r-pair (p-advance $p) (make-literal "boolean" false $line))]
       [(or (= $v "nil") (= $v "null"))
                       (r-pair (p-advance $p) (make-literal "nil"     nil   $line))]
       [true           (r-pair (p-advance $p) (make-literal "symbol"  $v    $line))])]
    [(= $k "Variable")
     (r-pair (p-advance $p) (make-variable $v $line))]
    [(= $k "Keyword")
     (r-pair (p-advance $p) (make-keyword $v $line))]
    [true (r-pair (p-advance $p) (make-literal "unknown" $v $line))])))

;; ── 33 parse-expr — 단일 표현식 (atom 또는 S-expr/array/map/block)

(defn parse-expr [$p]
  (let [[$t (p-peek $p)] [$k (get $t :kind)] [$v (get $t :value)]]
  (cond
    [(= $k "LParen")   (parse-sexpr $p)]
    [(= $k "LBracket") (parse-bracket $p)]
    [(= $k "LBrace")   (parse-map $p)]
    [(and (= $k "Unknown") (= $v "@"))
     (let [[$p1 (p-advance $p)]
           [$res (parse-expr $p1)]]
       (r-pair (get $res :p)
               (make-sexpr "deref" (list (get $res :node)) (get $t :line))))]
    [true (parse-atom $p)])))

;; ── 33 parse-sexpr (parens)

(defn parse-sexpr [$p]
  (let [[$start-tok (p-peek $p)] [$line (get $start-tok :line)]
      [$p1 (p-advance $p)]                          ;; consume (
      [$first (parse-args $p1 [])]                  ;; collect until )
      [$p2 (get $first :p)] [$args (get $first :node)]]
  (if (= (length $args) 0)
    (r-pair (parse-consume-rparen $p2) (make-sexpr "" (list) $line))
    (let [[$op-node (get $args 0)]
          [$op (if (= (get $op-node :kind) "literal")
                 (get $op-node :value)
                 (if (= (get $op-node :kind) "variable")
                   (str "$" (get $op-node :name))
                   "unknown"))]
          [$rest (slice $args 1 (length $args))]]
      (cond
        [(= $op "try")
         ;; try-catch-finally: (try body (catch param body) (finally body))
         (let [[$body (if (> (length $rest) 0) (get $rest 0) null)]
               [$catch-clause (if (> (length $rest) 1) (get $rest 1) null)]
               [$finally-clause (if (> (length $rest) 2) (get $rest 2) null)]]
           (r-pair (parse-consume-rparen $p2)
                   (make-try $body $catch-clause $finally-clause $line)))]
        [(= $op "loop")
         ;; loop: (loop [[$i 0] (< $i 10) (+ $i 1)] body...)
         ;; 형식: (loop [init-binding condition update] body)
         (let [[$loop-array (if (> (length $rest) 0) (get $rest 0) null)]
               [$_body-start (if (> (length $rest) 1) (get $rest 1) null)]]
           (if (null? $loop-array)
             (r-pair (parse-consume-rparen $p2) (make-sexpr "loop" (list) $line))
             (if (not (= (get $loop-array :kind) "array"))
               (r-pair (parse-consume-rparen $p2) (make-sexpr "loop" $rest $line))
               (let [[$items (get $loop-array :items)]
                     [$init (if (> (length $items) 0) (get $items 0) null)]
                     [$condition (if (> (length $items) 1) (get $items 1) null)]
                     [$update (if (> (length $items) 2) (get $items 2) null)]
                     [$body-exprs (slice $rest 1 (length $rest))]]
                 (r-pair (parse-consume-rparen $p2)
                         (make-loop $init $condition $update
                                   (if (= (length $body-exprs) 1)
                                     (get $body-exprs 0)
                                     (make-sexpr "do" $body-exprs $line))
                                   $line))))))]
        [(= $op "and")
         (r-pair (parse-consume-rparen $p2)
                 {:kind "and" :args $rest :line $line})]
        [(= $op "or")
         (r-pair (parse-consume-rparen $p2)
                 {:kind "or" :args $rest :line $line})]
        [true
         (r-pair (parse-consume-rparen $p2)
                 (make-sexpr $op $rest $line))])))))

(defn parse-consume-rparen [$p]
  (let [[$t (p-peek $p)]]
  (if (and (not (null? $t)) (= (get $t :kind) "RParen"))
    (p-advance $p)
    $p)))

;; args 수집 (재귀): RParen 만나면 중단
(defn parse-args [$p $acc]
  (let [[$t (p-peek $p)]]
  (cond
    [(null? $t)                              (r-pair $p $acc)]
    [(= (get $t :kind) "RParen")             (r-pair $p $acc)]
    [(= (get $t :kind) "RBracket")           (r-pair $p $acc)]
    [(= (get $t :kind) "RBrace")             (r-pair $p $acc)]
    [true
     (let [[$one (parse-expr $p)]]
       (parse-args (get $one :p) (append $acc (get $one :node))))])))

;; ── 34 parse-bracket — [a b c] 또는 [FUNC ...] 블록

(defn parse-bracket [$p]
  (let [[$tok (p-peek $p)] [$line (get $tok :line)]
      [$p1 (p-advance $p)]                ;; consume [
      [$next (p-peek $p1)]]
  (if (and (not (null? $next))
           (= (get $next :kind) "Symbol")
           (is-block-type? (get $next :value))
           (= (get $next :value) (upper-case (get $next :value))))
    (parse-named-block $p1 $line)
    (parse-array $p1 $line))))

(defn is-block-type? [$s]
  (let [[$c (char-at $s 0)]]
  (and (>= $c "A") (<= $c "Z"))))

(defn upper-case [$s]
  $s)   ;; FL stdlib 기본 upper-case 가 없으면 identity. 판별엔 첫글자만 본다.

(defn parse-array [$p $line]
  (let [[$collected (parse-args $p [])]
      [$p2 (get $collected :p)] [$items (get $collected :node)]]
  (r-pair (parse-consume-rbracket $p2) (make-array-block $items $line))))

(defn parse-consume-rbracket [$p]
  (let [[$t (p-peek $p)]]
  (if (and (not (null? $t)) (= (get $t :kind) "RBracket"))
    (p-advance $p)
    $p)))

;; [TYPE name? :k v :k v ...]  Named block (FUNC/ROUTE/PAGE 등)
(defn parse-named-block [$p $line]
  (let [[$type-tok (p-peek $p)] [$type (get $type-tok :value)]
      [$p1 (p-advance $p)]
      [$name-info (parse-optional-name $p1)]
      [$p2 (get $name-info :p)] [$name (get $name-info :node)]
      [$fields-info (parse-block-fields $p2 {})]
      [$p3 (get $fields-info :p)] [$fields (get $fields-info :node)]]
  (r-pair (parse-consume-rbracket $p3)
          (make-block $type $name $fields $line))))

(defn parse-optional-name [$p]
  (let [[$t (p-peek $p)]]
  (if (and (not (null? $t))
           (= (get $t :kind) "Symbol")
           (not (= (char-at (get $t :value) 0) ":")))
    (r-pair (p-advance $p) (get $t :value))
    (r-pair $p null))))

;; :k v :k v ... 반복. RBracket 만나면 중단.
(defn parse-block-fields [$p $acc]
  (if (p-end? $p) (r-pair $p $acc)
    (let [[$t (p-peek $p)]]
      (if (= (get $t :kind) "Keyword")
        (let [[$key (get $t :value)]
              [$p1 (p-advance $p)]
              [$val (parse-expr $p1)]]
          (parse-block-fields (get $val :p) (_fl_map_set $acc $key (get $val :node))))
        (r-pair $p $acc)))))
;; ──────────────────────────────────────

(defn parse-map [$p]
  (let [[$tok (p-peek $p)] [$line (get $tok :line)]
      [$p1 (p-advance $p)]
      [$collected (parse-args $p1 [])]
      [$p2 (get $collected :p)] [$items (get $collected :node)]]
  (r-pair (parse-consume-rbrace $p2) (make-map-block $items $line))))

(defn parse-consume-rbrace [$p]
  (let [[$t (p-peek $p)]]
  (if (and (not (null? $t)) (= (get $t :kind) "RBrace"))
    (p-advance $p)
    $p)))

;; ── 40/44 공개 API: parse(tokens) → ast list

(defn parse-all [$p]
  (if (p-end? $p)
  (get $p :ast)
  (let [[$one (parse-expr $p)]
        [$p2 (p-append-ast (get $one :p) (get $one :node))]]
    (parse-all $p2))))

(defn parse [$tokens]
  (parse-all (p-make $tokens)))

;; self/codegen-c.fl — FreeLang → C 코드젠 (Stage 2)
;; 지원 범위: self/CODEGEN_C_SCOPE.md 참조
;; ABI: self/ABI.md (FLValue tagged union)

;; S19/S20: lambda collector + capture 추적
(define lambda-id-atom    (atom 0))
(define lambda-defs-atom  (atom []))
(define outer-params-atom (atom []))
;; S23: define 변수 이름 추적 — 이 이름으로 호출 시 fl_fn_call 사용
(define known-fncall-targets-atom (atom []))
;; S24: defn 이름 목록 (forward pass) + wrapper 구현 목록
(define known-defns-atom   (atom []))
(define wrapper-defs-atom  (atom []))
(define function-c-symbols-atom (atom []))
;; S24: define 전역 선언 목록 ("static FLValue name;")
(define global-decls-atom  (atom []))

;; bug4: nested defn hoisting
(define cgc-defn-depth-atom   (atom 0))
(define cgc-hoisted-fns-atom  (atom []))
(define cgc-hoisted-fwds-atom (atom ""))

;; ── 유틸 ──

(defn get-block-items [$node]
  (if (null? $node) (list)
  (if (and (= (get $node :kind) "block") (= (get $node :type) "Array"))
    (get (get $node :fields) "items")
    $node)))

(defn c-esc [$s]
  ;; 문자열 리터럴을 C 이스케이프로 변환 (\\ " \n \t \r)
  (str-replace
    (str-replace
      (str-replace
        (str-replace
          (str-replace $s "\\" "\\\\")
          "\"" "\\\"")
        "\n" "\\n")
      "\t" "\\t")
    "\r" "\\r"))

(defn c-reserved? [$s]
  (includes-item ["else" "return" "for" "while" "do" "int" "long" "void"
                  "char" "float" "double" "struct" "union" "enum"
                  "static" "const" "if" "switch" "case" "break"
                  "continue" "default" "goto" "sizeof" "auto" "inline"
                  "bool" "true" "false"] $s))

(defn c-name [$n]
  ;; Preserve native C underscores; the registration pass rejects mangling collisions.
  (let [[$a (str-replace $n "->" "_to_")]
        [$b (str-replace $a "-" "_")]
        [$c (str-replace $b "/" "__")]
        [$d (str-replace $c "?" "_p")]
        [$e (str-replace $d "!" "_b")]
        [$f (str-replace $e "=" "_eq")]
        [$g (str-replace $f "." "_dot")]
        [$h (str-replace $g "<" "_lt")]
        [$i (str-replace $h ">" "_gt")]
        [$j (str-replace $i "+" "_plus")]
        [$k (str-replace $j "*" "_star")]
        [$l (str-replace $k "%" "_pct")]
        [$m (str-replace $l "&" "_and")]
        [$o (str-replace $m "|" "_or")]
        [$p (str-replace $o "^" "_xor")]
        [$raw (str-replace $p "~" "_not")]]
    (if (includes-item ["now-iso" "str-split" "str-join" "str-trim" "str-replace" "str-index-of"] $n) (str "fl_library_" $raw)
    (if (= $n "dir-list") "fl_library_dir_list"
    (if (= $n "http-get") "fl_library_http_get"
      (if (c-reserved? $raw) (str "fl_" $raw) $raw))))))

(defn c-runtime-name [$op]
  (cond
    [(= $op "vec-push") "fl_vec_push"]
    [(= $op "tcp-bind") "fl_tcp_bind"]
    [(= $op "tcp-listen") "fl_tcp_listen"]
    [(= $op "tcp-accept") "fl_tcp_accept"]
    [(= $op "tcp-close") "fl_tcp_close"]
    [(= $op "tcp-local-port") "fl_tcp_local_port"]
    [(= $op "auth-random-token") "fl_auth_random_token"]
    [(= $op "auth-pbkdf2") "fl_auth_pbkdf2"]
    [(= $op "auth-constant-time-equal") "fl_auth_constant_time_equal"]
    [true nil]))

(defn cgc-runtime-call [$op $args]
  (let [[$name (c-runtime-name $op)]]
    (str $name "(" (cgc-args $args) ")")))

(defn cgc-register-function [$raw]
  (let [[$name (c-name $raw)]
        [$entries @function-c-symbols-atom]]
    (loop [$i 0]
      (if (>= $i (length $entries))
        (do (swap! function-c-symbols-atom push [$name $raw]) $name)
        (let [[$entry (get $entries $i)]]
          (if (= (get $entry 0) $name)
            (do
              (println (str "[CGC-ERR] C symbol collision: " (get $entry 1) " and " $raw " -> " $name))
              (_fl_exit 1))
            (recur (+ $i 1))))))))

;; ── 메인 dispatch ──

(defn cgc [$n]
  (cond
    [(null? $n) "fl_nil()"]
    [(= (get $n :kind) "literal")   (cgc-literal $n)]
    [(= (get $n :kind) "variable")
      (let [[$name (get $n :name)]
            [$cn   (c-name $name)]
            [$line (get $n :line)]]
        (if (or (includes-item @known-fncall-targets-atom $cn)
                (includes-item @outer-params-atom $cn))
          $cn
          (if (includes-item @known-defns-atom $cn)
            (str "fl_fn_new(__fl_wrap_" $cn ", 0, NULL)")
            ;; 알려진 함수/변수가 아니면 경고 출력 (컴파일 시점)
            (do
              (println (str "[FL Warn] 정의되지 않은 이름: " $name
                            (if (null? $line) "" (str " (line " $line ")"))))
              $cn))))]
    [(= (get $n :kind) "keyword")   (str "fl_str_val(\"" (c-esc (get $n :name)) "\")")]
    [(= (get $n :kind) "sexpr")     (cgc-sexpr $n)]
    [(= (get $n :kind) "block")     (cgc-block $n)]
    [(= (get $n :kind) "and")       (cgc-and (get $n :args))]
    [(= (get $n :kind) "or")        (cgc-or (get $n :args))]
    [(= (get $n :kind) "try")       (cgc-try $n)]
    [(= (get $n :kind) "loop")
     (do (println (str "[CGC-ERR] unsupported IR kind=loop line=" (get $n :line)))
         (fl-cgc-halt)
         "fl_nil()")]
    [(= (get $n :kind) "template-string")
     (cgc-template (get $n :parts))]
    [(= (get $n :kind) "catch")
     (do (println (str "[CGC-ERR] unsupported IR kind=catch line=" (get $n :line)))
         (fl-cgc-halt)
         "fl_nil()")]
    [(= (get $n :kind) "throw")
     (do (println (str "[CGC-ERR] unsupported IR kind=throw line=" (get $n :line)))
         (fl-cgc-halt)
         "fl_nil()")]
    [true
     (do (println (str "[CGC-ERR] unsupported IR kind=" (get $n :kind) " line=" (get $n :line)))
         (fl-cgc-halt)
         "fl_nil()")]))

;; ── 리터럴 ──

(defn cgc-literal [$n]
  (let [[$t (get $n :type)] [$v (get $n :value)]]
  (cond
    [(= $t "number")  (if (str-includes (str $v) ".") (str "fl_float(" $v ")") (str "fl_int(" $v ")"))]
    [(= $t "string")  (str "fl_str_val(\"" (c-esc $v) "\")")]
    [(= $t "boolean") (if $v "fl_bool(true)" "fl_bool(false)")]
    [(= $t "nil")     "fl_nil()"]
    [(= $t "symbol")  (cond
                        [(= $v "true")  "fl_bool(true)"]
                        [(= $v "false") "fl_bool(false)"]
                        [(or (= $v "nil") (= $v "null")) "fl_nil()"]
                        [(= $v "json-parse") "fl_fn_new(json_parse_wrap, 0, NULL)"]
                        [true (let [[$cn (c-name $v)]]
                                (if (or (includes-item @known-fncall-targets-atom $cn)
                                        (includes-item @outer-params-atom $cn))
                                  $cn
                                  (if (includes-item @known-defns-atom $cn)
                                    (str "fl_fn_new(__fl_wrap_" $cn ", 0, NULL)")
                                    $cn)))])]
    [true
     (do (println (str "[CGC-ERR] unsupported literal type=" (get $n :type) " line=" (get $n :line)))
         "fl_nil()")])))

;; ── block (FUNC/Array/Map) ──

(defn cgc-block [$n]
  (let [[$t (get $n :type)]]
  (cond
    [(= $t "FUNC")  (cgc-func-block $n)]
    [(= $t "Array") (cgc-array-block $n)]
    [(= $t "Map")   (cgc-map-block $n)]
    [true
     (do (println (str "[CGC-ERR] unsupported block type=" $t " line=" (get $n :line)))
         "fl_nil()")])))

(defn cgc-func-block [$n]
  (let [[$name (c-name (get $n :name))]
      [$f (get $n :fields)]
      [$params-block (get $f :params)]
      [$body-node (get $f :body)]
      [$ps (cgc-params (get-block-items $params-block))]
      [$body (cgc $body-node)]]
  (str "FLValue " $name "(" $ps ") {\n    return " $body ";\n}")))

(defn cgc-params [$it]
  (cgc-params-loop $it 0 ""))
(defn cgc-params-loop [$_it $_i $_acc]
  (loop [$i $_i $acc $_acc]
    (if (>= $i (length $_it)) $acc
    (let [[$n (cgc-extract-name (get $_it $i))]
          [$entry (str "FLValue " $n)]]
      (recur (+ $i 1) (if (= (length $acc) 0) $entry (str $acc ", " $entry)))))))

(defn cgc-extract-name [$node]
  (cond
    [(= (get $node :kind) "variable") (c-name (get $node :name))]
    [(= (get $node :kind) "literal")  (c-name (str (get $node :value)))]
    [true "_anon"]))

(defn cgc-extract-raw-name [$node]
  (cond
    [(= (get $node :kind) "variable") (get $node :name)]
    [(= (get $node :kind) "literal") (str (get $node :value))]
    [true "_anon"]))

;; ── sexpr ──

;; S23: FLValue fn 동적 호출 — fl_fn_call 사용
(defn cgc-fncall [$fn-c $args]
  (let [[$argc (length $args)]
        [$id @lambda-id-atom]]
    (swap! lambda-id-atom + 1)
    (if (= $argc 0)
      (str "fl_fn_call(" $fn-c ", 0, NULL)")
      (str "(__extension__ ({ FLValue __fl_ca_" $id "[" $argc "] = {"
           (cgc-args $args) "};"
           " fl_fn_call(" $fn-c ", " $argc ", __fl_ca_" $id "); }))"))))

(defn cgc-sexpr [$n]
  (let [[$op (get $n :op)] [$args (get $n :args)]]
  (if (string? $op)
    (cgc-dispatch $op $args)
    (cgc-fncall (cgc $op) $args))))

(defn cgc-dispatch [$op $args]
  (if (not (null? (c-runtime-name $op)))
    (cgc-runtime-call $op $args)
  (if (and (includes-item ["now-iso" "str-index-of" "str-split" "str-join" "str-trim" "str-replace" "json-parse" "json-stringify" "http-get" "http-post" "file-read" "file-write" "file-append" "file-exists?" "file-size" "dir-list"] $op)
           (includes-item @known-defns-atom (c-name $op)))
    (cgc-dispatch-fallback $op $args)
    (cond
  [(= $op "if")     (cgc-if $args)]
  [(= $op "when")   (cgc-if $args)]
  [(= $op "??")      (cgc-null-coalesce $args)]
  [(= $op "case")   (cgc-case $args)]
  [(= $op "cond")   (cgc-cond $args)]
  [(= $op "do")     (cgc-do $args)]
  [(= $op "let")    (cgc-let $args)]
  [(= $op "defn")   (cgc-defn $args)]
  [(= $op "define") (cgc-define $args)]
  [(= $op "+")      (cgc-binop-chain $args "fl_add")]
  [(= $op "-")      (if (= (length $args) 1)
                      (str "fl_sub(fl_int(0), " (cgc (get $args 0)) ")")
                      (cgc-binop-chain $args "fl_sub"))]
  [(= $op "*")      (cgc-binop-chain $args "fl_mul")]
  [(= $op "/")      (str "fl_div(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "%")      (str "fl_mod(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "=")      (str "fl_eq(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "!=")     (str "fl_neq(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "not=")   (str "fl_neq(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "<")      (str "fl_lt(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op ">")      (str "fl_gt(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "<=")     (str "fl_lte(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op ">=")     (str "fl_gte(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "and")    (cgc-and $args)]
  [(= $op "or")     (cgc-or $args)]
  [(= $op "not")    (str "fl_not(" (cgc (get $args 0)) ")")]
  [(= $op "println") (str "fl_println(" (cgc-str-arg $args) ")")]
  [(= $op "print")   (str "fl_print(" (cgc-str-arg $args) ")")]
  [(= $op "str")    (cgc-str $args)]
  [(= $op "set!")   (cgc-set! $args)]
  [(= $op "while")  (cgc-while $args)]
  ;; S26: atom / deref / swap! / reset!
  [(= $op "atom")          (str "fl_atom_new(" (cgc (get $args 0)) ")")]
  [(= $op "deref")         (str "fl_atom_deref(" (cgc (get $args 0)) ")")]
  [(= $op "reset!")        (str "fl_atom_reset(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "swap!")         (cgc-swap! $args)]
  ;; S26: stdlib 매핑
  [(= $op "includes-item")  (str "fl_includes_item(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(or (= $op "str-includes") (= $op "str-contains")) (str "fl_str_includes(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "str-blank?") (cgc-str-blank? $args)]
  [(= $op "str-starts-with") (str "fl_str_starts_with(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "str-ends-with")   (str "fl_str_ends_with(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "string?")         (str "fl_string_p(" (cgc (get $args 0)) ")")]
  [(= $op "obj-entries")     (str "fl_map_entries(" (cgc (get $args 0)) ")")]
  ;; S28: stdlib 커버리지 확장 (N-시리즈 P2)
  ;; 컬렉션 기본
  [(= $op "length")      (str "length(" (cgc (get $args 0)) ")")]
  [(= $op "count")       (str "length(" (cgc (get $args 0)) ")")]
  [(= $op "get")         (str "get(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "assoc")       (str "fl_map_set(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ", " (cgc (get $args 2)) ")")]
  [(= $op "dissoc")      (str "dissoc(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "reverse")     (str "reverse(" (cgc (get $args 0)) ")")]
  [(= $op "sort")        (str "sort(" (cgc (get $args 0)) ")")]
  [(= $op "sort-by")     (str "fl_sort_by(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "range")       (cgc-range $args)]
  [(= $op "max")         (cgc-extrema $args "max")]
  [(= $op "min")         (cgc-extrema $args "min")]
  [(= $op "take")        (str "take(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "drop")        (str "drop(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "last")        (str "fl_vec_last(" (cgc (get $args 0)) ")")]
  [(= $op "nth")         (str "get(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "concat")      (str "fl_concat(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "uuid")        "uuid()"]
  ;; 맵 ops
  [(= $op "obj-merge")   (str "fl_map_merge(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "obj-pick")    (str "select_keys(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "obj-omit")    (str "fl_obj_omit(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "obj-values")  (str "vals(" (cgc (get $args 0)) ")")]
  [(= $op "vals")        (str "vals(" (cgc (get $args 0)) ")")]
  [(= $op "entries")     (str "entries(" (cgc (get $args 0)) ")")]
  [(= $op "get-in")      (str "fl_get_in(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "map-vals")    (str "fl_map_vals_fn(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  ;; 문자열 ops
  [(or (= $op "str-split") (= $op "_fl_str_split"))    (str "str_split(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "str-slice")    (str "substring(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ", " (cgc (get $args 2)) ")")]
  [(= $op "str-to-upper") (str "str_to_upper(" (cgc (get $args 0)) ")")]
  [(= $op "str-to-lower") (str "str_to_lower(" (cgc (get $args 0)) ")")]
  [(or (= $op "str-trim") (= $op "_fl_str_trim"))     (str "str_trim(" (cgc (get $args 0)) ")")]
  [(= $op "str-pad-left") (str "str_pad_left(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ", " (cgc (get $args 2)) ")")]
  [(= $op "str-pad-right")(str "str_pad_right(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ", " (cgc (get $args 2)) ")")]
  [(or (= $op "str-index-of") (= $op "_fl_str_index_of")) (str "str_index_of(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "str-repeat")   (str "str_repeat(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "str-length")   (str "length(" (cgc (get $args 0)) ")")]
  [(= $op "str-to-num")   (str "fl_str_to_num(" (cgc (get $args 0)) ")")]
  [(= $op "html-escape")  (str "fl_html_escape(" (cgc (get $args 0)) ")")]
  ;; 타입 술어
  [(= $op "number?")      (str "fl_number_p(" (cgc (get $args 0)) ")")]
  [(= $op "boolean?")     (str "fl_boolean_p(" (cgc (get $args 0)) ")")]
  [(= $op "integer?")     (str "fl_integer_p(" (cgc (get $args 0)) ")")]
  [(= $op "float?")       (str "fl_float_p(" (cgc (get $args 0)) ")")]
  [(= $op "array?")       (str "fl_array_p(" (cgc (get $args 0)) ")")]
  [(= $op "vector?")      (str "fl_array_p(" (cgc (get $args 0)) ")")]
  [(= $op "map?")         (str "fl_map_p(" (cgc (get $args 0)) ")")]
  [(= $op "fn?")          (str "fl_fn_p(" (cgc (get $args 0)) ")")]
  [(= $op "type-of")      (str "type_of(" (cgc (get $args 0)) ")")]
  [(= $op "empty?")       (cgc-empty? $args)]
  [(= $op "not-empty?")   (str "fl_not_empty_p(" (cgc (get $args 0)) ")")]
  [(= $op "nil-or-empty?") (str "fl_nil_or_empty_p(" (cgc (get $args 0)) ")")]
  [(= $op "loop")   (cgc-loop $args)]
  [(= $op "recur")  "/* orphan recur */ fl_nil()"]
  ;; S15: collection ops → 기존 fl_* 직접 매핑
  [(= $op "map")         (str "fl_map_fn(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "filter")      (str "fl_filter_fn(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "reduce")      (str "fl_reduce_fn(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ", " (cgc (get $args 2)) ")")]
  [(= $op "append")      (str "fl_vec_push(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "push")        (str "fl_vec_push(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  ;; task-native-stdlib-gap P1: 기존 C 구현 dispatch 연결
  [(= $op "flatten")     (str "flatten(" (cgc (get $args 0)) ")")]
  [(= $op "flatten-1")   (str "flatten(" (cgc (get $args 0)) ")")]
  [(= $op "distinct")    (str "distinct(" (cgc (get $args 0)) ")")]
  [(= $op "zip")         (str "zip(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "zip-with")    (str "zip(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "group-by")    (str "group_by(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "frequencies") (str "frequencies(" (cgc (get $args 0)) ")")]
  ;; P1: 신규 C 구현 함수
  [(= $op "every?")      (str "fl_every_p(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "any?")        (str "fl_any_p(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "none?")       (str "fl_none_p(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "find-first")  (str "fl_find_first(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "count-if")    (str "fl_count_if(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "repeat")      (str "fl_repeat(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "map-indexed") (str "fl_map_indexed(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "mapcat")      (str "fl_mapcat(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "keep")        (str "fl_keep(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "comp")        (str "fl_comp(" (cgc-args $args) ", " (length $args) ")")]
  [(= $op "conj")        (str "fl_conj(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "into")        (str "fl_into(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "keys")        (str "fl_map_keys(" (cgc (get $args 0)) ")")]
  [(= $op "obj-keys")    (str "fl_map_keys(" (cgc (get $args 0)) ")")]
  [(= $op "map-entries") (str "fl_map_entries(" (cgc (get $args 0)) ")")]
  [(= $op "null?")        (str "null_p(" (cgc (get $args 0)) ")")]
  [(= $op "nil?")         (str "null_p(" (cgc (get $args 0)) ")")]
  ;; N-12: 미커버리지 완전 해소
  [(= $op "char-at")      (str "char_at(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "char-from-byte") (str "char_from_byte(" (cgc (get $args 0)) ")")]
  [(= $op "char-code-at") (str "char_code_at(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  ;; S15: math/time — C stdlib 충돌 방지용 fl_ 접두사
  [(= $op "floor")       (str "fl_floor(" (cgc (get $args 0)) ")")]
  [(= $op "ceil")        (str "fl_ceil(" (cgc (get $args 0)) ")")]
  [(= $op "abs")         (str "fl_abs(" (cgc (get $args 0)) ")")]
  [(= $op "math-sqrt")   (str "fl_math_sqrt(" (cgc (get $args 0)) ")")]
  [(= $op "now")         "fl_now()"]
  [(= $op "now-ms")      "fl_now_ms()"]
  [(or (= $op "str-join") (= $op "_fl_str_join"))    (str "fl_str_join(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "str-replace") (str "str_replace(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ", " (cgc (get $args 2)) ")")]
  [(= $op "substring")   (str "substring(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ", " (cgc (get $args 2)) ")")]
  [(= $op "trim")        (str "trim(" (cgc (get $args 0)) ")")]
  [(= $op "slice")       (str "substring(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ", " (cgc (get $args 2)) ")")]
  ;; S16: list vararg → fl_vec_from, _fl-map-set alias
  [(= $op "list")        (cgc-list $args)]
  [(= $op "_fl_map_set") (str "fl_map_set(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ", " (cgc (get $args 2)) ")")]
  ;; S17: _fl_* dispatch 정규화 — file ops
  [(= $op "dir-list")        (str "dir_list(" (cgc (get $args 0)) ")")]
  [(= $op "_fl_file_read")    (str "fl_file_read(" (cgc (get $args 0)) ")")]
  [(= $op "_fl_file_write")   (str "fl_file_write(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "file-read")        (str "fl_file_read(" (cgc (get $args 0)) ")")]
  [(= $op "file-write")       (str "fl_file_write(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "file-exists")      (str "file_exists(" (cgc (get $args 0)) ")")]
  [(= $op "file_exists")      (str "file_exists(" (cgc (get $args 0)) ")")]
  ;; N-11: 파일 ops — stub → 실제 구현
  [(= $op "_fl_file_append")  (str "_fl_file_append(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "file-append")      (str "_fl_file_append(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "_fl_file_copy")    (str "_fl_file_copy(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "_fl_file_delete")  (str "_fl_file_delete(" (cgc (get $args 0)) ")")]
  [(= $op "file-delete")      (str "_fl_file_delete(" (cgc (get $args 0)) ")")]
  [(= $op "_fl_file_mkdir")   (str "_fl_file_mkdir(" (cgc (get $args 0)) ")")]
  [(= $op "file-mkdir")       (str "_fl_file_mkdir(" (cgc (get $args 0)) ")")]
  [(= $op "_fl_file_rmdir")   (str "_fl_file_rmdir(" (cgc (get $args 0)) ")")]
  [(= $op "_fl_file_list")    (str "_fl_file_list(" (cgc (get $args 0)) ")")]
  [(= $op "file-list")        (str "_fl_file_list(" (cgc (get $args 0)) ")")]
  [(= $op "_fl_file_size")    (str "_fl_file_size(" (cgc (get $args 0)) ")")]
  [(= $op "_fl_file_modified")(str "_fl_file_modified(" (cgc (get $args 0)) ")")]
  [(= $op "_fl_file_rename")  (str "_fl_file_rename(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "_fl_file_is_file") (str "_fl_file_is_file(" (cgc (get $args 0)) ")")]
  [(= $op "file-is-file?")    (str "_fl_file_is_file(" (cgc (get $args 0)) ")")]
  [(= $op "_fl_file_is_dir")  (str "_fl_file_is_dir(" (cgc (get $args 0)) ")")]
  [(= $op "file-is-dir?")     (str "_fl_file_is_dir(" (cgc (get $args 0)) ")")]
  ;; N-11: env / process — stub → 실제 구현
  [(= $op "_fl_env_get")           (str "_fl_env_get(" (cgc (get $args 0)) ")")]
  [(= $op "env-get")               (str "_fl_env_get(" (cgc (get $args 0)) ")")]
  [(= $op "_fl_env_set")           (str "_fl_env_set(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "_fl_env_all")           "_fl_env_all()"]
  [(= $op "_fl_process_run")       (str "_fl_process_run(" (cgc (get $args 0)) ")")]
  [(= $op "process-run")           (str "_fl_process_run(" (cgc (get $args 0)) ")")]
  [(= $op "_fl_process_run_args")  (str "_fl_process_run_args(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "_fl_process_exec")      (str "_fl_process_exec(" (cgc (get $args 0)) ")")]
  [(= $op "_fl_process_exec_args") (str "_fl_process_exec_args(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "_fl_process_spawn")     (str "_fl_process_spawn(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "process_spawn")         (str "process_spawn(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "process-spawn")         (str "process_spawn(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "_fl_test_isolate")       (str "_fl_test_isolate(" (cgc (get $args 0)) ")")]
  [(= $op "_fl_exit")               (str "_fl_exit(" (cgc (get $args 0)) ")")]
  [(= $op "capability-list")       "capability_list()"]
  [(= $op "capability-enable")     (str "capability_enable(" (cgc (get $args 0)) ")")]
  [(= $op "capability-disable")    (str "capability_disable(" (cgc (get $args 0)) ")")]
  [(= $op "capability-enabled?")   (str "capability_enabled_p(" (cgc (get $args 0)) ")")]
  [(= $op "git_status")            (str "git_status(" (cgc (get $args 0)) ")")]
  [(= $op "git-status")            (str "git_status(" (cgc (get $args 0)) ")")]
  [(= $op "git_head")              (str "git_head(" (cgc (get $args 0)) ")")]
  [(= $op "git-head")              (str "git_head(" (cgc (get $args 0)) ")")]
  [(= $op "git_branch")            (str "git_branch(" (cgc (get $args 0)) ")")]
  [(= $op "git-branch")            (str "git_branch(" (cgc (get $args 0)) ")")]
  [(= $op "git_diff_name_only")    (str "git_diff_name_only(" (cgc (get $args 0)) ")")]
  [(= $op "git-diff-name-only")    (str "git_diff_name_only(" (cgc (get $args 0)) ")")]
  [(= $op "http_get")              (str "http_get(" (cgc (get $args 0)) ")")]
  [(= $op "shell_cwd")             "shell_cwd()"]
  [(= $op "shell-cwd")             "shell_cwd()"]
  [(= $op "_fl_process_kill")      (str "_fl_process_kill(" (cgc (get $args 0)) ")")]
  [(= $op "_fl_process_wait")      (str "_fl_process_wait(" (cgc (get $args 0)) ")")]
  [(= $op "_fl_process_exists")    (str "_fl_process_exists(" (cgc (get $args 0)) ")")]
  [(= $op "_fl_process_getcwd")    "_fl_process_getcwd()"]
  [(= $op "process-cwd")           "_fl_process_getcwd()"]
  [(= $op "_fl_process_chdir")     (str "_fl_process_chdir(" (cgc (get $args 0)) ")")]
  [(= $op "_fl_process_pid")       "_fl_process_pid()"]
  [(= $op "process-pid")           "_fl_process_pid()"]
  [(= $op "_fl_process_ppid")      "_fl_process_ppid()"]
  [(= $op "_fl_run_inherit")       (str "_fl_run_inherit(" (cgc (get $args 0)) ")")]
  [(= $op "run-inherit")           (str "_fl_run_inherit(" (cgc (get $args 0)) ")")]
  [(= $op "cli-args")              "fl_get_argv()"]
  [(= $op "get-arg")               (str "get_arg(" (cgc (get $args 0)) ")")]
  [(= $op "get_arg")               (str "get_arg(" (cgc (get $args 0)) ")")]
  [(= $op "sys:args")              "sys_args()"]
  [(= $op "sys-args")              "sys_args()"]
  [(= $op "bit-xor") (str "fl_bit_xor(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "bit-and") (str "fl_bit_and(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "bit-or")  (str "fl_bit_or("  (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "bit-shl") (str "fl_bit_shl(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "bit-shr") (str "fl_bit_shr(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  ;; S17: json — 타입 안전 stub (S18에서 실 구현)
  [(= $op "json-parse")
    (if (includes-item @known-defns-atom (c-name $op))
      (cgc-dispatch-fallback $op $args)
      (str "fl_json_parse(" (cgc (get $args 0)) ")"))]
  [(= $op "json-stringify")
    (if (includes-item @known-defns-atom (c-name $op))
      (cgc-dispatch-fallback $op $args)
      (str "fl_json_stringify(" (cgc (get $args 0)) ")"))]
  ;; 병렬 실행
  [(= $op "run-parallel")      (str "fl_run_parallel(" (cgc (get $args 0)) ", " (if (>= (length $args) 2) (cgc (get $args 1)) "fl_int(0)") ")")]
  ;; HTTP 클라이언트 (libcurl) — {:status N :body "..." :headers {}}
  [(= $op "http-get")          (str "fl_http_get(" (cgc (get $args 0)) ")")]
  [(= $op "http-post")         (str "fl_http_post(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ", " (cgc (get $args 2)) ")")]
  [(= $op "http-get-headers")  (str "fl_http_get_headers(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "http-post-headers") (str "fl_http_post_headers(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ", " (cgc (get $args 2)) ")")]
  [(= $op "http-post-stream")     (str "fl_http_post_stream(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ", " (cgc (get $args 2)) ", " (cgc (get $args 3)) ")")]
  [(= $op "http-stream-collect") (str "fl_http_stream_collect(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ", " (cgc (get $args 2)) ")")]
  ;; 유틸 — sleep/now
  [(= $op "sleep")   (str "fl_sleep_ms(" (cgc (get $args 0)) ")")]
  [(= $op "now-ms")  "fl_now_ms()"]
  [(= $op "now_iso") "fl_now_iso()"]
  [(= $op "now-iso") "fl_now_iso()"]
  [(= $op "text")
   (if (>= (length $args) 1)
     (str "fl_text(" (cgc (get $args 0)) ")")
     "fl_str_val(\"\")")]
  [(= $op "shell_env") (str "shell_env(" (cgc (get $args 0)) ")")]
  [(= $op "throw")
   (str "(__extension__ ({ fl_throw("
        (if (>= (length $args) 1) (cgc (get $args 0)) "fl_nil()")
        "); fl_nil(); }))")]
  [(= $op "error")
   (str "(__extension__ ({ fl_throw("
        (if (>= (length $args) 1) (cgc (get $args 0)) "fl_str_val(\"error\")")
        "); fl_nil(); }))")]
  [(= $op "is")     (str "fl_is(" (cgc (get $args 0)) ")")]
  [(= $op "is=")    (str "is_eq(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "deftest") (cgc-deftest $args)]
  [(= $op "run-tests") "run_tests()"]
  [(= $op "test-summary") "test_summary()"]
  [(= $op "try-call") (str "try_call(" (cgc (get $args 0)) ")")]
  [(= $op "try_call") (str "try_call(" (cgc (get $args 0)) ")")]
  [(= $op "err?")    (str "err_p(" (cgc (get $args 0)) ")")]
  [(= $op "ok?")     (str "ok_p(" (cgc (get $args 0)) ")")]
  [(= $op "unwrap")  (str "unwrap_result(" (cgc (get $args 0)) ")")]
  [(= $op "contains?") (str "contains_p(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "json_has") (str "json_has(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "catch")
   (do (println "[CGC-ERR] catch outside try")
       (fl-cgc-halt)
       "fl_nil()")]
  ;; N-05: HTTP 서버
  [(= $op "server-start")       (str "fl_http_start(" (cgc (get $args 0)) ")")]
  [(= $op "server-stop")        "fl_http_stop()"]
  [(= $op "server-html")        (str "fl_resp_html(" (cgc (get $args 0)) ")")]
  [(= $op "server-json")        (str "fl_resp_json(" (cgc (get $args 0)) ")")]
  [(= $op "server-status")      (str "fl_resp_status(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "server-redirect")    (str "fl_resp_redirect(" (cgc (get $args 0)) ")")]
  [(= $op "server-html-cookie") (str "fl_resp_html_cookie(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "server-set-cookie")  (str "fl_resp_set_cookie(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ", " (cgc (get $args 2)) ")")]
  [(= $op "server-route")       (str "fl_http_route(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ", " (cgc (get $args 2)) ")")]
  [(= $op "server-get")         (str "fl_http_route(fl_str_val(\"GET\"), " (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "server-post")        (str "fl_http_route(fl_str_val(\"POST\"), " (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  ;; N-06: SQLite3 DB
  [(= $op "db-open")   (str "fl_db_open(" (cgc (get $args 0)) ")")]
  [(= $op "db-close")  (str "fl_db_close(" (cgc (get $args 0)) ")")]
  [(= $op "db-query")  (str "fl_db_query(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ", " (cgc (get $args 2)) ")")]
  [(= $op "db-exec")   (str "fl_db_exec("  (cgc (get $args 0)) ", " (cgc (get $args 1)) ", " (cgc (get $args 2)) ")")]
  ;; S19: fn lambda → static FLClosure 추출
  [(= $op "fn")      (cgc-fn $args)]
  [(= $op "cg-and")  (str "fl_and(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "cg-or")   (str "fl_or(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "cg-match")"fl_nil()"]
  ;; N-09: 암호화 / JWT / 비밀번호
  [(= $op "auth-jwt-sign")       (str "fl_jwt_sign(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ", " (cgc (get $args 2)) ")")]
  [(= $op "auth-jwt-verify")     (str "fl_jwt_verify(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "auth-jwt-expired")    (str "fl_jwt_expired(" (cgc (get $args 0)) ")")]
  [(= $op "auth-jwt-decode")     (str "fl_jwt_verify(" (cgc (get $args 0)) ", fl_str_val(\"\"))")]
  [(= $op "auth-hash-password")  (str "fl_hash_password(" (cgc (get $args 0)) ")")]
  [(= $op "auth-verify-password")(str "fl_verify_password(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [true             (cgc-dispatch-fallback $op $args)]))))

(defn cgc-swap! [$args]
  (let [[$atom-c  (cgc (get $args 0))]
        [$fn-node (get $args 1)]
        [$extra   (slice $args 2 (length $args))]]
    (let [[$deref (str "fl_atom_deref(" $atom-c ")")]
          [$op    (get $fn-node :value)]
          [$ec    (cgc-args $extra)]]
      (let [[$rhs (cond
                    [(= $op "+")    (str "fl_add(" $deref ", " $ec ")")]
                    [(= $op "-")    (str "fl_sub(" $deref ", " $ec ")")]
                    [(= $op "*")    (str "fl_mul(" $deref ", " $ec ")")]
                    [(= $op "push") (str "fl_vec_push(" $deref ", " $ec ")")]
                    [true           (str (c-name $op) "(" $deref
                                      (if (= (length $extra) 0) "" (str ", " $ec)) ")")]
                  )]]
        (str "fl_atom_reset(" $atom-c ", " $rhs ")")))))

(defn cgc-dispatch-fallback [$op $args]
  (cond
    [(= $op "first")  (str "fl_vec_first(" (cgc (get $args 0)) ")")]
    [(= $op "rest")   (str "fl_vec_rest(" (cgc (get $args 0)) ")")]
    [true
     (let [[$cn (c-name $op)]]
       (if (includes-item @known-fncall-targets-atom $cn)
         (cgc-fncall $cn $args)
         (str $cn "(" (cgc-args $args) ")")))]))

;; ── S19/S20: fn lambda → static FLClosure 추출 (capture 지원) ──

;; argv[i] 선언 구문
(defn cgc-fn-argv-decls [$items $i $acc]
  (if (>= $i (length $items)) $acc
  (let [[$name (c-name (cgc-extract-raw-name (get $items $i)))]]
    (cgc-fn-argv-decls $items (+ $i 1)
      (str $acc "    FLValue " $name " __attribute__((unused)) = argv[" $i "];\n")))))

;; 파라미터 이름 목록 수집
(defn cgc-fn-param-names [$items $i $acc]
  (if (>= $i (length $items)) $acc
  (cgc-fn-param-names $items (+ $i 1)
    (push $acc (c-name (cgc-extract-raw-name (get $items $i)))))))

;; body AST에서 variable 이름 수집 (중복 제거)
(defn cgc-collect-vars [$node $acc]
  (cond
    [(null? $node) $acc]
    [(= (get $node :kind) "variable")
     (let [[$n (c-name (get $node :name))]]
       (if (includes-item $acc $n) $acc (push $acc $n)))]
    [(= (get $node :kind) "try")
     (cgc-collect-vars (get $node :finally)
       (cgc-collect-vars (get $node :catch)
         (cgc-collect-vars (get $node :body) $acc)))]
    [(and (= (get $node :kind) "literal") (= (get $node :type) "symbol"))
     (let [[$n (c-name (get $node :value))]]
       (if (or (= $n "") (includes-item $acc $n)) $acc (push $acc $n)))]
    [(= (get $node :kind) "sexpr")
     (cgc-collect-vars-loop (get $node :args) 0 $acc)]
    [(= (get $node :kind) "block")
     (if (= (get $node :type) "Map")
       (let [[$items (get (get $node :fields) :items)]]
         (cgc-collect-vars-loop (if (null? $items) [] $items) 0 $acc))
       (cgc-collect-vars-loop (get-block-items $node) 0 $acc))]
    [(= (get $node :kind) "and")
     (cgc-collect-vars-loop (get $node :args) 0 $acc)]
    [(= (get $node :kind) "or")
     (cgc-collect-vars-loop (get $node :args) 0 $acc)]
    [true $acc]))

(defn cgc-collect-vars-loop [$_args $_i $_acc]
  (loop [$i $_i $acc $_acc]
    (if (or (null? $_args) (>= $i (length $_args))) $acc
    (recur (+ $i 1) (cgc-collect-vars (get $_args $i) $acc)))))

;; _self->env[i] 복원 구문
(defn cgc-fn-env-decls [$_caps $_i $_acc]
  (loop [$i $_i $acc $_acc]
    (if (>= $i (length $_caps)) $acc
    (recur (+ $i 1)
      (str $acc "    FLValue " (get $_caps $i) " = _self->env[" $i "];\n")))))

;; 캡처 변수 배열 표현식 "v1, v2"
(defn cgc-env-arr [$_caps $_i $_acc]
  (loop [$i $_i $acc $_acc]
    (if (>= $i (length $_caps)) $acc
    (recur (+ $i 1)
      (if (= $i 0) (get $_caps 0) (str $acc ", " (get $_caps $i)))))))

;; 캡처 후보 필터 (closure 대신 loop — self-host 캡처 분석 회피)
(defn cgc-fn-caps-filter [$all-vars $param-names $outer $i $acc]
  (if (>= $i (length $all-vars))
    $acc
    (let [[$v (get $all-vars $i)]]
      (cgc-fn-caps-filter $all-vars $param-names $outer (+ $i 1)
        (if (and (not (includes-item $param-names $v))
                 (includes-item $outer $v))
          (push $acc $v)
          $acc)))))

(defn cgc-outer-push [$names]
  (cgc-outer-push-loop $names 0))

(defn cgc-outer-push-loop [$names $i]
  (if (>= $i (length $names)) nil
    (do
      (swap! outer-params-atom push (get $names $i))
      (cgc-outer-push-loop $names (+ $i 1)))))

(defn cgc-try-catch-param [$catch]
  (if (null? $catch) "error"
    (if (= (get $catch :kind) "catch")
      (c-name (get $catch :param))
      (if (= (get $catch :kind) "sexpr")
        (let [[$args (get $catch :args)]]
          (if (>= (length $args) 1)
            (let [[$p (get $args 0)]]
              (if (= (get $p :kind) "variable") (c-name (get $p :name))
                (if (= (get $p :kind) "literal") (c-name (get $p :value)) "error")))
            "error"))
        "error"))))

(defn cgc-try-catch-body [$catch]
  (if (null? $catch) "fl_nil()"
    (if (= (get $catch :kind) "catch")
      (cgc (get $catch :body))
      (if (= (get $catch :kind) "sexpr")
        (let [[$args (get $catch :args)]]
          (if (>= (length $args) 2) (cgc (get $args 1)) "fl_nil()"))
        "fl_nil()"))))

(defn cgc-try [$n]
  (let [[$id @lambda-id-atom]
        [$body (get $n :body)]
        [$catch (get $n :catch)]
        [$finally (get $n :finally)]
        [$pname (cgc-try-catch-param $catch)]
        [$cbody (cgc-try-catch-body $catch)]
        [$fbody (if (null? $finally) "" (str (cgc $finally) "; "))]
        [$tbody (cgc $body)]]
    (swap! lambda-id-atom + 1)
    (str "(__extension__ ({ FLValue __fl_try_r_" $id ";"
         " if (fl_try_top >= 64) { fl_throw(fl_str_val(\"try nest overflow\")); }"
         " if (setjmp(fl_try_stack[fl_try_top].buf) == 0) {"
         " fl_try_top++; __fl_try_r_" $id " = " $tbody "; fl_try_top--; }"
         " else { fl_try_top--; FLValue " $pname " = fl_try_stack[fl_try_top].err;"
         " __fl_try_r_" $id " = " $cbody "; }"
         $fbody " __fl_try_r_" $id "; }))")))

(defn cgc-tpl-env-loop [$names $i $acc]
  (if (>= $i (length $names)) $acc
    (let [[$n (get $names $i)]]
      (cgc-tpl-env-loop $names (+ $i 1)
        (str $acc " __fl_te = fl_map_set(__fl_te, fl_str_val(\"" $n "\"), " $n ");")))))

(defn cgc-template [$raw]
  (let [[$s (if (string? $raw) $raw "")]
        [$names @outer-params-atom]
        [$env (cgc-tpl-env-loop $names 0 "FLValue __fl_te = fl_map_new();")]]
    (str "(__extension__ ({ " $env
         " fl_template_bound(fl_str_val(\"" (c-esc $s) "\"), __fl_te); }))")))

(defn cgc-deftest [$args]
  (let [[$id @lambda-id-atom]
        [$name (if (>= (length $args) 1) (cgc (get $args 0)) "fl_str_val(\"(anonymous)\")")]
        [$body (if (>= (length $args) 2)
                 (cgc-body (slice $args 1 (length $args)) 0 "")
                 "fl_nil()")]]
    (swap! lambda-id-atom + 1)
    (str "(__extension__ ({ FLValue __fl_tname_" $id " = " $name ";"
         " if (fl_try_top >= 64) { fl_throw(fl_str_val(\"try nest overflow\")); }"
         " if (setjmp(fl_try_stack[fl_try_top].buf) == 0) {"
         " fl_try_top++; " $body "; fl_try_top--;"
         " fl_test_pass(__fl_tname_" $id "); }"
         " else { fl_try_top--; fl_test_fail(__fl_tname_" $id ", fl_try_stack[fl_try_top].err); }"
         " fl_nil(); }))")))

(defn cgc-fn [$args]
  (let [[$id @lambda-id-atom]
        [$_inc (swap! lambda-id-atom + 1)]
        [$param-items (get-block-items (get $args 0))]
        [$param-names (cgc-fn-param-names $param-items 0 [])]
        [$saved @outer-params-atom]
        [$saved-fncall-targets @known-fncall-targets-atom]
        [$_push (cgc-outer-push $param-names)]
        [$body-node (get $args 1)]
        [$all-vars (cgc-collect-vars $body-node [])]
        [$bound (cgc-bind-names $param-names)]
        [$outer @outer-params-atom]
        [$caps (cgc-fn-caps-filter $all-vars $param-names $saved 0 [])]
        [$nenv (length $caps)]
        [$env-decls (cgc-fn-env-decls $caps 0 "")]
        [$body-c (cgc $body-node)]
        [$_restore-fncall-targets (reset! known-fncall-targets-atom $saved-fncall-targets)]
        [$_restore (reset! outer-params-atom $saved)]
        [$decls (cgc-fn-argv-decls $param-items 0 "")]
        [$fn-name (str "__fl_anon_" $id)]]
    (do
      (swap! lambda-defs-atom push
        (str "static FLValue " $fn-name
             "(FLClosure* _self, int _argc, FLValue* argv) {\n"
             "    (void)_self; (void)_argc;\n"
             $env-decls
             $decls
             "    return " $body-c ";\n}"))
      (if (= $nenv 0)
        (str "fl_fn_new(" $fn-name ", 0, NULL)")
        (str "(__extension__ ({ FLValue __env_" $id "[" $nenv "] = {"
             (cgc-env-arr $caps 0 "") "};"
             " fl_fn_new(" $fn-name ", " $nenv ", __env_" $id "); }))")))))

;; ── list (vararg → fl_vec_from) ──

(defn cgc-list [$args]
  (if (= (length $args) 0)
    "fl_vec_new()"
    (let [[$cnt (length $args)]
          [$vals (cgc-args $args)]]
      (str "(__extension__ ({ FLValue __fl_lst[" $cnt "] = {" $vals "};"
           " fl_vec_from(__fl_lst, " $cnt "); }))"))))

;; ── str 특수 처리 (n인자 → fl_str_n) ──

(defn cgc-str [$args]
  (let [[$n (length $args)]]
  (if (= $n 0) "fl_str_val(\"\")"
    (if (= $n 1) (str "fl_str_n(1, " (cgc (get $args 0)) ")")
      (str "fl_str_n(" $n ", " (cgc-args $args) ")")))))

(defn cgc-str-arg [$args]
  (if (= (length $args) 1)
    (cgc (get $args 0))
    (cgc-str $args)))

;; ── case ──
;; bootstrap.js: 첫 인자를 한 번 평가하고, 짝을 === 로 비교한다.
;; 맞는 본문만 평가한다. 짝이 끝난 뒤 인자가 하나 남으면 기본값이다.
;; 맞지 않고 기본값도 없으면 null.

(defn cgc-case-expr [$node $mode $vars]
  (if (= $mode "wr")
    (cgc-with-recur $node $vars)
    (cgc $node)))

(defn cgc-case-step [$args $i $id $mode $vars]
  (let [[$n (length $args)]]
    (if (>= $i $n) ""
      (if (< $i (- $n 1))
        (str "if (!__fl_case_hit_" $id ") { FLValue __fl_case_k_" $id "_" $i " = " (cgc (get $args $i)) "; "
             "if (fl_truthy(fl_eq(__fl_case_v_" $id ", __fl_case_k_" $id "_" $i "))) { "
             "__fl_case_r_" $id " = " (cgc-case-expr (get $args (+ $i 1)) $mode $vars) "; "
             "__fl_case_hit_" $id " = 1; } } "
             (cgc-case-step $args (+ $i 2) $id $mode $vars))
        (if (= $i (- $n 1))
          (str "if (!__fl_case_hit_" $id ") __fl_case_r_" $id " = "
               (cgc-case-expr (get $args $i) $mode $vars) "; ")
          "")))))

(defn cgc-case-emit [$args $mode $vars]
  (if (= (length $args) 0) "fl_nil()"
    (let [[$id @lambda-id-atom]]
      (swap! lambda-id-atom + 1)
      (str "(__extension__ ({ FLValue __fl_case_v_" $id " = " (cgc (get $args 0)) ";"
           " FLValue __fl_case_r_" $id " = fl_nil();"
           " int __fl_case_hit_" $id " = 0; "
           "(void)__fl_case_v_" $id "; (void)__fl_case_hit_" $id "; "
           (cgc-case-step $args 1 $id $mode $vars)
           " __fl_case_r_" $id "; }))"))))

(defn cgc-case [$args]
  (cgc-case-emit $args "plain" []))

(defn cgc-case-wr [$args $vars]
  (cgc-case-emit $args "wr" $vars))

;; ── if ──

(defn cgc-if [$args]
  (let [[$cond (cgc (get $args 0))]
        [$then (cgc (get $args 1))]
        [$else (if (>= (length $args) 3) (cgc (get $args 2)) "fl_nil()")]]
  (str "(fl_truthy(" $cond ") ? " $then " : " $else ")")))

(defn cgc-null-coalesce [$args]
  (let [[$id @lambda-id-atom]
        [$left (cgc (get $args 0))]
        [$right (cgc (get $args 1))]
        [$temp (str "__fl_coalesce_" $id)]]
    (swap! lambda-id-atom + 1)
    (str "(__extension__ ({ FLValue " $temp " = " $left "; fl_truthy(null_p(" $temp ")) ? " $right " : " $temp "; }))")))

(defn cgc-empty? [$args]
  (let [[$id @lambda-id-atom]
        [$value (cgc (get $args 0))]
        [$temp (str "__fl_empty_" $id)]]
    (swap! lambda-id-atom + 1)
    (str "(__extension__ ({ FLValue " $temp " = " $value "; fl_truthy(fl_map_p(" $temp ")) ? fl_eq(length(fl_map_keys(" $temp ")), fl_int(0)) : fl_eq(length(" $temp "), fl_int(0)); }))")))

(defn cgc-str-blank? [$args]
  (let [[$id @lambda-id-atom]
        [$value (cgc (get $args 0))]
        [$temp (str "__fl_blank_" $id)]]
    (swap! lambda-id-atom + 1)
    (str "(__extension__ ({ FLValue " $temp " = " $value "; fl_or(null_p(" $temp "), fl_eq(str_trim(" $temp "), fl_str_val(\"\"))); }))")))

;; ── cond ──

(defn cgc-cond [$args]
  (if (= (length $args) 0) "fl_nil()"
  (let [[$first (get $args 0)]
        [$nested (and (= (get $first :kind) "block") (= (get $first :type) "Array"))]]
    (if $nested
      (cgc-cond-nested $args (- (length $args) 1) "fl_nil()")
      "fl_nil()"))))

(defn cgc-cond-nested [$args $i $acc]
  (if (< $i 0) $acc
  (let [[$items (get-block-items (get $args $i))]
        [$test (get $items 0)]
        [$body (get $items 1)]
        [$is-else (and (= (get $test :kind) "literal")
                       (or (= (get $test :value) true) (= (get $test :value) "true")))]]
    (cgc-cond-nested $args (- $i 1)
      (if $is-else
        (cgc $body)
        (str "(fl_truthy(" (cgc $test) ") ? " (cgc $body) " : " $acc ")"))))))

;; ── do ──

(defn cgc-do [$args]
  (str "(__extension__ ({ " (cgc-stmts $args 0 "") " }))"))

;; ── let ──

(defn cgc-let [$args]
  (let [[$items (get-block-items (get $args 0))]
        [$first (get $items 0)]
        [$nested (and (= (get $first :kind) "block") (= (get $first :type) "Array"))]
        [$saved @outer-params-atom]
        [$decls (if $nested (cgc-let-2d $items 0 "") (cgc-let-1d $items 0 ""))]
        [$body (cgc-body (slice $args 1 (length $args)) 0 "")]
        [$_restore (reset! outer-params-atom $saved)]]
  (str "((__extension__ ({\n" $decls "    " $body ";\n})))")))

(defn cgc-let-1d [$it $i $acc]
  (if (>= $i (length $it)) $acc
  (let [[$n (cgc-extract-name (get $it $i))]
        [$v (cgc (get $it (+ $i 1)))]
        [$attr (if (str-starts-with $n "_") " __attribute__((unused))" "")]]
    (swap! known-fncall-targets-atom push $n)
    (swap! outer-params-atom push $n)
    (cgc-let-1d $it (+ $i 2) (str $acc "    FLValue " $n $attr " = " $v ";\n")))))

(defn cgc-let-2d [$it $i $acc]
  (if (>= $i (length $it)) $acc
  (let [[$p    (get-block-items (get $it $i))]
        [$n    (cgc-extract-name (get $p 0))]
        [$v    (cgc (get $p 1))]
        [$attr (if (str-starts-with $n "_") " __attribute__((unused))" "")]]
    (swap! known-fncall-targets-atom push $n)
    (swap! outer-params-atom push $n)
    (cgc-let-2d $it (+ $i 1) (str $acc "    FLValue " $n $attr " = " $v ";\n")))))

(defn cgc-body [$args $i $acc]
  (if (>= $i (length $args)) $acc
  (let [[$last (= $i (- (length $args) 1))]
        [$c (cgc (get $args $i))]]
    (if $last (str $acc $c) (cgc-body $args (+ $i 1) (str $acc $c ";\n    "))))))

;; ── defn (최상위) ──

(defn cgc-bind-names [$names]
  (cgc-bind-names-loop $names 0))

(defn cgc-bind-names-loop [$names $i]
  (if (>= $i (length $names)) nil
    (do
      (swap! known-fncall-targets-atom push (get $names $i))
      (cgc-bind-names-loop $names (+ $i 1)))))

(defn cgc-defn-impl [$args]
  (let [[$name (c-name (cgc-extract-raw-name (get $args 0)))]
        [$param-items (get-block-items (get $args 1))]
        [$ps (cgc-params $param-items)]
        [$pnames (cgc-fn-param-names $param-items 0 [])]]
    (reset! outer-params-atom $pnames)
    (cgc-bind-names $pnames)
    (let [[$call-args (cgc-wrapper-call-args $param-items 0 "")]]
      (swap! wrapper-defs-atom push
        (str "static FLValue __fl_wrap_" $name
             "(FLClosure* _s, int _ac, FLValue* argv) {\n"
             "    (void)_s; (void)_ac;\n"
             "    return " $name "(" $call-args ");\n}"))
      (let [[$bodies (slice $args 2 (length $args))]
            [$body (if (= (length $bodies) 1)
                     (cgc (get $bodies 0))
                     (cgc-do $bodies))]]
        (str "FLValue " $name "(" $ps ") {\n    return " $body ";\n}")))))

(defn cgc-defn [$args]
  (let [[$depth @cgc-defn-depth-atom]
        [$saved-params @outer-params-atom]
        [$saved-fncall-targets @known-fncall-targets-atom]]
    (reset! cgc-defn-depth-atom (+ @cgc-defn-depth-atom 1))
    (let [[$result (cgc-defn-impl $args)]
          [$_restore-fncall-targets (reset! known-fncall-targets-atom $saved-fncall-targets)]]
      (reset! cgc-defn-depth-atom (- @cgc-defn-depth-atom 1))
      (reset! outer-params-atom $saved-params)
      (if (> $depth 0)
        (let [[$name (cgc-register-function (cgc-extract-raw-name (get $args 0)))]
              [$param-items (get-block-items (get $args 1))]
              [$ps (cgc-params $param-items)]]
          (swap! cgc-hoisted-fns-atom push $result)
          (swap! known-defns-atom push $name)
          (reset! cgc-hoisted-fwds-atom
            (str @cgc-hoisted-fwds-atom
                 "FLValue " $name "(" $ps ");\n"
                 "static FLValue __fl_wrap_" $name "(FLClosure*, int, FLValue*);\n"))
          "fl_nil()")
        $result))))

;; ── define (전역 변수) ──

(defn cgc-define [$args]
  (let [[$name (c-name (cgc-extract-raw-name (get $args 0)))]
        [$val (cgc (get $args 1))]]
    (swap! known-fncall-targets-atom push $name)
    (swap! global-decls-atom push (str "static FLValue " $name ";"))
    (str $name " = " $val ";")))

;; ── 이진 연산 연쇄 (fl_add(fl_add(a,b),c)) ──

(defn cgc-binop-chain [$args $fn]
  (if (= (length $args) 0) "fl_int(0)"
  (if (= (length $args) 1) (cgc (get $args 0))
  (cgc-binop-fold $args $fn 1 (cgc (get $args 0))))))

(defn cgc-binop-fold [$args $fn $i $acc]
  (if (>= $i (length $args)) $acc
  (cgc-binop-fold $args $fn (+ $i 1)
    (str $fn "(" $acc ", " (cgc (get $args $i)) ")"))))

;; ── range / variadic extrema ──

(defn cgc-range [$args]
  (if (= (length $args) 1)
    (str "range(fl_int(0), " (cgc (get $args 0)) ")")
    (str "range(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")))

(defn cgc-extrema [$args $fn]
  (if (= (length $args) 0) "fl_nil()"
  (if (= (length $args) 1) (cgc (get $args 0))
    (cgc-extrema-fold $args $fn 2
      (str $fn "(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")))))

(defn cgc-extrema-fold [$args $fn $i $acc]
  (if (>= $i (length $args)) $acc
    (cgc-extrema-fold $args $fn (+ $i 1)
      (str $fn "(" $acc ", " (cgc (get $args $i)) ")"))))

;; ── and / or ──

(defn cgc-and [$args]
  (if (= (length $args) 0) "fl_bool(true)"
  (if (= (length $args) 1) (cgc (get $args 0))
  (cgc-and-fold $args 1 (cgc (get $args 0))))))

(defn cgc-and-fold [$args $i $acc]
  (if (>= $i (length $args)) $acc
  (cgc-and-fold $args (+ $i 1)
    (str "fl_and(" $acc ", " (cgc (get $args $i)) ")"))))

(defn cgc-or [$args]
  (if (= (length $args) 0) "fl_bool(false)"
  (if (= (length $args) 1) (cgc (get $args 0))
  (cgc-or-fold $args 1 (cgc (get $args 0))))))

(defn cgc-or-fold [$args $i $acc]
  (if (>= $i (length $args)) $acc
  (cgc-or-fold $args (+ $i 1)
    (str "fl_or(" $acc ", " (cgc (get $args $i)) ")"))))

;; ── args list ──

(defn cgc-args [$args]
  (cgc-args-loop $args 0 ""))
(defn cgc-args-loop [$_args $_i $_acc]
  (loop [$i $_i $acc $_acc]
    (if (or (null? $_args) (>= $i (length $_args))) $acc
    (let [[$c (cgc (get $_args $i))]]
      (recur (+ $i 1) (if (= $i 0) $c (str $acc ", " $c)))))))

;; ── stmts (do 블록) ──

(defn cgc-stmts [$args $i $acc]
  (loop [$i $i $acc $acc]
    (if (>= $i (length $args)) $acc
    (recur (+ $i 1) (str $acc (cgc (get $args $i)) "; ")))))

;; ── 전체 프로그램 생성 ──

(defn cgc-forward-decls [$nodes]
  (cgc-forward-loop $nodes 0 ""))

(defn cgc-forward-loop [$_nodes $_i $_acc]
  (loop [$i $_i $acc $_acc]
    (if (>= $i (length $_nodes)) $acc
    (let [[$n (get $_nodes $i)]
          [$kind (get $n :kind)]
          [$is-defn (and (= $kind "sexpr") (= (get $n :op) "defn"))]
          [$is-block-func (and (= $kind "block") (= (get $n :type) "FUNC"))]]
    (recur (+ $i 1)
      (if (or $is-defn $is-block-func)
        (let [[$raw-name (if $is-defn
                           (cgc-extract-raw-name (get (get $n :args) 0))
                           (get $n :name))]
              [$name (cgc-register-function $raw-name)]
              [$params (if $is-defn
                         (get-block-items (get (get $n :args) 1))
                         (get-block-items (get (get $n :fields) :params)))]
              [$ps (cgc-params $params)]]
          (swap! known-defns-atom push $name)
          (str $acc
               "FLValue " $name "(" $ps ");\n"
               (if $is-defn
                 (str "static FLValue __fl_wrap_" $name "(FLClosure*, int, FLValue*);\n")
                 "")))
        $acc))))))

;; S24: defn wrapper argv 호출 인자 생성 "argv[0], argv[1], ..."
(defn cgc-wrapper-call-args [$_items $_i $_acc]
  (loop [$i $_i $acc $_acc]
    (if (>= $i (length $_items)) $acc
    (recur (+ $i 1)
      (str $acc (if (= (length $acc) 0) "" ", ") "argv[" $i "]")))))

(defn cgc-top-level [$_nodes $_i $_stmts $_fns]
  (loop [$i $_i $stmts $_stmts $fns $_fns]
    (if (>= $i (length $_nodes)) {:stmts $stmts :fns $fns}
    (let [[$n (get $_nodes $i)]
          [$k (get $n :kind)]
          [$is-defn (and (= $k "sexpr") (= (get $n :op) "defn"))]
          [$is-block-func (and (= $k "block") (= (get $n :type) "FUNC"))]]
      (if (or $is-defn $is-block-func)
        (recur (+ $i 1) $stmts (str $fns (cgc $n) "\n\n"))
        (recur (+ $i 1) (str $stmts "    " (cgc $n) ";\n") $fns))))))

;; S19: lambda forward decl 목록 생성
(defn cgc-lambda-fwd-loop [$_defs $_i $_acc]
  (loop [$i $_i $acc $_acc]
    (if (>= $i (length $_defs)) $acc
    (recur (+ $i 1)
      (str $acc "static FLValue __fl_anon_" $i "(FLClosure*, int, FLValue*);\n")))))

(defn cgc-lambda-fwds []
  (cgc-lambda-fwd-loop @lambda-defs-atom 0 ""))

;; S19: lambda 정의 목록 이어붙이기
(defn cgc-join-lambda-loop [$_defs $_i $_acc]
  (loop [$i $_i $acc $_acc]
    (if (>= $i (length $_defs)) $acc
    (recur (+ $i 1) (str $acc (get $_defs $i) "\n\n")))))

(defn cgc-join-lambdas []
  (cgc-join-lambda-loop @lambda-defs-atom 0 ""))

;; S24: wrapper 구현 목록 이어붙이기
(defn cgc-join-wrappers []
  (cgc-join-lambda-loop @wrapper-defs-atom 0 ""))

;; S24: global define 선언 목록 이어붙이기
(defn cgc-join-globals []
  (cgc-join-lambda-loop @global-decls-atom 0 ""))

;; bug4: hoisted nested defn 목록 이어붙이기
(defn cgc-join-hoisted []
  (cgc-join-lambda-loop @cgc-hoisted-fns-atom 0 ""))

(defn generate-c [$nodes $print-last]
  (let [[$fwd (cgc-forward-decls $nodes)]
        [$parts (cgc-top-level $nodes 0 "" "")]
        [$fns (get $parts :fns)]
        [$stmts (get $parts :stmts)]
        [$gdecls (cgc-join-globals)]
        [$lfwd (cgc-lambda-fwds)]
        [$ldefs (cgc-join-lambdas)]
        [$wdefs (cgc-join-wrappers)]
        [$hfwd @cgc-hoisted-fwds-atom]
        [$hfns (cgc-join-hoisted)]
        [$body (if $print-last
                 (str "    { FLValue __fl_last = (__extension__ ({\n"
                      $stmts
                      "    })); if (__fl_last.tag != FL_NIL) fl_println(__fl_last); }\n")
                 $stmts)]]
  (str
    "#include \"runtime.h\"\n"
    "#pragma GCC diagnostic ignored \"-Wunused-function\"\n"
    "#pragma GCC diagnostic ignored \"-Wunused-parameter\"\n\n"
    $fwd
    $hfwd
    $gdecls "\n"
    $lfwd "\n"
    $ldefs
    $wdefs "\n"
    $hfns
    $fns
    "int main(int argc, char** argv) {\n"
    "    fl_init_argv(argc, argv);\n"
    $body
    "    return 0;\n"
    "}\n")))

;; ── S13: set! / loop / recur ──

;; statement expression으로 감싸 삼항 연산자 내 우선순위 문제 방지
(defn cgc-set! [$args]
  (str "(__extension__ ({ " (cgc (get $args 0)) " = " (cgc (get $args 1)) "; fl_nil(); }))"))

(defn cgc-while [$args]
  (str "(__extension__ ({ while (fl_truthy(" (cgc (get $args 0)) ")) { " (cgc (get $args 1)) "; } fl_nil(); }))"))

;; loop 바인딩 [v1 i1 v2 i2 ...] 에서 변수명 배열 추출
(defn loop-extract-vars [$items $i $acc]
  (if (>= $i (length $items)) $acc
  (loop-extract-vars $items (+ $i 2)
    (push $acc (cgc-extract-name (get $items $i))))))

;; FLValue 선언문 생성 — 임시변수로 초기값 먼저 저장 (파라미터 shadow UB 방지)
(defn loop-make-decls [$items $i $acc]
  (if (>= $i (length $items)) $acc
  (let [[$name (cgc-extract-name (get $items $i))]
        [$val (cgc (get $items (+ $i 1)))]
        [$tmp (str "__fl_loop_tmp_" $i)]]
    (loop-make-decls $items (+ $i 2)
      (str $acc
           "    FLValue " $tmp " = " $val ";\n"
           "    FLValue " $name " = " $tmp ";\n")))))

(defn cgc-loop-bind-names [$vars $i]
  (if (>= $i (length $vars)) nil
    (let [[$name (get $vars $i)]]
      (do
        (swap! outer-params-atom push $name)
        (swap! known-fncall-targets-atom push $name)
        (cgc-loop-bind-names $vars (+ $i 1))))))

(defn cgc-loop-body [$body $vars]
  (let [[$saved-params @outer-params-atom]
        [$saved-targets @known-fncall-targets-atom]
        [$_bind (cgc-loop-bind-names $vars 0)]
        [$body-c (cgc-with-recur $body $vars)]
        [$_restore-targets (reset! known-fncall-targets-atom $saved-targets)]
        [$_restore-params (reset! outer-params-atom $saved-params)]]
    $body-c))

;; (loop [...] body) → while 래퍼 생성
(defn cgc-loop [$args]
  (let [[$items (get-block-items (get $args 0))]
        [$body (get $args 1)]
        [$vars (loop-extract-vars $items 0 [])]
        [$decls (loop-make-decls $items 0 "")]
        [$body-c (cgc-loop-body $body $vars)]]
    (str "(__extension__ ({\n"
         $decls
         "    int _fl_looping = 1; FLValue _fl_result = fl_nil();\n"
         "    while (_fl_looping) { _fl_looping = 0;\n"
         "    _fl_result = " $body-c ";\n    }\n"
         "    _fl_result;\n}))")))

;; recur 임시변수 선언 생성
(defn cgc-recur-temps [$args $i $acc]
  (if (>= $i (length $args)) $acc
  (cgc-recur-temps $args (+ $i 1)
    (str $acc "    FLValue _fl_t" $i " = " (cgc (get $args $i)) ";\n"))))

;; 임시변수 → 루프 변수 재할당
(defn cgc-recur-assigns [$vars $i $acc]
  (if (>= $i (length $vars)) $acc
  (cgc-recur-assigns $vars (+ $i 1)
    (str $acc "    " (get $vars $i) " = _fl_t" $i ";\n"))))

;; (recur ...) → 임시 평가 후 재할당 + _fl_looping=1
(defn cgc-recur-stmt [$args $vars]
  (let [[$temps (cgc-recur-temps $args 0 "")]
        [$assigns (cgc-recur-assigns $vars 0 "")]]
    (str "(__extension__ ({\n"
         $temps $assigns
         "    _fl_looping = 1; fl_nil();\n}))")))

;; recur-aware AST 순회: recur만 특수 처리, 나머지는 위임
(defn cgc-with-recur [$node $vars]
  (if (null? $node) "fl_nil()"
  (let [[$k (get $node :kind)]]
  (cond
    [(= $k "sexpr")
     (let [[$op (get $node :op)] [$args (get $node :args)]]
     (cond
       [(= $op "recur") (cgc-recur-stmt $args $vars)]
       [(= $op "if")    (cgc-if-wr $args $vars)]
       [(= $op "case")  (cgc-case-wr $args $vars)]
       [(= $op "cond")  (cgc-cond-wr $args $vars)]
       [(= $op "do")    (cgc-do-wr $args $vars)]
       [(= $op "let")   (cgc-let-wr $args $vars)]
       [(= $op "loop")  (cgc-loop $args)]
       [true            (cgc $node)]))]
    [true (cgc $node)]))))

;; if 내부 recur-aware
(defn cgc-if-wr [$args $vars]
  (let [[$cond (cgc (get $args 0))]
        [$then (cgc-with-recur (get $args 1) $vars)]
        [$else (if (>= (length $args) 3) (cgc-with-recur (get $args 2) $vars) "fl_nil()")]]
  (str "(fl_truthy(" $cond ") ? " $then " : " $else ")")))

;; cond 내부 recur-aware
(defn cgc-cond-wr [$args $vars]
  (if (= (length $args) 0) "fl_nil()"
  (let [[$first (get $args 0)]
        [$nested (and (= (get $first :kind) "block") (= (get $first :type) "Array"))]]
    (if $nested
      (cgc-cond-nested-wr $args $vars (- (length $args) 1) "fl_nil()")
      "fl_nil()"))))

(defn cgc-cond-nested-wr [$args $vars $i $acc]
  (if (< $i 0) $acc
  (let [[$items (get-block-items (get $args $i))]
        [$test (get $items 0)]
        [$body (get $items 1)]
        [$is-else (and (= (get $test :kind) "literal")
                       (or (= (get $test :value) true) (= (get $test :value) "true")))]]
    (cgc-cond-nested-wr $args $vars (- $i 1)
      (if $is-else
        (cgc-with-recur $body $vars)
        (str "(fl_truthy(" (cgc $test) ") ? " (cgc-with-recur $body $vars) " : " $acc ")"))))))

;; do 내부 recur-aware
(defn cgc-do-wr [$args $vars]
  (str "(__extension__ ({ " (cgc-stmts-wr $args $vars 0 "") " }))"))
(defn cgc-stmts-wr [$args $vars $i $acc]
  (if (>= $i (length $args)) $acc
  (cgc-stmts-wr $args $vars (+ $i 1)
    (str $acc (cgc-with-recur (get $args $i) $vars) "; "))))

;; let 내부 recur-aware (선언은 cgc-let-1d/2d 재활용, body만 wr)
(defn cgc-let-wr [$args $vars]
  (let [[$items (get-block-items (get $args 0))]
        [$first (get $items 0)]
        [$nested (and (= (get $first :kind) "block") (= (get $first :type) "Array"))]
        [$saved @outer-params-atom]
        [$decls (if $nested (cgc-let-2d $items 0 "") (cgc-let-1d $items 0 ""))]
        [$body-c (cgc-body-wr (slice $args 1 (length $args)) $vars 0 "")]
        [$_restore (reset! outer-params-atom $saved)]]
  (str "((__extension__ ({\n" $decls "    " $body-c ";\n})))")))

(defn cgc-body-wr [$args $vars $i $acc]
  (if (>= $i (length $args)) $acc
  (let [[$last (= $i (- (length $args) 1))]
        [$c (cgc-with-recur (get $args $i) $vars)]]
    (if $last $c (cgc-body-wr $args $vars (+ $i 1) (str $acc $c ";\n    "))))))

;; ── S14: Array / Map 리터럴 lowering ──

(defn cgc-array-block [$n]
  (let [[$items (get (get $n :fields) "items")]]
  (if (or (null? $items) (= (length $items) 0))
    "fl_vec_new()"
    (let [[$cnt (length $items)]
          [$vals (cgc-args $items)]]
      (str "(__extension__ ({ FLValue __fl_arr[" $cnt "] = {" $vals "};"
           " fl_vec_from(__fl_arr, " $cnt "); }))")))))

(defn cgc-map-entry-c [$ent]
  (str "fl_str_val(\"" (c-esc (get $ent 0)) "\"), " (cgc (get $ent 1))))

(defn cgc-map-entries-c [$ents $i $acc]
  (if (>= $i (length $ents)) $acc
    (let [[$sep (if (= $i 0) "" ", ")]
          [$ec (cgc-map-entry-c (get $ents $i))]]
      (cgc-map-entries-c $ents (+ $i 1) (str $acc $sep $ec)))))

;; all.fl AST: items 배열에서 Keyword/val 쌍 처리
(defn cgc-map-key-c [$key-node]
  (if (= (get $key-node :kind) "keyword")
    (str "fl_str_val(\"" (c-esc (get $key-node :name)) "\")")
    (cgc $key-node)))

(defn cgc-map-items-c [$items $i $acc]
  (if (>= $i (length $items)) $acc
    (let [[$sep (if (= $i 0) "" ", ")]
          [$key-c (cgc-map-key-c (get $items $i))]
          [$val-c (cgc (get $items (+ $i 1)))]]
      (cgc-map-items-c $items (+ $i 2)
        (str $acc $sep $key-c ", " $val-c)))))

(defn cgc-map-from-items [$items]
  (if (or (null? $items) (= (length $items) 0))
    "fl_map_new()"
    (let [[$n-pairs (/ (length $items) 2)]
          [$n-items (length $items)]
          [$kvs (cgc-map-items-c $items 0 "")]]
      (str "(__extension__ ({ FLValue __fl_kv[" $n-items "] = {" $kvs "};"
           " fl_map_from_pairs(__fl_kv, " $n-pairs "); }))"))))

(defn cgc-map-block [$n]
  (let [[$fields (get $n :fields)]
        [$items  (get $fields :items)]]
  (if (and (not (null? $items)) (= (type-of $items) "array"))
    ;; self-hosted AST 경로: items 배열에 Keyword/val 쌍으로 저장
    (cgc-map-from-items $items)
    ;; bootstrap.js AST 경로: map-entries로 직접 접근 (json 라운드트립 금지 — 중첩 Map 손상)
    (let [[$ents (map-entries $fields)]]
    (if (or (null? $ents) (= (length $ents) 0))
      "fl_map_new()"
      (let [[$n-pairs (length $ents)]
            [$n-items (* $n-pairs 2)]
            [$kvs (cgc-map-entries-c $ents 0 "")]]
        (str "(__extension__ ({ FLValue __fl_kv[" $n-items "] = {" $kvs "};"
             " fl_map_from_pairs(__fl_kv, " $n-pairs "); }))")))))))

;; ── IR Validator (S34-d) ────────────────────────────────────────────────────
;; shape 계약 gate: parse 직후, codegen 전에 실행

(define ir-kind-set  ["literal" "variable" "keyword" "sexpr" "block" "and" "or" "try"])
(define ir-lit-types ["number" "string" "boolean" "nil" "symbol"])

(defn ir-err [$msg $n]
  (println (str "[IR-ERR] " $msg " | kind=" (get $n :kind) " line=" (get $n :line)))
  false)

(defn ir-chk [$n]
  (if (null? $n) true
  (let [[$k (get $n :kind)]]
  (cond
    [(null? $k)
     (ir-err "missing :kind" $n)]
    [(not (includes-item ir-kind-set $k))
     (ir-err (str "unknown kind=" $k) $n)]
    [(= $k "literal")
     (let [[$t (get $n :type)] [$v (get $n :value)]]
     (cond
       [(null? $t)
        (ir-err "literal missing :type" $n)]
       [(not (includes-item ir-lit-types $t))
        (ir-err (str "literal bad type=" $t) $n)]
       [(and (= $t "boolean") (not (= (type-of $v) "boolean")))
        (ir-err (str "boolean value must be FL boolean, got " (type-of $v)) $n)]
       [(and (= $t "nil") (not (null? $v)))
        (ir-err "nil literal value must be nil" $n)]
       [true true]))]
    [(= $k "variable")
     (if (null? (get $n :name)) (ir-err "variable missing :name" $n) true)]
    [(= $k "keyword")
     (if (null? (get $n :name)) (ir-err "keyword missing :name" $n)  true)]
    [(= $k "sexpr")
     (cond
       [(null? (get $n :op))   (ir-err "sexpr missing :op"   $n)]
       [(not (= (type-of (get $n :op)) "string")) (ir-err "sexpr :op must be string" $n)]
       [(or (= (get $n :op) "and") (= (get $n :op) "or"))
        (ir-err (str "and/or must be canonical kind node, not sexpr op=" (get $n :op)) $n)]
       [(null? (get $n :args)) (ir-err "sexpr missing :args" $n)]
       [(not (= (type-of (get $n :args)) "array")) (ir-err "sexpr :args must be array" $n)]
       [true true])]
    [(= $k "block")
     (if (null? (get $n :type)) (ir-err "block missing :type" $n) true)]
    [(or (= $k "and") (= $k "or"))
     (if (or (null? (get $n :args)) (not (= (type-of (get $n :args)) "array")))
       (ir-err (str $k " missing/invalid :args") $n)
       true)]
    [true true]))))

;; ── Helper for ir-validator ──
(defn includes-item [$arr $val]
  (loop [$i 0]
    (if (>= $i (length $arr)) false
      (if (= (get $arr $i) $val) true
        (recur (+ $i 1))))))

(defn ir-validate [$nodes]
  (if (or (null? $nodes) (= (length $nodes) 0))
    true
    (loop [$i 0]
      (if (>= $i (length $nodes)) true
        (do
          (if (not (ir-chk (get $nodes $i)))
            (do (println "[CGC-ERR] ir-validate failed") (fl-cgc-halt))
            nil)
          (recur (+ $i 1)))))))

;; ── S27 entry point ──────────────────────────────────────────────────────────
;; 경로에서 디렉토리 부분 추출 ("a/b/c.fl" → "a/b/")
(defn path-dir [$path]
  (let [[$len (length $path)]
        [$last (loop [$i (- $len 1) $r -1]
                 (if (< $i 0) $r
                   (if (= (char-at $path $i) "/")
                     $i
                     (recur (- $i 1) $r))))]]
    (if (< $last 0) "" (substring $path 0 (+ $last 1)))))

;; 노드 목록에 서브목록 모두 추가
(defn append-all [$acc $items]
  (loop [$i 0 $a $acc]
    (if (>= $i (length $items)) $a
      (recur (+ $i 1) (push $a (get $items $i))))))

;; (load "file.fl") 를 컴파일 타임에 인라인 — 재귀적으로 처리
(define cgc-loaded-paths (atom []))
(defn cgc-load-parts [$parts $i $stack]
  (if (>= $i (length $parts)) $stack
    (let [[$part (get $parts $i)] [$n (length $stack)]]
      (cgc-load-parts $parts (+ $i 1)
        (cond
          [(or (= $part "") (= $part ".")) $stack]
          [(and (= $part "..") (> $n 0) (not (= (get $stack (- $n 1)) ".."))) (slice $stack 0 (- $n 1))]
          [true (push $stack $part)])))))
(defn cgc-load-key [$path]
  ;; shortcut: the fixed seed lacks str-join mapping; upgrade when the seed is refreshed.
  (str (if (str-starts-with $path "/") "/" "")
    (join (cgc-load-parts (str-split $path "/") 0 []) "/")))
(defn expand-loads [$nodes $base-dir]
  (loop [$i 0 $acc []]
    (if (>= $i (length $nodes))
      $acc
      (let [[$node (get $nodes $i)]]
        (if (and (= (get $node :kind) "sexpr") (= (get $node :op) "load"))
          (let [[$path-node (get (get $node :args) 0)]
                [$rel-path  (get $path-node :value)]
                ;; 절대 경로면 그대로, 상대 경로면 base-dir 우선, 없으면 CWD 기준
                [$try1 (if (str-starts-with $rel-path "/")
                          $rel-path
                          (str $base-dir $rel-path))]
                [$src1 (file-read $try1)]
                [$abs-path (if (null? $src1) $rel-path $try1)]
                [$src  (if (null? $src1) (file-read $rel-path) $src1)]]
            (if (null? $src)
              (do (println (str "[load] 파일 없음: " $rel-path))
                  (recur (+ $i 1) $acc))
              (if (includes-item @cgc-loaded-paths (cgc-load-key $abs-path))
                (recur (+ $i 1) $acc)
                (do (swap! cgc-loaded-paths push (cgc-load-key $abs-path))
              (let [[$sub-dir  (path-dir $abs-path)]
                    [$sub-raw  (parse (lex $src))]
                    [$expanded (expand-loads $sub-raw $sub-dir)]]
                (recur (+ $i 1) (append-all $acc $expanded)))))))
          (recur (+ $i 1) (push $acc $node)))))))

;; 괄호·문자열 균형. 맞는 소스는 null, 깨진 소스는 [CGC-ERR] 문구.
(defn syntax-step [$st $k $line]
  (cond
    [(= $k "UnclosedString")
     {:paren (get $st :paren) :bracket (get $st :bracket) :brace (get $st :brace)
      :err (str "unclosed string line=" $line)}]
    [(= $k "LParen")
     {:paren (+ (get $st :paren) 1) :bracket (get $st :bracket) :brace (get $st :brace) :err null}]
    [(= $k "RParen")
     (if (= (get $st :paren) 0)
       {:paren 0 :bracket (get $st :bracket) :brace (get $st :brace)
        :err (str "extra closing parenthesis line=" $line)}
       {:paren (- (get $st :paren) 1) :bracket (get $st :bracket) :brace (get $st :brace) :err null})]
    [(= $k "LBracket")
     {:paren (get $st :paren) :bracket (+ (get $st :bracket) 1) :brace (get $st :brace) :err null}]
    [(= $k "RBracket")
     (if (= (get $st :bracket) 0)
       {:paren (get $st :paren) :bracket 0 :brace (get $st :brace)
        :err (str "extra closing bracket line=" $line)}
       {:paren (get $st :paren) :bracket (- (get $st :bracket) 1) :brace (get $st :brace) :err null})]
    [(= $k "LBrace")
     {:paren (get $st :paren) :bracket (get $st :bracket) :brace (+ (get $st :brace) 1) :err null}]
    [(= $k "RBrace")
     (if (= (get $st :brace) 0)
       {:paren (get $st :paren) :bracket (get $st :bracket) :brace 0
        :err (str "extra closing brace line=" $line)}
       {:paren (get $st :paren) :bracket (get $st :bracket) :brace (- (get $st :brace) 1) :err null})]
    [true $st]))

(defn syntax-error-message [$tokens]
  (loop [$i 0 $st {:paren 0 :bracket 0 :brace 0 :err null}]
    (if (or (not (null? (get $st :err))) (>= $i (length $tokens)))
      (if (not (null? (get $st :err)))
        (get $st :err)
        (if (not (= (get $st :paren) 0)) "unclosed parenthesis"
          (if (not (= (get $st :bracket) 0)) "unclosed bracket"
            (if (not (= (get $st :brace) 0)) "unclosed brace"
              null))))
      (let [[$t (get $tokens $i)]]
        (recur (+ $i 1) (syntax-step $st (get $t :kind) (get $t :line)))))))

(defn cgc-run [$argv]
  (let [[$input  (get $argv 0)]
        [$output (get $argv 1)]
        [$print-last (and (>= (length $argv) 3) (= (str (get $argv 2)) "--print-last"))]]
  (if (or (null? $input) (null? $output))
    (println "usage: cgc-bin <input.fl> <output.c> [--print-last]")
    (let [[$src      (file-read $input)]
          [$base-dir (path-dir $input)]
          [$tokens   (lex $src)]
          [$syn      (syntax-error-message $tokens)]]
      (if (not (null? $syn))
        (do
          (println (str "[CGC-ERR] " $syn))
          (fl-cgc-halt))
        (let [[$raw      (parse $tokens)]
              [$nodes    (expand-loads $raw $base-dir)]
              [$_v      (ir-validate $nodes)]
              [$c-code   (generate-c $nodes $print-last)]]
          (file-write $output $c-code)
          (if (= (fl_gcc_syntax_check $output "runtime") 0)
            (println (str "Compiled " $input " -> " $output))
            (do (println (str "[CGC-ERR] generated C failed gcc -fsyntax-only: " $output))
                (_fl_exit 1)))))))))

(cgc-run (cli-args))
