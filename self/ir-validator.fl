;; ── IR Validator (S34-d) ─────────────────────────────────────────────────────
;; top-level 노드 shape 계약 gate (loop/recur — 스택 안전)

(define ir-kind-set  ["literal" "variable" "keyword" "sexpr" "block" "and" "or"])
(define ir-lit-types ["number" "string" "boolean" "nil" "symbol" "unknown"])

(defn ir-err [$msg $n]
  (println (str "[IR-ERR] " $msg " | kind=" (get $n :kind) " line=" (get $n :line)))
  false)

(defn ir-chk [$n]
  (if (null? $n) true
  (let [[$k (get $n :kind)]]
  (cond
    [(null? $k)
     (ir-err "missing :kind" $n)]
    [(not (includes-item ir-kind-set $k))
     (println (str "[IR-WARN] unknown kind=" $k " line=" (get $n :line))) true]
    [(= $k "literal")
     (let [[$t (get $n :type)] [$v (get $n :value)]]
     (cond
       [(null? $t)
        (ir-err "literal missing :type" $n)]
       [(not (includes-item ir-lit-types $t))
        (ir-err (str "literal bad type=" $t) $n)]
       [(and (= $t "boolean") (not (= (type-of $v) "boolean")))
        (ir-err (str "boolean value must be FL boolean, got " (type-of $v)) $n)]
       [(and (= $t "nil") (not (null? $v)))
        (ir-err "nil literal value must be nil" $n)]
       [true true]))]
    [(= $k "variable")
     (if (null? (get $n :name)) (ir-err "variable missing :name" $n) true)]
    [(= $k "keyword")
     (if (null? (get $n :name)) (ir-err "keyword missing :name" $n) true)]
    [(= $k "sexpr")
     (cond
       [(null? (get $n :op))   (ir-err "sexpr missing :op" $n)]
       [(not (= (type-of (get $n :op)) "string")) (ir-err "sexpr :op must be string" $n)]
       [(null? (get $n :args)) (ir-err "sexpr missing :args" $n)]
       [(not (= (type-of (get $n :args)) "array")) (ir-err "sexpr :args must be array" $n)]
       [true true])]
    [(= $k "block")
     (if (null? (get $n :type)) (ir-err "block missing :type" $n) true)]
    [(or (= $k "and") (= $k "or"))
     (if (or (null? (get $n :args)) (not (= (type-of (get $n :args)) "array")))
       (ir-err (str $k " missing/invalid :args") $n) true)]
    [true true]))))

(defn ir-validate [$nodes]
  (if (or (null? $nodes) (= (length $nodes) 0))
    true
    (loop [$i 0]
      (if (>= $i (length $nodes)) true
        (do
          (ir-chk (get $nodes $i))
          (recur (+ $i 1)))))))
