;; self/codegen-c.fl — FreeLang → C 코드젠 (Stage 2)
;; 지원 범위: self/CODEGEN_C_SCOPE.md 참조
;; ABI: self/ABI.md (FLValue tagged union)

;; S19/S20: lambda collector + capture 추적
(define lambda-id-atom    (atom 0))
(define lambda-defs-atom  (atom []))
(define outer-params-atom (atom []))
;; S23: define 변수 이름 추적 — 이 이름으로 호출 시 fl_fn_call 사용
(define known-fncall-targets-atom (atom []))

;; ── 유틸 ──

(defn get-block-items [$node]
  (if (null? $node) (list)
  (if (and (= (get $node :kind) "block") (= (get $node :type) "Array"))
    (get (get $node :fields) "items")
    $node)))

(defn c-esc [$s]
  ;; 문자열 리터럴을 C 이스케이프로 변환 (\\ " \n \t \r)
  (str-replace
    (str-replace
      (str-replace
        (str-replace
          (str-replace $s "\\" "\\\\")
          "\"" "\\\"")
        "\n" "\\n")
      "\t" "\\t")
    "\r" "\\r"))

(defn c-name [$n]
  ;; FL 식별자를 C 식별자로 변환 (-> → _to_ / - → _ / ? → _p / ! → _b)
  (str-replace
    (str-replace
      (str-replace
        (str-replace $n "->" "_to_")
        "-" "_")
      "?" "_p")
    "!" "_b"))

;; ── 메인 dispatch ──

(defn cgc [$n]
  (cond
    [(null? $n) "fl_nil()"]
    [(= (get $n :kind) "literal")   (cgc-literal $n)]
    [(= (get $n :kind) "variable")  (c-name (get $n :name))]
    [(= (get $n :kind) "sexpr")     (cgc-sexpr $n)]
    [(= (get $n :kind) "block")     (cgc-block $n)]
    [(= (get $n :kind) "and")       (cgc-and (get $n :args))]
    [(= (get $n :kind) "or")        (cgc-or (get $n :args))]
    [true (str "/* unsupported:" (get $n :kind) " */ fl_nil()")]))

;; ── 리터럴 ──

(defn cgc-literal [$n]
  (let [[$t (get $n :type)] [$v (get $n :value)]]
  (cond
    [(= $t "number")  (if (str-includes (str $v) ".") (str "fl_float(" $v ")") (str "fl_int(" $v ")"))]
    [(= $t "string")  (str "fl_str_val(\"" (c-esc $v) "\")")]
    [(= $t "boolean") (if $v "fl_bool(true)" "fl_bool(false)")]
    [(= $t "symbol")  (cond
                        [(= $v "true")  "fl_bool(true)"]
                        [(= $v "false") "fl_bool(false)"]
                        [(or (= $v "nil") (= $v "null")) "fl_nil()"]
                        [true (c-name $v)])]
    [true "fl_nil()"])))

;; ── block (FUNC/Array/Map) ──

(defn cgc-block [$n]
  (let [[$t (get $n :type)]]
  (cond
    [(= $t "FUNC")  (cgc-func-block $n)]
    [(= $t "Array") (cgc-array-block $n)]
    [(= $t "Map")   (cgc-map-block $n)]
    [true (str "/* unsupported block:" $t " */ fl_nil()")])))

(defn cgc-func-block [$n]
  (let [[$name (c-name (get $n :name))]
      [$f (get $n :fields)]
      [$params-block (get $f :params)]
      [$body-node (get $f :body)]
      [$ps (cgc-params (get-block-items $params-block))]
      [$body (cgc $body-node)]]
  (str "FLValue " $name "(" $ps ") {\n    return " $body ";\n}")))

(defn cgc-params [$it]
  (cgc-params-loop $it 0 ""))
(defn cgc-params-loop [$it $i $acc]
  (if (>= $i (length $it)) $acc
  (let [[$n (cgc-extract-name (get $it $i))]
        [$entry (str "FLValue " $n)]]
    (cgc-params-loop $it (+ $i 1) (if (= (length $acc) 0) $entry (str $acc ", " $entry))))))

(defn cgc-extract-name [$node]
  (cond
    [(= (get $node :kind) "variable") (c-name (get $node :name))]
    [(= (get $node :kind) "literal")  (c-name (str (get $node :value)))]
    [true "_anon"]))

;; ── sexpr ──

;; S23: FLValue fn 동적 호출 — fl_fn_call 사용
(defn cgc-fncall [$fn-c $args]
  (let [[$argc (length $args)]
        [$id @lambda-id-atom]]
    (swap! lambda-id-atom + 1)
    (if (= $argc 0)
      (str "fl_fn_call(" $fn-c ", 0, NULL)")
      (str "(__extension__ ({ FLValue __fl_ca_" $id "[" $argc "] = {"
           (cgc-args $args) "};"
           " fl_fn_call(" $fn-c ", " $argc ", __fl_ca_" $id "); }))"))))

(defn cgc-sexpr [$n]
  (let [[$op (get $n :op)] [$args (get $n :args)]]
  (if (string? $op)
    (cgc-dispatch $op $args)
    (cgc-fncall (cgc $op) $args))))

(defn cgc-dispatch [$op $args]
  (cond
  [(= $op "if")     (cgc-if $args)]
  [(= $op "cond")   (cgc-cond $args)]
  [(= $op "do")     (cgc-do $args)]
  [(= $op "let")    (cgc-let $args)]
  [(= $op "defn")   (cgc-defn $args)]
  [(= $op "define") (cgc-define $args)]
  [(= $op "+")      (cgc-binop-chain $args "fl_add")]
  [(= $op "-")      (if (= (length $args) 1)
                      (str "fl_sub(fl_int(0), " (cgc (get $args 0)) ")")
                      (cgc-binop-chain $args "fl_sub"))]
  [(= $op "*")      (cgc-binop-chain $args "fl_mul")]
  [(= $op "/")      (str "fl_div(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "%")      (str "fl_mod(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "=")      (str "fl_eq(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "!=")     (str "fl_neq(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "<")      (str "fl_lt(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op ">")      (str "fl_gt(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "<=")     (str "fl_lte(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op ">=")     (str "fl_gte(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "and")    (cgc-and $args)]
  [(= $op "or")     (cgc-or $args)]
  [(= $op "not")    (str "fl_not(" (cgc (get $args 0)) ")")]
  [(= $op "println") (str "fl_println(" (cgc-str-arg $args) ")")]
  [(= $op "print")   (str "fl_print(" (cgc-str-arg $args) ")")]
  [(= $op "str")    (cgc-str $args)]
  [(= $op "set!")   (cgc-set! $args)]
  [(= $op "while")  (cgc-while $args)]
  [(= $op "loop")   (cgc-loop $args)]
  [(= $op "recur")  "/* orphan recur */ fl_nil()"]
  ;; S15: collection ops → 기존 fl_* 직접 매핑
  [(= $op "map")         (str "fl_map_fn(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "filter")      (str "fl_filter_fn(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "reduce")      (str "fl_reduce_fn(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ", " (cgc (get $args 2)) ")")]
  [(= $op "append")      (str "fl_vec_push(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "push")        (str "fl_vec_push(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "keys")        (str "fl_map_keys(" (cgc (get $args 0)) ")")]
  [(= $op "obj-keys")    (str "fl_map_keys(" (cgc (get $args 0)) ")")]
  [(= $op "map-entries") (str "fl_map_entries(" (cgc (get $args 0)) ")")]
  [(= $op "null?")       (str "null_p(" (cgc (get $args 0)) ")")]
  [(= $op "nil?")        (str "null_p(" (cgc (get $args 0)) ")")]
  ;; S15: math/time — C stdlib 충돌 방지용 fl_ 접두사
  [(= $op "floor")       (str "fl_floor(" (cgc (get $args 0)) ")")]
  [(= $op "ceil")        (str "fl_ceil(" (cgc (get $args 0)) ")")]
  [(= $op "abs")         (str "fl_abs(" (cgc (get $args 0)) ")")]
  [(= $op "math-sqrt")   (str "fl_math_sqrt(" (cgc (get $args 0)) ")")]
  [(= $op "now")         "fl_now()"]
  [(= $op "now-ms")      "fl_now_ms()"]
  [(= $op "str-join")    (str "join(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "str-replace") (str "str_replace(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ", " (cgc (get $args 2)) ")")]
  [(= $op "substring")   (str "substring(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ", " (cgc (get $args 2)) ")")]
  [(= $op "trim")        (str "trim(" (cgc (get $args 0)) ")")]
  [(= $op "slice")       (str "substring(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ", " (cgc (get $args 2)) ")")]
  ;; S16: list vararg → fl_vec_from, _fl-map-set alias
  [(= $op "list")        (cgc-list $args)]
  [(= $op "_fl_map_set") (str "fl_map_set(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ", " (cgc (get $args 2)) ")")]
  ;; S17: _fl_* dispatch 정규화 — file ops
  [(= $op "_fl_file_read")    (str "fl_file_read(" (cgc (get $args 0)) ")")]
  [(= $op "_fl_file_write")   (str "fl_file_write(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "file-read")        (str "fl_file_read(" (cgc (get $args 0)) ")")]
  [(= $op "file-write")       (str "fl_file_write(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "file-exists")      (str "fl_bool(fl_file_read(" (cgc (get $args 0)) ").tag != FL_NIL)")]
  [(= $op "file_exists")      (str "fl_bool(fl_file_read(" (cgc (get $args 0)) ").tag != FL_NIL)")]
  [(= $op "_fl_file_append")  "fl_nil()"]
  [(= $op "_fl_file_copy")    "fl_nil()"]
  [(= $op "_fl_file_delete")  "fl_nil()"]
  [(= $op "_fl_file_mkdir")   "fl_nil()"]
  [(= $op "_fl_file_rmdir")   "fl_nil()"]
  [(= $op "_fl_file_list")    "fl_vec_new()"]
  [(= $op "_fl_file_size")    "fl_int(0)"]
  [(= $op "_fl_file_modified")"fl_int(0)"]
  [(= $op "_fl_file_rename")  "fl_nil()"]
  [(= $op "_fl_file_is_file") "fl_bool(false)"]
  [(= $op "_fl_file_is_dir")  "fl_bool(false)"]
  ;; S17: env / process / misc — stub
  [(= $op "_fl_env_get")           "fl_nil()"]
  [(= $op "_fl_env_set")           "fl_nil()"]
  [(= $op "_fl_env_all")           "fl_map_new()"]
  [(= $op "_fl_process_run")       "fl_str_val(\"\")"]
  [(= $op "_fl_process_run_args")  "fl_str_val(\"\")"]
  [(= $op "_fl_process_exec")      "fl_str_val(\"\")"]
  [(= $op "_fl_process_exec_args") "fl_str_val(\"\")"]
  [(= $op "_fl_process_spawn")     "fl_str_val(\"\")"]
  [(= $op "_fl_process_kill")      "fl_nil()"]
  [(= $op "_fl_process_wait")      "fl_nil()"]
  [(= $op "_fl_process_exists")    "fl_bool(false)"]
  [(= $op "_fl_process_getcwd")    "fl_str_val(\"/\")"]
  [(= $op "_fl_process_chdir")     "fl_nil()"]
  [(= $op "_fl_process_pid")       "fl_int(0)"]
  [(= $op "_fl_process_ppid")      "fl_nil()"]
  [(= $op "_fl_run_inherit")       "fl_nil()"]
  [(= $op "cli-args")              "fl_get_argv()"]
  [(= $op "bit-xor")               (str "fl_int(" (cgc (get $args 0)) ".i ^ " (cgc (get $args 1)) ".i)")]
  ;; S17: json — 타입 안전 stub (S18에서 실 구현)
  [(= $op "json-parse")      (str "fl_str_n(1, " (cgc (get $args 0)) ")")]
  [(= $op "json-stringify")  (str "fl_str_n(1, " (cgc (get $args 0)) ")")]
  ;; S19: fn lambda → static FLClosure 추출
  [(= $op "fn")      (cgc-fn $args)]
  [(= $op "cg-and")  (str "fl_and(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "cg-or")   (str "fl_or(" (cgc (get $args 0)) ", " (cgc (get $args 1)) ")")]
  [(= $op "cg-match")"fl_nil()"]
  [true             (cgc-dispatch-fallback $op $args)]))

(defn cgc-dispatch-fallback [$op $args]
  (let [[$cn (c-name $op)]]
    (if (includes-item @known-fncall-targets-atom $cn)
      (cgc-fncall $cn $args)
      (str $cn "(" (cgc-args $args) ")"))))

;; ── S19/S20: fn lambda → static FLClosure 추출 (capture 지원) ──

;; argv[i] 선언 구문
(defn cgc-fn-argv-decls [$items $i $acc]
  (if (>= $i (length $items)) $acc
  (let [[$name (c-name (cgc-extract-name (get $items $i)))]]
    (cgc-fn-argv-decls $items (+ $i 1)
      (str $acc "    FLValue " $name " = argv[" $i "];\n")))))

;; 파라미터 이름 목록 수집
(defn cgc-fn-param-names [$items $i $acc]
  (if (>= $i (length $items)) $acc
  (cgc-fn-param-names $items (+ $i 1)
    (push $acc (c-name (cgc-extract-name (get $items $i)))))))

;; body AST에서 variable 이름 수집 (중복 제거)
(defn cgc-collect-vars [$node $acc]
  (cond
    [(null? $node) $acc]
    [(= (get $node :kind) "variable")
     (let [[$n (c-name (get $node :name))]]
       (if (includes-item $acc $n) $acc (push $acc $n)))]
    [(= (get $node :kind) "sexpr")
     (cgc-collect-vars-loop (get $node :args) 0 $acc)]
    [(= (get $node :kind) "block")
     (cgc-collect-vars-loop (get-block-items $node) 0 $acc)]
    [(= (get $node :kind) "and")
     (cgc-collect-vars-loop (get $node :args) 0 $acc)]
    [(= (get $node :kind) "or")
     (cgc-collect-vars-loop (get $node :args) 0 $acc)]
    [true $acc]))

(defn cgc-collect-vars-loop [$args $i $acc]
  (if (or (null? $args) (>= $i (length $args))) $acc
  (cgc-collect-vars-loop $args (+ $i 1)
    (cgc-collect-vars (get $args $i) $acc))))

;; _self->env[i] 복원 구문
(defn cgc-fn-env-decls [$caps $i $acc]
  (if (>= $i (length $caps)) $acc
  (cgc-fn-env-decls $caps (+ $i 1)
    (str $acc "    FLValue " (get $caps $i) " = _self->env[" $i "];\n"))))

;; 캡처 변수 배열 표현식 "v1, v2"
(defn cgc-env-arr [$caps $i $acc]
  (if (>= $i (length $caps)) $acc
  (cgc-env-arr $caps (+ $i 1)
    (if (= $i 0) (get $caps 0) (str $acc ", " (get $caps $i))))))

(defn cgc-fn [$args]
  (let [[$id @lambda-id-atom]
        [$param-items (get-block-items (get $args 0))]
        [$param-names (cgc-fn-param-names $param-items 0 [])]
        [$body-node (get $args 1)]
        [$all-vars (cgc-collect-vars $body-node [])]
        [$outer @outer-params-atom]
        [$caps (filter (fn [$v]
                  (and (not (includes-item $param-names $v))
                       (includes-item $outer $v)))
                  $all-vars)]
        [$nenv (length $caps)]
        [$env-decls (cgc-fn-env-decls $caps 0 "")]
        [$body-c (cgc $body-node)]
        [$decls (cgc-fn-argv-decls $param-items 0 "")]
        [$fn-name (str "__fl_anon_" $id)]]
    (swap! lambda-id-atom + 1)
    (swap! lambda-defs-atom push
      (str "static FLValue " $fn-name
           "(FLClosure* _self, int _argc, FLValue* argv) {\n"
           $env-decls
           $decls
           "    return " $body-c ";\n}"))
    (if (= $nenv 0)
      (str "fl_fn_new(" $fn-name ", 0, NULL)")
      (str "(__extension__ ({ FLValue __env_" $id "[" $nenv "] = {"
           (cgc-env-arr $caps 0 "") "};"
           " fl_fn_new(" $fn-name ", " $nenv ", __env_" $id "); }))"))))

;; ── list (vararg → fl_vec_from) ──

(defn cgc-list [$args]
  (if (= (length $args) 0)
    "fl_vec_new()"
    (let [[$cnt (length $args)]
          [$vals (cgc-args $args)]]
      (str "(__extension__ ({ FLValue __fl_lst[" $cnt "] = {" $vals "};"
           " fl_vec_from(__fl_lst, " $cnt "); }))"))))

;; ── str 특수 처리 (n인자 → fl_str_n) ──

(defn cgc-str [$args]
  (let [[$n (length $args)]]
  (if (= $n 0) "fl_str_val(\"\")"
    (if (= $n 1) (str "fl_str_n(1, " (cgc (get $args 0)) ")")
      (str "fl_str_n(" $n ", " (cgc-args $args) ")")))))

(defn cgc-str-arg [$args]
  (if (= (length $args) 1)
    (cgc (get $args 0))
    (cgc-str $args)))

;; ── if ──

(defn cgc-if [$args]
  (let [[$cond (cgc (get $args 0))]
        [$then (cgc (get $args 1))]
        [$else (if (>= (length $args) 3) (cgc (get $args 2)) "fl_nil()")]]
  (str "(fl_truthy(" $cond ") ? " $then " : " $else ")")))

;; ── cond ──

(defn cgc-cond [$args]
  (if (= (length $args) 0) "fl_nil()"
  (let [[$first (get $args 0)]
        [$nested (and (= (get $first :kind) "block") (= (get $first :type) "Array"))]]
    (if $nested
      (cgc-cond-nested $args (- (length $args) 1) "fl_nil()")
      "fl_nil()"))))

(defn cgc-cond-nested [$args $i $acc]
  (if (< $i 0) $acc
  (let [[$items (get-block-items (get $args $i))]
        [$test (get $items 0)]
        [$body (get $items 1)]
        [$is-else (and (= (get $test :kind) "literal") (= (get $test :value) true))]]
    (cgc-cond-nested $args (- $i 1)
      (if $is-else
        (cgc $body)
        (str "(fl_truthy(" (cgc $test) ") ? " (cgc $body) " : " $acc ")"))))))

;; ── do ──

(defn cgc-do [$args]
  (str "(__extension__ ({ " (cgc-stmts $args 0 "") " }))"))

;; ── let ──

(defn cgc-let [$args]
  (let [[$items (get-block-items (get $args 0))]
        [$first (get $items 0)]
        [$nested (and (= (get $first :kind) "block") (= (get $first :type) "Array"))]
        [$decls (if $nested (cgc-let-2d $items 0 "") (cgc-let-1d $items 0 ""))]
        [$body (cgc-body (slice $args 1 (length $args)) 0 "")]]
  (str "((__extension__ ({\n" $decls "    " $body ";\n})))")))

(defn cgc-let-1d [$it $i $acc]
  (if (>= $i (length $it)) $acc
  (let [[$n (cgc-extract-name (get $it $i))]
        [$v (cgc (get $it (+ $i 1)))]]
    (swap! known-fncall-targets-atom push $n)
    (cgc-let-1d $it (+ $i 2) (str $acc "    FLValue " $n " = " $v ";\n")))))

(defn cgc-let-2d [$it $i $acc]
  (if (>= $i (length $it)) $acc
  (let [[$p (get-block-items (get $it $i))]
        [$n (cgc-extract-name (get $p 0))]
        [$v (cgc (get $p 1))]]
    (swap! known-fncall-targets-atom push $n)
    (cgc-let-2d $it (+ $i 1) (str $acc "    FLValue " $n " = " $v ";\n")))))

(defn cgc-body [$args $i $acc]
  (if (>= $i (length $args)) $acc
  (let [[$last (= $i (- (length $args) 1))]
        [$c (cgc (get $args $i))]]
    (if $last $c (cgc-body $args (+ $i 1) (str $acc $c ";\n    "))))))

;; ── defn (최상위) ──

(defn cgc-defn [$args]
  (let [[$name (c-name (cgc-extract-name (get $args 0)))]
        [$param-items (get-block-items (get $args 1))]
        [$ps (cgc-params $param-items)]
        [$pnames (cgc-fn-param-names $param-items 0 [])]]
    (reset! outer-params-atom $pnames)
    (let [[$body (cgc (get $args 2))]]
      (str "FLValue " $name "(" $ps ") {\n    return " $body ";\n}"))))

;; ── define (전역 변수) ──

(defn cgc-define [$args]
  (let [[$name (c-name (cgc-extract-name (get $args 0)))]
        [$val (cgc (get $args 1))]]
    (swap! known-fncall-targets-atom push $name)
    (str "FLValue " $name " = " $val ";")))

;; ── 이진 연산 연쇄 (fl_add(fl_add(a,b),c)) ──

(defn cgc-binop-chain [$args $fn]
  (if (= (length $args) 0) "fl_int(0)"
  (if (= (length $args) 1) (cgc (get $args 0))
  (cgc-binop-fold $args $fn 1 (cgc (get $args 0))))))

(defn cgc-binop-fold [$args $fn $i $acc]
  (if (>= $i (length $args)) $acc
  (cgc-binop-fold $args $fn (+ $i 1)
    (str $fn "(" $acc ", " (cgc (get $args $i)) ")"))))

;; ── and / or ──

(defn cgc-and [$args]
  (if (= (length $args) 0) "fl_bool(true)"
  (if (= (length $args) 1) (cgc (get $args 0))
  (cgc-and-fold $args 1 (cgc (get $args 0))))))

(defn cgc-and-fold [$args $i $acc]
  (if (>= $i (length $args)) $acc
  (cgc-and-fold $args (+ $i 1)
    (str "fl_and(" $acc ", " (cgc (get $args $i)) ")"))))

(defn cgc-or [$args]
  (if (= (length $args) 0) "fl_bool(false)"
  (if (= (length $args) 1) (cgc (get $args 0))
  (cgc-or-fold $args 1 (cgc (get $args 0))))))

(defn cgc-or-fold [$args $i $acc]
  (if (>= $i (length $args)) $acc
  (cgc-or-fold $args (+ $i 1)
    (str "fl_or(" $acc ", " (cgc (get $args $i)) ")"))))

;; ── args list ──

(defn cgc-args [$args]
  (cgc-args-loop $args 0 ""))
(defn cgc-args-loop [$args $i $acc]
  (if (or (null? $args) (>= $i (length $args))) $acc
  (let [[$c (cgc (get $args $i))]]
    (cgc-args-loop $args (+ $i 1) (if (= $i 0) $c (str $acc ", " $c))))))

;; ── stmts (do 블록) ──

(defn cgc-stmts [$args $i $acc]
  (if (>= $i (length $args)) $acc
  (cgc-stmts $args (+ $i 1) (str $acc (cgc (get $args $i)) "; "))))

;; ── 전체 프로그램 생성 ──

(defn cgc-forward-decls [$nodes]
  (cgc-forward-loop $nodes 0 ""))

(defn cgc-forward-loop [$nodes $i $acc]
  (if (>= $i (length $nodes)) $acc
  (let [[$n (get $nodes $i)]]
  (cgc-forward-loop $nodes (+ $i 1)
    (if (and (= (get $n :kind) "sexpr") (= (get $n :op) "defn"))
      (let [[$name (c-name (cgc-extract-name (get (get $n :args) 0)))]
            [$ps (cgc-params (get-block-items (get (get $n :args) 1)))]]
        (str $acc "FLValue " $name "(" $ps ");\n"))
      $acc)))))

(defn cgc-top-level [$nodes $i $stmts $fns]
  (if (>= $i (length $nodes)) {:stmts $stmts :fns $fns}
  (let [[$n (get $nodes $i)]
        [$k (get $n :kind)]
        [$is-defn (and (= $k "sexpr") (= (get $n :op) "defn"))]
        [$is-block-func (and (= $k "block") (= (get $n :type) "FUNC"))]]
    (if (or $is-defn $is-block-func)
      (cgc-top-level $nodes (+ $i 1) $stmts (str $fns (cgc $n) "\n\n"))
      (cgc-top-level $nodes (+ $i 1) (str $stmts "    " (cgc $n) ";\n") $fns)))))

;; S19: lambda forward decl 목록 생성
(defn cgc-lambda-fwd-loop [$defs $i $acc]
  (if (>= $i (length $defs)) $acc
  (cgc-lambda-fwd-loop $defs (+ $i 1)
    (str $acc "static FLValue __fl_anon_" $i "(FLClosure*, int, FLValue*);\n"))))

(defn cgc-lambda-fwds []
  (cgc-lambda-fwd-loop @lambda-defs-atom 0 ""))

;; S19: lambda 정의 목록 이어붙이기
(defn cgc-join-lambda-loop [$defs $i $acc]
  (if (>= $i (length $defs)) $acc
  (cgc-join-lambda-loop $defs (+ $i 1) (str $acc (get $defs $i) "\n\n"))))

(defn cgc-join-lambdas []
  (cgc-join-lambda-loop @lambda-defs-atom 0 ""))

(defn generate-c [$nodes]
  (let [[$fwd (cgc-forward-decls $nodes)]
        [$parts (cgc-top-level $nodes 0 "" "")]
        [$fns (get $parts :fns)]
        [$stmts (get $parts :stmts)]
        [$lfwd (cgc-lambda-fwds)]
        [$ldefs (cgc-join-lambdas)]]
  (str
    "#include \"runtime.h\"\n\n"
    $fwd
    $lfwd "\n"
    $ldefs
    $fns
    "int main(int argc, char** argv) {\n"
    "    fl_init_argv(argc, argv);\n"
    $stmts
    "    return 0;\n"
    "}\n")))

;; ── S13: set! / loop / recur ──

;; statement expression으로 감싸 삼항 연산자 내 우선순위 문제 방지
(defn cgc-set! [$args]
  (str "(__extension__ ({ " (cgc (get $args 0)) " = " (cgc (get $args 1)) "; fl_nil(); }))"))

(defn cgc-while [$args]
  (str "(__extension__ ({ while (fl_truthy(" (cgc (get $args 0)) ")) { " (cgc (get $args 1)) "; } fl_nil(); }))"))

;; loop 바인딩 [v1 i1 v2 i2 ...] 에서 변수명 배열 추출
(defn loop-extract-vars [$items $i $acc]
  (if (>= $i (length $items)) $acc
  (loop-extract-vars $items (+ $i 2)
    (push $acc (cgc-extract-name (get $items $i))))))

;; FLValue 선언문 생성
(defn loop-make-decls [$items $i $acc]
  (if (>= $i (length $items)) $acc
  (let [[$name (cgc-extract-name (get $items $i))]
        [$val (cgc (get $items (+ $i 1)))]]
    (loop-make-decls $items (+ $i 2)
      (str $acc "    FLValue " $name " = " $val ";\n")))))

;; (loop [...] body) → while 래퍼 생성
(defn cgc-loop [$args]
  (let [[$items (get-block-items (get $args 0))]
        [$body (get $args 1)]
        [$vars (loop-extract-vars $items 0 [])]
        [$decls (loop-make-decls $items 0 "")]
        [$body-c (cgc-with-recur $body $vars)]]
    (str "(__extension__ ({\n"
         $decls
         "    int _fl_looping = 1; FLValue _fl_result = fl_nil();\n"
         "    while (_fl_looping) { _fl_looping = 0;\n"
         "    _fl_result = " $body-c ";\n    }\n"
         "    _fl_result;\n}))")))

;; recur 임시변수 선언 생성
(defn cgc-recur-temps [$args $i $acc]
  (if (>= $i (length $args)) $acc
  (cgc-recur-temps $args (+ $i 1)
    (str $acc "    FLValue _fl_t" $i " = " (cgc (get $args $i)) ";\n"))))

;; 임시변수 → 루프 변수 재할당
(defn cgc-recur-assigns [$vars $i $acc]
  (if (>= $i (length $vars)) $acc
  (cgc-recur-assigns $vars (+ $i 1)
    (str $acc "    " (get $vars $i) " = _fl_t" $i ";\n"))))

;; (recur ...) → 임시 평가 후 재할당 + _fl_looping=1
(defn cgc-recur-stmt [$args $vars]
  (let [[$temps (cgc-recur-temps $args 0 "")]
        [$assigns (cgc-recur-assigns $vars 0 "")]]
    (str "(__extension__ ({\n"
         $temps $assigns
         "    _fl_looping = 1; fl_nil();\n}))")))

;; recur-aware AST 순회: recur만 특수 처리, 나머지는 위임
(defn cgc-with-recur [$node $vars]
  (if (null? $node) "fl_nil()"
  (let [[$k (get $node :kind)]]
  (cond
    [(= $k "sexpr")
     (let [[$op (get $node :op)] [$args (get $node :args)]]
     (cond
       [(= $op "recur") (cgc-recur-stmt $args $vars)]
       [(= $op "if")    (cgc-if-wr $args $vars)]
       [(= $op "cond")  (cgc-cond-wr $args $vars)]
       [(= $op "do")    (cgc-do-wr $args $vars)]
       [(= $op "let")   (cgc-let-wr $args $vars)]
       [(= $op "loop")  (cgc-loop $args)]
       [true            (cgc $node)]))]
    [true (cgc $node)]))))

;; if 내부 recur-aware
(defn cgc-if-wr [$args $vars]
  (let [[$cond (cgc (get $args 0))]
        [$then (cgc-with-recur (get $args 1) $vars)]
        [$else (if (>= (length $args) 3) (cgc-with-recur (get $args 2) $vars) "fl_nil()")]]
  (str "(fl_truthy(" $cond ") ? " $then " : " $else ")")))

;; cond 내부 recur-aware
(defn cgc-cond-wr [$args $vars]
  (if (= (length $args) 0) "fl_nil()"
  (let [[$first (get $args 0)]
        [$nested (and (= (get $first :kind) "block") (= (get $first :type) "Array"))]]
    (if $nested
      (cgc-cond-nested-wr $args $vars (- (length $args) 1) "fl_nil()")
      "fl_nil()"))))

(defn cgc-cond-nested-wr [$args $vars $i $acc]
  (if (< $i 0) $acc
  (let [[$items (get-block-items (get $args $i))]
        [$test (get $items 0)]
        [$body (get $items 1)]
        [$is-else (and (= (get $test :kind) "literal") (= (get $test :value) true))]]
    (cgc-cond-nested-wr $args $vars (- $i 1)
      (if $is-else
        (cgc-with-recur $body $vars)
        (str "(fl_truthy(" (cgc $test) ") ? " (cgc-with-recur $body $vars) " : " $acc ")"))))))

;; do 내부 recur-aware
(defn cgc-do-wr [$args $vars]
  (str "(__extension__ ({ " (cgc-stmts-wr $args $vars 0 "") " }))"))
(defn cgc-stmts-wr [$args $vars $i $acc]
  (if (>= $i (length $args)) $acc
  (cgc-stmts-wr $args $vars (+ $i 1)
    (str $acc (cgc-with-recur (get $args $i) $vars) "; "))))

;; let 내부 recur-aware (선언은 cgc-let-1d/2d 재활용, body만 wr)
(defn cgc-let-wr [$args $vars]
  (let [[$items (get-block-items (get $args 0))]
        [$first (get $items 0)]
        [$nested (and (= (get $first :kind) "block") (= (get $first :type) "Array"))]
        [$decls (if $nested (cgc-let-2d $items 0 "") (cgc-let-1d $items 0 ""))]
        [$body-c (cgc-body-wr (slice $args 1 (length $args)) $vars 0 "")]]
  (str "((__extension__ ({\n" $decls "    " $body-c ";\n})))")))

(defn cgc-body-wr [$args $vars $i $acc]
  (if (>= $i (length $args)) $acc
  (let [[$last (= $i (- (length $args) 1))]
        [$c (cgc-with-recur (get $args $i) $vars)]]
    (if $last $c (cgc-body-wr $args $vars (+ $i 1) (str $acc $c ";\n    "))))))

;; ── S14: Array / Map 리터럴 lowering ──

(defn cgc-array-block [$n]
  (let [[$items (get (get $n :fields) "items")]]
  (if (or (null? $items) (= (length $items) 0))
    "fl_vec_new()"
    (let [[$cnt (length $items)]
          [$vals (cgc-args $items)]]
      (str "(__extension__ ({ FLValue __fl_arr[" $cnt "] = {" $vals "};"
           " fl_vec_from(__fl_arr, " $cnt "); }))")))))

(defn cgc-map-entry-c [$ent]
  (str "fl_str_val(\"" (c-esc (get $ent 0)) "\"), " (cgc (get $ent 1))))

(defn cgc-map-entries-c [$ents $i $acc]
  (if (>= $i (length $ents)) $acc
    (let [[$sep (if (= $i 0) "" ", ")]
          [$ec (cgc-map-entry-c (get $ents $i))]]
      (cgc-map-entries-c $ents (+ $i 1) (str $acc $sep $ec)))))

(defn cgc-map-block [$n]
  (let [[$ents (obj-entries (json-parse (json-stringify (get $n :fields))))]]
  (if (or (null? $ents) (= (length $ents) 0))
    "fl_map_new()"
    (let [[$n-pairs (length $ents)]
          [$n-items (* $n-pairs 2)]
          [$kvs (cgc-map-entries-c $ents 0 "")]]
      (str "(__extension__ ({ FLValue __fl_kv[" $n-items "] = {" $kvs "};"
           " fl_map_from_pairs(__fl_kv, " $n-pairs "); }))")))))
