;; Test Suite for Recur TCO Implementation
;; Validates cgc-loop-tco + cgc-recur-tco against 6 patterns

;; ── Pattern 1: Simple increment (count-to) ──
(defn count-to [$n $acc]
  (loop [$i 0]
    (if (>= $i $n) $acc
      (recur (+ $i 1)))))

(defn test-pattern-1 []
  (let [[$result (count-to 100 "done")]]
    (if (= $result "done")
      "✅ Pattern 1: Simple increment PASS"
      "❌ Pattern 1 FAIL")))

;; ── Pattern 2: Multiple variables (sum-to) ──
(defn sum-to [$n $acc]
  (loop [$i 0 $sum 0]
    (if (>= $i $n) $sum
      (recur (+ $i 1) (+ $sum $i)))))

(defn test-pattern-2 []
  (let [[$result (sum-to 100 0)]]
    ;; sum 0..99 = 99*100/2 = 4950
    (if (= $result 4950)
      "✅ Pattern 2: Multiple variables PASS"
      (str "❌ Pattern 2 FAIL (expected 4950, got " $result ")"))))

;; ── Pattern 3: String accumulation (build-str) ──
(defn build-str [$n]
  (loop [$i 0 $acc ""]
    (if (>= $i $n) $acc
      (recur (+ $i 1) (str $acc (str $i) ",")))))

(defn test-pattern-3 []
  (let [[$result (build-str 5)]]
    ;; expected: "0,1,2,3,4,"
    (if (str-includes $result "0,1,2,3,4,")
      "✅ Pattern 3: String accumulation PASS"
      (str "❌ Pattern 3 FAIL (got " $result ")"))))

;; ── Pattern 4: List iteration with side effects ──
(defn process-list [$items]
  (loop [$i 0 $result []]
    (if (>= $i (length $items)) $result
      (recur (+ $i 1) (push $result (get $items $i))))))

(defn test-pattern-4 []
  (let [[$input [10 20 30]]
        [$result (process-list $input)]]
    (if (= (length $result) 3)
      "✅ Pattern 4: List iteration PASS"
      (str "❌ Pattern 4 FAIL (got " $result ")"))))

;; ── Pattern 5: Cond with multiple recur branches ──
(defn classify [$n]
  (loop [$i 0]
    (cond
      [(= $i 3) "three"]
      [(even? $i) (recur (+ $i 1))]
      [true (recur (+ $i 2))])))

(defn even? [$x]
  (= (mod $x 2) 0))

(defn test-pattern-5 []
  (let [[$result (classify 0)]]
    (if (= $result "three")
      "✅ Pattern 5: Cond with recur PASS"
      (str "❌ Pattern 5 FAIL (got " $result ")"))))

;; ── Pattern 6: Complex expressions with let ──
(defn filter-sum [$items $threshold]
  (loop [$i 0 $sum 0]
    (if (>= $i (length $items)) $sum
      (let [[$val (get $items $i)]]
        (recur (+ $i 1) (if (> $val $threshold) (+ $sum $val) $sum))))))

(defn test-pattern-6 []
  (let [[$input [1 5 10 3 20 2]]
        [$result (filter-sum $input 5)]]
    ;; sum items > 5: 10 + 20 = 30
    (if (= $result 30)
      "✅ Pattern 6: Complex expressions PASS"
      (str "❌ Pattern 6 FAIL (expected 30, got " $result ")"))))

;; ── Stack depth test (1M iterations) ──
(defn stack-depth-test [$iterations]
  (loop [$i 0]
    (if (>= $i $iterations) "done"
      (recur (+ $i 1)))))

(defn test-stack-depth []
  (let [[$result (stack-depth-test 1000000)]]
    (if (= $result "done")
      "✅ Stack Depth: 1M iterations PASS (no overflow)"
      "❌ Stack Depth FAIL")))

;; ── Performance test (string building) ──
(defn perf-string-build [$n]
  (loop [$i 0 $acc ""]
    (if (>= $i $n) $acc
      (recur (+ $i 1) (str $acc "x")))))

(defn test-perf []
  (let [[$result (perf-string-build 10000)]]
    (if (= (length $result) 10000)
      "✅ Performance: String 10k build PASS"
      (str "❌ Performance FAIL (got length " (length $result) ")"))))

;; ── Main test runner ──
(defn run-all-tests []
  (do
    (println (test-pattern-1))
    (println (test-pattern-2))
    (println (test-pattern-3))
    (println (test-pattern-4))
    (println (test-pattern-5))
    (println (test-pattern-6))
    (println (test-stack-depth))
    (println (test-perf))
    "All tests completed"))

;; Execute tests
(run-all-tests)
