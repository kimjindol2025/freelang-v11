(println "=== 포맷팅 헬퍼 테스트 ===")
(println "str-pad-left tests:")
(println (str-pad-left "5" 5 "0"))
(println (str-pad-left "hi" 5))
(println "str-pad-right tests:")
(println (str-pad-right "hi" 5))
(println (str-pad-right "hi" 5 "-"))
(println "str-truncate tests:")
(println (str-truncate "hello world" 5))
(println (str-truncate "hello" 5 "~"))
(println "format-number tests:")
(println (format-number 1234567))
(println (format-number 42))
(println "format-decimal tests:")
(println (format-decimal 3.14159 2))
(println (format-decimal 42 2))
(println "format-percent tests:")
(println (format-percent 0.456 1))
(println (format-percent 1 0))
(println "✅ 모든 테스트 완료!")
