  automatic_type_detection_cause: manual_casting
  automatic_type_detection_fixed: true
  parameter_marker_cause: ambiguity_prefix
  parameter_marker_fixed: optional
  serialization_cause: json_overhead
  serialization_fixed: auto
  self_hosting_cause: circular_dependency
  self_hosting_fixed: proven
}

