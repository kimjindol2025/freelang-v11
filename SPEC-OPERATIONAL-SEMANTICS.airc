; SPEC: FreeLang v11 Operational Semantics
; Version: 2026-05-23
; Status: Verified (L2 self-hosting)
; Authors: kim (runtime design), Claude (formalization)

(spec-declare "operational-semantics"
  (meta
    :title "FreeLang v11 Operational Semantics"
    :version "2026-05-23"
    :status :verified
    :scope "Node.js runtime v11.7.12"
    :target "backend orchestration, observability, rapid semantics iteration"
    :doc "docs/OPERATIONAL-SEMANTICS.md"))

; ============================================================================
; AXIOM 1: Status0 Invariant (부분 실패 격리)
; ============================================================================
(axiom status0-invariant
  :definition "비동기 작업의 각 단계는 status ∈ {0, 1, -1} 중 정확히 하나"
  :properties [
    "status=0: pending (초기)"
    "status=1: success (최종, 변경 불가)"
    "status=-1: failed (최종, 변경 불가)"
    "한 번 1 또는 -1이 되면 변경 불가"
    "재시도는 새로운 작업 인스턴스 생성"
  ]
  :verification "src/stdlib-job.ts:45-62"
  :test "@test test-status0-invariant")

(rule status0-transition
  :from [status 0]  ; pending
  :to-success [status 1 result nil error nil]
  :to-fail [status -1 result nil error "..."]
  :guard "status must be 0"
  :atomic true)

; ============================================================================
; AXIOM 2: Topology Convergence (구조 안정화)
; ============================================================================
(axiom topology-convergence
  :definition "분산 시스템은 시간이 지날수록 목표 구조로 수렴"
  :algorithm [
    "1. observe current_topology"
    "2. compare desired_topology"
    "3. compute distance = |desired - current| + |current - desired|"
    "4. apply transitions to reduce distance"
    "5. repeat until distance == 0"
  ]
  :convergence "distance monotonically decreases"
  :termination "distance reaches 0 in finite steps"
  :verification "src/stdlib-topology.ts:80-120"
  :test "@test test-topology-convergence")

(metric topology-distance
  :compute "(count (symmetric-diff current desired))"
  :invariant ">= 0"
  :goal "== 0"
  :deadline "within node_count * rebalance_interval")

; ============================================================================
; AXIOM 3: Append-Only Lifecycle (감사 추적)
; ============================================================================
(axiom append-only-lifecycle
  :definition "모든 상태 전이는 immutable log에 기록되며 재생 가능"
  :properties [
    "write-only: append (수정 불가)"
    "read: arbitrary replay from checkpoint"
    "validation: checksum(prev + event) integrity"
    "durability: fsync on each write"
  ]
  :log-format {:event string :id string :ts number :checksum string}
  :replay-guarantee "deterministic(log, seed) → state"
  :verification "src/stdlib-elog.ts:1-50"
  :test "@test test-append-only-replay")

(invariant append-only-immutability
  :property "∀ log_entry, log_entry.timestamp is monotonic"
  :enforcement "no mutable write to log"
  :recovery "replay from any checkpoint to current"
  :corruption-detect "checksum mismatch → alert + halt")

; ============================================================================
; AXIOM 4: Projection-Only Derived State (재계산 불필요)
; ============================================================================
(axiom projection-only-state
  :definition "모든 조회 상태는 log에서 파생, 직접 수정 불가"
  :roles {
    :source-of-truth "append-only log (immutable)"
    :materialized-view "computed from log (can be discarded)"
    :cache "performance optimization (must be invalidatable)"
  }
  :consistency-property "∀t, cache(t) = compute-from-log(log[0..t])"
  :cache-invalidation "cache can be dropped anytime, recomputed from log"
  :verification "src/stdlib-projection.ts"
  :test "@test test-projection-consistency")

(rule derived-state-immutability
  :only-write "append-only log"
  :forbidden ["direct state mutation" "in-place updates"]
  :read-path ["log → materialized view" "cache (if consistent)"]
  :invalidation "when log changes, cache is invalidated")

; ============================================================================
; AXIOM 5: Transition-Window Correctness (상태 전이 검증)
; ============================================================================
(axiom transition-window-correctness
  :definition "상태 A → B 전이는 특정 조건에서만 유효, 전이 중 불변성 유지"
  :state-machine {
    :job {
      0 [1 -1]                 ; pending → {success, failed}
      1 []                     ; success → {} (no exit)
      -1 []                    ; failed → {} (no exit)
    }
    :process {
      "starting" ["running"]
      "running" ["stopping"]
      "stopping" ["stopped"]
      "stopped" ["starting"]
    }
  }
  :window-invariant "during transition A→B, state must not change"
  :atomicity "entire transition is atomic"
  :verification "src/stdlib-state-machine.ts"
  :test "@test test-transition-correctness")

(rule valid-transitions-only
  :before "(assert (is-valid-transition? from to))"
  :during "(assert (no-external-observation-during-transition))"
  :after "(assert (state == to))")

; ============================================================================
; AXIOM 6: Deterministic Event Flow (재현 가능성)
; ============================================================================
(axiom deterministic-event-flow
  :definition "같은 이벤트 시퀀스 + 같은 시드 → 항상 같은 상태"
  :prerequisites [
    "event order is logical (not wall-clock)"
    "random numbers use deterministic seed"
    "external I/O is deterministic (mock or recorded)"
    "no timing-dependent behavior"
  ]
  :property "∀ events, seed: compute-state(events, seed) is pure"
  :verification "∀ replay_count: state1 == state2 == ... == stateN"
  :test "@test test-deterministic-reproduction")

(invariant deterministic-reproducibility
  :claim "compute-state(E, S) always produces identical output"
  :proof "L3 self-hosting: stage2.js == stage3.js (SHA256)"
  :scope "Node.js runtime (non-cryptographic randomness only)"
  :exclusion ["wall-clock time" "random() without seed" "external HTTP"])

; ============================================================================
; AXIOM 7: Observable State (검사 가능성)
; ============================================================================
(axiom observable-state
  :definition "런타임의 모든 상태는 외부에서 관찰 가능"
  :observation-points [
    "job_state(id) → {status, result, error}"
    "process_state(pid) → {pid, memory, cpu, status}"
    "topology_current() → {nodes, edges, transitions}"
    "log_tail(path, n) → [events]"
    "message_queue(qid) → [messages]"
    "error_boundary(proc_id) → {failures, scope}"
  ]
  :watchpoint-api [
    ":watch $variable"
    ":watches (list all watched)"
    ":unwatch $variable"
  ]
  :verification "src/stdlib-observable.ts"
  :test "@test test-all-observable-points")

(capability external-observation
  :allowed ["job state" "process state" "topology" "logs" "queues"]
  :forbidden ["internal closure state" "VM internals" "optimized-away values"]
  :latency "< 1ms for hot paths")

; ============================================================================
; VERIFICATION GATES
; ============================================================================
(verification-gate phase1-syntax-check
  :command "node bootstrap.js check app.fl"
  :requirement "parse success"
  :time-budget "100ms"
  :failure-action "halt")

(verification-gate phase2-type-inference
  :command "node bootstrap.js infer app.fl"
  :requirement "type consistency"
  :time-budget "500ms"
  :failure-action "warn")

(verification-gate phase3-semantics
  :command "@test all tests"
  :requirement "1090/1090 PASS"
  :coverage ">= 95%"
  :failure-action "halt")

(verification-gate phase4-l2-self-hosting
  :command "stage1.js compile self/all.fl → stage2.js"
  :requirement "compile success"
  :verification "executable(stage2.js)"
  :failure-action "halt")

(verification-gate phase5-deterministic-build
  :command "for i in 1..3: bootstrap.js → stage_i.js"
  :requirement "sha256(stage1.js) == sha256(stage2.js) == sha256(stage3.js)"
  :proof "canonical state achieved"
  :failure-action "halt")

; ============================================================================
; DESIGN PRINCIPLES (설계 원칙)
; ============================================================================
(principle explicit
  :claim "no implicit behavior"
  :rules [
    "all state transitions must be explicit"
    "error handling must be explicit"
    "failure boundaries must be explicit"
    "side-effects must be explicit"
  ])

(principle observable
  :claim "all internal state must be externally observable"
  :rules [
    "job state queryable anytime"
    "process topology inspectable"
    "event log readable"
    "watch API available"
  ])

(principle deterministic
  :claim "same input → always same output"
  :scope "given same random seed and wall-clock time fixed"
  :enforcement "no time-dependent behavior"
  :proof "L3 verification gates")

(principle isolated
  :claim "process boundaries are explicit isolation barriers"
  :rules [
    "process crash does not affect others"
    "error in one process is isolated"
    "state ownership is clear"
    "no shared mutable state across processes"
  ])

; ============================================================================
; CURRENT VERIFICATION STATUS (2026-05-23)
; ============================================================================
(verification-status
  :status0-invariant [
    :verified-by "@test test-status0"
    :verified-by "integration test suite"
    :grade :production
  ]
  :topology-convergence [
    :verified-by "L2 proof case-15"
    :verified-by "runtime behavior observation"
    :grade :beta
  ]
  :append-only-lifecycle [
    :verified-by "elog v0.1 implementation"
    :verified-by "replay consistency test"
    :grade :beta
  ]
  :projection-only [
    :verified-by "query system tests (partial)"
    :grade :partial
  ]
  :transition-correctness [
    :verified-by "state machine test suite"
    :grade :beta
  ]
  :deterministic-flow [
    :verified-by "L2 self-hosting tests"
    :verified-by "stage1.js → stage2.js success"
    :verified-by "L3 verification (pending)"
    :grade :l2
  ]
  :observable-state [
    :verified-by "runtime introspection API"
    :grade :beta
  ]
  :verification-gates [
    :verified-by "CI pipeline"
    :coverage "all 5 gates automated"
    :grade :production
  ])

; ============================================================================
; NEXT PHASE: Native Runtime Semantics Equivalence
; ============================================================================
(future-work
  :phase "P2: Native Backend"
  :goal "prove operational semantics equivalent between Node.js and Native C runtime"
  :approach [
    "1. cgc-main.fl generates C code from semantics"
    "2. Native runtime implements same axioms"
    "3. Test: deterministic(Node) == deterministic(Native)"
  ]
  :timeline "post-L3 verification")

(future-work
  :phase "P3: Hybrid Runtime"
  :goal "control-plane on Node.js, data-plane on Native"
  :invariant "both maintain same operational semantics"
  :timeline "post-P2")
