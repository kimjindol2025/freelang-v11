;; stdlib/validate.fl — 데이터 검증 유틸리티 (v11.6.36)
;; (load "stdlib/validate.fl")

;; ── 기본 타입 검증 ────────────────────────────────────────────────────────────

(defn validate-email [s]
  (if (string? s)
    (re-test "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$" s)
    false))

(defn validate-url [s]
  (if (string? s)
    (re-test "^https?://.+" s)
    false))

(defn validate-min-length [s n]
  (if (string? s) (>= (length s) n) false))

(defn validate-max-length [s n]
  (if (string? s) (<= (length s) n) false))

(defn validate-range [v mn mx]
  (and (>= v mn) (<= v mx)))

(defn validate-integer [v]
  (integer? v))

(defn validate-positive [v]
  (and (number? v) (> v 0)))

(defn validate-non-negative [v]
  (and (number? v) (>= v 0)))

;; ── 빈 값 검증 ────────────────────────────────────────────────────────────────
;; 반환: 비어있는 필드 키 목록
(defn validate-required [m fields]
  (filter
    (fn [k]
      (let [v (get m k)]
        (or (nil? v)
            (and (string? v) (str-blank? v)))))
    fields))

;; ── 단일 필드 검증 내부 헬퍼 ──────────────────────────────────────────────────
(defn -check-required [errs k val rule]
  (if (and (get rule :required)
           (or (nil? val) (and (string? val) (str-blank? val))))
    (push errs (str k " is required"))
    errs))

(defn -check-email [errs k val rule]
  (if (and (not (nil? val)) (get rule :email) (not (validate-email val)))
    (push errs (str k " must be a valid email"))
    errs))

(defn -check-url [errs k val rule]
  (if (and (not (nil? val)) (get rule :url) (not (validate-url val)))
    (push errs (str k " must be a valid URL"))
    errs))

(defn -check-min-length [errs k val rule]
  (let [n (get rule :min-length)]
    (if (and (not (nil? n)) (string? val) (not (validate-min-length val n)))
      (push errs (str k " must be at least " n " characters"))
      errs)))

(defn -check-max-length [errs k val rule]
  (let [n (get rule :max-length)]
    (if (and (not (nil? n)) (string? val) (not (validate-max-length val n)))
      (push errs (str k " must be at most " n " characters"))
      errs)))

(defn -check-type [errs k val rule]
  (let [t (get rule :type)]
    (if (and (not (nil? t)) (not (nil? val)) (not (= (type-of val) t)))
      (push errs (str k " must be of type " t))
      errs)))

(defn -check-min [errs k val rule]
  (let [mn (get rule :min)]
    (if (and (not (nil? mn)) (number? val) (< val mn))
      (push errs (str k " must be >= " mn))
      errs)))

(defn -check-max [errs k val rule]
  (let [mx (get rule :max)]
    (if (and (not (nil? mx)) (number? val) (> val mx))
      (push errs (str k " must be <= " mx))
      errs)))

;; ── 단일 필드 규칙 검증 ───────────────────────────────────────────────────────
;; 반환: 에러 메시지 목록 (비어있으면 OK)
(defn validate-field [k val rule]
  (let [e0 []]
  (let [e1 (-check-required  e0 k val rule)]
  (let [e2 (-check-email     e1 k val rule)]
  (let [e3 (-check-url       e2 k val rule)]
  (let [e4 (-check-min-length e3 k val rule)]
  (let [e5 (-check-max-length e4 k val rule)]
  (let [e6 (-check-type      e5 k val rule)]
  (let [e7 (-check-min       e6 k val rule)]
        (-check-max          e7 k val rule))))))))))

;; ── 스키마 검증 ───────────────────────────────────────────────────────────────
;; schema 예시:
;;   {:name {:required true :min-length 2 :max-length 50}
;;    :email {:required true :email true}
;;    :age   {:type "number" :min 0 :max 150}}
;; 반환: {:ok bool :errors [{:field k :message msg}]}
(defn validate-schema [data schema]
  (let [ks (obj-keys schema)]
  (let [all-errors (reduce
    (fn [acc k]
      (let [rule (get schema k)
            val  (get data k)
            msgs (validate-field k val rule)]
        (if (> (length msgs) 0)
          (into acc (map (fn [m] {:field k :message m}) msgs))
          acc)))
    []
    ks)]
  {:ok (= (length all-errors) 0)
   :errors all-errors})))
