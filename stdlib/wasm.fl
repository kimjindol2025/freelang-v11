;; stdlib/wasm.fl — FreeLang → WASM 컴파일러 (v11.7.3)
;; (load "stdlib/wasm.fl")
;;
;; FreeLang S-expression을 WebAssembly 바이트코드로 컴파일하고 실행한다.
;; 외부 도구 없이 순수 Node.js WebAssembly API만 사용.
;;
;; 사용법:
;;   (wasm-fn "add" ["a" "b"] ["+", "a", "b"])
;;   → 함수 정의 맵 반환 (wasm-module에 전달)
;;
;;   (wasm-module [fn1 fn2 ...])
;;   → {:ok true :wasm base64 :size n} 또는 {:ok false :error msg}
;;
;;   (wasm-run! module "add" [3 4])
;;   → 7  (또는 throw)
;;
;;   (wasm-eval expr params args)
;;   → (wasm-eval ["+", "a", "b"] ["a" "b"] [3 4]) → 7
;;
;; 지원 연산자:
;;   + - * / %           산술
;;   == != < > <= >=     비교 (i32 결과)
;;   and or not xor      논리/비트
;;   << >>               비트 시프트
;;   if do let call      제어 흐름
;;   abs neg min max     수학
;;
;; 실무 예제:
;;   (load "stdlib/wasm.fl")
;;   (let [m (wasm-module
;;             [(wasm-fn "fib" ["n"]
;;               ["if" ["<=" "n" 1] "n"
;;                ["+", ["call" "fib" ["-" "n" 1]]
;;                      ["call" "fib" ["-" "n" 2]]]])])]
;;     (wasm-run! m "fib" [20]))  ;; → 6765

(defn -wasm-backend []
  (let [r (shell-exec-result "pwd")]
    (str (str-trim (get r :stdout)) "/stdlib/wasm-backend.js")))

(defn -wasm-tmp []
  (str "/tmp/wasm_" (str (now-ms)) ".json"))

(defn -wasm-exec [mode ast-map]
  (let [tmp  (-wasm-tmp)
        _    (file-write tmp (json-stringify ast-map))
        cmd  (str "node " (-wasm-backend) " " mode " " tmp)
        res  (shell-exec-result cmd)
        _    (shell-exec-result (str "rm -f " tmp))]
    (if (not (get res :ok))
      {:ok false :error (get res :stderr)}
      (try (json-parse (str-trim (get res :stdout)))
           (catch e {:ok false :error (str "parse error: " e)})))))

;; ── 공개 API ──────────────────────────────────────────────────────────────────

(defn wasm-fn [name params body]
  {"name" name "params" params "body" body})

(defn wasm-fn-f64 [name params body]
  {"name" name "params" params "body" body "returnType" "f64"
   "paramTypes" (map (fn [_] "f64") params)})

(defn wasm-fn-typed [name params param-types body return-type]
  {"name" name "params" params "paramTypes" param-types
   "body" body "returnType" return-type})

(defn wasm-module [fns]
  (let [r (-wasm-exec "compile" {"fns" fns})]
    (if (get r "ok")
      {:ok true :wasm (get r "wasm") :size (get r "size")}
      {:ok false :error (get r "error")})))

(defn wasm-run! [module fn-name args]
  (when (not (get module :ok))
    (throw (str "WASM 모듈 오류: " (get module :error))))
  (let [tmp  (-wasm-tmp)
        wasm (get module :wasm)
        use-math (= (get module :math) true)
        _    (file-write tmp (json-stringify {"wasm" wasm}))
        inst-code (if use-math
          "const MATH={sin:Math.sin,cos:Math.cos,tan:Math.tan,exp:Math.exp,log:Math.log,pow:Math.pow,atan:Math.atan,atan2:Math.atan2,tanh:Math.tanh};const i=new WebAssembly.Instance(m,{math:MATH});"
          "const i=new WebAssembly.Instance(m);")
        cmd  (str "node -e \""
               "const b=Buffer.from('" wasm "','base64');"
               "const m=new WebAssembly.Module(b);"
               inst-code
               "const f=i.exports['" fn-name "'];"
               "const args=" (json-stringify args) ";"
               "process.stdout.write(JSON.stringify({ok:true,value:f(...args)}));"
               "\"")
        res  (shell-exec-result cmd)
        _    (shell-exec-result (str "rm -f " tmp))]
    (if (not (get res :ok))
      (throw (str "WASM 실행 오류: " (get res :stderr)))
      (let [data (json-parse (str-trim (get res :stdout)))]
        (if (get data "ok")
          (get data "value")
          (throw (str "WASM 오류: " (get data "error"))))))))

(defn wasm-eval [expr params args]
  (let [r (-wasm-exec "eval" {"expr" expr "params" params "args" args})]
    (if (get r "ok")
      (get r "value")
      (throw (str "WASM eval 오류: " (get r "error"))))))

;; ── 편의 함수 ──────────────────────────────────────────────────────────────────

(defn wasm-compile-expr [name params body]
  (wasm-module [(wasm-fn name params body)]))

(defn wasm-ok? [module]
  (= (get module :ok) true))

(defn wasm-size [module]
  (get module :size 0))

;; ── W-2: 배열 연산 (linear memory) ───────────────────────────────────────────
;;
;; (wasm-eval-mem expr params args)
;;   메모리 모드로 eval — arr-new/get/set/len 사용 가능
;;   반환값은 스칼라(i32)
;;
;; (wasm-arr-reduce arr init expr)
;;   FreeLang 배열을 WASM으로 reduce — expr에서 "acc"(누적), "x"(원소) 사용
;;   예: (wasm-arr-reduce [1 2 3 4 5] 0 ["+", "acc", "x"])  → 15
;;
;; (wasm-arr-map arr expr)
;;   FreeLang 배열을 WASM으로 map → 새 FreeLang 배열 반환
;;   예: (wasm-arr-map [1 2 3] ["*", "x", 2])  → [2 4 6]
;;
;; (wasm-arr-zip-map arr-a arr-b expr)
;;   두 배열을 같은 인덱스로 합쳐 변환 — expr에서 "a", "b" 사용
;;   예: (wasm-arr-zip-map [1 2 3] [4 5 6] ["+", "a", "b"])  → [5 7 9]
;;
;; ── 편의 함수 ─────────────────────────────────────────────────────────────────
;;
;; (wasm-arr-sum arr)           → 합계
;; (wasm-arr-max arr)           → 최댓값
;; (wasm-arr-min arr)           → 최솟값
;; (wasm-arr-scale arr k)       → 각 원소 × k
;; (wasm-arr-dot arr-a arr-b)   → 내적 (dot product)

(defn wasm-eval-mem [expr params args]
  (let [r (-wasm-exec "eval" {"expr" expr "params" params "args" args "memory" true})]
    (if (get r "ok")
      (get r "value")
      (throw (str "WASM eval-mem 오류: " (get r "error"))))))

(defn wasm-arr-reduce [fl-arr init expr]
  (let [r (-wasm-exec "arr-reduce" {
    "input_array" fl-arr
    "init" init
    "expr" expr
  })]
    (if (get r "ok")
      (get r "value")
      (throw (str "WASM arr-reduce 오류: " (get r "error"))))))

(defn wasm-arr-map [fl-arr expr]
  (let [r (-wasm-exec "arr-map" {
    "input_array" fl-arr
    "expr" expr
  })]
    (if (get r "ok")
      (get r "value")
      (throw (str "WASM arr-map 오류: " (get r "error"))))))

(defn wasm-arr-zip-map [arr-a arr-b expr]
  (let [r (-wasm-exec "arr-zip-map" {
    "arr_a" arr-a
    "arr_b" arr-b
    "expr" expr
  })]
    (if (get r "ok")
      (get r "value")
      (throw (str "WASM arr-zip-map 오류: " (get r "error"))))))

;; ── 편의 함수 ─────────────────────────────────────────────────────────────────

(defn wasm-arr-sum [arr]
  (wasm-arr-reduce arr 0 ["+" "acc" "x"]))

(defn wasm-arr-max [arr]
  (wasm-arr-reduce arr (first arr)
    ["if" [">" "x" "acc"] "x" "acc"]))

(defn wasm-arr-min [arr]
  (wasm-arr-reduce arr (first arr)
    ["if" ["<" "x" "acc"] "x" "acc"]))

(defn wasm-arr-scale [arr k]
  (wasm-arr-map arr ["*" "x" k]))

(defn wasm-arr-dot [arr-a arr-b]
  (wasm-arr-reduce
    (wasm-arr-zip-map arr-a arr-b ["*" "a" "b"])
    0
    ["+" "acc" "x"]))

;; ── W-3: wasm-defn / wasm-defn-multi ─────────────────────────────────────────
;;
;; (wasm-defn fn-name params body)
;;   WASM 함수를 FreeLang 함수처럼 정의.
;;   모듈을 한 번만 컴파일하고 클로저로 반환.
;;   파라미터 최대 5개.
;;
;;   사용법:
;;     (define fib
;;       (wasm-defn "fib" ["n"]
;;         ["if" ["<=" "n" 1] "n"
;;               ["+" ["call" "fib" ["-" "n" 1]]
;;                    ["call" "fib" ["-" "n" 2]]]]))
;;     (fib 30)  → 832040
;;
;; (wasm-defn-multi fns entry)
;;   여러 함수를 하나의 모듈로 컴파일 — 상호재귀 지원.
;;   fns: [{"name" ... "params" [...] "body" ...}]
;;   entry: 외부 호출 함수 이름
;;
;; (wasm-arr-filter arr expr)
;;   expr이 0이 아닌 원소만 유지.
;;   예: (wasm-arr-filter [1 2 3 4 5] [">" "x" 3])  → [4 5]
;;
;; (wasm-arr-scan arr init expr)
;;   running-total 배열 반환 (prefix sum 등).
;;   예: (wasm-arr-scan [1 2 3 4 5] 0 ["+" "acc" "x"])  → [1 3 6 10 15]
;;
;; (wasm-bench label wasm-fn fl-fn arg n-runs)
;;   WASM vs FreeLang 배치 연산 속도 비교.

(defn wasm-defn [fn-name params body]
  (let [m (wasm-module [(wasm-fn fn-name params body)])
        n (length params)]
    (cond
      (= n 0) (fn [] (wasm-run! m fn-name []))
      (= n 1) (fn [a] (wasm-run! m fn-name [a]))
      (= n 2) (fn [a b] (wasm-run! m fn-name [a b]))
      (= n 3) (fn [a b c] (wasm-run! m fn-name [a b c]))
      (= n 4) (fn [a b c d] (wasm-run! m fn-name [a b c d]))
      (= n 5) (fn [a b c d e] (wasm-run! m fn-name [a b c d e]))
      true (throw "wasm-defn: 파라미터 최대 5개 지원"))))

(defn wasm-defn-multi [fns entry]
  (let [wasm-fns (map (fn [f]
                        (wasm-fn (get f :name) (get f :params) (get f :body)))
                      fns)
        m        (wasm-module wasm-fns)
        entry-f  (find-first (fn [f] (= (get f :name) entry)) fns)
        n        (length (get entry-f :params []))]
    (cond
      (= n 0) (fn [] (wasm-run! m entry []))
      (= n 1) (fn [a] (wasm-run! m entry [a]))
      (= n 2) (fn [a b] (wasm-run! m entry [a b]))
      (= n 3) (fn [a b c] (wasm-run! m entry [a b c]))
      (= n 4) (fn [a b c d] (wasm-run! m entry [a b c d]))
      true (throw "wasm-defn-multi: 최대 4개 파라미터"))))

(defn wasm-arr-filter [fl-arr pred-expr]
  (let [r (-wasm-exec "arr-filter" {
    "input_array" fl-arr
    "expr" pred-expr
  })]
    (if (get r "ok")
      (get r "value")
      (throw (str "WASM arr-filter 오류: " (get r "error"))))))

(defn wasm-arr-scan [fl-arr init expr]
  (let [r (-wasm-exec "arr-scan" {
    "input_array" fl-arr
    "init" init
    "expr" expr
  })]
    (if (get r "ok")
      (get r "value")
      (throw (str "WASM arr-scan 오류: " (get r "error"))))))

;; WASM vs FreeLang 배치 속도 비교
(defn wasm-bench [label wasm-f fl-f arg n-runs]
  (let [ws (now-ms)
        _  (dotimes [_ n-runs] (wasm-f arg))
        we (now-ms)
        fs (now-ms)
        _  (dotimes [_ n-runs] (fl-f arg))
        fe (now-ms)]
    {:label label
     :wasm-ms  (- we ws)
     :fl-ms    (- fe fs)
     :speedup  (if (> (- we ws) 0) (/ (- fe fs) (- we ws)) nil)
     :runs     n-runs}))

;; ── W-4: f64 / 수학 함수 ──────────────────────────────────────────────────────
;;
;; (wasm-eval-f64 expr params args)
;;   f64 타입 eval — 파라미터와 반환값 모두 f64
;;
;; (wasm-eval-math expr params args)
;;   수학 함수(sin/cos/tan/exp/log/pow/atan/atan2) 포함 eval
;;
;; (wasm-defn-f64 fn-name params body)
;;   f64 파라미터 + f64 반환 WASM 클로저
;;
;; (wasm-arr-reduce-f64 arr init expr)
;;   f64 배열 reduce — "acc", "x" 사용
;;
;; (wasm-arr-map-f64 arr expr)
;;   f64 배열 map — "x" 사용
;;
;; (wasm-arr-zip-map-f64 arr-a arr-b expr)
;;   두 f64 배열 합산 변환 — "a", "b" 사용
;;
;; (wasm-arr-scan-f64 arr init expr)
;;   f64 running total 배열
;;
;; 편의 함수:
;;   (wasm-arr-sum-f64 arr)
;;   (wasm-arr-dot-f64 a b)
;;   (wasm-arr-scale-f64 arr k)
;;   (wasm-arr-stats arr) → {:sum :mean :max :min}

(defn wasm-eval-f64 [expr params args]
  (let [param-types (map (fn [_] "f64") params)
        r (-wasm-exec "eval" {"expr" expr "params" params
                              "paramTypes" param-types "returnType" "f64" "args" args})]
    (if (get r "ok")
      (get r "value")
      (throw (str "WASM eval-f64 오류: " (get r "error"))))))

(defn wasm-eval-math [expr params args]
  (let [param-types (map (fn [_] "f64") params)
        r (-wasm-exec "eval" {"expr" expr "params" params
                              "paramTypes" param-types "returnType" "f64" "args" args "math" true})]
    (if (get r "ok")
      (get r "value")
      (throw (str "WASM eval-math 오류: " (get r "error"))))))

(defn wasm-defn-f64 [fn-name params body]
  (let [m (wasm-module [(wasm-fn-f64 fn-name params body)])
        n (length params)]
    (cond
      (= n 0) (fn [] (wasm-run! m fn-name []))
      (= n 1) (fn [a] (wasm-run! m fn-name [a]))
      (= n 2) (fn [a b] (wasm-run! m fn-name [a b]))
      (= n 3) (fn [a b c] (wasm-run! m fn-name [a b c]))
      (= n 4) (fn [a b c d] (wasm-run! m fn-name [a b c d]))
      (= n 5) (fn [a b c d e] (wasm-run! m fn-name [a b c d e]))
      true (throw "wasm-defn-f64: 파라미터 최대 5개"))))

(defn -wasm-math-module [fns]
  (let [r (-wasm-exec "compile" {"fns" fns "math" true})]
    (if (get r "ok")
      {:ok true :wasm (get r "wasm") :size (get r "size") :math true}
      {:ok false :error (get r "error")})))

(defn wasm-defn-math [fn-name params body]
  (let [fn-def (wasm-fn-f64 fn-name params body)
        m (-wasm-math-module [fn-def])
        n (length params)]
    (when (not (get m :ok))
      (throw (str "WASM math 컴파일 오류: " (get m :error))))
    (cond
      (= n 0) (fn [] (wasm-run! m fn-name []))
      (= n 1) (fn [a] (wasm-run! m fn-name [a]))
      (= n 2) (fn [a b] (wasm-run! m fn-name [a b]))
      (= n 3) (fn [a b c] (wasm-run! m fn-name [a b c]))
      (= n 4) (fn [a b c d] (wasm-run! m fn-name [a b c d]))
      (= n 5) (fn [a b c d e] (wasm-run! m fn-name [a b c d e]))
      true (throw "wasm-defn-math: 파라미터 최대 5개"))))

;; ── f64 배열 연산 ─────────────────────────────────────────────────────────────

(defn wasm-arr-reduce-f64 [fl-arr init expr]
  (let [r (-wasm-exec "arr-reduce-f64" {
    "input_array" fl-arr "init" init "expr" expr
  })]
    (if (get r "ok")
      (get r "value")
      (throw (str "WASM arr-reduce-f64 오류: " (get r "error"))))))

(defn wasm-arr-map-f64 [fl-arr expr]
  (let [r (-wasm-exec "arr-map-f64" {
    "input_array" fl-arr "expr" expr
  })]
    (if (get r "ok")
      (get r "value")
      (throw (str "WASM arr-map-f64 오류: " (get r "error"))))))

(defn wasm-arr-zip-map-f64 [arr-a arr-b expr]
  (let [r (-wasm-exec "arr-zip-map-f64" {
    "arr_a" arr-a "arr_b" arr-b "expr" expr
  })]
    (if (get r "ok")
      (get r "value")
      (throw (str "WASM arr-zip-map-f64 오류: " (get r "error"))))))

(defn wasm-arr-scan-f64 [fl-arr init expr]
  (let [r (-wasm-exec "arr-scan-f64" {
    "input_array" fl-arr "init" init "expr" expr
  })]
    (if (get r "ok")
      (get r "value")
      (throw (str "WASM arr-scan-f64 오류: " (get r "error"))))))

;; ── f64 편의 함수 ─────────────────────────────────────────────────────────────

(defn wasm-arr-sum-f64 [arr]
  (wasm-arr-reduce-f64 arr 0.0 ["+" "acc" "x"]))

(defn wasm-arr-dot-f64 [arr-a arr-b]
  (wasm-arr-reduce-f64
    (wasm-arr-zip-map-f64 arr-a arr-b ["*" "a" "b"])
    0.0 ["+" "acc" "x"]))

(defn wasm-arr-scale-f64 [arr k]
  (wasm-arr-map-f64 arr ["*" "x" k]))

(defn wasm-arr-stats [arr]
  (let [n (length arr)
        s (wasm-arr-sum-f64 arr)
        mx (wasm-arr-reduce-f64 arr (first arr) ["if" [">" "x" "acc"] "x" "acc"])
        mn (wasm-arr-reduce-f64 arr (first arr) ["if" ["<" "x" "acc"] "x" "acc"])]
    {:sum s :mean (/ s n) :max mx :min mn :count n}))
