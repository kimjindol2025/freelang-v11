;; stdlib/web/v9-stdlib-dom.fl — DOM 조작 JS 헬퍼 (v11 SSR 재작성)
;; (load "stdlib/web/v9-stdlib-dom.fl")
;;
;; 서버에서 <script> 블록을 생성 → 브라우저에서 DOM 조작.
;; 모든 함수는 HTML 문자열을 반환합니다.

;; ── DOM 유틸리티 주입 ────────────────────────────────────────────
;; (dom-utils-js) → <script>window.fl = {...}</script>
;; 브라우저에서: fl.q("#id"), fl.setText(el, "text"), fl.on(el, "click", fn), ...
(defn dom-utils-js []
  "<script>(function(){
window.fl={
  q:function(s){return document.querySelector(s);},
  qAll:function(s){return Array.from(document.querySelectorAll(s));},
  id:function(i){return document.getElementById(i);},
  setText:function(el,t){if(el)el.textContent=String(t);},
  setHtml:function(el,h){if(el)el.innerHTML=h;},
  getText:function(el){return el?el.textContent:'';},
  getHtml:function(el){return el?el.innerHTML:'';},
  attr:function(el,k,v){if(!el)return '';if(v===undefined)return el.getAttribute(k)||'';el.setAttribute(k,v);},
  removeAttr:function(el,k){if(el)el.removeAttribute(k);},
  addClass:function(el,c){if(el)el.classList.add(c);},
  removeClass:function(el,c){if(el)el.classList.remove(c);},
  hasClass:function(el,c){return el?el.classList.contains(c):false;},
  toggleClass:function(el,c){if(el)el.classList.toggle(c);},
  css:function(el,p,v){if(!el)return '';if(v===undefined)return el.style[p]||'';el.style[p]=v;},
  append:function(p,c){if(p&&c)p.appendChild(c);},
  remove:function(el){if(el)el.remove();},
  create:function(tag){return document.createElement(tag);},
  on:function(el,ev,fn){if(el)el.addEventListener(ev,fn);},
  off:function(el,ev,fn){if(el)el.removeEventListener(ev,fn);}
};
})();</script>")

;; ── 즉시 실행 DOM 조작 스크립트 ─────────────────────────────────
;; (dom-set-text "#title" "새 제목") → <script>...</script>
(defn dom-set-text [selector text]
  (str "<script>(function(){"
       "var el=document.querySelector(" (json-stringify selector) ");"
       "if(el)el.textContent=" (json-stringify text) ";"
       "})();</script>"))

;; (dom-set-html "#content" "<p>내용</p>") — XSS 주의: 신뢰된 HTML만
(defn dom-set-html [selector html]
  (str "<script>(function(){"
       "var el=document.querySelector(" (json-stringify selector) ");"
       "if(el)el.innerHTML=" (json-stringify html) ";"
       "})();</script>"))

;; (dom-add-class "#btn" "active")
(defn dom-add-class [selector class-name]
  (str "<script>(function(){"
       "document.querySelectorAll(" (json-stringify selector) ")"
       ".forEach(function(el){el.classList.add(" (json-stringify class-name) ");});"
       "})();</script>"))

;; (dom-remove-class "#btn" "active")
(defn dom-remove-class [selector class-name]
  (str "<script>(function(){"
       "document.querySelectorAll(" (json-stringify selector) ")"
       ".forEach(function(el){el.classList.remove(" (json-stringify class-name) ");});"
       "})();</script>"))

;; (dom-show "#panel") / (dom-hide "#panel")
(defn dom-show [selector]
  (str "<script>(function(){"
       "var el=document.querySelector(" (json-stringify selector) ");"
       "if(el)el.style.display='';"
       "})();</script>"))

(defn dom-hide [selector]
  (str "<script>(function(){"
       "var el=document.querySelector(" (json-stringify selector) ");"
       "if(el)el.style.display='none';"
       "})();</script>"))

;; ── 이벤트 핸들러 바인딩 스크립트 ───────────────────────────────
;; (dom-on-click "#btn" "console.log('clicked')")
(defn dom-on-click [selector handler-body]
  (str "<script>(function(){"
       "document.querySelectorAll(" (json-stringify selector) ")"
       ".forEach(function(el){"
       "el.addEventListener('click',function(event){" handler-body "});});"
       "})();</script>"))

;; (dom-on-input "#input" "flSetState('query',event.target.value)")
(defn dom-on-input [selector handler-body]
  (str "<script>(function(){"
       "document.querySelectorAll(" (json-stringify selector) ")"
       ".forEach(function(el){"
       "el.addEventListener('input',function(event){" handler-body "});});"
       "})();</script>"))
