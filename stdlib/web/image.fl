;; stdlib/web/image.fl — 이미지 최적화 헬퍼 (v11)
;; (load "stdlib/web/image.fl")
;;
;; next/image 대체. srcset + lazy loading으로 Core Web Vitals 최적화.

;; ── 내부 속성 이스케이프 ─────────────────────────────────────────
(defn _img-esc [s] (if (nil? s) "" (str s)))

;; ── 핵심: render-image ───────────────────────────────────────────
;; (render-image "/img/hero.jpg" "Hero" {:width 1200 :height 630})
;; → <img src="..." alt="..." width="..." height="..." loading="lazy" ...>
(defn render-image [src alt opts]
  (let [o       (?? opts {})
        width   (?? (get o :width) (?? (get o "width") 0))
        height  (?? (get o :height) (?? (get o "height") 0))
        loading (?? (get o :loading) (?? (get o "loading") "lazy"))
        decoding (?? (get o :decoding) (?? (get o "decoding") "async"))
        class   (?? (get o :class) (?? (get o "class") ""))
        srcset  (?? (get o :srcset) (?? (get o "srcset") ""))
        w-attr  (if (> width 0) (str " width=\"" width "\"") "")
        h-attr  (if (> height 0) (str " height=\"" height "\"") "")
        c-attr  (if (str-blank? class) "" (str " class=\"" class "\""))
        ss-attr (if (str-blank? srcset) "" (str " srcset=\"" srcset "\""))]
    (str "<img src=\"" (_img-esc src) "\" alt=\"" (_img-esc alt) "\""
         w-attr h-attr c-attr ss-attr
         " loading=\"" loading "\" decoding=\"" decoding "\">")))

;; ── 반응형 srcset 헬퍼 ───────────────────────────────────────────
;; (srcset-for "/img/hero" [320 640 1024 1920]) → "/img/hero-320w.webp 320w, ..."
;; (srcset-for "/img/hero" [320 640] {:ext "avif"})
(defn srcset-for [base widths]
  (str-join
    (map (fn [w] (str base "-" w "w.webp " w "w")) widths)
    ", "))

(defn srcset-for-ext [base widths ext]
  (str-join
    (map (fn [w] (str base "-" w "w." ext " " w "w")) widths)
    ", "))

;; ── 반응형 <picture> 요소 ────────────────────────────────────────
;; (render-picture "/img/hero" "Hero" [320 640 1024] {})
(defn render-picture [base alt widths opts]
  (let [o       (?? opts {})
        width   (?? (get o :width) (?? (get o "width") 0))
        height  (?? (get o :height) (?? (get o "height") 0))
        class   (?? (get o :class) (?? (get o "class") ""))
        sizes   (?? (get o :sizes) (?? (get o "sizes") "100vw"))
        avif    (srcset-for-ext base widths "avif")
        webp    (srcset-for-ext base widths "webp")
        jpg-src (str base ".jpg")
        w-attr  (if (> width 0) (str " width=\"" width "\"") "")
        h-attr  (if (> height 0) (str " height=\"" height "\"") "")
        c-attr  (if (str-blank? class) "" (str " class=\"" class "\""))]
    (str "<picture>"
         "<source type=\"image/avif\" srcset=\"" avif "\" sizes=\"" sizes "\">"
         "<source type=\"image/webp\" srcset=\"" webp "\" sizes=\"" sizes "\">"
         "<img src=\"" jpg-src "\" alt=\"" alt "\""
         w-attr h-attr c-attr
         " loading=\"lazy\" decoding=\"async\"></picture>")))

;; ── CDN URL 빌더 ────────────────────────────────────────────────
;; (cdn-url "/img/hero.jpg" {:width 800 :quality 80})
(defn cdn-url [src opts]
  (let [o       (?? opts {})
        width   (?? (get o :width) (?? (get o "width") 0))
        quality (?? (get o :quality) (?? (get o "quality") 80))
        format  (?? (get o :format) (?? (get o "format") "auto"))
        w-q     (if (> width 0) (str "&w=" width) "")]
    (str src "?cdn=1" w-q "&q=" quality "&f=" format)))

;; ── LCP 우선순위 이미지 ──────────────────────────────────────────
;; (render-image-priority "/img/hero.jpg" "Hero" {:width 1200 :height 630})
(defn render-image-priority [src alt opts]
  (let [o      (?? opts {})
        merged (obj-merge o {:loading "eager" :decoding "sync"})]
    (render-image src alt merged)))
