;; stdlib/web/v9-stdlib-fetch.fl — 브라우저 Fetch 헬퍼 JS (v11 SSR 재작성)
;; (load "stdlib/web/v9-stdlib-fetch.fl")
;;
;; 서버에서 <script> 블록을 생성 → 브라우저에서 API 호출.
;; 모든 함수는 HTML 문자열을 반환합니다.

;; ── Fetch 유틸리티 주입 ──────────────────────────────────────────
;; (fetch-utils-js) → <script>window.flFetch = {...}</script>
;; 브라우저에서:
;;   flFetch.get('/api/users').then(data => ...)
;;   flFetch.post('/api/users', {name: 'Alice'}).then(data => ...)
(defn fetch-utils-js []
  "<script>(function(){
var headers={'Content-Type':'application/json'};
window.flFetch={
  _req:async function(url,opts){
    try{
      var res=await fetch(url,opts);
      var ct=res.headers.get('content-type')||'';
      if(ct.includes('application/json')){
        var data=await res.json();
        return {ok:res.ok,status:res.status,data:data};
      }
      var text=await res.text();
      return {ok:res.ok,status:res.status,data:text};
    }catch(e){return {ok:false,error:e.message};}
  },
  get:function(url,hdrs){
    return this._req(url,{method:'GET',headers:Object.assign({},headers,hdrs||{})});
  },
  post:function(url,body,hdrs){
    return this._req(url,{method:'POST',headers:Object.assign({},headers,hdrs||{}),body:JSON.stringify(body||{})});
  },
  put:function(url,body,hdrs){
    return this._req(url,{method:'PUT',headers:Object.assign({},headers,hdrs||{}),body:JSON.stringify(body||{})});
  },
  del:function(url,hdrs){
    return this._req(url,{method:'DELETE',headers:Object.assign({},headers,hdrs||{})});
  },
  patch:function(url,body,hdrs){
    return this._req(url,{method:'PATCH',headers:Object.assign({},headers,hdrs||{}),body:JSON.stringify(body||{})});
  }
};
})();</script>")

;; ── 버튼 클릭 → GET 요청 → DOM 업데이트 ────────────────────────
;; (fetch-on-click "#load-btn" "/api/data" "#result" "data.html")
;; data.html: 응답 객체에서 꺼낼 필드 경로 (예: "data.html", "data", "message")
(defn fetch-on-click [btn-selector url target-selector result-expr]
  (str "<script>(function(){"
       "document.querySelectorAll(" (json-stringify btn-selector) ")"
       ".forEach(function(el){"
       "el.addEventListener('click',async function(){"
       "el.disabled=true;"
       "var res=await flFetch.get(" (json-stringify url) ");"
       "var target=document.querySelector(" (json-stringify target-selector) ");"
       "if(target&&res.ok){var v=" result-expr ";target.textContent=typeof v==='string'?v:JSON.stringify(v);}"
       "el.disabled=false;"
       "});});"
       "})();</script>"))

;; ── 폼 AJAX 제출 (JSON) ──────────────────────────────────────────
;; (fetch-form-json "#my-form") — 폼 제출 시 JSON POST, 응답 처리
(defn fetch-form-json [form-selector]
  (str "<script>(function(){"
       "document.querySelectorAll(" (json-stringify form-selector) ")"
       ".forEach(function(form){"
       "if(form.__flFetch)return;form.__flFetch=true;"
       "form.addEventListener('submit',async function(ev){"
       "ev.preventDefault();"
       "var data=Object.fromEntries(new FormData(form));"
       "var res=await flFetch.post(form.action||window.location.pathname,data);"
       "form.dispatchEvent(new CustomEvent('fl-fetch-done',{detail:res}));"
       "if(res.ok&&res.data&&res.data.redirect)window.location=res.data.redirect;"
       "var errEl=form.querySelector('[data-fl-error]');"
       "if(errEl)errEl.textContent=(res.ok?'':(res.data&&res.data.message)||'오류 발생');"
       "});"
       "});"
       "})();</script>"))

;; ── 주기적 폴링 ─────────────────────────────────────────────────
;; (fetch-poll "/api/status" 5000 "document.getElementById('status').textContent=data.status")
(defn fetch-poll [url interval-ms handler-body]
  (str "<script>(function(){"
       "async function poll(){"
       "var res=await flFetch.get(" (json-stringify url) ");"
       "if(res.ok){var data=res.data;" handler-body ";}"
       "}"
       "poll();setInterval(poll," interval-ms ");"
       "})();</script>"))
