;; stdlib/web/v9-stdlib-storage.fl — localStorage/sessionStorage JS 헬퍼 (v11 SSR 재작성)
;; (load "stdlib/web/v9-stdlib-storage.fl")
;;
;; 서버에서 <script> 블록을 생성 → 브라우저에서 스토리지 관리.
;; 모든 함수는 HTML 문자열을 반환합니다.

;; ── 스토리지 유틸리티 주입 ───────────────────────────────────────
;; (storage-utils-js) → <script>window.flStorage = {...}</script>
;; 브라우저에서:
;;   flStorage.set('key', value)
;;   flStorage.get('key', defaultValue)
;;   flStorage.remove('key')
;;   flStorage.session.set/get/remove (sessionStorage)
(defn storage-utils-js []
  "<script>(function(){
function makeStorage(s){
  return {
    set:function(k,v){try{s.setItem(k,JSON.stringify(v));}catch(e){}},
    get:function(k,def){try{var v=s.getItem(k);return v!==null?JSON.parse(v):(def!==undefined?def:null);}catch(e){return def!==undefined?def:null;}},
    remove:function(k){s.removeItem(k);},
    clear:function(){s.clear();},
    has:function(k){return s.getItem(k)!==null;},
    keys:function(){return Object.keys(s);}
  };
}
window.flStorage=makeStorage(localStorage);
window.flSession=makeStorage(sessionStorage);
})();</script>")

;; ── 페이지 로드 시 스토리지 값 읽어 DOM 업데이트 ────────────────
;; (storage-load-js "theme" "#theme-indicator" "data-theme")
(defn storage-load-js [key selector attr-or-text]
  (str "<script>(function(){"
       "var val=flStorage.get(" (json-stringify key) ");"
       "if(val===null)return;"
       "var el=document.querySelector(" (json-stringify selector) ");"
       "if(!el)return;"
       (if (= attr-or-text "textContent")
         "el.textContent=String(val);"
         (if (= attr-or-text "value")
           "el.value=String(val);"
           (str "el.setAttribute(" (json-stringify attr-or-text) ",String(val));")))
       "})();</script>"))

;; ── 다크모드 토글 + 저장 ────────────────────────────────────────
;; (dark-mode-js) → 다크모드 토글 + localStorage 저장 스크립트
(defn dark-mode-js []
  "<script>(function(){
var saved=flStorage.get('fl-dark-mode');
if(saved===true||(saved===null&&window.matchMedia('(prefers-color-scheme:dark)').matches)){
  document.documentElement.classList.add('dark');
}
window.flToggleDark=function(){
  var isDark=document.documentElement.classList.toggle('dark');
  flStorage.set('fl-dark-mode',isDark);
};
})();</script>")

;; ── 최근 방문 기록 ───────────────────────────────────────────────
;; (track-visit-js) → 현재 페이지 방문 기록 (최대 10개)
(defn track-visit-js []
  "<script>(function(){
var key='fl-visits';
var visits=flStorage.get(key)||[];
var entry={url:location.pathname,time:Date.now()};
visits=visits.filter(function(v){return v.url!==entry.url;});
visits.unshift(entry);
if(visits.length>10)visits=visits.slice(0,10);
flStorage.set(key,visits);
})();</script>")
