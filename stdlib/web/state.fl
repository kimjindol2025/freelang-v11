;; stdlib/web/state.fl — 반응형 상태 관리 + DOM 바인딩 (v11)
;; (load "stdlib/web/state.fl")
;;
;; 서버에서 <script> 블록을 생성하는 SSR 헬퍼들.
;; 브라우저에서 window.flGetState / flSetState / flSubscribe / flAction 제공.

;; ── 상태 초기화 스크립트 ────────────────────────────────────────
;; (init-state-js {:count 0 :name "Alice"}) → "<script>window.__flState=...;</script>"
(defn init-state-js [initial-state]
  (str "<script>"
       "window.__flState=window.__flState||{};"
       "Object.assign(window.__flState," (json-stringify initial-state) ");"
       "window.__flSubscribers=window.__flSubscribers||{};"
       "window.flGetState=function(k){return window.__flState[k];};"
       "window.flSetState=function(k,v){"
         "window.__flState[k]=v;"
         "var subs=window.__flSubscribers[k]||[];"
         "subs.forEach(function(fn){fn(v);});"
         "document.dispatchEvent(new CustomEvent('fl-state-change',{detail:{key:k,value:v}}));"
       "};"
       "window.flSubscribe=function(k,fn){"
         "window.__flSubscribers[k]=window.__flSubscribers[k]||[];"
         "window.__flSubscribers[k].push(fn);"
       "};"
       "window.flUnsubscribe=function(k,fn){"
         "var subs=window.__flSubscribers[k]||[];"
         "window.__flSubscribers[k]=subs.filter(function(s){return s!==fn;});"
       "};"
       "</script>"))

;; ── 상태 → DOM 바인딩 스크립트 ──────────────────────────────────
;; (bind-state-js "count" "#counter") → "<script>...</script>"
(defn bind-state-js [state-key selector]
  (str "<script>(function(){"
       "function _u(v){document.querySelectorAll('" selector "').forEach(function(el){el.textContent=String(v);});}"
       "flSubscribe('" state-key "',_u);"
       "document.addEventListener('DOMContentLoaded',function(){_u(flGetState('" state-key "')||'');});"
       "})();</script>"))

;; ── localStorage 영속화 스크립트 ────────────────────────────────
;; (persist-state-js ["count" "user"]) → "<script>...</script>"
(defn persist-state-js [keys]
  (str "<script>(function(){"
       "var persistKeys=" (json-stringify keys) ";"
       "persistKeys.forEach(function(k){"
         "var saved=localStorage.getItem('fl-state-'+k);"
         "if(saved!==null){try{flSetState(k,JSON.parse(saved));}catch(e){}}"
         "flSubscribe(k,function(v){localStorage.setItem('fl-state-'+k,JSON.stringify(v));});"
       "});"
       "})();</script>"))

;; ── 상태 블록 통합 렌더링 ───────────────────────────────────────
;; (render-state-block {:count 0} ["count"]) → init + persist 합친 스크립트
(defn render-state-block [initial-data persist-keys]
  (let [init (init-state-js initial-data)
        persist (if (> (length persist-keys) 0)
                  (persist-state-js persist-keys)
                  "")]
    (str init persist)))

;; ── 자동 바인딩 스크립트 ────────────────────────────────────────
;; HTML 속성으로 반응성 선언:
;;   <p data-fl-bind="count">0</p>          ← 상태 textContent 반영
;;   <input data-fl-model="name">           ← 양방향 input
;;   <button data-fl-click="inc">+1</button> ← 클릭 이벤트 연결
;;   <div data-fl-show="loggedIn">...</div> ← 조건부 표시
(defn auto-bind-js []
  (str "<script>(function(){"
       "var actions={};"
       "window.flAction=function(name,fn){actions[name]=fn;};"
       "function scanElement(root){"
         "var q=function(s){return root.querySelectorAll?root.querySelectorAll(s):[];};"
         "q('[data-fl-bind]').forEach(function(el){"
           "var k=el.getAttribute('data-fl-bind');"
           "if(el.__flBound===k)return;el.__flBound=k;"
           "var cur=flGetState(k);if(cur!==undefined)el.textContent=String(cur);"
           "flSubscribe(k,function(v){el.textContent=String(v);});"
         "});"
         "q('[data-fl-model]').forEach(function(el){"
           "var k=el.getAttribute('data-fl-model');"
           "if(el.__flModel===k)return;el.__flModel=k;"
           "var cur=flGetState(k);if(cur!==undefined)el.value=String(cur);"
           "el.addEventListener('input',function(){flSetState(k,el.value);});"
           "flSubscribe(k,function(v){if(document.activeElement!==el)el.value=String(v);});"
         "});"
         "q('[data-fl-click]').forEach(function(el){"
           "var name=el.getAttribute('data-fl-click');"
           "if(el.__flClick===name)return;el.__flClick=name;"
           "el.addEventListener('click',function(e){"
             "var fn=actions[name];if(fn)fn(e,el);else console.warn('[fl] no action: '+name);"
           "});"
         "});"
         "q('[data-fl-show]').forEach(function(el){"
           "var k=el.getAttribute('data-fl-show');"
           "if(el.__flShow===k)return;el.__flShow=k;"
           "function apply(v){el.style.display=(v&&v!=='false')?'':'none';}"
           "apply(flGetState(k));flSubscribe(k,apply);"
         "});"
       "}"
       "function scanAll(){scanElement(document);}"
       "if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',scanAll);"
       "else scanAll();"
       "new MutationObserver(function(muts){"
         "muts.forEach(function(m){"
           "m.addedNodes.forEach(function(n){if(n.nodeType===1)scanElement(n);});"
         "});"
       "}).observe(document.body,{childList:true,subtree:true});"
       "})();</script>"))

;; ── 액션 등록 스크립트 ───────────────────────────────────────────
;; (register-action-js "inc" "function(e,el){flSetState('count',(flGetState('count')||0)+1);}")
(defn register-action-js [name body-js]
  (str "<script>flAction(" (json-stringify name) "," body-js ");</script>"))

;; ── 낙관적 제출 스크립트 (data-fl-submit 폼 → AJAX + 즉시 UI 갱신) ──
;; <form data-fl-submit="/api/posts" data-fl-optimistic="posts:prepend">
(defn optimistic-submit-js []
  (str "<script>(function(){"
       "function applyOp(k,op,v){"
         "if(op==='set')flSetState(k,v);"
         "else if(op==='prepend'){var a=flGetState(k)||[];flSetState(k,[v].concat(a));}"
         "else if(op==='append'){var a=flGetState(k)||[];flSetState(k,a.concat([v]));}"
         "else if(op==='increment'){flSetState(k,(flGetState(k)||0)+(Number(v)||1));}"
       "}"
       "function attach(form){"
         "if(form.__flSubmit)return;form.__flSubmit=true;"
         "form.addEventListener('submit',async function(ev){"
           "ev.preventDefault();"
           "var endpoint=form.getAttribute('data-fl-submit');"
           "var optSpec=form.getAttribute('data-fl-optimistic');"
           "var data={};new FormData(form).forEach(function(v,k){data[k]=v;});"
           "var prev=null,key=null,op=null;"
           "if(optSpec){var parts=optSpec.split(':');key=parts[0];op=parts[1]||'set';"
             "prev=flGetState(key);applyOp(key,op,data);}"
           "var errEl=form.querySelector('[data-fl-error]');"
           "if(errEl)errEl.textContent='';"
           "form.classList.add('fl-submitting');"
           "try{"
             "var res=await fetch(endpoint,{"
               "method:form.getAttribute('method')||'POST',"
               "headers:{'Content-Type':'application/json'},"
               "body:JSON.stringify(data)});"
             "var body;try{body=await res.json();}catch(e){body={ok:res.ok};}"
             "if(!res.ok||body.success===false){"
               "if(key!==null)flSetState(key,prev);"
               "if(errEl)errEl.textContent=(body&&body.error)||('HTTP '+res.status);"
             "}else{"
               "if(key&&body&&body.data)applyOp(key,'set',body.data);"
               "form.reset();"
               "form.dispatchEvent(new CustomEvent('fl-submit-ok',{detail:body}));"
             "}"
           "}catch(err){"
             "if(key!==null)flSetState(key,prev);"
             "if(errEl)errEl.textContent=err.message||'network error';"
           "}finally{form.classList.remove('fl-submitting');}"
         "});"
       "}"
       "function scan(root){"
         "var q=root.querySelectorAll?root.querySelectorAll('form[data-fl-submit]'):[];"
         "q.forEach(attach);"
       "}"
       "if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){scan(document);});"
       "else scan(document);"
       "new MutationObserver(function(ms){"
         "ms.forEach(function(m){m.addedNodes.forEach(function(n){if(n.nodeType===1)scan(n);});});"
       "}).observe(document.body,{childList:true,subtree:true});"
       "})();</script>"))
