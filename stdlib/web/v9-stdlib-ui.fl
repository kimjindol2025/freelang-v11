;; stdlib/web/v9-stdlib-ui.fl — UI 컴포넌트 JS 헬퍼 (v11 SSR 재작성)
;; (load "stdlib/web/v9-stdlib-ui.fl")
;;
;; 서버에서 <script>/<style> 블록을 생성 → 브라우저 대화형 UI.
;; 모달, 드로어, 탭, 아코디언, 무한스크롤 등.

;; ── 드롭다운 메뉴 JS ─────────────────────────────────────────────
;; <button data-fl-dropdown="#menu1">메뉴▼</button>
;; <ul id="menu1" hidden>...</ul>
(defn dropdown-js []
  "<script>(function(){
document.addEventListener('click',function(e){
  var btn=e.target.closest('[data-fl-dropdown]');
  if(btn){
    var target=document.querySelector(btn.getAttribute('data-fl-dropdown'));
    if(target){
      var hidden=target.hasAttribute('hidden');
      document.querySelectorAll('[data-fl-dropdown-menu]').forEach(function(m){m.setAttribute('hidden','');});
      if(hidden){target.removeAttribute('hidden');target.setAttribute('data-fl-dropdown-menu','');}
      else target.setAttribute('hidden','');
    }
    e.stopPropagation();return;
  }
  document.querySelectorAll('[data-fl-dropdown-menu]').forEach(function(m){m.setAttribute('hidden','');});
});
})();</script>")

;; ── 탭 컴포넌트 JS ───────────────────────────────────────────────
;; HTML: <div data-fl-tabs>
;;         <button data-fl-tab="tab1" class="active">탭1</button>
;;         <button data-fl-tab="tab2">탭2</button>
;;       </div>
;;       <div data-fl-panel="tab1">내용1</div>
;;       <div data-fl-panel="tab2" hidden>내용2</div>
(defn tabs-js []
  "<script>(function(){
document.addEventListener('click',function(e){
  var btn=e.target.closest('[data-fl-tab]');
  if(!btn)return;
  var tab=btn.getAttribute('data-fl-tab');
  var container=btn.closest('[data-fl-tabs]');
  if(container){
    container.querySelectorAll('[data-fl-tab]').forEach(function(b){b.classList.remove('active');});
    btn.classList.add('active');
  }
  document.querySelectorAll('[data-fl-panel]').forEach(function(p){
    if(p.getAttribute('data-fl-panel')===tab)p.removeAttribute('hidden');
    else p.setAttribute('hidden','');
  });
});
})();</script>")

;; ── 아코디언 JS ──────────────────────────────────────────────────
;; HTML: <details class="fl-accordion"><summary>질문</summary><p>답변</p></details>
(defn accordion-js []
  "<script>(function(){
document.addEventListener('click',function(e){
  var summary=e.target.closest('.fl-accordion summary');
  if(!summary)return;
  var details=summary.parentElement;
  if(details.hasAttribute('open')){details.removeAttribute('open');}
  else{
    document.querySelectorAll('.fl-accordion[open]').forEach(function(d){d.removeAttribute('open');});
    details.setAttribute('open','');
  }
  e.preventDefault();
});
})();</script>")

;; ── 무한 스크롤 JS ───────────────────────────────────────────────
;; (infinite-scroll-js "/api/posts?page=" "#posts-container" "page")
(defn infinite-scroll-js [url-prefix container-selector page-param]
  (str "<script>(function(){"
       "var page=1,loading=false,done=false;"
       "var container=document.querySelector(" (json-stringify container-selector) ");"
       "async function loadMore(){"
       "if(loading||done||!container)return;"
       "loading=true;"
       "var res=await fetch(" (json-stringify url-prefix) "+page);"
       "var data=await res.json();"
       "if(!data||!data.items||data.items.length===0){done=true;return;}"
       "data.items.forEach(function(item){"
       "var div=document.createElement('div');"
       "div.textContent=JSON.stringify(item);"
       "container.appendChild(div);"
       "});"
       "page++;loading=false;"
       "}"
       "window.addEventListener('scroll',function(){"
       "if(window.innerHeight+window.scrollY>=document.body.offsetHeight-200)loadMore();"
       "});"
       "loadMore();"
       "})();</script>"))

;; ── 복사 버튼 JS ─────────────────────────────────────────────────
;; HTML: <button data-fl-copy="#code-block">복사</button>
(defn copy-btn-js []
  "<script>(function(){
document.addEventListener('click',function(e){
  var btn=e.target.closest('[data-fl-copy]');
  if(!btn)return;
  var target=document.querySelector(btn.getAttribute('data-fl-copy'));
  if(!target)return;
  navigator.clipboard.writeText(target.textContent||target.value||'')
    .then(function(){
      var orig=btn.textContent;btn.textContent='복사됨!';
      setTimeout(function(){btn.textContent=orig;},1500);
    });
});
})();</script>")

;; ── 전체 UI JS 주입 ──────────────────────────────────────────────
;; (all-ui-js) → dropdown + tabs + accordion + copy 한번에 주입
(defn all-ui-js []
  (str (dropdown-js) (tabs-js) (accordion-js) (copy-btn-js)))
