;; stdlib/web/metadata.fl — SEO 메타데이터 헬퍼 (v11)
;; (load "stdlib/web/metadata.fl")
;;
;; (render-meta {:title "페이지" :description "설명" :og-image "/img.jpg"})
;; → <title>...</title><meta ...>...

;; ── 속성값 이스케이프 (XSS 방지) ────────────────────────────────
(defn escape-attr [s]
  (if (nil? s) ""
    (str-replace-all
      (str-replace-all
        (str-replace-all
          (str-replace-all (str s) "&" "&amp;")
          "\"" "&quot;")
        "<" "&lt;")
      ">" "&gt;")))

;; ── 개별 태그 빌더 ───────────────────────────────────────────────
(defn meta-tag [name content]
  (if (or (nil? content) (= content "")) ""
    (str "<meta name=\"" name "\" content=\"" (escape-attr content) "\">")))

(defn og-tag [property content]
  (if (or (nil? content) (= content "")) ""
    (str "<meta property=\"" property "\" content=\"" (escape-attr content) "\">")))

(defn link-tag [rel href]
  (if (or (nil? href) (= href "")) ""
    (str "<link rel=\"" rel "\" href=\"" (escape-attr href) "\">")))

;; ── 통합 메타데이터 렌더러 ──────────────────────────────────────
;; 지원 키: :title :description :keywords :author :viewport :theme-color
;;          :og-title :og-description :og-image :og-url :og-type
;;          :twitter-card :twitter-site :canonical :robots
(defn render-meta [meta]
  (let [title    (?? (get meta "title") (?? (get meta :title) ""))
        desc     (?? (get meta "description") (?? (get meta :description) ""))
        keywords (?? (get meta "keywords") (?? (get meta :keywords) ""))
        author   (?? (get meta "author") (?? (get meta :author) ""))
        viewport (?? (get meta "viewport") (?? (get meta :viewport) "width=device-width,initial-scale=1"))
        theme    (?? (get meta "theme-color") (?? (get meta :theme-color) ""))
        canonical (?? (get meta "canonical") (?? (get meta :canonical) ""))
        robots   (?? (get meta "robots") (?? (get meta :robots) ""))
        og-title (?? (get meta "og-title") (?? (get meta :og-title) title))
        og-desc  (?? (get meta "og-description") (?? (get meta :og-description) desc))
        og-image (?? (get meta "og-image") (?? (get meta :og-image) ""))
        og-url   (?? (get meta "og-url") (?? (get meta :og-url) ""))
        og-type  (?? (get meta "og-type") (?? (get meta :og-type) "website"))
        tw-card  (?? (get meta "twitter-card") (?? (get meta :twitter-card)
                   (if (= og-image "") "summary" "summary_large_image")))
        tw-site  (?? (get meta "twitter-site") (?? (get meta :twitter-site) ""))
        title-tag (if (= title "") "" (str "<title>" (escape-attr title) "</title>"))]
    (str title-tag
         (meta-tag "viewport" viewport)
         (meta-tag "description" desc)
         (meta-tag "keywords" keywords)
         (meta-tag "author" author)
         (meta-tag "theme-color" theme)
         (meta-tag "robots" robots)
         (link-tag "canonical" canonical)
         (og-tag "og:title" og-title)
         (og-tag "og:description" og-desc)
         (og-tag "og:image" og-image)
         (og-tag "og:url" og-url)
         (og-tag "og:type" og-type)
         (meta-tag "twitter:card" tw-card)
         (meta-tag "twitter:site" tw-site)
         (meta-tag "twitter:title" og-title)
         (meta-tag "twitter:description" og-desc)
         (meta-tag "twitter:image" og-image))))

;; ── <head> 완성 블록 ─────────────────────────────────────────────
;; (page-head {:title "홈" :description "..."}) → <head>...</head>
(defn page-head [meta]
  (let [charset (?? (get meta "charset") (?? (get meta :charset) "UTF-8"))
        extra   (?? (get meta "extra") (?? (get meta :extra) ""))]
    (str "<head>"
         "<meta charset=\"" charset "\">"
         (render-meta meta)
         extra
         "</head>")))

;; ── set-meta! (동적 등록 플레이스홀더) ─────────────────────────
;; 페이지 렌더링 중 메타데이터 등록 — 현재는 passthrough
(defn set-meta! [meta] meta)
