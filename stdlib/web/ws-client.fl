;; stdlib/web/ws-client.fl — WebSocket 클라이언트 런타임 (v11)
;; (load "stdlib/web/ws-client.fl")
;;
;; 서버에서 <script> 블록 생성 → 브라우저에 자동 재연결 + 토픽 pub/sub 제공.
;;
;; 사용 예:
;;   (server_html (str "<html><body>"
;;                     (ws-client-runtime "/api/ws")
;;                     "</body></html>"))
;;
;; 브라우저에서:
;;   flWs.on('chat', function(data){ ... });
;;   flWs.send('chat', {text: "hi"});
;;
;; 또는 선언형 HTML 속성:
;;   <div data-fl-ws-on="chat:text">여기에 텍스트 업데이트</div>
;;   <div data-fl-ws-on="log:append">로그 누적</div>

;; ── 핵심 런타임 JS ─────────────────────────────────────────────
;; (ws-client-runtime "/api/ws")
;; → <script> 자동 재연결(지수 백오프) + 토픽 pub/sub + 선언형 바인딩
(defn ws-client-runtime [ws-url]
  (str "<script>(function(){"
       "var url=" (json-stringify ws-url) ";"
       "if(url.startsWith('/')){"
         "var proto=location.protocol==='https:'?'wss:':'ws:';"
         "url=proto+'//'+location.host+url;"
       "}"
       "var ws=null,delay=500,subs={},queue=[];"
       "function connect(){"
         "ws=new WebSocket(url);"
         "ws.onopen=function(){"
           "delay=500;"
           "while(queue.length)ws.send(queue.shift());"
           "(subs['__open']||[]).forEach(function(fn){fn();});"
         "};"
         "ws.onmessage=function(ev){"
           "var m;try{m=JSON.parse(ev.data);}catch(e){m={topic:'__raw',data:ev.data};}"
           "var topic=m.topic||'__message';"
           "(subs[topic]||[]).forEach(function(fn){fn(m.data,m);});"
           "(subs['__message']||[]).forEach(function(fn){fn(m);});"
         "};"
         "ws.onclose=function(){"
           "(subs['__close']||[]).forEach(function(fn){fn();});"
           "setTimeout(connect,Math.min(delay,10000));"
           "delay=Math.min(delay*2,10000);"
         "};"
         "ws.onerror=function(){try{ws.close();}catch(e){}};"
       "}"
       "window.flWs={"
         "on:function(topic,fn){(subs[topic]=subs[topic]||[]).push(fn);},"
         "off:function(topic,fn){subs[topic]=(subs[topic]||[]).filter(function(f){return f!==fn;});},"
         "send:function(topic,data){"
           "var payload=JSON.stringify({topic:topic,data:data});"
           "if(ws&&ws.readyState===1)ws.send(payload);"
           "else queue.push(payload);"
         "}"
       "};"
       "connect();"
       "function scanDeclarative(root){"
         "var q=root.querySelectorAll?root.querySelectorAll('[data-fl-ws-on]'):[];"
         "q.forEach(function(el){"
           "var spec=el.getAttribute('data-fl-ws-on');"
           "if(el.__flWs===spec)return;el.__flWs=spec;"
           "var parts=spec.split(':'),topic=parts[0],action=parts[1]||'text';"
           "window.flWs.on(topic,function(data){"
             "var txt=typeof data==='string'?data:JSON.stringify(data);"
             "if(action==='text')el.textContent=txt;"
             "else if(action==='html'){"
               "var d=document.createElement('div');d.textContent=txt;el.innerHTML=d.innerHTML;"
             "}"
             "else if(action==='append'){"
               "var li=document.createElement('div');li.textContent=txt;el.appendChild(li);"
             "}"
           "});"
         "});"
       "}"
       "if(document.readyState==='loading')"
         "document.addEventListener('DOMContentLoaded',function(){scanDeclarative(document);});"
       "else scanDeclarative(document);"
       "new MutationObserver(function(ms){"
         "ms.forEach(function(m){"
           "m.addedNodes.forEach(function(n){if(n.nodeType===1)scanDeclarative(n);});"
         "});"
       "}).observe(document.body,{childList:true,subtree:true});"
       "})();</script>"))

;; ── 토픽 구독 스크립트 ────────────────────────────────────────────
;; (ws-on "chat" "document.getElementById('log').textContent=data")
(defn ws-on [topic handler-body]
  (str "<script>flWs.on("
       (json-stringify topic)
       ",function(data,msg){" handler-body "});</script>"))

;; ── 클릭 시 전송 스크립트 ────────────────────────────────────────
;; (ws-send-on-click "#send-btn" "chat" "{text: document.getElementById('input').value}")
(defn ws-send-on-click [selector topic data-expr]
  (str "<script>document.querySelectorAll("
       (json-stringify selector)
       ").forEach(function(el){"
       "el.addEventListener('click',function(){"
         "flWs.send(" (json-stringify topic) ",(" data-expr "));"
       "});});</script>"))

;; ── 연결/해제 이벤트 훅 ──────────────────────────────────────────
;; (ws-on-open "console.log('connected')")
(defn ws-on-open [handler-body]
  (str "<script>flWs.on('__open',function(){" handler-body "});</script>"))

(defn ws-on-close [handler-body]
  (str "<script>flWs.on('__close',function(){" handler-body "});</script>"))

;; ── 상태 표시기 (연결/끊김 배지) ─────────────────────────────────
;; <span id="ws-status">●</span> 에 자동으로 색상 반영
;; (ws-status-indicator "#ws-status")
(defn ws-status-indicator [selector]
  (str "<script>"
       "(function(){"
       "var el=document.querySelector(" (json-stringify selector) ");"
       "if(!el)return;"
       "function setColor(c){el.style.color=c;}"
       "flWs.on('__open',function(){setColor('#10b981');});"
       "flWs.on('__close',function(){setColor('#ef4444');});"
       "})();"
       "</script>"))
