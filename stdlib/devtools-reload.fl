;; stdlib/devtools-reload.fl — v12 Hot Reload
;; (load "stdlib/devtools-reload.fl")
;;
;; 파일 변경 감지 → 라우트 재등록 (서버 재시작 없음)
;;
;; 빠른 시작:
;;   (load "stdlib/devtools-reload.fl")
;;   (hot-reload! "app.fl")          ; app.fl 변경 시 자동 재로드
;;
;; 세밀한 제어:
;;   (hot-reload! "routes.fl" {:debounce 200 :on-reload (fn [f] (println f))})
;;
;; 다중 파일:
;;   (watch-files ["routes.fl" "handlers.fl"] (fn [f] (reload-and-refresh! f)))

;; ── 핵심 API ──────────────────────────────────────────────────────────────────

(defn reload! [file-path]
  "파일을 현재 인터프리터 컨텍스트에서 재평가.
   defn/define이 현재 env에서 업데이트됨."
  (try
    (fl-reload file-path)
    (println (str "\x1b[36m[HOT]\x1b[0m reloaded: " file-path))
    (catch e
      (println (str "\x1b[31m[HOT]\x1b[0m reload error: " (get e "message"))))))

(defn reload-and-refresh! [file-path]
  "파일 재로드 후 라우트 재등록.
   HTTP 서버는 계속 실행됨 (포트 유지)."
  (try
    (server-clear-routes)
    (fl-reload file-path)
    (println (str "\x1b[36m[HOT]\x1b[0m reloaded + routes refreshed: " file-path))
    (catch e
      (println (str "\x1b[31m[HOT]\x1b[0m reload error: " (get e "message"))))))

(defn hot-reload! [file-path]
  "파일 변경 감지 → 자동 재로드 + 라우트 재등록.
   서버는 계속 실행. 옵션 없으면 기본값 사용."
  (hot-reload-opts! file-path {}))

(defn hot-reload-opts! [file-path opts]
  "hot-reload! + 옵션 지원.
   opts: {:debounce 300 :on-reload (fn [f] ...) :clear-routes true}"
  (let [debounce  (get opts :debounce 300)
        on-reload (get opts :on-reload nil)
        clear?    (get opts :clear-routes true)]
    (println (str "\x1b[2m[HOT] watching: " file-path "\x1b[0m"))
    (fl-watch file-path
      (fn [changed]
        (when clear? (server-clear-routes))
        (try
          (fl-reload changed)
          (println (str "\x1b[36m[HOT]\x1b[0m " (now-ms) " reloaded: " changed))
          (when on-reload (on-reload changed))
          (catch e
            (println (str "\x1b[31m[HOT]\x1b[0m error in " changed ": " (get e "message"))))))
      {:debounce debounce})))

;; ── 다중 파일 감시 ────────────────────────────────────────────────────────────

(defn watch-files [file-paths callback]
  "여러 파일을 동시에 감시. 각 변경마다 callback(changed-path) 호출."
  (map (fn [f] (fl-watch f callback {})) file-paths))

(defn hot-reload-dir! [dir ext]
  "디렉토리 내 특정 확장자 파일 모두 감시.
   예: (hot-reload-dir! \"routes\" \".fl\")"
  (let [files (filter
                (fn [f] (str-ends-with f ext))
                (file-list dir))]
    (watch-files files (fn [changed]
      (server-clear-routes)
      (try
        (fl-reload changed)
        (println (str "\x1b[36m[HOT]\x1b[0m reloaded: " changed))
        (catch e
          (println (str "\x1b[31m[HOT]\x1b[0m error: " (get e "message")))))))))

;; ── 파일 목록 헬퍼 ────────────────────────────────────────────────────────────

(defn file-list [dir]
  "디렉토리 내 파일 목록 반환 (전체 경로)."
  (let [r (shell-exec-result (str "find " dir " -type f 2>/dev/null"))]
    (if (get r :ok)
      (filter (fn [s] (> (length s) 0))
              (str-split (str-trim (get r :stdout)) "\n"))
      [])))
