;; stdlib/ai.fl — AI Runtime Layer 2
;; Layer 1(http-post-headers, json-parse/stringify)이 Native에서 동작하는 전제.

;; ── Anthropic Claude ──

(define ANTHROPIC_API "https://api.anthropic.com/v1/messages")
(define ANTHROPIC_VERSION "2023-06-01")

(defn ai-complete [prompt]
  (ai-complete-model prompt "claude-opus-4-8" 1024))

(defn ai-complete-model [prompt model max-tokens]
  (let [api-key (env-get "ANTHROPIC_API_KEY")]
    (if (null? api-key)
      (do (println "[ai-complete] ANTHROPIC_API_KEY 없음") nil)
      (let [;; OAuth Bearer(sk-ant-oat...) 또는 일반 API key(sk-ant-api...) 자동 감지
            headers (if (str-starts-with api-key "sk-ant-oat")
                      {"Authorization" (str "Bearer " api-key)
                       "anthropic-version" ANTHROPIC_VERSION
                       "content-type" "application/json"}
                      {"x-api-key" api-key
                       "anthropic-version" ANTHROPIC_VERSION
                       "content-type" "application/json"})
            body (json-stringify
                   {"model" model
                    "max_tokens" max-tokens
                    "messages" [{"role" "user" "content" prompt}]})
            res (http-post-headers ANTHROPIC_API body headers)]
        (if (= (get res "status") 200)
          (let [parsed (json-parse (get res "body"))]
            (get (get (get parsed "content") 0) "text"))
          (do (println "[ai-complete] error:" (get res "status"))
              nil))))))

;; ── 스트리밍 ──

(defn ai-make-headers [api-key]
  (if (str-starts-with api-key "sk-ant-oat")
    {"Authorization" (str "Bearer " api-key)
     "anthropic-version" ANTHROPIC_VERSION
     "content-type" "application/json"}
    {"x-api-key" api-key
     "anthropic-version" ANTHROPIC_VERSION
     "content-type" "application/json"}))

;; (ai-stream-collect prompt) → 전체 텍스트 문자열 반환
;; C 레벨에서 SSE 파싱 및 text_delta 축적
(defn ai-stream-collect [prompt]
  (ai-stream-collect-model prompt "claude-haiku-4-5-20251001" 1024))

(defn ai-stream-collect-model [prompt model max-tokens]
  (let [api-key (env-get "ANTHROPIC_API_KEY")]
    (if (null? api-key)
      (do (println "[ai-stream] ANTHROPIC_API_KEY 없음") "")
      (let [headers (ai-make-headers api-key)
            body (json-stringify
                   {"model" model
                    "max_tokens" max-tokens
                    "stream" true
                    "messages" [{"role" "user" "content" prompt}]})
            res (http-stream-collect ANTHROPIC_API body headers)]
        (if (= (get res "status") 200)
          (get res "text")
          (do (println "[ai-stream] error:" (get res "status")) ""))))))

;; ── OpenAI 호환 ──

(defn ai-openai [prompt base-url api-key model]
  (let [body (json-stringify
               {"model" model
                "messages" [{"role" "user" "content" prompt}]})]
    (let [res (http-post-headers
                (str base-url "/chat/completions") body
                {"Authorization" (str "Bearer " api-key)
                 "Content-Type" "application/json"})]
      (if (= (get res "status") 200)
        (let [parsed (json-parse (get res "body"))]
          (get (get (get (get parsed "choices") 0) "message") "content"))
        nil))))
