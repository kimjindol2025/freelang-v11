;; stdlib/env.fl — .env 파일 파싱 + 환경변수 관리 (v11.7.3)
;; (load "stdlib/env.fl")
;;
;; 사용법:
;;   (env-load! ".env")                    ;; .env 파일 로드
;;   (env-get "DATABASE_URL")              ;; → "mysql://..."  or nil
;;   (env-get-default "PORT" "3000")       ;; → 기본값 "3000"
;;   (env-require! "DATABASE_URL")         ;; 없으면 즉시 에러
;;   (env-int "PORT" 3000)                 ;; 정수 변환
;;   (env-bool "DEBUG" false)              ;; 불린 변환

;; ── 내부 저장소 (atom으로 가변 상태) ──────────────────────────────────────────

(define *env-store* (atom {}))

;; ── 파싱 헬퍼 ────────────────────────────────────────────────────────────────

(defn -env-parse-line [line]
  (let [trimmed (str-trim line)]
    (if (or (str-blank? trimmed)
            (str-starts-with trimmed "#"))
      nil
      (let [idx (str-index-of trimmed "=")]
        (if (< idx 1)
          nil
          (let [k   (str-trim (str-slice trimmed 0 idx))
                raw (str-trim (str-slice trimmed (+ idx 1) (length trimmed)))
                v   (if (and (str-starts-with raw "\"")
                             (str-ends-with raw "\""))
                      (str-slice raw 1 (- (length raw) 1))
                      (if (and (str-starts-with raw "'")
                               (str-ends-with raw "'"))
                        (str-slice raw 1 (- (length raw) 1))
                        raw))]
            {:k k :v v}))))))

(defn -env-parse [content]
  (let [lines  (str-lines content)
        parsed (filter (fn [x] (not (nil? x)))
                       (map -env-parse-line lines))]
    (reduce (fn [acc item]
              (assoc acc (get item :k) (get item :v)))
            {}
            parsed)))

;; ── 로드 ─────────────────────────────────────────────────────────────────────

(defn env-load! [path]
  (if (file-exists path)
    (let [content (file-read path)
          parsed  (-env-parse content)]
      (reset! *env-store* parsed)
      {:ok true :count (length (obj-keys parsed))})
    {:ok false :error (str "파일 없음: " path)}))

(defn env-load-default! []
  (env-load! ".env"))

;; ── 조회 ─────────────────────────────────────────────────────────────────────

(defn env-get [key]
  (let [from-store (get (deref *env-store*) key)]
    (if (nil? from-store)
      (fl-env-get key nil)
      from-store)))

(defn env-get-default [key default]
  (let [val (env-get key)]
    (if (nil? val) default val)))

(defn env-require! [key]
  (let [val (env-get key)]
    (if (nil? val)
      (throw (str "필수 환경변수 없음: " key))
      val)))

;; ── 타입 변환 ─────────────────────────────────────────────────────────────────

(defn env-int [key default]
  (let [val (env-get key)]
    (if (nil? val)
      default
      (let [n (str-to-num val)]
        (if (nil? n) default (int n))))))

(defn env-float [key default]
  (let [val (env-get key)]
    (if (nil? val)
      default
      (let [n (str-to-num val)]
        (if (nil? n) default n)))))

(defn env-bool [key default]
  (let [val (env-get key)]
    (if (nil? val)
      default
      (or (= val "true") (= val "1") (= val "yes")))))

;; ── 전체 조회 ─────────────────────────────────────────────────────────────────

(defn env-all []
  (deref *env-store*))

(defn env-keys []
  (obj-keys (deref *env-store*)))

