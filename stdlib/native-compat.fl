;; Small FreeLang wrappers for operations used by the native v11 suite.

(defn take [count items]
  (fl-vec-slice items 0 (if (< count 0) 0 count)))

(defn drop [count items]
  (fl-vec-slice items (if (< count 0) 0 count) (length items)))

(defn dissoc [items key]
  (fl-map-del items key))

(defn min [left right]
  (if (< left right) left right))

(defn str-to-lower [value]
  (str-lower value))
