;; stdlib/agent.fl — Agent Runtime (Layer 3)
;; 전제: stdlib/ai.fl 로드됨 (ai.fl이 http/json을 사용)

;; ── Claude API (tool_use 지원) ──

(defn agent-api-call [messages tools model max-tokens]
  (let [api-key (env-get "ANTHROPIC_API_KEY")]
    (if (null? api-key)
      nil
      (let [headers (if (str-starts-with api-key "sk-ant-oat")
                      {"Authorization" (str "Bearer " api-key)
                       "anthropic-version" "2023-06-01"
                       "content-type" "application/json"}
                      {"x-api-key" api-key
                       "anthropic-version" "2023-06-01"
                       "content-type" "application/json"})
            body (json-stringify
                   {"model" model
                    "max_tokens" max-tokens
                    "tools" tools
                    "messages" messages})
            res (http-post-headers
                  "https://api.anthropic.com/v1/messages"
                  body headers)]
        (if (= (get res "status") 200)
          (json-parse (get res "body"))
          (do (println "[agent] error:" (get res "status")) nil))))))

;; ── content 블록 처리 ──

(defn content-text [content]
  (if (null? content) ""
    (let [texts (filter (fn [b] (= (get b "type") "text")) content)]
      (if (= (length texts) 0) ""
        (get (get texts 0) "text")))))

(defn content-tool-uses [content]
  (if (null? content) []
    (filter (fn [b] (= (get b "type") "tool_use")) content)))

;; ── 내장 Tool 실행기 ──
;; 외부에서 (agent-add-tool name fn) 으로 확장 가능

(define _agent-tools (atom {}))

(defn agent-add-tool [name handler]
  (reset! _agent-tools (assoc @_agent-tools name handler)))

(defn agent-execute-tool [name input]
  (let [handler (get @_agent-tools name)]
    (if (not (null? handler))
      (str (handler input))
      ;; 내장 tool
      (cond
        [(= name "http_get")
         (let [url (get input "url")]
           (get (http-get url) "body"))]
        [(= name "http_post")
         (let [url  (get input "url")
               body (get input "body")
               ct   (if (null? (get input "content_type"))
                      "application/json"
                      (get input "content_type"))]
           (get (http-post url body ct) "body"))]
        [(= name "file_read")
         (let [path (get input "path")]
           (file-read path))]
        [(= name "file_write")
         (let [path    (get input "path")
               content (get input "content")]
           (file-write path content)
           "ok")]
        [(= name "str_contains")
         (str (str-includes (get input "text") (get input "substring")))]
        [true (str "[unknown tool: " name "]")]))))

;; tool_use 블록 → tool_result 변환
(defn run-tool-uses [tool-uses]
  (map
    (fn [tu]
      {"type"        "tool_use_id"
       "tool_use_id" (get tu "id")
       "type"        "tool_result"
       "content"     (agent-execute-tool (get tu "name") (get tu "input"))})
    tool-uses))

;; ── Agent 실행 루프 ──

(defn agent-run [user-prompt tools model max-turns]
  (loop [messages [{"role" "user" "content" user-prompt}]
         turn 0]
    (if (>= turn max-turns)
      "[max-turns 초과]"
      (let [resp (agent-api-call messages tools model 1024)]
        (if (null? resp)
          "[API 오류]"
          (let [stop    (get resp "stop_reason")
                content (get resp "content")]
            (if (= stop "end_turn")
              (content-text content)
              ;; tool_use → 실행 → 결과 전달
              (let [tool-uses    (content-tool-uses content)
                    tool-results (run-tool-uses tool-uses)
                    new-messages (push
                                   (push messages
                                     {"role" "assistant" "content" content})
                                   {"role" "user" "content" tool-results})]
                (recur new-messages (+ turn 1))))))))))

;; ── 편의 함수 ──

;; 기본 모델로 실행 (haiku)
(defn agent [user-prompt tools]
  (agent-run user-prompt tools "claude-haiku-4-5-20251001" 10))

;; 강력한 모델로 실행 (opus)
(defn agent-opus [user-prompt tools]
  (agent-run user-prompt tools "claude-opus-4-8" 10))

;; ── 기본 Tool 스키마 모음 ──

(define tool-http-get
  {"name" "http_get"
   "description" "URL에 HTTP GET 요청을 보내고 응답 본문을 반환한다"
   "input_schema" {"type" "object"
                   "properties" {"url" {"type" "string" "description" "요청할 URL"}}
                   "required" ["url"]}})

(define tool-http-post
  {"name" "http_post"
   "description" "URL에 HTTP POST 요청을 보낸다"
   "input_schema" {"type" "object"
                   "properties" {"url"          {"type" "string"}
                                 "body"         {"type" "string" "description" "요청 본문"}
                                 "content_type" {"type" "string" "description" "Content-Type (기본: application/json)"}}
                   "required" ["url" "body"]}})

(define tool-file-read
  {"name" "file_read"
   "description" "파일을 읽어 내용을 반환한다"
   "input_schema" {"type" "object"
                   "properties" {"path" {"type" "string" "description" "파일 경로"}}
                   "required" ["path"]}})

(define tool-file-write
  {"name" "file_write"
   "description" "파일에 내용을 쓴다"
   "input_schema" {"type" "object"
                   "properties" {"path"    {"type" "string"}
                                 "content" {"type" "string"}}
                   "required" ["path" "content"]}})

;; 자주 쓰는 tool 묶음
(define tools-web [tool-http-get tool-http-post])
(define tools-fs  [tool-file-read tool-file-write])
(define tools-all [tool-http-get tool-http-post tool-file-read tool-file-write])
