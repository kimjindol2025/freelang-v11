;; stdlib/rate-limiter.fl — app-level sliding window (v11.7.11)
;; (load "stdlib/rate-limiter.fl")
;;
;; Server-level cap is separate: (server_body_limit bytes) (server_rate_limit n ms)
;; See stdlib/http-limits.fl for 413/429 body shape.
;;
;;   (define rl (rl-create 100 60000))
;;   (rl-check rl "user:123")
;;     → {:ok true :value {:remaining 99 :reset-at N}}
;;     → {:ok false :code "RATE_LIMITED" :message "rate limited" :details {:remaining 0 :retry-after MS}}

(defn rl-create [limit window-ms]
  {:limit limit
   :window-ms window-ms
   :store (cache-create 10000)})

(defn rl-create-default []
  (rl-create 60 60000))

(defn -rl-get-entry [store key]
  (let [entry (cache-get store key)]
    (if (nil? entry)
      {:count 0 :window-start (now-ms)}
      entry)))

(defn -rl-in-window? [entry window-ms]
  (< (- (now-ms) (get entry :window-start)) window-ms))

(defn rl-check [rl key]
  (let [store     (get rl :store)
        limit     (get rl :limit)
        window-ms (get rl :window-ms)
        entry     (-rl-get-entry store key)
        now       (now-ms)]
    (if (-rl-in-window? entry window-ms)
      (if (< (get entry :count) limit)
        (let [new-entry {:count (+ (get entry :count) 1)
                         :window-start (get entry :window-start)}
              remaining (- limit (get new-entry :count))
              reset-at  (+ (get entry :window-start) window-ms)]
          (cache-set store key new-entry window-ms)
          {:ok true :value {:remaining remaining :reset-at reset-at}})
        (let [retry-after (- (+ (get entry :window-start) window-ms) now)]
          {:ok false
           :code "RATE_LIMITED"
           :message "rate limited"
           :details {:remaining 0 :retry-after retry-after}}))
      (let [new-entry {:count 1 :window-start now}
            remaining (- limit 1)]
        (cache-set store key new-entry window-ms)
        {:ok true :value {:remaining remaining :reset-at (+ now window-ms)}}))))

(defn rl-reset [rl key]
  (cache-del (get rl :store) key))

(defn rl-stats [rl key]
  (let [store     (get rl :store)
        limit     (get rl :limit)
        window-ms (get rl :window-ms)
        entry     (-rl-get-entry store key)]
    {:key        key
     :limit      limit
     :window-ms  window-ms
     :count      (get entry :count)
     :remaining  (- limit (get entry :count))
     :window-start (get entry :window-start)
     :reset-at   (+ (get entry :window-start) window-ms)}))

;; IP key: only use X-Forwarded-For when caller passes trusted-ip?.
;; Do not read forwarded headers as truth by default.
(defn rl-client-key [req trusted-ip?]
  (let [headers (get req "headers")
        fwd     (get headers "x-forwarded-for")
        ip      (if trusted-ip? fwd nil)]
    (str "ip:" (if (nil? ip) "unknown" ip))))

(defn rl-middleware [rl req handler trusted-ip?]
  (let [key    (rl-client-key req trusted-ip?)
        result (rl-check rl key)]
    (if (get result :ok)
      (handler req)
      (server-status 429 {:ok false
                          :data nil
                          :error {:code "RATE_LIMITED"
                                  :retry_after (get (get result :details) :retry-after)}
                          :request_id (get req :request_id)}))))
