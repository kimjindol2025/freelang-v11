;; stdlib/color-util.fl — 색상 변환/조작 유틸 (v11.7.3)
;; (load "stdlib/color-util.fl")
;;
;; 사용법:
;;   (color-hex->rgb "#FF5733")           → {:r 255 :g 87 :b 51}
;;   (color-rgb->hex 255 87 51)           → "#FF5733"
;;   (color-lighten "#336699" 20)         → 20% 밝게
;;   (color-darken "#336699" 20)          → 20% 어둡게
;;   (color-mix "#FF0000" "#0000FF" 0.5)  → 50% 혼합
;;   (color-contrast "#000000" "#FFFFFF") → 명암비 계산
;;   (color-accessible? fg bg)            → WCAG AA 기준 체크
;;
;; 실무 예제:
;;   (load "stdlib/color-util.fl")
;;   ;; 브랜드 컬러에서 전체 팔레트 자동 생성
;;   (defn brand-palette [base-hex]
;;     {:50  (color-lighten base-hex 45)
;;      :100 (color-lighten base-hex 35)
;;      :300 (color-lighten base-hex 15)
;;      :500 base-hex
;;      :700 (color-darken base-hex 15)
;;      :900 (color-darken base-hex 35)})

;; ── 내부 헬퍼 ────────────────────────────────────────────────────────────────

(defn -color-clamp [v]
  (max 0 (min 255 (int (round v)))))

(defn -hex-digit [n]
  (let [s "0123456789ABCDEF"]
    (str-slice s n (+ n 1))))

(defn -byte-to-hex [b]
  (str (-hex-digit (int (/ b 16))) (-hex-digit (% b 16))))

(defn -hex-byte [s i]
  (let [h (str-to-upper (str-slice s i (+ i 2)))
        hi (str-index-of "0123456789ABCDEF" (str-slice h 0 1))
        lo (str-index-of "0123456789ABCDEF" (str-slice h 1 2))]
    (+ (* hi 16) lo)))

;; ── 파싱 / 변환 ───────────────────────────────────────────────────────────────

(defn color-hex->rgb [hex]
  (let [h (if (str-starts-with hex "#") (str-slice hex 1 (length hex)) hex)
        h (if (= (length h) 3)
            (str (str-slice h 0 1) (str-slice h 0 1)
                 (str-slice h 1 2) (str-slice h 1 2)
                 (str-slice h 2 3) (str-slice h 2 3))
            h)]
    {:r (-hex-byte h 0)
     :g (-hex-byte h 2)
     :b (-hex-byte h 4)}))

(defn color-rgb->hex [r g b]
  (str "#"
       (-byte-to-hex (-color-clamp r))
       (-byte-to-hex (-color-clamp g))
       (-byte-to-hex (-color-clamp b))))

(defn color-rgb->hsl [r g b]
  (let [r1 (/ r 255)
        g1 (/ g 255)
        b1 (/ b 255)
        mx (max r1 (max g1 b1))
        mn (min r1 (min g1 b1))
        l  (/ (+ mx mn) 2)
        d  (- mx mn)
        s  (if (= d 0) 0
             (if (> l 0.5)
               (/ d (- 2 mx mn))
               (/ d (+ mx mn))))
        h  (if (= d 0) 0
             (cond
               (= mx r1) (* 60 (/ (- g1 b1) d))
               (= mx g1) (* 60 (+ (/ (- b1 r1) d) 2))
               true      (* 60 (+ (/ (- r1 g1) d) 4))))
        h  (if (< h 0) (+ h 360) h)]
    {:h (round h) :s (round (* s 100)) :l (round (* l 100))}))

(defn -hsl-to-rgb-channel [p q t]
  (let [t (if (< t 0) (+ t 1) t)
        t (if (> t 1) (- t 1) t)]
    (cond
      (< t (/ 1 6)) (+ p (* (- q p) 6 t))
      (< t (/ 1 2)) q
      (< t (/ 2 3)) (+ p (* (- q p) (- (/ 2 3) t) 6))
      true p)))

(defn color-hsl->rgb [h s l]
  (let [s1 (/ s 100)
        l1 (/ l 100)]
    (if (= s1 0)
      {:r (int (* l1 255)) :g (int (* l1 255)) :b (int (* l1 255))}
      (let [q (if (< l1 0.5)
                (* l1 (+ 1 s1))
                (- (+ l1 s1) (* l1 s1)))
            p  (- (* 2 l1) q)
            h1 (/ h 360)]
        {:r (-color-clamp (* 255 (-hsl-to-rgb-channel p q (+ h1 (/ 1 3)))))
         :g (-color-clamp (* 255 (-hsl-to-rgb-channel p q h1)))
         :b (-color-clamp (* 255 (-hsl-to-rgb-channel p q (- h1 (/ 1 3)))))}))))

(defn color-hex->hsl [hex]
  (let [rgb (color-hex->rgb hex)]
    (color-rgb->hsl (get rgb :r) (get rgb :g) (get rgb :b))))

(defn color-hsl->hex [h s l]
  (let [rgb (color-hsl->rgb h s l)]
    (color-rgb->hex (get rgb :r) (get rgb :g) (get rgb :b))))

;; ── 조작 ─────────────────────────────────────────────────────────────────────

(defn color-lighten [hex pct]
  (let [hsl (color-hex->hsl hex)
        new-l (min 100 (+ (get hsl :l) pct))]
    (color-hsl->hex (get hsl :h) (get hsl :s) new-l)))

(defn color-darken [hex pct]
  (let [hsl (color-hex->hsl hex)]
    (color-hsl->hex (get hsl :h) (get hsl :s) (max 0 (- (get hsl :l) pct)))))

(defn color-saturate [hex pct]
  (let [hsl (color-hex->hsl hex)
        new-s (min 100 (+ (get hsl :s) pct))]
    (color-hsl->hex (get hsl :h) new-s (get hsl :l))))

(defn color-desaturate [hex pct]
  (let [hsl (color-hex->hsl hex)
        new-s (max 0 (- (get hsl :s) pct))]
    (color-hsl->hex (get hsl :h) new-s (get hsl :l))))

(defn color-grayscale [hex]
  (color-desaturate hex 100))

(defn color-invert [hex]
  (let [rgb (color-hex->rgb hex)]
    (color-rgb->hex (- 255 (get rgb :r))
                    (- 255 (get rgb :g))
                    (- 255 (get rgb :b)))))

(defn color-mix [hex1 hex2 ratio]
  (let [rgb1 (color-hex->rgb hex1)
        rgb2 (color-hex->rgb hex2)
        r    (+ (* (get rgb1 :r) ratio) (* (get rgb2 :r) (- 1 ratio)))
        g    (+ (* (get rgb1 :g) ratio) (* (get rgb2 :g) (- 1 ratio)))
        b    (+ (* (get rgb1 :b) ratio) (* (get rgb2 :b) (- 1 ratio)))]
    (color-rgb->hex r g b)))

(defn color-opacity [hex alpha]
  (let [rgb (color-hex->rgb hex)]
    (str "rgba(" (get rgb :r) "," (get rgb :g) "," (get rgb :b) "," alpha ")")))

;; ── 접근성 / 명암비 ───────────────────────────────────────────────────────────

(defn -color-luminance [hex]
  (let [rgb (color-hex->rgb hex)
        linear (fn [c]
                 (let [v (/ c 255)]
                   (if (<= v 0.03928)
                     (/ v 12.92)
                     (pow (/ (+ v 0.055) 1.055) 2.4))))]
    (+ (* 0.2126 (linear (get rgb :r)))
       (* 0.7152 (linear (get rgb :g)))
       (* 0.0722 (linear (get rgb :b))))))

(defn color-contrast [fg bg]
  (let [l1 (-color-luminance fg)
        l2 (-color-luminance bg)
        lighter (max l1 l2)
        darker  (min l1 l2)]
    (/ (+ lighter 0.05) (+ darker 0.05))))

(defn color-accessible? [fg bg]
  (>= (color-contrast fg bg) 4.5))

(defn color-accessible-aa-large? [fg bg]
  (>= (color-contrast fg bg) 3.0))

;; ── 팔레트 생성 ───────────────────────────────────────────────────────────────

(defn color-palette [base-hex]
  {"50"  (color-lighten base-hex 45)
   "100" (color-lighten base-hex 35)
   "200" (color-lighten base-hex 25)
   "300" (color-lighten base-hex 15)
   "400" (color-lighten base-hex 7)
   "500" base-hex
   "600" (color-darken base-hex 7)
   "700" (color-darken base-hex 15)
   "800" (color-darken base-hex 25)
   "900" (color-darken base-hex 35)})

(defn color-complementary [hex]
  (let [hsl (color-hex->hsl hex)
        comp-h (% (+ (get hsl :h) 180) 360)]
    (color-hsl->hex comp-h (get hsl :s) (get hsl :l))))

(defn color-triadic [hex]
  (let [hsl (color-hex->hsl hex)
        h   (get hsl :h)
        s   (get hsl :s)
        l   (get hsl :l)]
    [hex
     (color-hsl->hex (% (+ h 120) 360) s l)
     (color-hsl->hex (% (+ h 240) 360) s l)]))

(defn color-analogous [hex]
  (let [hsl (color-hex->hsl hex)
        h   (get hsl :h)
        s   (get hsl :s)
        l   (get hsl :l)]
    [(color-hsl->hex (% (+ h 330) 360) s l)
     hex
     (color-hsl->hex (% (+ h 30) 360) s l)]))
