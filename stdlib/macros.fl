; stdlib/macros.fl — FreeLang 매크로 표준 라이브러리
; 사용: (load "stdlib/macros.fl")

; ── 제어 흐름 ──────────────────────────────────────────────────

; unless — 조건이 거짓일 때 실행
(defmacro unless [cond & body]
  (if (not cond) (do (splice body)) nil))

; when+ — 조건이 참일 때 여러 식 실행 (내장 when 확장)
(defmacro when+ [cond & body]
  (if cond (do (splice body)) nil))

; cond+ — 여러 조건 분기 (가독성 개선)
; 사용: (cond+ (> x 5) "크다" (= x 5) "같다" "작다")
; → 내장 cond 와 동일하지만 매크로로 확인 가능

; ── 디버그 / 테스트 ────────────────────────────────────────────

; assert! — 조건 실패 시 에러 메시지 출력
(defmacro assert! [expr msg]
  (if expr
    (println (str "  ✅ " msg))
    (println (str "  ❌ FAIL: " msg))))

; spy — 값을 출력하고 그대로 반환 (파이프라인 디버그용)
(defmacro spy [label expr]
  (let [v expr]
    (println (str "[spy] " label " = " v))
    v))

; time! — 실행 시간 측정
(defmacro time! [label & body]
  (let [t0 (now-ms)
        r  (do (splice body))
        t1 (now-ms)]
    (println (str "[time] " label " = " (- t1 t0) "ms"))
    r))

; ── 블록 구조 ─────────────────────────────────────────────────

; do+ — 여러 식을 순서대로 실행 (명시적 블록)
(defmacro do+ [& forms]
  (do (splice forms)))

; with-log — 라벨 출력 후 본문 실행
(defmacro with-log [label & body]
  (do
    (println (str "▶ " label))
    (splice body)
    (println (str "◀ " label))))

; ── 함수 적용 ─────────────────────────────────────────────────

; apply-fn — 함수 값을 인자에 적용 (함수가 변수일 때)
(defmacro apply-fn [f x]
  (f x))

; apply-fn2 — 함수 값을 두 인자에 적용
(defmacro apply-fn2 [f x y]
  (f x y))

; ── 값 처리 ───────────────────────────────────────────────────

; default — nil이면 기본값 반환 (or와 동일하지만 의도 명확)
(defmacro default [val fallback]
  (if (= val nil) fallback val))

; when-val — val이 nil이 아닐 때 본문 실행, val을 it로 바인딩
(defmacro when-val [val & body]
  (let [it val]
    (if (not (= it nil))
      (do (splice body))
      nil)))
