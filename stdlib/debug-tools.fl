;; debug-tools.fl — inspect, assert, watch, breakpoint, log-vars
;; (load "stdlib/debug-tools.fl")
;;
;; v11+cgc VERIFIED 버전. 변경사항:
;;   - docstring 제거 (cgc: defn 내 문자열 → 본문으로 취급)
;;   - count → length
;;   - :keyword 키 → "string" 키
;;   - if-let → let + if nil?
;;   - doseq [[k v] m] → doseq [k (keys m)] + (get m k)
;;   - *trace-depth* set! → atom
;;   - log-vars [& vars] → log-vars [pairs] (API 변경: 쌍 배열)
;;   - debug/time-fn (variadic+apply) 제거 — v11에서도 불완전
;;   - now → now_ms
;;
;; v11 검증: 2026-06-21 VERIFIED
;; cgc 검증: 2026-06-21 VERIFIED

;; ── 전역 상태 ─────────────────────────────────────────────────────────────────

(define *debug-enabled* true)
(define *watch-vars* (atom {}))
(define *trace-depth* (atom 0))

;; ── 1. inspect — 값 상세 출력 ────────────────────────────────────────────────

(defn -inspect-size [value]
  (if (array? value)
    (length value)
    (if (map? value)
      (length (keys value))
      "N/A")))

(defn inspect [name value]
  (do
    (println "")
    (println (str "🔍 inspect: " name))
    (println (str "  타입: " (type-of value)))
    (println (str "  크기: " (-inspect-size value)))
    (println (str "  값: " value))
    (println "")
    value))

;; ── 2. watch — 변수 변화 감시 ────────────────────────────────────────────────

(defn watch [var-name initial-value]
  (do
    (reset! *watch-vars*
      (assoc (deref *watch-vars*) var-name
        {"initial" initial-value "current" initial-value "changes" []}))
    (println (str "👁️ [watch] " var-name " 감시 시작: " initial-value))))

(defn update-watched [var-name new-value]
  (let [wv (get (deref *watch-vars*) var-name)]
    (if (nil? wv)
      (println (str "⚠️ [watch] " var-name " 등록되지 않음"))
      (let [old-value (get wv "current")
            new-entry {"from" old-value "to" new-value "time" (now_ms)}
            new-wv (assoc (assoc wv "current" new-value)
                          "changes" (push (get wv "changes") new-entry))]
        (reset! *watch-vars* (assoc (deref *watch-vars*) var-name new-wv))
        (println (str "📊 [watch] " var-name " 변경: " old-value " → " new-value))))))

;; ── 3. debug-trace — 함수 호출 추적 ──────────────────────────────────────────
;;
;; debug-trace [fn-name body-fn] — body-fn은 인자 없는 함수
;; 사용: (debug-trace "fetch" (fn [] (db-query ...)))
;;
;; [주의] 중첩 인라인 (fn [] ...) 사용 시 cgc는 top-level defn으로 분리 필요
;; [v11 제약] 고차함수 경계에서 function 파라미터 클로저 캡처 실패 (v11 해석기 버그)
;;   → v11에서 중첩 defn body-fn 호출 시 "Function not found: body-fn" 오류
;;   → cgc에서는 정상 동작
;; 이름: v11 내장 trace 와 충돌하지 않도록 debug-trace 사용

(defn debug-trace [fn-name body-fn]
  (do
    (println (str "├─ " fn-name))
    (body-fn)))

;; ── 4. breakpoint — 컨텍스트 출력 ───────────────────────────────────────────

(defn breakpoint [name context]
  (do
    (println "")
    (println (str "⏸️ === 브레이크포인트: " name " ==="))
    (println "컨텍스트:")
    (doseq [k (keys context)]
      (println (str "  " k " = " (get context k))))
    (println "")
    context))

;; ── 5. assert — 조건 검증 ────────────────────────────────────────────────────

(defn assert [condition message]
  (if (not condition)
    (do
      (println "")
      (println (str "❌ assertion failed: " message))
      (throw message))
    (do
      (println (str "✅ assertion passed: " message))
      true)))

;; ── 6. log-vars — 여러 변수 출력 ─────────────────────────────────────────────
;;
;; API 변경 (v11 variadic → cgc 호환 배열):
;;   v11 이전: (log-vars ["a" 1] ["b" "hello"])
;;   현재:     (log-vars [["a" 1] ["b" "hello"]])
;;
;; 각 pair = [이름 값] 쌍

(defn log-vars [pairs]
  (do
    (println "")
    (println "📋 === 변수 로그 ===")
    (doseq [pair pairs]
      (println (str "  " (first pair) ": " (get pair 1))))
    (println "")))
