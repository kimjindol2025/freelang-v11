;; stdlib/parallel.fl — 병렬 실행 (task-parallel-agent)
;; 주의: ai 함수 사용 시 사용하는 쪽에서 (load "stdlib/ai.fl") 먼저 실행

;; (parallel-run [fn1 fn2 fn3]) → [result1 result2 result3]
(defn parallel-run [fns]
  (run-parallel fns 0))

;; (parallel-run-timeout [fn1 fn2] ms) → 결과 배열
(defn parallel-run-timeout [fns timeout-ms]
  (run-parallel fns timeout-ms))
