;; 파일 ops
(define path "/tmp/fl-test-stub.txt")
(file-write path "hello native")
(println (str "file-exists: " (file-exists path)))
(println (str "file-read:   " (file-read path)))
(file-append path "\nappended")
(println (str "after-append: " (file-read path)))
(println (str "file-size:   " (_fl_file_size path)))
(println (str "is-file:     " (_fl_file_is_file path)))
(println (str "is-dir:      " (_fl_file_is_dir "/tmp")))
(file-delete path)
(println (str "after-delete: " (file-exists path)))

;; 디렉토리
(define dpath "/tmp/fl-test-dir")
(file-mkdir dpath)
(println (str "mkdir+is-dir: " (_fl_file_is_dir dpath)))
(_fl_file_rmdir dpath)

;; 환경변수
(println (str "env HOME: " (env-get "HOME")))

;; 프로세스
(println (str "pid>0: " (> (_fl_process_pid) 0)))
(println (str "cwd:   " (_fl_process_getcwd)))

(println "ALL FILE/PROCESS PASS")
