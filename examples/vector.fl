(define v [1 2 3])
(println (vec-get v 0))
(println (vec-get v 2))
(println (vec-len v))
(define v2 (vec-push v 4))
(println (vec-len v))
(println (vec-len v2))
(define v3 (vec-set v 1 99))
(println (vec-get v3 1))
(println (vec-get v 1))
(define nested [[1 2] [3 4]])
(println (vec-get (vec-get nested 0) 1))
