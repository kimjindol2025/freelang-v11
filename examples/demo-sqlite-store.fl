;; ─────────────────────────────────────────────────────────────
;; demo-sqlite-store.fl — store.fl 실 사용 예제 + 검증
;; 실행: node bootstrap.js run examples/demo-sqlite-store.fl
;; ─────────────────────────────────────────────────────────────

(load "/root/freelang-v11/lib/validate.fl")
(load "/root/freelang-v11/lib/result.fl")
(load "/root/freelang-v11/lib/store.fl")

;; ── 1. store 정의 (DB 경로 주입) ─────────────────────────────

(define DB "/tmp/demo-store.db")

(define users
  (store/define DB "users"
    {:name  {"required" true "type" "string" "max-length" 80}
     :email {"type" "string" "email" true}
     :age   {"type" "number" "min" 0 "max" 150}}
    ["id INTEGER PRIMARY KEY AUTOINCREMENT"
     "name TEXT NOT NULL"
     "email TEXT"
     "age INTEGER"
     "created_at TEXT NOT NULL DEFAULT (datetime('now'))"]))

(define posts
  (store/define DB "posts"
    {:title   {"required" true "type" "string" "max-length" 200}
     :user_id {"required" true "type" "number"}}
    ["id INTEGER PRIMARY KEY AUTOINCREMENT"
     "user_id INTEGER NOT NULL"
     "title TEXT NOT NULL"
     "body TEXT"]))

;; ── 2. 마이그레이션 ─────────────────────────────────────────

(store/migrate users)
(store/migrate posts)
(println "✅ migrate OK")

;; ── 3. INSERT (검증 포함) ────────────────────────────────────

(define r1 (store/insert! users {:name "Alice" :email "alice@dclub.kr" :age 30}))
(define r2 (store/insert! users {:name "Bob" :email "bob@dclub.kr" :age 25}))
(define r3 (store/insert! users {:name "Carol" :email "carol@dclub.kr" :age 28}))

(println (str "✅ insert Alice: ok=" (res/ok? r1)))
(println (str "✅ insert Bob:   ok=" (res/ok? r2)))

;; 검증 실패 케이스
(define r-fail (store/insert! users {:name "" :email "invalid" :age -1}))
(println (str "✅ validation fail: ok=" (res/ok? r-fail)))
(println (str "   error: " (res/err-msg r-fail)))

;; ── 4. SELECT ────────────────────────────────────────────────

(define all (store/find-all users))
(println (str "✅ find-all count=" (length all)))

(define alices (store/find users {:name "Alice"}))
(println (str "✅ find Alice count=" (length alices)))

(define bob (store/find-one users {:name "Bob"}))
(println (str "✅ find-one Bob age=" (get bob "age")))

;; ── 5. UPDATE ────────────────────────────────────────────────

(define alice-row (store/find-one users {:name "Alice"}))
(define alice-id (get alice-row "id"))

(define ur (store/update! users {:age 31} {:id alice-id}))
(println (str "✅ update Alice age: ok=" (res/ok? ur)))

(define updated (store/find-one users {:id alice-id}))
(println (str "✅ Alice new age=" (get updated "age")))

;; ── 6. COUNT + EXISTS ────────────────────────────────────────

(define total (store/count users))
(println (str "✅ total count=" total))

(define active-count (store/count-where users {:age 30}))
(println (str "✅ age=30 count=" active-count))

(define exists (store/exists? users {:name "Bob"}))
(println (str "✅ Bob exists=" exists))

;; ── 7. TRANSACTION ───────────────────────────────────────────

(define carol-row (store/find-one users {:name "Carol"}))
(define carol-id (get carol-row "id"))

(define tx-result
  (store/tx DB (fn []
    (db_insert DB "posts" {:user_id carol-id :title "FreeLang으로 SQLite 쓰기" :body "store.fl 첫 포스트"})
    (db_insert DB "posts" {:user_id carol-id :title "트랜잭션 예제" :body "BEGIN/COMMIT 패턴"})
    "posts inserted")))

(println (str "✅ tx result: ok=" (res/ok? tx-result)))

(define carol-posts (store/find posts {:user_id carol-id}))
(println (str "✅ Carol posts count=" (length carol-posts)))
(println (str "✅ first post title=" (get (get carol-posts 0) "title")))

;; ── 8. DELETE ────────────────────────────────────────────────

(store/delete! users {:name "Bob"})
(println (str "✅ after delete count=" (store/count users)))

;; ── 9. RAW 쿼리 ─────────────────────────────────────────────

(define raw-result
  (store/raw-query users
    "SELECT u.name, p.title FROM users u JOIN posts p ON u.id = p.user_id ORDER BY p.id"
    []))
(println (str "✅ JOIN query count=" (length raw-result)))
(println (str "   row0: " (get (get raw-result 0) "name") " / " (get (get raw-result 0) "title")))

;; ── 10. 다른 경로 DB (저장 종속) ─────────────────────────────

(define ALT_DB "/tmp/alt-demo.db")

(define items
  (store/define ALT_DB "items"
    {:label {"required" true "type" "string"}}
    ["id INTEGER PRIMARY KEY AUTOINCREMENT"
     "label TEXT NOT NULL"]))

(store/migrate items)
(store/insert! items {:label "item-A"})
(store/insert! items {:label "item-B"})
(println (str "✅ alt-db items count=" (store/count items)))

(println "")
(println "ALL PASS ✅")
