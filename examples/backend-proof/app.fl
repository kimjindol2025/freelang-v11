;; FreeLang backend proof — HTTP + SQLite CRUD + restart persistence
;; 실행:
;;   FL_BACKEND_PROOF_DB=/tmp/backend-proof.sqlite \
;;   node bootstrap.js run examples/backend-proof/app.fl

(define $DB-PATH (or (env-get "FL_BACKEND_PROOF_DB") "./backend-proof.sqlite"))
(define $API-TOKEN (or (env-get "FL_BACKEND_PROOF_TOKEN") ""))
(define $DB {:type "sqlite" :path $DB-PATH})

(defn column-exists? [$name]
  (> (length (filter (fn [$column] (= (get $column "name") $name))
                     (db-query $DB "PRAGMA table_info(items)" [])))
     0))

(db-exec $DB
  "CREATE TABLE IF NOT EXISTS items (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, created_at TEXT NOT NULL, idempotency_key TEXT NOT NULL UNIQUE, request_name TEXT NOT NULL, version INTEGER NOT NULL DEFAULT 1)"
  [])

;; 기존 backend-proof DB를 데이터 손실 없이 현재 스키마로 올린다.
(if (not (column-exists? "idempotency_key"))
  (db-exec $DB "ALTER TABLE items ADD COLUMN idempotency_key TEXT" []))
(if (not (column-exists? "request_name"))
  (db-exec $DB "ALTER TABLE items ADD COLUMN request_name TEXT" []))
(if (not (column-exists? "version"))
  (db-exec $DB "ALTER TABLE items ADD COLUMN version INTEGER NOT NULL DEFAULT 1" []))

(db-exec $DB
  "UPDATE items SET idempotency_key = 'legacy-' || id WHERE idempotency_key IS NULL"
  [])
(db-exec $DB
  "UPDATE items SET request_name = name WHERE request_name IS NULL"
  [])
(db-exec $DB
  "CREATE UNIQUE INDEX IF NOT EXISTS items_idempotency_key_uq ON items(idempotency_key)"
  [])

(defn item-id [$req]
  (get (get $req "params") "id"))

(defn item-by-id [$id]
  (first (db-query $DB
           "SELECT id, name, created_at, version FROM items WHERE id = ?"
           [$id])))

(defn item-by-key [$key]
  (first (db-query $DB
           "SELECT id, request_name FROM items WHERE idempotency_key = ?"
           [$key])))

(defn authorized? [$req]
  (and (> (length $API-TOKEN) 0)
       (= (server-req-header $req "authorization")
          (str "Bearer " $API-TOKEN))))

(defn request-id [$req]
  (get $req "request_id"))

(defn log-response [$req $status $code]
  (println (json-stringify
    {"event" "backend_request"
     "request_id" (request-id $req)
     "method" (get $req "method")
     "path" (get $req "path")
     "status" $status
     "error_code" $code})))

(defn respond-ok [$req $data]
  (do
    (log-response $req 200 null)
    (server-json {"ok" true
                  "data" $data
                  "error" null
                  "request_id" (request-id $req)})))

(defn respond-error [$req $status $code]
  (do
    (log-response $req $status $code)
    (server-status $status
      (json-stringify {"ok" false
                       "data" null
                       "error" {"code" $code}
                       "request_id" (request-id $req)}))))

(defn unauthorized [$req]
  (respond-error $req 401 "UNAUTHORIZED"))

(defn valid-name? [$name]
  (and (string? $name) (> (length (str-trim $name)) 0)))

(defn idempotency-key [$req]
  (server-req-header $req "idempotency-key"))

(defn valid-idempotency-key? [$key]
  (and (string? $key) (> (length (str-trim $key)) 0)))

(defn handle-health [$req]
  (respond-ok $req {"service" "freelang-backend-proof"}))

(defn handle-list [$req]
  (if (authorized? $req)
    (respond-ok $req {"items" (db-query $DB "SELECT id, name, created_at, version FROM items ORDER BY id" [])})
    (unauthorized $req)))

(defn handle-get [$req]
  (if (authorized? $req)
    (let [[$item (item-by-id (item-id $req))]]
      (if (= $item null)
        (respond-error $req 404 "NOT_FOUND")
        (respond-ok $req {"item" $item})))
    (unauthorized $req)))

(defn handle-create [$req]
  (if (authorized? $req)
    (let [[$body (server-req-json $req)]]
      (if (= $body null)
        (respond-error $req 400 "INVALID_JSON")
        (let [[$name (get $body "name")]
              [$key (idempotency-key $req)]]
          (if (not (valid-name? $name))
            (respond-error $req 400 "INVALID_INPUT")
            (if (not (valid-idempotency-key? $key))
              (respond-error $req 400 "IDEMPOTENCY_KEY_REQUIRED")
              (let [[$clean-name (str-trim $name)]
                    [$clean-key (str-trim $key)]
                    [$existing (item-by-key $clean-key)]]
                (if (= $existing null)
                  (let [[$result (db-exec $DB
                                  "INSERT INTO items (name, created_at, idempotency_key, request_name) VALUES (?, ?, ?, ?)"
                                  [$clean-name (now-iso) $clean-key $clean-name])]
                        [$id (get $result "insertId")]]
                    (respond-ok $req {"item" (item-by-id $id)}))
                  (if (= (get $existing "request_name") $clean-name)
                    (respond-ok $req {"item" (item-by-id (get $existing "id"))})
                    (respond-error $req 409 "IDEMPOTENCY_CONFLICT")))))))))
    (unauthorized $req)))

(defn handle-update [$req]
  (if (authorized? $req)
    (let [[$id (item-id $req)]
          [$body (server-req-json $req)]]
      (if (= $body null)
        (respond-error $req 400 "INVALID_JSON")
        (let [[$name (get $body "name")]
              [$expected-version (get $body "version")]
              [$item (item-by-id $id)]]
          (if (or (not (valid-name? $name))
                  (not (number? $expected-version))
                  (< $expected-version 1))
            (respond-error $req 400 "INVALID_INPUT")
            (if (= $item null)
              (respond-error $req 404 "NOT_FOUND")
              (let [[$result (db-exec $DB
                               "UPDATE items SET name = ?, version = version + 1 WHERE id = ? AND version = ?"
                               [(str-trim $name) $id $expected-version])]]
                (if (= (get $result "affectedRows") 0)
                  (respond-error $req 409 "VERSION_CONFLICT")
                  (respond-ok $req {"item" (item-by-id $id)}))))))))
    (unauthorized $req)))

(defn handle-delete [$req]
  (if (authorized? $req)
    (let [[$id (item-id $req)]
          [$result (db-exec $DB "DELETE FROM items WHERE id = ?" [$id])]]
      (if (= (get $result "affectedRows") 0)
        (respond-error $req 404 "NOT_FOUND")
        (respond-ok $req {"deleted" 1})))
    (unauthorized $req)))

(server-get "/health" "handle-health")
(server-get "/api/items" "handle-list")
(server-get "/api/items/:id" "handle-get")
(server-post "/api/items" "handle-create")
(server-put "/api/items/:id" "handle-update")
(server-delete "/api/items/:id" "handle-delete")

(server-body-limit 4096)
(server-rate-limit 100 60000)
(server-start 40117)
(println "FreeLang backend proof: http://127.0.0.1:40117")
