;; N-06 SQLite3 DB C 포팅 E2E 검증
(define db (db-open ":memory:"))

;; CREATE
(db-exec db "CREATE TABLE items (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, score INTEGER)" [])
(println "CREATE OK")

;; INSERT
(db-exec db "INSERT INTO items (name, score) VALUES (?, ?)" ["alice" 95])
(db-exec db "INSERT INTO items (name, score) VALUES (?, ?)" ["bob" 80])
(db-exec db "INSERT INTO items (name, score) VALUES (?, ?)" ["carol" 72])
(println "INSERT OK")

;; SELECT
(define rows (db-query db "SELECT * FROM items ORDER BY score DESC" []))
(println (str "SELECT count=" (length rows)))
(println (str "first=" (get (get rows 0) "name") " score=" (get (get rows 0) "score")))

;; UPDATE
(db-exec db "UPDATE items SET score = ? WHERE name = ?" [100 "bob"])
(define updated (db-query db "SELECT score FROM items WHERE name = ?" ["bob"]))
(println (str "UPDATE score=" (get (get updated 0) "score")))

;; DELETE
(db-exec db "DELETE FROM items WHERE name = ?" ["carol"])
(define after-del (db-query db "SELECT COUNT(*) as cnt FROM items" []))
(println (str "DELETE remaining=" (get (get after-del 0) "cnt")))

(db-close db)
(println "ALL PASS")
