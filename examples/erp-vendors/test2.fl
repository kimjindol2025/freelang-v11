(load "test-auth-helper.fl")

(defn out [command args]
  (let [[r (evidence-run command args)]]
    (if (= (get r "code") 0) (get r "stdout")
      (throw (str "command failed: " command " " (get r "stderr"))))))
(defn has [text needle] (>= (_fl_str_index_of text needle) 0))
(defn count-text [text needle index total]
  (let [[found (_fl_str_index_of (substring text index (length text)) needle)]]
    (if (< found 0) total
      (count-text text needle (+ index found (length needle)) (+ total 1)))))
(defn check [condition name]
  (if condition (do (println (str "PASS " name)) true)
    (do (println (str "FAIL " name)) false)))
(defn start-server [work port binary]
  (erp-start-auth-server work port binary (get (cli-args) 2) "vendors.sqlite" "0"))
(defn request [url path args]
  (out "curl" (concat
    (concat (concat ["--silent" "--show-error" "--include"] args)
      (if (> (length args) 0)
        ["--cookie" (erp-test-cookie-jar url) "--data-urlencode" (str "_csrf=" (out "cat" [(str (erp-test-cookie-jar url) ".csrf")]))]
        ["--cookie" (erp-test-cookie-jar url)]))
    [(str url path)])))
(defn post-vendor [url name memo]
  (request url "/vendors" ["--data-urlencode" (str "name=" name) "--data-urlencode" "phone=000" "--data-urlencode" (str "memo=" memo)]))
(defn count-output [database]
  (out "sqlite3" [database "select count(*) from vendors;"]))
(defn sqlite-list [database]
  (out "sqlite3" [database "select id||'|'||name||'|'||memo from vendors order by id;"]))

(let [[work (get (cli-args) 0)] [binary (get (cli-args) 1)]
      [listener (tcp-listen "127.0.0.1" 0)]
      [port (tcp-local-port listener)]]
  (tcp-close listener)
  (let [[pid (str-trim (start-server work port binary))]
        [url (str "http://127.0.0.1:" port)]
        [database (str work "/vendors.sqlite")]]
    (do
      (evidence-run "sleep" ["0.1"])
      (let [[created1 (post-vendor url "Acme" "standard")]
            [created2 (post-vendor url "한글 거래처" "needle memo")]
            [created3 (post-vendor url "Percent%Vendor" "percent")]
            [created4 (post-vendor url "Under_score" "under")]
            [created5 (post-vendor url "<script>&\"'" "script")]
            [created6 (post-vendor url "O'Reilly" "apostrophe")]
            [search-hit (request url "/vendors?q=Acme" [])]
            [search-zero (request url "/vendors?q=no-such-vendor" [])]
            [search-korean (request url "/vendors?q=%ED%95%9C%EA%B8%80" [])]
            [search-plus (request url "/vendors?q=needle+memo" [])]
            [search-percent (request url "/vendors?q=%25" [])]
            [search-underscore (request url "/vendors?q=%5F" [])]
            [search-script (request url "/vendors?q=%3Cscript%3E" [])]
            [search-apostrophe (request url "/vendors?q=O%27Reilly" [])]
            [search-input-escape (has search-script "name=\"q\" value=\"&lt;script&gt;\"")]
            [xss-row (out "sh" ["-c" "curl --silent --show-error --cookie \"$2\" \"$1/vendors\" | grep '<td>.*&lt;script&gt;.*</td>'" "erp-test" url (erp-test-cookie-jar url)])]
            [concurrent (out "sh" ["-c" "work=$1; base=$2; jar=$3; csrf=$4; for i in $(seq 1 20); do curl --silent --show-error --cookie \"$jar\" --output \"$work/get-$i.body\" --write-out '%{http_code}' \"$base/vendors\" >\"$work/get-$i.code\" & done; for i in $(seq 1 10); do curl --silent --show-error --cookie \"$jar\" --output /dev/null --write-out '%{http_code}' --data-urlencode \"_csrf=$csrf\" --data-urlencode \"name=Concurrent-$i\" --data-urlencode \"phone=$i\" --data-urlencode 'memo=parallel' \"$base/vendors\" >\"$work/post-$i.code\" & done; wait; printf 'CONCURRENT_CODES_BEGIN\\n'; for i in $(seq 1 20); do cat \"$work/get-$i.code\"; printf '\\n'; done; for i in $(seq 1 10); do cat \"$work/post-$i.code\"; printf '\\n'; done; printf 'CONCURRENT_CODES_END\\n'" "erp-concurrent" work url (erp-test-cookie-jar url) (out "cat" [(str (erp-test-cookie-jar url) ".csrf")])])]
            [cli-after (sqlite-list database)]
            [concurrent-count (out "sqlite3" [database "select count(*) from vendors where name like 'Concurrent-%';"])]
            [total-count (count-output database)]
            [alive (out "curl" ["--silent" "--show-error" "--output" "/dev/null" "--write-out" "%{http_code}" (str url "/vendors") "--cookie" (erp-test-cookie-jar url)])]
            [checks [
              (check (and (has search-hit "Acme") (not (has search-hit "Beta"))) "search matches name")
              (check (not (has search-zero "<tr><td>")) "zero-result search is empty")
              (check (has search-korean "한글 거래처") "percent-encoded Korean query decodes")
              (check (has search-plus "한글 거래처") "plus decodes to a space and matches memo")
              (check (and (has search-percent "Percent%Vendor") (not (has search-percent "Acme"))) "percent is searched literally")
              (check (and (has search-underscore "Under_score") (not (has search-underscore "Acme"))) "underscore is searched literally")
              (check (and (has search-script "&lt;script&gt;&amp;&quot;&#39;") search-input-escape) "script query and search field are HTML escaped")
              (check (has search-apostrophe "O&#39;Reilly") "apostrophe query is parameterized")
              (check (and (has created1 "303") (has created2 "303") (has created3 "303") (has created4 "303") (has created5 "303") (has created6 "303")) "six example rows saved")
              (check (and (= (count-text concurrent "200\n" 0 0) 20) (= (count-text concurrent "303\n" 0 0) 10)) "all 20 list and 10 create requests returned")
              (check (and (= concurrent-count "10\n") (= total-count "16\n")) "SQLite confirms exactly ten concurrent inserts")
              (check (= alive "200") "server remains alive after concurrent requests")
            ]]
            [passed (length (filter (fn [result] result) checks))]]
        (do
          (println "SEARCH_APOSTROPHE_SQLITE:")
          (print (out "sqlite3" [database "select id||'|'||name from vendors where name='O''Reilly';"]))
          (println "XSS_ESCAPED_HTML_ROW:")
          (print xss-row)
          (println "CONCURRENT_RESPONSE_CODES:")
          (print concurrent)
          (println "SQLITE_AFTER_CONCURRENCY:")
          (print cli-after)
          (println "SQLITE_CONCURRENT_COUNT:")
          (print concurrent-count)
          (println "SQLITE_TOTAL_COUNT:")
          (print total-count)
          (out "sh" ["-c" "kill \"$1\" 2>/dev/null || true" "erp-test" pid])
          (println (str "ERP2_SUMMARY=" passed "/" (length checks))))))))
