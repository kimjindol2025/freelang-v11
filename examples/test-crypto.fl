(define secret "my-secret-key")

;; 1. 비밀번호 해싱
(define pw "password123")
(define hash (auth-hash-password pw))
(println (str "hash: " hash))

;; 2. 비밀번호 검증
(define ok (auth-verify-password pw hash))
(println (str "verify ok: " ok))
(define fail (auth-verify-password "wrong" hash))
(println (str "verify fail: " fail))

;; 3. JWT 서명
(define payload {"user_id" 42 "role" "admin"})
(define token (auth-jwt-sign payload secret 3600))
(println (str "token: " token))

;; 4. JWT 검증
(define verified (auth-jwt-verify token secret))
(println (str "verified.user_id: " (get verified "user_id")))

;; 5. JWT 만료 확인
(define expired (auth-jwt-expired token))
(println (str "expired: " expired))

(println "ALL CRYPTO PASS")
