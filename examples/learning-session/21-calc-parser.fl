;; 미니 계산기 파서 — 재귀 하강 파서
;; 문법: expr = term ((+|-) term)*
;;        term = factor ((*|/) factor)*
;;        factor = number | "(" expr ")" | "-" factor

(let [;; ── 렉서: 문자열 → 토큰 배열 ──
      tokenize (fn [s]
                 (loop [i 0 tokens []]
                   (if (>= i (length s))
                     tokens
                     (let [ch (substring s i (+ i 1))]
                       (cond
                         (or (= ch " ") (= ch "\t"))
                         (recur (+ i 1) tokens)

                         (or (= ch "+") (= ch "-")
                             (= ch "*") (= ch "/")
                             (= ch "(") (= ch ")"))
                         (recur (+ i 1) (append tokens {"type" "op" "val" ch}))

                         (and (>= ch "0") (<= ch "9"))
                         ;; 숫자: 연속된 자리 모두 읽기
                         (let [num (loop [j i acc ""]
                                     (if (>= j (length s))
                                       {"end" j "str" acc}
                                       (let [c (substring s j (+ j 1))]
                                         (if (or (and (>= c "0") (<= c "9"))
                                                 (= c "."))
                                           (recur (+ j 1) (str acc c))
                                           {"end" j "str" acc}))))]
                           (recur (get num "end")
                                  (append tokens {"type" "num"
                                                  "val"  (str-to-num (get num "str"))})))

                         :else
                         (recur (+ i 1) tokens))))))

      ;; ── 파서 상태 헬퍼 ──
      ;; state = {"tokens" [...] "pos" n}
      peek   (fn [st]    (get (get st "tokens") (get st "pos")))
      adv    (fn [st]    (assoc st "pos" (+ (get st "pos") 1)))
      at-end (fn [st]    (>= (get st "pos") (length (get st "tokens"))))

      ;; ── 재귀 하강 파서 ──
      ;; 각 함수: state → {"val" number "st" new-state}

      ;; 앞선언 (FreeLang은 let 내 상호재귀 불가 → 단일 parse-expr로 통합)
      ;; factor = number | "(" expr ")" | "-" factor
      parse-factor (fn [st]
                     (let [tok (peek st)]
                       (cond
                         (= tok nil)
                         {"val" 0 "st" st}

                         (= (get tok "type") "num")
                         {"val" (get tok "val") "st" (adv st)}

                         (and (= (get tok "type") "op") (= (get tok "val") "-"))
                         (let [r (parse-factor (adv st))]
                           {"val" (- 0 (get r "val")) "st" (get r "st")})

                         (and (= (get tok "type") "op") (= (get tok "val") "("))
                         (let [inner (parse-expr (adv st))
                               st2   (get inner "st")
                               close (peek st2)]
                           {"val" (get inner "val")
                            "st"  (if (and (not (= close nil))
                                           (= (get close "val") ")"))
                                    (adv st2)
                                    st2)})

                         :else
                         {"val" 0 "st" st})))

      ;; term = factor ((*|/) factor)*
      parse-term (fn [st]
                   (loop [left (parse-factor st)]
                     (let [tok (peek (get left "st"))]
                       (if (and (not (= tok nil))
                                (= (get tok "type") "op")
                                (or (= (get tok "val") "*")
                                    (= (get tok "val") "/")))
                         (let [op    (get tok "val")
                               right (parse-factor (adv (get left "st")))
                               v     (if (= op "*")
                                       (* (get left "val") (get right "val"))
                                       (/ (get left "val") (get right "val")))]
                           (recur {"val" v "st" (get right "st")}))
                         left))))

      ;; expr = term ((+|-) term)*
      parse-expr (fn [st]
                   (loop [left (parse-term st)]
                     (let [tok (peek (get left "st"))]
                       (if (and (not (= tok nil))
                                (= (get tok "type") "op")
                                (or (= (get tok "val") "+")
                                    (= (get tok "val") "-")))
                         (let [op    (get tok "val")
                               right (parse-term (adv (get left "st")))
                               v     (if (= op "+")
                                       (+ (get left "val") (get right "val"))
                                       (- (get left "val") (get right "val")))]
                           (recur {"val" v "st" (get right "st")}))
                         left))))

      ;; 최상위 계산
      calc (fn [expr-str]
             (let [tokens (tokenize expr-str)
                   result (parse-expr {"tokens" tokens "pos" 0})]
               (get result "val")))

      ;; 결과 출력 헬퍼
      show (fn [expr-str]
             (let [v (calc expr-str)]
               (println (str "  " expr-str " = " v))))]

  (println "=== 기본 사칙연산 ===")
  (show "1 + 2")
  (show "10 - 3")
  (show "4 * 5")
  (show "15 / 3")
  (println "")

  (println "=== 연산자 우선순위 ===")
  (show "2 + 3 * 4")
  (show "10 - 2 * 3")
  (show "2 * 3 + 4 * 5")
  (show "100 / 5 / 4")
  (println "")

  (println "=== 괄호 ===")
  (show "(2 + 3) * 4")
  (show "10 / (2 + 3)")
  (show "(1 + 2) * (3 + 4)")
  (show "((2 + 3) * 4) - 1")
  (println "")

  (println "=== 음수 ===")
  (show "-5 + 3")
  (show "10 + -3")
  (show "-(2 + 3)")
  (println "")

  (println "=== 실수 ===")
  (show "3.14 * 2")
  (show "1 / 3")
  (show "0.1 + 0.2"))
