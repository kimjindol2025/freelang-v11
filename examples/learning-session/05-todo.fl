;; 할 일 목록 — 추가 / 완료 / 필터 / 우선순위

(let [;; 할 일 생성
      make-todo  (fn [id title priority]
                   {:id id :title title :priority priority :done false})

      ;; 완료 처리
      complete   (fn [todos id]
                   (map (fn [t]
                          (if (= (get t :id) id)
                            (assoc t :done true)
                            t))
                        todos))

      ;; 우선순위별 필터
      by-priority (fn [todos p]
                    (filter (fn [t] (= (get t :priority) p)) todos))

      ;; 미완료만 필터
      pending    (fn [todos]
                   (filter (fn [t] (= (get t :done) false)) todos))

      ;; 완료만 필터
      done       (fn [todos]
                   (filter (fn [t] (= (get t :done) true)) todos))

      ;; 출력
      print-todo (fn [t]
                   (let [check (if (get t :done) "✓" "○")
                         pri   (get t :priority)
                         badge (cond
                                 (= pri "high")   "[!]"
                                 (= pri "medium") "[-]"
                                 :else            "[ ]")]
                     (println (str check " " badge " " (get t :title)))))

      ;; 요약
      summary    (fn [todos]
                   (let [total   (length todos)
                         done-cnt (length (done todos))
                         pct     (if (= total 0) 0
                                   (/ (* done-cnt 100) total))]
                     (println (str "진행: " done-cnt "/" total " (" pct "%)"))))

      ;; 초기 데이터
      todos [(make-todo 1 "FreeLang 예제 작성"     "high")
             (make-todo 2 "버그 수정 목록 정리"     "high")
             (make-todo 3 "블로그 포스팅"           "medium")
             (make-todo 4 "테스트 코드 작성"        "medium")
             (make-todo 5 "문서 업데이트"           "low")
             (make-todo 6 "gogs 푸시"              "low")]

      ;; 1, 3번 완료 처리
      todos2 (-> todos
                 (complete 1)
                 (complete 3))]

  (println "=== 전체 할 일 ===")
  (map print-todo todos2)
  (println "")
  (summary todos2)

  (println "")
  (println "=== 미완료 ===")
  (map print-todo (pending todos2))

  (println "")
  (println "=== 높은 우선순위 ===")
  (map print-todo (by-priority todos2 "high")))
