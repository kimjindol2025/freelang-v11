(load "../lib/mail/workflow.fl")
(define args (cli-args))
(define folder (get args 0))
(define sequence (get args 1))
(define sender-address (get args 2))
(define source (file-read-json (str folder "/" sequence ".source.json")))
(define triage (file-read-json (str folder "/" sequence ".json")))
(if (not (and (get source "ok") (get triage "ok")))
  (do (println "WORKFLOW=INPUT_MISSING") (_fl_exit 1)) nil)
(define prepared (mail-workflow-from-records (get source "value") (get triage "value")
  {"from" sender-address}))
(if (not (get prepared "ok"))
  (do (println (str "WORKFLOW=ERROR code=" (get (get prepared "error") "code"))) (_fl_exit 1)) nil)
(if (= (get prepared "status") "pending-human-approval")
  (let [[saved (mail-workflow-save-draft (str folder "/draft-" sequence ".json") prepared)]]
    (println (if (get saved "ok") "WORKFLOW=PENDING_HUMAN_APPROVAL" "WORKFLOW=SAVE_FAILED"))
    (_fl_exit (if (get saved "ok") 0 1)))
  (do (println (str "WORKFLOW=" (get prepared "status"))) (_fl_exit 0)))
