;; WHERE 절 SQL 동적 생성 테스트
(define where {:name "alice" :age 30})
(define cols (keys where))
(define sql-parts (map (fn [c] (str c " = ?")) cols))
(define where-str (str-join sql-parts " AND "))
(define params (map (fn [c] (get where c)) cols))

(println (str "WHERE: " where-str))
(println (str "params: " (str params)))

;; DB 테스트
(define DB "/tmp/test-where.db")
(db_create DB "CREATE TABLE IF NOT EXISTS p (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, age INTEGER)")
(db_insert DB "p" {:name "alice" :age 30})
(db_insert DB "p" {:name "bob" :age 25})
(db_insert DB "p" {:name "carol" :age 30})

(define sql (str "SELECT * FROM p WHERE " where-str))
(println (str "SQL: " sql))
(define rows (db_query DB sql params))
(println (str "count=" (length rows)))
(println (str "first=" (get (get rows 0) "name")))
(println "WHERE BUILD PASS")
