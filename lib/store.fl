;; ─────────────────────────────────────────────────────────────
;; store.fl — SQLite 스토어 추상화 (DB 경로 주입 가능)
;; (load "lib/validate.fl")  ;; 먼저 로드
;; (load "lib/result.fl")    ;; 먼저 로드
;; (load "lib/store.fl")
;;
;; 사용:
;;   (define users
;;     (store/define "/data/app.db" "users"
;;       {:name {"required" true "type" "string" "max-length" 100}
;;        :email {"type" "string" "email" true}}
;;       ["id INTEGER PRIMARY KEY AUTOINCREMENT"
;;        "name TEXT NOT NULL"
;;        "email TEXT"
;;        "created_at TEXT"]))
;;
;;   (store/migrate users)
;;   (store/insert! users {:name "alice" :email "alice@x.com"})
;;   (store/find users {:name "alice"})
;;   (store/find-one users {:email "alice@x.com"})
;;   (store/update! users {:name "Alice"} {:id 1})
;;   (store/delete! users {:id 1})
;;   (store/count users)
;;   (store/tx (store/db users) (fn [] ...))
;;
;;   (store/query users {:where "age > ?" :args [30] :order "age" :limit 10})
;;   (store/find-page users {:status "active"} 1 20)
;;   (store/bulk-insert! users [{:name "A"} {:name "B"}])
;;   (-> (store/q users) (q/where "age > ?" [30]) (q/exec (store/db users)))
;; ─────────────────────────────────────────────────────────────

;; ── store 정의 ───────────────────────────────────────────────

(defn store/define [db-path table schema cols]
  {:db db-path :table table :schema schema :cols cols})

(defn store/db [store] (get store :db))
(defn store/table [store] (get store :table))

;; ── 마이그레이션 (테이블 생성) ───────────────────────────────

(defn store/migrate [store]
  (db_create
    (get store :db)
    (str "CREATE TABLE IF NOT EXISTS " (get store :table)
         " (" (str-join (get store :cols) ", ") ")")))

;; ── 내부 헬퍼: WHERE map → SQL + params ─────────────────────

(defn store/-where-sql [where]
  (if (or (nil? where) (empty? (keys where)))
    {:sql "" :params []}
    (let [cols   (keys where)
          parts  (map (fn [c] (str c " = ?")) cols)
          params (map (fn [c] (get where c)) cols)]
      {:sql (str " WHERE " (str-join parts " AND "))
       :params params})))

;; ── INSERT ───────────────────────────────────────────────────

(defn store/insert! [store data]
  (let [schema (get store :schema)
        v (if (nil? schema)
             {:ok true}
             (vld/schema data schema))]
    (if (vld/ok? v)
      (res/ok (db_insert (get store :db) (get store :table) data))
      (res/err (vld/error-str v)))))

;; ── SELECT ───────────────────────────────────────────────────

(defn store/find [store where]
  (let [w   (store/-where-sql where)
        sql (str "SELECT * FROM " (get store :table)
                 (get w :sql))]
    (db_query (get store :db) sql (get w :params))))

(defn store/find-one [store where]
  (let [rows (store/find store where)]
    (if (empty? rows) nil (first rows))))

(defn store/find-all [store]
  (store/find store nil))

;; ── UPDATE ───────────────────────────────────────────────────
;; partial update: 전달된 필드만 검증 (required 규칙 제외)

(defn store/-partial-schema [schema data]
  (let [data-keys (keys data)]
    (reduce
      (fn [acc k]
        (let [rules (get schema k)
              partial-rules (if (nil? rules)
                               nil
                               (assoc rules "required" false))]
          (if (nil? partial-rules) acc (assoc acc k partial-rules))))
      {}
      data-keys)))

(defn store/update! [store data where]
  (let [schema (get store :schema)
        v (if (nil? schema)
             {:ok true}
             (vld/schema data (store/-partial-schema schema data)))]
    (if (vld/ok? v)
      (res/ok (db-update (get store :db) (get store :table) data where))
      (res/err (vld/error-str v)))))

;; ── DELETE ───────────────────────────────────────────────────

(defn store/delete! [store where]
  (db-delete-row (get store :db) (get store :table) where))

;; ── COUNT ────────────────────────────────────────────────────

(defn store/count [store]
  (db_count (get store :db) (get store :table)))

(defn store/count-where [store where]
  (let [w   (store/-where-sql where)
        sql (str "SELECT COUNT(*) as cnt FROM " (get store :table)
                 (get w :sql))
        row (first (db_query (get store :db) sql (get w :params)))]
    (if (nil? row) 0 (get row "cnt"))))

(defn store/exists? [store where]
  (> (store/count-where store where) 0))

;; ── TRANSACTION ──────────────────────────────────────────────
;; tx는 단순 BEGIN/COMMIT 래퍼
;; 주의: try/catch 미지원으로 에러 시 수동 ROLLBACK 필요

(defn store/begin [db-path]
  (db_query db-path "BEGIN" []))

(defn store/commit [db-path]
  (db_query db-path "COMMIT" []))

(defn store/rollback [db-path]
  (db_query db-path "ROLLBACK" []))

(defn store/tx [db-path body-fn]
  (do
    (store/begin db-path)
    (let [result (body-fn)]
      (store/commit db-path)
      (res/ok result))))

;; ── QUERY (WHERE 문자열 + 정렬/페이징 opts) ─────────────────
;; opts: {:where "age > ?" :args [30] :order "name" :dir "ASC"
;;        :limit 10 :offset 0}

(defn store/query [store opts]
  (let [db    (get store :db)
        table (get store :table)
        where (?? (get opts :where) "")
        args  (?? (get opts :args) [])
        order (get opts :order)
        dir   (?? (get opts :dir) "ASC")
        lim   (get opts :limit)
        off   (get opts :offset)
        sql   (str "SELECT * FROM " table
                   (if (= where "") "" (str " WHERE " where))
                   (if (nil? order) "" (str " ORDER BY " order " " dir))
                   (if (nil? lim) "" (str " LIMIT " lim))
                   (if (nil? off) "" (str " OFFSET " off)))]
    (db_query db sql args)))

;; query.fl 빌더 진입점
;; (store/exec-q users (-> (store/q users) (q/where "age > ?" [30]) (q/order-by "name" "ASC")))
(defn store/q [store]
  (q/from (get store :table)))

;; q/exec는 MariaDB db-query를 호출하므로 SQLite용 브릿지 필요
(defn store/exec-q [store q]
  (db_query (get store :db) (q/build-select q) (get q :params)))

;; ── FIND-PAGE ────────────────────────────────────────────────
;; returns {:data [...] :page N :total N :pages N :per N}
;; q/paginate은 MariaDB 전용이므로 db_query로 직접 구현

(defn store/find-page [store where page per-page]
  (let [db     (get store :db)
        table  (get store :table)
        w      (store/-where-sql where)
        offset (* (- page 1) per-page)
        sql    (str "SELECT * FROM " table (get w :sql)
                    " LIMIT " per-page " OFFSET " offset)
        total  (store/count-where store where)
        pages  (ceil (/ total per-page))
        data   (db_query db sql (get w :params))]
    {:data data :page page :total total :pages pages :per per-page}))

;; ── BULK INSERT ──────────────────────────────────────────────
;; 전체 행 선검증 → 트랜잭션으로 일괄 삽입
;; 첫 번째 검증 실패 시 즉시 res/err 반환 (삽입 없음)

(defn store/bulk-insert! [store rows]
  (let [schema (get store :schema)
        errors (filter
                 (fn [e] (not (nil? e)))
                 (map (fn [row]
                        (let [v (if (nil? schema)
                                  {:ok true}
                                  (vld/schema row schema))]
                          (if (vld/ok? v) nil (vld/error-str v))))
                      rows))]
    (if (not (empty? errors))
      (res/err (first errors))
      (store/tx (get store :db)
        (fn []
          (reduce
            (fn [_ row]
              (db_insert (get store :db) (get store :table) row))
            nil
            rows)
          (length rows))))))

;; ── RAW ─────────────────────────────────────────────────────

(defn store/raw-query [store sql params]
  (db_query (get store :db) sql params))

(defn store/raw-exec [store sql]
  (db_create (get store :db) sql))
