(load "guard.fl")
(load "triage.fl")

;; Build a reply draft from untrusted mail and validated triage output.
;; This module never sends automatically. Delivery is a separate call that
;; requires the existing single-use approval checked by mail-guard-send.
(defn mail-workflow-error [code message]
  {"ok" false "error" {"code" code "message" message}})
(defn mail-workflow-sequence? [value]
  (or (and (string? value) (!= value ""))
      (and (number? value) (> value 0) (= value (floor value)))))
(defn mail-workflow-draft [source triage sender-address]
  (if (not (and (map? source) (map? triage)
      (mail-workflow-sequence? (get source "sequence")) (string? (get source "from"))
      (string? (get source "subject")) (string? (get sender-address "from"))
      (triage-valid? triage)))
    (mail-workflow-error "INVALID_INPUT" "source, sender and triage fields are required")
    (if (get triage "위험 표시")
      {"ok" true "status" "human-review-required"}
      (if (or (not (smtp-address? (get source "from")))
              (not (smtp-address? (get sender-address "from")))
              (not (smtp-clean? (get source "subject")))
              (= (get source "subject") "")
              (not (smtp-clean? (get triage "답장 초안"))))
        (mail-workflow-error "UNSAFE_HEADER_OR_ADDRESS" "reply headers or mailbox address are not safe")
        (let [[subject (if (str-starts-with (str-lower (get source "subject")) "re:")
          (get source "subject") (str "Re: " (get source "subject")))]]
          {"ok" true "status" "pending-human-approval"
            "draft" {"draft_id" (str "reply-" (get source "sequence"))
              "source_sequence" (get source "sequence")
              "mail" {"from" (get sender-address "from") "to" (get source "from")
                "subject" subject "body" (get triage "답장 초안")}
              "risk" false "approval_required" true}})))))
(defn mail-workflow-from-records [source-record triage-record sender-address]
  (if (not (and (map? source-record) (map? triage-record)
      (string? (get triage-record "status"))))
    (mail-workflow-error "INVALID_RECORD" "triage source and result records are required")
    (if (= (get triage-record "status") "사장님 확인 필요")
      {"ok" true "status" "human-review-required"}
      (if (not (= (get triage-record "status") "초안 저장"))
        (mail-workflow-error "INVALID_RECORD" "triage result is not draftable")
        (mail-workflow-draft source-record (get triage-record "result") sender-address)))))
(defn mail-workflow-save-draft [path draft]
  (if (not (and (string? path) (map? draft)
      (= (get draft "status") "pending-human-approval")
      (map? (get draft "draft"))))
    (mail-workflow-error "INVALID_DRAFT" "only a pending safe draft may be stored")
    (let [[encoded (json-stringify draft)]]
      (if (not (get encoded "ok")) encoded
        (file-write-atomic path (get encoded "value"))))))
(defn mail-workflow-send-approved [host port draft-path policy smtp-options]
  (let [[stored (file-read-json draft-path)]]
    (if (not (and (get stored "ok")
        (= (get (get stored "value") "status") "pending-human-approval")
        (= (get (get (get stored "value") "draft") "risk") false)
        (= (get (get (get stored "value") "draft") "approval_required") true)))
      (mail-workflow-error "DRAFT_NOT_SENDABLE" "draft is missing, risky or already processed")
      (let [[draft (get (get stored "value") "draft")]
            [sent (mail-guard-send host port (get draft "draft_id")
              (get draft "mail") false policy smtp-options)]]
        (if (get sent "ok")
          (let [[updated (file-write-atomic draft-path
            (get (json-stringify (assoc (get stored "value") "status" "sent")) "value"))]]
            (if (get updated "ok") sent updated))
          sent)))))
