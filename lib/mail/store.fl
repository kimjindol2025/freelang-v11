(load "smtp.fl")
(load "../time/time.fl")

;; SQLite persistence for mailboxes, inbound messages and reviewable drafts.
;; API callers must pass the authenticated owner_id; every user-facing query
;; checks that ownership in SQL rather than trusting a mailbox identifier.
(defn mail-store-error [code message]
  {"ok" false "error" {"code" code "message" message}})
(defn mail-store-text? [value cap]
  (and (string? value) (> (length value) 0) (<= (length value) cap)
    (smtp-clean? value)))
(defn mail-store-init [db]
  (db-exec db "CREATE TABLE IF NOT EXISTS mailboxes (
    mailbox_id TEXT PRIMARY KEY,
    owner_id TEXT NOT NULL,
    address TEXT NOT NULL UNIQUE,
    state TEXT NOT NULL CHECK (state IN ('active','suspended')),
    created_at INTEGER NOT NULL
  )" [])
  (db-exec db "CREATE TABLE IF NOT EXISTS mailbox_sync_state (
    mailbox_id TEXT PRIMARY KEY REFERENCES mailboxes(mailbox_id),
    uidvalidity INTEGER NOT NULL,
    last_uid INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
  )" [])
  (db-exec db "CREATE TABLE IF NOT EXISTS messages (
    message_id TEXT PRIMARY KEY,
    mailbox_id TEXT NOT NULL REFERENCES mailboxes(mailbox_id),
    remote_uid TEXT NOT NULL,
    from_address TEXT NOT NULL,
    to_address TEXT NOT NULL,
    subject TEXT NOT NULL,
    body TEXT NOT NULL,
    received_at INTEGER NOT NULL,
    UNIQUE(mailbox_id, remote_uid)
  )" [])
  (db-exec db "CREATE INDEX IF NOT EXISTS messages_mailbox_received
    ON messages(mailbox_id, received_at DESC)" [])
  (db-exec db "CREATE TABLE IF NOT EXISTS drafts (
    draft_id TEXT PRIMARY KEY,
    owner_id TEXT NOT NULL,
    mailbox_id TEXT NOT NULL REFERENCES mailboxes(mailbox_id),
    source_message_id TEXT NOT NULL REFERENCES messages(message_id),
    from_address TEXT NOT NULL,
    to_address TEXT NOT NULL,
    subject TEXT NOT NULL,
    body TEXT NOT NULL,
    state TEXT NOT NULL CHECK (state IN ('pending-human-approval','approved','sending','sent','failed')),
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
  )" [])
  (db-exec db "CREATE INDEX IF NOT EXISTS drafts_owner_state
    ON drafts(owner_id, state, created_at DESC)" [])
  (db-exec db "CREATE TABLE IF NOT EXISTS draft_approvals (
    approval_id TEXT PRIMARY KEY,
    draft_id TEXT NOT NULL UNIQUE REFERENCES drafts(draft_id),
    actor_id TEXT NOT NULL,
    payload_sha256 TEXT NOT NULL,
    expires_at INTEGER NOT NULL,
    used_at INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL
  )" [])
  (db-exec db "CREATE TABLE IF NOT EXISTS mail_send_jobs (
    job_id TEXT PRIMARY KEY,
    draft_id TEXT NOT NULL UNIQUE REFERENCES drafts(draft_id),
    approval_id TEXT NOT NULL UNIQUE REFERENCES draft_approvals(approval_id),
    state TEXT NOT NULL CHECK (state IN ('submitting','submitted','deferred','bounced','unknown','cancelled','failed')),
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
  )" [])
  (db-exec db "CREATE INDEX IF NOT EXISTS mail_send_jobs_state
    ON mail_send_jobs(state,created_at)" [])
  (db-exec db "CREATE TABLE IF NOT EXISTS mail_outbox (
    job_id TEXT PRIMARY KEY REFERENCES mail_send_jobs(job_id),
    state TEXT NOT NULL CHECK (state IN ('queued','submitting')),
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
  )" [])
  (db-exec db "CREATE INDEX IF NOT EXISTS mail_outbox_state_created
    ON mail_outbox(state,created_at)" [])
  {"ok" true})
(defn mail-store-mailbox-create [db mailbox-id owner-id address]
  (if (not (and (mail-store-text? mailbox-id 128) (mail-store-text? owner-id 128)
      (smtp-address? address)))
    (mail-store-error "INVALID_MAILBOX" "mailbox identity, owner and address are required")
    (let [[created (try
      (db-exec db "INSERT INTO mailboxes(mailbox_id,owner_id,address,state,created_at)
        VALUES(?,?,?,'active',?)" [mailbox-id owner-id address (now-s)])
      (catch error nil))]]
      (if (= created 1) {"ok" true "created" true}
        (mail-store-error "MAILBOX_CONFLICT" "mailbox id or address already exists")))))
(defn mail-store-list-mailboxes [db owner-id]
  (if (not (mail-store-text? owner-id 128))
    (mail-store-error "INVALID_QUERY" "owner is required")
    {"ok" true "mailboxes" (db-query db "SELECT mailbox_id,address,state,created_at
      FROM mailboxes WHERE owner_id=? ORDER BY address" [owner-id])}))
(defn mail-store-get-mailbox [db owner-id mailbox-id]
  (if (not (and (mail-store-text? owner-id 128) (mail-store-text? mailbox-id 128))) nil
    (let [[rows (db-query db "SELECT mailbox_id,address,state,created_at
      FROM mailboxes WHERE owner_id=? AND mailbox_id=?" [owner-id mailbox-id])]]
      (if (= (length rows) 1) (get rows 0) nil))))
(defn mail-store-sync-state [db mailbox-id]
  (if (not (mail-store-text? mailbox-id 128))
    (mail-store-error "INVALID_SYNC_STATE" "mailbox id is required")
    (let [[rows (db-query db "SELECT mailbox_id,uidvalidity,last_uid,updated_at
      FROM mailbox_sync_state WHERE mailbox_id=?" [mailbox-id])]]
      (if (= (length rows) 1) {"ok" true "state" (get rows 0)}
        {"ok" true "state" {"mailbox_id" mailbox-id "uidvalidity" 0 "last_uid" 0 "updated_at" 0}}))))
(defn mail-store-sync-set-epoch [db mailbox-id uidvalidity]
  (if (not (and (mail-store-text? mailbox-id 128) (number? uidvalidity)
      (> uidvalidity 0) (<= uidvalidity 4294967295) (= uidvalidity (floor uidvalidity))))
    (mail-store-error "INVALID_SYNC_EPOCH" "mailbox and positive UIDVALIDITY are required")
    (let [[saved (try
      (do
        (db-exec db "BEGIN IMMEDIATE" [])
        (let [[rows (db-query db "SELECT uidvalidity FROM mailbox_sync_state WHERE mailbox_id=?" [mailbox-id])]]
          (if (= (length rows) 0)
            (db-exec db "INSERT INTO mailbox_sync_state(mailbox_id,uidvalidity,last_uid,updated_at)
              VALUES(?,?,0,?)" [mailbox-id uidvalidity (now-s)])
            (if (!= (get (get rows 0) "uidvalidity") uidvalidity)
              (db-exec db "UPDATE mailbox_sync_state SET uidvalidity=?,last_uid=0,updated_at=?
                WHERE mailbox_id=?" [uidvalidity (now-s) mailbox-id])
              0))
          (db-exec db "COMMIT" []) true))
      (catch error (do (db-exec db "ROLLBACK" []) false))]]
      (if saved (mail-store-sync-state db mailbox-id)
        (mail-store-error "SYNC_EPOCH_FAILED" "UIDVALIDITY epoch could not be saved")))))
(defn mail-store-sync-advance [db mailbox-id uidvalidity uid]
  (if (not (and (mail-store-text? mailbox-id 128) (number? uidvalidity)
      (> uidvalidity 0) (<= uidvalidity 4294967295) (= uidvalidity (floor uidvalidity))
      (number? uid) (> uid 0) (<= uid 4294967295) (= uid (floor uid))))
    (mail-store-error "INVALID_SYNC_CURSOR" "mailbox, UIDVALIDITY and positive UID are required")
    (let [[changed (try
      (db-exec db "UPDATE mailbox_sync_state SET last_uid=?,updated_at=?
        WHERE mailbox_id=? AND uidvalidity=? AND last_uid<?"
        [uid (now-s) mailbox-id uidvalidity uid])
      (catch error nil))]]
      (if (= changed 1) {"ok" true "advanced" true "last_uid" uid}
        (let [[state (mail-store-sync-state db mailbox-id)]
              [current (get state "state")]]
          (if (and (get state "ok") (= (get current "uidvalidity") uidvalidity)
              (>= (get current "last_uid") uid))
            {"ok" true "advanced" false "last_uid" (get current "last_uid")}
            (mail-store-error "SYNC_CURSOR_STALE" "UIDVALIDITY changed or cursor row is missing"))))))
(defn mail-store-ingest [db message]
  (if (not (and (map? message)
      (mail-store-text? (get message "message_id") 128)
      (mail-store-text? (get message "mailbox_id") 128)
      (mail-store-text? (get message "remote_uid") 128)
      (mail-store-text? (get message "from") 998)
      (mail-store-text? (get message "to") 998)
      (string? (get message "subject")) (<= (length (get message "subject")) 998)
      (smtp-clean? (get message "subject"))
      (string? (get message "body")) (<= (length (get message "body")) 1048576)
      (number? (get message "received_at"))))
    (mail-store-error "INVALID_MESSAGE" "message fields are missing or exceed storage bounds")
    (let [[inserted (try
      (db-exec db "INSERT OR IGNORE INTO messages
        (message_id,mailbox_id,remote_uid,from_address,to_address,subject,body,received_at)
        VALUES(?,?,?,?,?,?,?,?)"
        [(get message "message_id") (get message "mailbox_id") (get message "remote_uid")
         (get message "from") (get message "to") (get message "subject")
         (get message "body") (get message "received_at")])
      (catch error nil))]]
      (if (number? inserted) {"ok" true "inserted" inserted}
        (mail-store-error "STORE_ERROR" "message could not be stored")))))
(defn mail-store-list-messages [db owner-id mailbox-id limit]
  (if (not (and (mail-store-text? owner-id 128) (mail-store-text? mailbox-id 128)
      (number? limit) (> limit 0) (<= limit 100) (= limit (floor limit))))
    (mail-store-error "INVALID_QUERY" "owner, mailbox and limit are required")
    {"ok" true "messages" (db-query db
      "SELECT m.message_id,m.remote_uid,m.from_address,m.to_address,m.subject,m.body,m.received_at
       FROM messages m JOIN mailboxes b ON b.mailbox_id=m.mailbox_id
       WHERE b.owner_id=? AND b.mailbox_id=? AND b.state='active'
       ORDER BY m.received_at DESC,m.remote_uid DESC LIMIT ?"
      [owner-id mailbox-id limit])}))
(defn mail-store-get-message [db owner-id mailbox-id message-id]
  (if (not (and (mail-store-text? owner-id 128) (mail-store-text? mailbox-id 128)
      (mail-store-text? message-id 128))) nil
    (let [[rows (db-query db "SELECT m.message_id,m.mailbox_id,m.remote_uid,
        m.from_address,m.to_address,m.subject,m.body,m.received_at,b.address AS mailbox_address
      FROM messages m JOIN mailboxes b ON b.mailbox_id=m.mailbox_id
      WHERE b.owner_id=? AND b.mailbox_id=? AND b.state='active' AND m.message_id=?"
      [owner-id mailbox-id message-id])]]
      (if (= (length rows) 1) (get rows 0) nil))))
(defn mail-store-search-messages [db owner-id mailbox-id query limit]
  (if (not (and (mail-store-text? owner-id 128) (mail-store-text? mailbox-id 128)
      (mail-store-text? query 256) (number? limit) (> limit 0)
      (<= limit 100) (= limit (floor limit))))
    (mail-store-error "INVALID_QUERY" "owner, mailbox, bounded search text and limit are required")
    {"ok" true "messages" (db-query db
      "SELECT m.message_id,m.remote_uid,m.from_address,m.to_address,m.subject,m.body,m.received_at
       FROM messages m JOIN mailboxes b ON b.mailbox_id=m.mailbox_id
       WHERE b.owner_id=? AND b.mailbox_id=? AND b.state='active'
         AND (instr(lower(m.from_address),lower(?))>0
           OR instr(lower(m.to_address),lower(?))>0
           OR instr(lower(m.subject),lower(?))>0
           OR instr(lower(m.body),lower(?))>0)
       ORDER BY m.received_at DESC,m.remote_uid DESC LIMIT ?"
      [owner-id mailbox-id query query query query limit])}))
(defn mail-store-draft-create [db owner-id draft]
  (let [[mail (get draft "mail")]]
    (if (not (and (mail-store-text? owner-id 128) (map? draft) (map? mail)
        (mail-store-text? (get draft "draft_id") 128)
        (mail-store-text? (get draft "mailbox_id") 128)
        (mail-store-text? (get draft "source_message_id") 128)
        (smtp-address? (get mail "from")) (smtp-address? (get mail "to"))
        (mail-store-text? (get mail "subject") 998)
        (string? (get mail "body")) (<= (length (get mail "body")) 1048576)
        (smtp-clean? (get mail "subject"))))
      (mail-store-error "INVALID_DRAFT" "draft fields are invalid or exceed storage bounds")
      (let [[inserted (try
        (db-exec db "INSERT INTO drafts
          (draft_id,owner_id,mailbox_id,source_message_id,from_address,to_address,subject,body,state,created_at,updated_at)
          SELECT ?,?,?,?,?,?,?,?,'pending-human-approval',?,?
          WHERE EXISTS (SELECT 1 FROM mailboxes WHERE mailbox_id=? AND owner_id=? AND state='active')
            AND EXISTS (SELECT 1 FROM messages WHERE message_id=? AND mailbox_id=?)"
          [(get draft "draft_id") owner-id (get draft "mailbox_id") (get draft "source_message_id")
           (get mail "from") (get mail "to") (get mail "subject") (get mail "body")
           (now-s) (now-s) (get draft "mailbox_id") owner-id
           (get draft "source_message_id") (get draft "mailbox_id")])
        (catch error nil))]]
        (if (= inserted 1) {"ok" true "created" true "state" "pending-human-approval"}
          (mail-store-error "DRAFT_CONFLICT_OR_FORBIDDEN" "source, mailbox, owner or draft id is invalid"))))))
(defn mail-store-draft-transition [db owner-id draft-id expected next]
  (if (not (and (mail-store-text? owner-id 128) (mail-store-text? draft-id 128)
      (or (and (= expected "pending-human-approval") (= next "approved"))
          (and (= expected "approved") (= next "sending"))
          (and (= expected "sending") (includes-item ["sent" "failed"] next)))))
    (mail-store-error "INVALID_TRANSITION" "draft state transition is not permitted")
    (let [[changed (db-exec db "UPDATE drafts SET state=?,updated_at=?
      WHERE draft_id=? AND owner_id=? AND state=?"
      [next (now-s) draft-id owner-id expected])]]
      (if (= changed 1) {"ok" true "state" next}
        (mail-store-error "DRAFT_NOT_FOUND_OR_STALE" "draft owner or state did not match")))))
(defn mail-store-list-drafts [db owner-id limit]
  (if (not (and (mail-store-text? owner-id 128) (number? limit)
      (> limit 0) (<= limit 100) (= limit (floor limit))))
    (mail-store-error "INVALID_QUERY" "owner and bounded limit are required")
    {"ok" true "drafts" (db-query db "SELECT draft_id,mailbox_id,source_message_id,
      from_address,to_address,subject,body,state,created_at,updated_at
      FROM drafts WHERE owner_id=? ORDER BY created_at DESC,draft_id DESC LIMIT ?"
      [owner-id limit])}))
(defn mail-store-get-draft [db draft-id]
  (if (not (mail-store-text? draft-id 128)) nil
    (let [[rows (db-query db "SELECT draft_id,owner_id,mailbox_id,source_message_id,
      from_address,to_address,subject,body,state,created_at,updated_at
      FROM drafts WHERE draft_id=?" [draft-id])]]
      (if (= (length rows) 1) (get rows 0) nil))))
(defn mail-store-approve-draft [db draft-id actor-id approval-id payload-sha256 expires-at]
  (if (not (and (mail-store-text? draft-id 128) (mail-store-text? actor-id 128)
      (mail-store-text? approval-id 128) (mail-store-text? payload-sha256 128)
      (number? expires-at) (> expires-at (now-s))))
    (mail-store-error "INVALID_APPROVAL" "approval fields or expiry are invalid")
    (let [[created (try
      (do
        (db-exec db "BEGIN IMMEDIATE" [])
        (let [[changed (db-exec db "UPDATE drafts SET state='approved',updated_at=?
          WHERE draft_id=? AND state='pending-human-approval'" [(now-s) draft-id])]]
          (if (= changed 1)
            (do
              (db-exec db "INSERT INTO draft_approvals
                (approval_id,draft_id,actor_id,payload_sha256,expires_at,used_at,created_at)
                VALUES(?,?,?,?,?,0,?)"
                [approval-id draft-id actor-id payload-sha256 expires-at (now-s)])
              (db-exec db "COMMIT" []) true)
            (do (db-exec db "ROLLBACK" []) false))))
      (catch error (do (db-exec db "ROLLBACK" []) false))]]
      (if created {"ok" true "state" "approved" "approval_id" approval-id}
        (mail-store-error "DRAFT_NOT_PENDING" "draft was missing, already approved or changed")))))
(defn mail-store-get-approval [db draft-id]
  (if (not (mail-store-text? draft-id 128)) nil
    (let [[rows (db-query db "SELECT approval_id,draft_id,actor_id,payload_sha256,
      expires_at,used_at,created_at FROM draft_approvals WHERE draft_id=?" [draft-id])]]
      (if (= (length rows) 1) (get rows 0) nil))))
(defn mail-store-begin-send [db draft-id approval-id job-id]
  (if (not (and (mail-store-text? draft-id 128) (mail-store-text? approval-id 128)
      (mail-store-text? job-id 128)))
    (mail-store-error "INVALID_SEND" "send identity is invalid")
    (let [[created (try
      (do
        (db-exec db "BEGIN IMMEDIATE" [])
        (let [[approval-changed (db-exec db "UPDATE draft_approvals SET used_at=?
          WHERE approval_id=? AND draft_id=? AND used_at=0 AND expires_at>?"
          [(now-s) approval-id draft-id (now-s)])]]
          (if (= approval-changed 1)
            (let [[draft-changed (db-exec db "UPDATE drafts SET state='sending',updated_at=?
              WHERE draft_id=? AND state='approved'" [(now-s) draft-id])]]
              (if (= draft-changed 1)
                (do
                  (db-exec db "INSERT INTO mail_send_jobs(job_id,draft_id,approval_id,state,created_at,updated_at)
                    VALUES(?,?,?,'submitting',?,?)"
                    [job-id draft-id approval-id (now-s) (now-s)])
                  (db-exec db "COMMIT" []) true)
                (do (db-exec db "ROLLBACK" []) false)))
            (do (db-exec db "ROLLBACK" []) false))))
      (catch error (do (db-exec db "ROLLBACK" []) false))]]
      (if created {"ok" true "state" "submitting" "job_id" job-id}
        (mail-store-error "APPROVAL_USED_OR_STALE" "approval is missing, expired or already consumed")))))
(defn mail-store-enqueue-send [db draft-id approval-id job-id]
  (if (not (and (mail-store-text? draft-id 128) (mail-store-text? approval-id 128)
      (mail-store-text? job-id 128)))
    (mail-store-error "INVALID_SEND" "send identity is invalid")
    (let [[created (try
      (do
        (db-exec db "BEGIN IMMEDIATE" [])
        (let [[approval-changed (db-exec db "UPDATE draft_approvals SET used_at=?
          WHERE approval_id=? AND draft_id=? AND used_at=0 AND expires_at>?"
          [(now-s) approval-id draft-id (now-s)])]]
          (if (= approval-changed 1)
            (let [[draft (db-query db "SELECT state FROM drafts WHERE draft_id=?" [draft-id])]]
              (if (and (= (length draft) 1) (= (get (get draft 0) "state") "approved"))
                (do
                  (db-exec db "INSERT INTO mail_send_jobs(job_id,draft_id,approval_id,state,created_at,updated_at)
                    VALUES(?,?,?,'submitting',?,?)" [job-id draft-id approval-id (now-s) (now-s)])
                  (db-exec db "INSERT INTO mail_outbox(job_id,state,created_at,updated_at)
                    VALUES(?,'queued',?,?)" [job-id (now-s) (now-s)])
                  (db-exec db "COMMIT" []) true)
                (do (db-exec db "ROLLBACK" []) false)))
            (do (db-exec db "ROLLBACK" []) false))))
      (catch error (do (db-exec db "ROLLBACK" []) false))]]
      (if created {"ok" true "state" "queued" "job_id" job-id}
        (mail-store-error "APPROVAL_USED_OR_STALE" "approval is missing, expired or already consumed")))))
(defn mail-store-claim-send [db]
  (let [[claim (try
    (do
      (db-exec db "BEGIN IMMEDIATE" [])
      (let [[rows (db-query db "SELECT j.job_id,j.draft_id,d.from_address,d.to_address,d.subject,d.body
        FROM mail_outbox o JOIN mail_send_jobs j ON j.job_id=o.job_id
        JOIN drafts d ON d.draft_id=j.draft_id
        WHERE o.state='queued' AND j.state='submitting' AND d.state='approved'
        ORDER BY o.created_at,j.job_id LIMIT 1" [])]]
        (if (= (length rows) 0)
          (do (db-exec db "COMMIT" []) {"ok" true "job" nil})
          (let [[job (get rows 0)]
                [outbox-updated (db-exec db "UPDATE mail_outbox SET state='submitting',updated_at=?
                  WHERE job_id=? AND state='queued'" [(now-s) (get job "job_id")])]
                [draft-updated (db-exec db "UPDATE drafts SET state='sending',updated_at=?
                  WHERE draft_id=? AND state='approved'" [(now-s) (get job "draft_id")])]]
            (if (and (= outbox-updated 1) (= draft-updated 1))
              (do (db-exec db "COMMIT" []) {"ok" true "job" job})
              (do (db-exec db "ROLLBACK" []) {"ok" false "job" nil}))))))
    (catch error (do (db-exec db "ROLLBACK" []) {"ok" false "job" nil}))]]
    (if (get claim "ok") claim
      (mail-store-error "OUTBOX_CLAIM_FAILED" "queued send could not be claimed"))))
(defn mail-store-finish-send [db job-id state]
  (if (not (includes-item ["submitted" "deferred" "bounced" "unknown" "failed"] state))
    (mail-store-error "INVALID_SEND_STATE" "send completion state is invalid")
    (let [[finished (try
      (do
        (db-exec db "BEGIN IMMEDIATE" [])
        (let [[rows (db-query db "SELECT draft_id FROM mail_send_jobs WHERE job_id=? AND state='submitting'" [job-id])]]
          (if (!= (length rows) 1)
            (do (db-exec db "ROLLBACK" []) false)
            (let [[draft-id (get (get rows 0) "draft_id")]
                  [updated (db-exec db "UPDATE mail_send_jobs SET state=?,updated_at=?
                    WHERE job_id=? AND state='submitting'" [state (now-s) job-id])]]
              (if (!= updated 1)
                (do (db-exec db "ROLLBACK" []) false)
                (if (= state "unknown")
                  (do
                    (db-exec db "DELETE FROM mail_outbox WHERE job_id=?" [job-id])
                    (db-exec db "COMMIT" []) true)
                  (let [[draft-state (db-exec db "UPDATE drafts SET state=?,updated_at=?
                    WHERE draft_id=? AND state='sending'"
                    [(if (= state "submitted") "sent" "failed") (now-s) draft-id])]]
                    (if (= draft-state 1)
                      (do
                        (db-exec db "DELETE FROM mail_outbox WHERE job_id=?" [job-id])
                        (db-exec db "COMMIT" []) true)
                      (do (db-exec db "ROLLBACK" []) false)))))))))
      (catch error (do (db-exec db "ROLLBACK" []) false))]]
      (if finished {"ok" true "state" state}
        (mail-store-error "SEND_JOB_NOT_PENDING" "send job is missing or could not be reconciled")))))
(defn mail-store-get-send-job [db job-id]
  (if (not (mail-store-text? job-id 128)) nil
    (let [[rows (db-query db "SELECT j.job_id,j.draft_id,j.approval_id,
      CASE WHEN o.state='queued' THEN 'queued' ELSE j.state END AS state,j.created_at,j.updated_at
      FROM mail_send_jobs j LEFT JOIN mail_outbox o ON o.job_id=j.job_id WHERE j.job_id=?" [job-id])]]
      (if (= (length rows) 1) (get rows 0) nil))))
(defn mail-store-reconcile-send-jobs [db]
  (let [[changed (db-exec db "UPDATE mail_send_jobs SET state='unknown',updated_at=?
    WHERE state='submitting' AND job_id NOT IN
      (SELECT job_id FROM mail_outbox WHERE state='queued')" [(now-s)])]]
    (db-exec db "DELETE FROM mail_outbox WHERE state='submitting'
      AND job_id IN (SELECT job_id FROM mail_send_jobs WHERE state='unknown')" [])
    changed))
