{
  "$": "airc-spec",
  "version": "1.0.0",
  "project": "freelang-v11",
  "date": "2026-05-20",
  "cmd": "python3 -c \"import json; d=json.load(open('SPEC.airc')); print('what:', d['identity']['what']); print('hot:', d['hot'])\"",

  "identity": {
    "what": "AI 에이전트가 안정적으로 실행할 수 있는 결정론적 DSL",
    "why": "AI가 생성한 코드가 세션마다 다르게 동작하는 문제를 없애기 위해",
    "for": "AI 에이전트 (Claude). 인간은 감독자",
    "not": "범용 프로그래밍 언어. Node.js/Python 대체 아님"
  },

  "hot": "task-effect-enforcement",

  "constitution": {
    "1": "AI 전용. 인간 가독성을 위한 구조 타협 금지",
    "2": "identity는 잠긴다. 변경은 사용자 협의 필수. Claude 단독 변경 금지",
    "3": "hot이 가리키는 task가 지금 당장 해야 할 일이다",
    "4": "오류·실수도 nodes에 기록한다. 성공만 기록하지 않는다",
    "5": "노드는 삭제하지 않는다. void 처리만 허용",
    "6": "why 없는 lock·decision 등록 불가"
  },

  "nodes": {

    "task-001": {
      "t": "task",
      "v": "SPEC.airc 현행화 — 현재 진행 중인 작업 hot으로 설정",
      "entry": ["SPEC.airc"],
      "check": ["python3 -c \"import json; json.load(open('SPEC.airc')); print('OK')\""],
      "verified": true,
      "next": []
    },

    "task-effect-enforcement": {
      "t": "task",
      "v": "Runtime Effect Enforcement MVP — 선언된 :effects와 실제 실행을 런타임에서 강제",
      "entry": ["docs/DESIGN-EFFECT-ENFORCEMENT.md"],
      "scope": [
        "src/effect-types.ts (신규)",
        "src/builtin-effects.ts (신규)",
        "src/effect-enforcer.ts (신규)",
        "src/eval-call-function.ts (수정 — 4개 진입점 gate hook)",
        "src/runtime-events.ts (수정 — effect-violation 이벤트 타입 추가)"
      ],
      "implementation_order": [
        "1. effect-types.ts",
        "2. builtin-effects.ts (registry 안정화 우선)",
        "3. effect-enforcer.ts (registry 기반 검증)",
        "4. eval-call-function hooks",
        "5. builtin dispatch gate",
        "6. runtime-events 확장",
        "7. 테스트 5종",
        "8. 회귀 1018개",
        "9. bootstrap SHA 비교",
        "10. 블로그/Gogs"
      ],
      "order_rationale": "registry가 흔들리면 enforcer 시그니처도 흔들린다. runtime-events 확장은 실제 violation 데이터가 나온 뒤 schema 확정.",
      "commits": [
        "C1: docs",
        "C2: types + registry",
        "C3: enforcer 엔진 + EFFECT_STACK_TRACE",
        "C4-1: callUserFunction + callFunctionValue + finally invariant (sync core)",
        "C4-2: TCO/Raw 4종 (callUserFunctionTCO/callFunctionValueTCO/Raw 2종)",
        "C4-3: callAsyncFunctionValue + callFunction dispatch + final bypass audit",
        "C5: runtime-events effect-violation 연동",
        "C6: T1~T5 + 1129 회귀 + unauthorized builtin matrix",
        "C7: bootstrap SHA + 블로그/Gogs",
        "C8 (후속): EFFECT_CATALOG ↔ BUILTIN_EFFECTS taxonomy normalization"
      ],
      "split_rationale": "리서치(C4 직전)에서 진입점이 4개가 아닌 8개임을 발견. async/TCO/raw/native fast-path가 한 변곡점에 묶이면 regression provenance가 흐려진다. 의미론 경계(sync일반/trampoline/async-dispatch)로 3분할.",
      "priority_invariants": [
        "1. stack leak impossible (push/pop pairing)",
        "2. enforcement correctness",
        "3. taxonomy consistency (C8 후속)"
      ],
      "branch": "feature/effect-enforcement",
      "branch_policy": "C1부터 feature/effect-enforcement에서 진행. C7 후 squash 없이 merge.",
      "success": [
        "T1: pure→io = FAIL (EffectViolation)",
        "T2: io→io = PASS",
        "T3: pure→pure = PASS",
        "T4: pure→net = FAIL",
        "T5: runtime-events에 effect-violation 1건 기록",
        "회귀: 기존 1018/1018 테스트 전부 PASS",
        "bootstrap SHA 변동 최소"
      ],
      "verified": false,
      "next": []
    },

    "dec-001": {
      "t": "decision",
      "v": "외부 npm 패키지 0개. Node.js 내장 모듈만 허용",
      "why": ["의존성이 생기면 버전 충돌·보안 취약점이 AI 코드에 전파된다", "결정론적 실행을 보장하려면 런타임이 고정되어야 한다"],
      "lock": true
    },

    "dec-002": {
      "t": "decision",
      "v": "단일 파서·단일 문법. 복수 구현 공존 금지",
      "why": ["파서가 둘이면 동작 불일치가 생긴다", "AI가 어느 파서 기준으로 코드를 써야 하는지 알 수 없다"],
      "lock": true
    },

    "dec-003": {
      "t": "decision",
      "v": "컴파일러 결함에 스펙을 맞추는 우회 금지. 결함은 런타임에서 고친다",
      "why": ["우회책이 쌓이면 언어 정의가 오염된다", "AI가 우회책을 정상 패턴으로 학습한다"],
      "lock": true
    },

    "dec-004": {
      "t": "decision",
      "v": "bootstrap.js가 단일 진입점. 직접 편집 금지, src/ TS에서 esbuild로 생성",
      "why": ["bootstrap.js를 직접 수정하면 다음 빌드에서 덮어씌워진다"],
      "lock": true
    },

    "dec-005": {
      "t": "decision",
      "v": "Runtime Effect Enforcement 도입 — 함수 :effects 메타를 런타임에서 강제. MVP는 6종 어휘(:pure :io :net :process :time :random)에 한정",
      "why": [
        "선언과 실제 실행의 불일치는 AI 생성 코드의 replay 보장을 깨뜨린다",
        "정적 :effects 검사(cli.ts)는 경고일 뿐 실행 차단력이 없다",
        "deterministic runtime DSL 목표의 첫 enforcement layer"
      ],
      "lock": false
    },

    "dec-006": {
      "t": "decision",
      "v": "effect metadata absent = legacy unrestricted. 메타가 부재한 함수는 enforcement 검사를 skip한다",
      "why": [
        "self-host bootstrap과 기존 1018개 테스트가 즉시 깨지지 않아야 점진 도입이 가능하다",
        "메타 부재 함수에 묵시적 pure를 부여하면 기존 IO 사용 코드가 모두 위반으로 잡힌다",
        "future strict 모드에서는 이 escape hatch를 닫을 수 있다"
      ],
      "lock": true
    },

    "dec-007": {
      "t": "decision",
      "v": "모든 callable entry는 단일 enforcement gate를 통과한다 (callUserFunction, callFunctionValue, builtin dispatch, TCO 경로)",
      "why": [
        "builtin 우회로가 생기면 enforcement 철학 자체가 무너진다",
        "TCO 경로 누락은 silent bypass를 만든다",
        "단일 gate는 introspection·테스트·replay 통합점을 보장한다"
      ],
      "lock": true
    },

    "err-001": {
      "t": "error",
      "v": "server_req_header/get 반환값 null이 (= $v nil)로 false 평가됨",
      "cause": "nil과 null이 내부적으로 다른 타입으로 처리됨",
      "fix": "4중 검사 헬퍼 표준화 — null·nil·빈문자열·false 모두 처리",
      "repeat_risk": "high"
    },

    "err-002": {
      "t": "error",
      "v": "update extra-args + define+fn 조합에서 변수 저장 오류",
      "cause": "런타임 버그 (2026-05-19 수정 완료)",
      "fix": "해당 패턴 workaround 불필요. 런타임에서 수정됨",
      "repeat_risk": "low"
    },

    "err-003": {
      "t": "error",
      "v": "tcp-server-raw 동일 프로세스에서 listen 미발화 — outbound가 ECONNREFUSED",
      "cause": "IO Worker로 listen 명령 전달 후 net.createServer().listen() 호출이 실제로 일어나지 않거나 fl-yield와 별도 시점에 일어남",
      "fix": "조사 필요. 외부 Node.js 서버로 우회 검증 가능. PAIN p18 참조",
      "repeat_risk": "high",
      "found": "YIELD-3 검증 #2 (2026-05-20)"
    },

    "err-004": {
      "t": "error",
      "v": "tcp-outbound·rpc-client-call 사용 후 process 자연 종료 안 됨 (EXIT=124)",
      "cause": "035e9a6c IO Worker unref 패치에도 ring buffer Atomics.wait·setInterval 잔존",
      "fix": "조사 필요. CI에서는 외부 timeout 사용. PAIN p19 참조",
      "repeat_risk": "high",
      "found": "YIELD-3 검증 #2·#3"
    },

    "err-005": {
      "t": "error",
      "v": "bootstrap.js shebang 자동 중복 prepend → SyntaxError",
      "cause": "외부 백그라운드 에이전트(미식별)가 빌드 산출물에 shebang 자동 추가, 이미 있어도 중복",
      "fix": "git checkout bootstrap.js 로 복원. 빌드/실행 전 head -2 확인. PAIN p20 참조",
      "repeat_risk": "high",
      "found": "YIELD-3 검증 중 2회 재발"
    },

    "err-006": {
      "t": "error",
      "v": "rate-limiter test 6/7 FAIL (server.close is not a function / status 404)",
      "cause": "회귀 아님 — d3b2432b 도입 시점부터 broken. server_start (portOrConfig)→string 시그니처와 테스트의 (port, handler)→http.Server 가정 불일치",
      "fix": "테스트를 실제 시그니처에 맞게 재작성 권장 (route 미리 등록 + __activeServer.server.close()). PAIN p21 참조",
      "repeat_risk": "low",
      "found": "YIELD-3 git log 추적"
    },

    "task-yield-3-done": {
      "t": "decision",
      "v": "YIELD-3 빌드+단위 검증 4/5 PASS — fl-yield·tcp-outbound·rpc-client-call·negative test 모두 동작",
      "evidence": "tests/yield3-1-basic.fl tests/yield3-2-echo.fl tests/yield3-3-rpc.fl tests/yield3-4-negative.fl",
      "remaining": "INV-1/INV-4/INV-5 충족, 부수 이슈 err-003~err-006는 별도 추적",
      "date": "2026-05-20"
    }

  },

  "lock": [
    {"rule": "외부 npm 0개", "why": "결정론적 실행 보장"},
    {"rule": "복수 파서 공존 금지", "why": "언어 정의 단일성"},
    {"rule": "컴파일러 결함 우회 금지", "why": "스펙 오염 방지"},
    {"rule": "bootstrap.js 직접 편집 금지", "why": "빌드 산출물이므로 덮어씌워짐"},
    {"rule": "effect metadata absent = legacy unrestricted", "why": "self-host bootstrap 및 기존 테스트 호환 보장"},
    {"rule": "모든 callable entry는 단일 effect gate 통과", "why": "builtin 우회 차단·TCO silent bypass 방지"}
  ],

  "graveyard": [
    {"idea": "외부 npm 패키지 허용", "why": "의존성 지옥 + 결정론 파괴", "final": true},
    {"idea": "복수 파서 공존", "why": "동작 불일치 발생. AI가 어느 기준으로 코드를 써야 할지 모름", "final": true},
    {"idea": "compile-time purity inference", "why": "현 단계에선 과함. runtime explicit enforcement만으로 시작. 추론은 오탐·미탐 부담이 크다", "final": true},
    {"idea": ":db / :gpu / :fs-read / :fs-write 세분화 effect", "why": "MVP 단계엔 과함. :io 하나로 통합. 어휘 폭발은 enforce 약화로 이어진다", "final": false},
    {"idea": "capability graph (effect polymorphism·algebraic effects)", "why": "타입 시스템 동반 필요. MVP 경계를 무너뜨린다", "final": false},
    {"idea": "builtin object에 _effects 어트리뷰트 부착", "why": "hidden mutation·serialization drift·accidental overwrite 위험. 별도 registry Map이 안전", "final": true}
  ],

  "handoff": {
    "step1": "cmd 실행 → identity·hot 확인",
    "step2": "graveyard 확인 → 이미 버린 방향인지 체크",
    "step3": "hot 노드 실행",
    "step4": "오류 발생 시 error 노드로 기록",
    "step5": "identity 변경 필요 시 사용자에게 먼저 물어라"
  }
}
