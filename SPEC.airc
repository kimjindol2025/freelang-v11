    "phase2-dynamic": {
      "t": "decision",
      "v": "Phase 2 — Dynamic Topology Convergence Correctness",
      "mission": "steady-state 기능 성공이 아니라 transition window에서 topology consistency 유지 검증",
      "essence": "연결 고정(steady state) 상태에서 끊김 없이 동작하는 것 ≠ 올바른 시스템. topology 변경 중(transition window)에서도 consistency를 유지하고 stale state를 확실하게 제거하는 것이 진정한 correctness",
      "evaluation_axes": [
        "1. deterministic lifecycle — 어떤 조건에서든 lifecycle이 일정한 상태 전이로 진행",
        "2. topology correctness — transition 중에도 old/new snapshot 상태가 혼재하지 않음",
        "3. stale-state elimination — 과거 revision은 반드시 버려지고 replay 금지"
      ],
      "principles": [
        "authoritative full snapshot only — 증분 업데이트·delta replay 금지. 항상 full snapshot으로만 갱신",
        "immutable snapshot build — snapshot 생성 중 상태 변경 금지. build 후 atomic swap만 허용",
        "atomic snapshot swap — old/new snapshot 교체 시 원자성 보장. 중간 상태 노출 금지",
        "old/new snapshot coexistence 허용 — transition 중 inflight request는 old snapshot으로 처리 후 완료",
        "reconnect → full sync only — 재연결 시 since=0부터 전체 snapshot 받기만. 증분 동기화 금지"
      ],
      "delivery_model": [
        "at-least-once watch delivery 허용 — 중복 이벤트는 revision으로 판별 후 collapse",
        "revision = logical clock — monotonic increment, crash recovery 불필요",
        "incoming_revision <= current_revision → discard — stale event 자동 버림",
        "duplicate revision → no-op collapse — 동일 revision 재수신 시 무시"
      ],
      "forbidden": [
        "incremental mutation — 기존 snapshot 구조 일부 수정 금지",
        "delta replay — 변경분만 반영하는 replay 금지",
        "partial update optimization — '효율'을 위한 부분 업데이트 금지",
        "bidirectional coupling — client/upstream 간 push/pull 혼용 금지"
      ],
      "critical_tests": [
        "ct-1: swap during inflight request — 요청 처리 중 topology swap 발생 시, 기존 upstream에서 완료하고 새 요청부터 새 upstream 사용",
        "ct-2: removed upstream inflight drain — 제거된 upstream의 inflight request를 graceful 완료 후 연결 종료",
        "ct-3: stale revision discard — 과거 revision 재수신 시 자동 버림. 상태 변화 없음",
        "ct-4: duplicated event collapse — 동일 revision 이벤트 다중 수신 시 중복 처리 안 됨"
      ],
      "lock": true,
      "date": "2026-05-23"
    },

    "task-step-1": {
      "t": "task",
      "v": "Step 1 — Registry Watch Endpoint (GET /watch?since=N)",
      "description": "authoritative full snapshot 반환 엔드포인트. revision counter 포함. at-least-once delivery 시뮬레이션을 위해 중복 호출 시에도 동일 revision 반환",
      "entry": ["src/registry-watch.ts (신규)"],
      "scope": [
        "GET /watch?since=N",
        "snapshot: {upstreams: [...], services: [...], revision: N}",
        "revision >= since이면 full snapshot 반환 (중복 허용)",
        "내부 revision counter (atomic increment)"
      ],
      "success": [
        "GET /watch?since=0 → {upstreams: [all], revision: 1}",
        "GET /watch?since=1 (동일 revision) → {upstreams: [same], revision: 1} (no-op)",
        "GET /watch?since=2 (미래) → 404 or empty (클라이언트 책임: since 재설정)"
      ],
