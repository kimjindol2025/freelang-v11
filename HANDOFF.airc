  "session_done": [
    "feat(macro): defmacro 완전 구현 — & rest 파라미터, (splice forms), 런타임 매크로 확장. a44fa8ac",
    "feat(errors): 에러 메시지 개선 — 유사 함수 top3 + arity 시그니처 + 파일명. d68476d2",
    "feat(stdlib): get! / get-in! — 키 없을 때 실제 키 목록 표시. 8d6ffd50",
    "feat(nil): str nil→빈 문자열 + first!/last!/or!/assert-not-nil/db-one. 6599943c",
    "feat(stack): callStack에 파일명 표시 + defn 정의 파일 추적. c3006872",
    "feat(stdlib): stdlib/macros.fl 신규 — unless/when+/assert!/spy/time!/with-log/default/when-val"
  ],

  "what_changed": {

    "defmacro": {
      "before": "(defmacro foo [a b] body) — 단순 치환만 됨. & rest 불가. op 위치 파라미터 불가",
      "after": [
        "(defmacro foo [a & rest] (do (splice rest))) — rest 파라미터 + splice",
        "(defmacro apply-fn [f x] (f x)) — op 위치 파라미터 치환",
        "(load \"stdlib/macros.fl\") 후 매크로 런타임 확장 가능"
      ],
      "files": ["bootstrap.js: evalDefmacro, MacroExpander.substitute, MacroExpander.expand, evalSExpr"]
    },

    "error_messages": {
      "before": "✖ [f] Function not found: f 혹시 'shell'를 말씀하신 건가요?",
      "after": [
        "✖ 'double-wrong' 함수 없음 (file.fl:3)\n  힌트: 비슷한 함수: 'double', 'process'",
        "✖ 'my-add': 인자 2개 필요, 1개 전달됨\n  시그니처: (my-add a b)\n  누락된 인자: b"
      ],
      "changes": [
        "suggestSimilar: 1개 → 상위 3개 배열 반환",
        "userFnCandidates: 내장/빌트인 필터링 (사용자 정의 함수만 제안)",
        "FunctionNotFoundError: 파일명:라인 포함",
        "arity 에러: 시그니처 + 누락 인자 명시"
      ]
    },

    "nil_propagation": {
      "before": "(str \"안녕 \" nil) → \"안녕 null\"  / (first []) → nil (조용히)",
      "after": "(str \"안녕 \" nil) → \"안녕 \"  / (first! []) → 에러 + 빈 배열 메시지",
      "new_functions": {
        "first!":         "(first! arr)           — 빈 배열/nil 시 에러",
        "last!":          "(last! arr)            — 빈 배열/nil 시 에러",
        "or!":            "(or! a b c)            — 모두 nil/false 시 에러",
        "assert-not-nil": "(assert-not-nil v msg) — nil 시 msg로 에러",
        "get!":           "(get! m \"key\")          — 키 없으면 실제 키 목록 표시",
        "get-in!":        "(get-in! m [k1 k2])    — 중첩 경로 실패 시 어느 단계 nil인지",
        "db-one":         "(db-one db sql params) — 첫 행 반환, 없으면 nil"
      }
    },

    "callstack": {
      "before": "→ level-c (line 2)\n  level-b (line 2)",
      "after":  "→ level-c  test-file.fl:2\n  level-b  test-file.fl:5",
      "note": "라인 번호 정확도는 TCO + 다중 평가 경로로 인해 제한적. 파일명은 정확."
    },

    "stdlib_macros": {
      "file": "stdlib/macros.fl",
      "load": "(load \"stdlib/macros.fl\")",
      "macros": {
        "unless":    "(unless cond & body)             — 조건 역전",
        "when+":     "(when+ cond step1 step2 ...)      — 여러 body",
        "assert!":   "(assert! expr \"메시지\")            — 테스트",
        "spy":       "(spy \"라벨\" expr)                  — 값 출력 후 통과",
        "time!":     "(time! \"라벨\" step1 ...)           — 실행 시간",
        "with-log":  "(with-log \"라벨\" step1 ...)        — 진입/종료 로그",
        "default":   "(default nil \"기본\")               — nil 대체",
        "when-val":  "(when-val x (println it))         — nil 아닐 때 it 바인딩",
        "apply-fn":  "(apply-fn f x)                    — 함수 값 적용"
      }
    }
  },

  "unchanged_behavior": [
    "(get m key) — nil 반환 유지 (하위 호환). strict 원하면 (get! m key)",
    "(first arr) — nil 반환 유지. strict 원하면 (first!)",
    "(str nil) — 이제 빈 문자열 반환 (변경됨, 하위 호환 아님)"
  ],

  "known_limitations": [
